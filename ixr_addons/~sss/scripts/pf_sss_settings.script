    {key="grass_explosion_strength",default=1,min=0,max=4,step=0.1,group="grass"},
    {key="grass_explosion_speed",default=5,min=0.1,max=20,step=0.1},
    {key="grass_shooting_strength",default=0.3,min=0,max=2,step=0.05},
    {key="grass_shooting_radius",default=2,min=0.1,max=10,step=0.1},
    {key="grass_anomalies",default=true,min=0,max=1,step=0.01,kind="check"},
    {key="grass_anomaly_distance",default=25,min=0,max=100,step=1},
    {key="shadow_grass_ratio",default=0.35,min=0,max=1,step=0.01,group="shadowmap"},
    {key="shadow_grass_distance",default=30,min=0,max=100,step=1},
    {key="terrain_auto_offsets",default=true,min=0,max=1,step=0.01,kind="check",group="terrain"},
    {key="terrain_grass_align",default=false,min=0,max=1,step=0.01,kind="check"},
    {key="terrain_grass_slope",default=90,min=0,max=90,step=1},
    {key="bloom_weather",default=false,min=0,max=1,step=0.01,kind="check",group="bloom"},
    {key="bloom_emissive",default=1,min=0,max=4,step=0.1},
    {key="puddles_min_wetness",default=0,min=0,max=1,step=0.05,group="puddles"},
    {key="wind_vanilla_emission",default=true,min=0,max=1,step=0.01,kind="check",group="wind"},
    {key="wet_gloss_min",default=0.60000002384186,min=0,max=0.95,step=0.01,group="wet"},
    {key="wet_gloss_max",default=0.89999997615814,min=0,max=0.99,step=0.01},
    {key="wet_gloss_auto",default=true,min=0,max=1,step=0.01,kind="check"},
    {key="wet_gloss_auto_max",default=1,min=0,max=1,step=0.01},
    {key="wet_specular",default=0.34999999403954,min=0,max=2,step=0.01},
    {key="wet_specular_color",default=0.5,min=0,max=1,step=0.01},
    {key="wet_buildup",default=1,min=0.1,max=10,step=0.1},
    {key="wet_drying",default=0.30000001192093,min=0.1,max=10,step=0.1},
    {key="wet_cover_resolution",default=256,min=64,max=2048,step=0.01,kind="list",values={64,128,256,512,1024,2048}},
}
schema[#schema+1]={key="fog_scattering_enabled",default=false,kind="check"}
schema[#schema+1]={key="grass_wind_enabled",default=true,kind="check"}
local visible = {}
local tree_wind_keys = {wind_enabled=true,wind_min=true,wind_tree_speed=true,wind_tree_trunk=true,wind_tree_bend=true,wind_grass_speed=true,wind_grass_turbulence=true,wind_grass_push=true,wind_grass_wave=true}
local grass_keys={grass_wind_enabled=true,grass_enabled=true,grass_player=true,grass_mutants=true,grass_entities=true,grass_distance=true,grass_radius=true,grass_horizontal=true,grass_vertical=true,grass_explosion_strength=true,grass_explosion_speed=true,grass_shooting_strength=true,grass_shooting_radius=true}
for _, item in ipairs(schema) do
    local key=item.key
    item.hidden=not tree_wind_keys[key] and not grass_keys[key] and (key:match("^puddles_tint_")~=nil or not (key=="footsteps_enabled" or key=="footsteps_volume" or key:match("^puddles_") or key=="ssr_quality" or key=="ssr_render_scale" or key=="ssr_blur" or key=="ssr_intensity" or key=="ssr_sky" or key=="ssr_temporal" or key=="wet_buildup" or key=="wet_drying"))
    item.group=nil
    if key=="grass_wind_enabled" then item.default=true end
    if key=="grass_anomalies" then item.default=false end
    if key=="puddles_enabled" or key=="wind_enabled" then item.default=true end
    if (key:match("_enabled$") and key~="puddles_enabled" and key~="footsteps_enabled" and key~="wind_enabled" and key~="grass_enabled" and key~="grass_wind_enabled") or key=="shadow_sun" or key=="shadow_local" then item.default=false end
end
-- Presentation order is independent of the renderer's fixed schema/uniform order.
for _, group in ipairs({"puddles","ssr","footsteps","wind","grass"}) do
    local first=true
    local group_rows=schema
    if group=="grass" then
        group_rows={}
        for _,key in ipairs({"grass_wind_enabled","wind_grass_speed","wind_grass_turbulence","wind_grass_push","wind_grass_wave","grass_enabled","grass_player","grass_mutants","grass_entities","grass_distance","grass_radius","grass_horizontal","grass_vertical","grass_explosion_strength","grass_explosion_speed","grass_shooting_strength","grass_shooting_radius"}) do
            for _,item in ipairs(schema) do if item.key==key then group_rows[#group_rows+1]=item;break end end
        end
    end
    for _, item in ipairs(group_rows) do
        local key=item.key
        local category=key:match("^([^_]+)_")
        if key=="wet_buildup" or key=="wet_drying" then category="puddles" end
        if key:match("^wind_grass_") then category="grass" end
        if not item.hidden and category==group then
            if first then item.group=group;first=false end
            visible[#visible+1]=item
        end
    end
end
for _, item in ipairs(schema) do if item.hidden then visible[#visible+1]=item end end
function rows() return visible end
function defaults()
    local values = {}
    for _, item in ipairs(schema) do values[item.key] = item.default end
    return values
end
function impl.copy(values)
    local result = {}
    for _, item in ipairs(schema) do result[item.key] = values[item.key] end
    return result
end
function validate(values)
    for _, item in ipairs(schema) do
        local value = values[item.key]
        if item.kind == "check" then
            if type(value) ~= "boolean" then return false,"pf_sss_invalid" end
        elseif type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
            return false,"pf_sss_invalid"
        elseif item.kind == "list" then
            local found = false
            for _, option in ipairs(item.values) do if option == value then found = true end end
            if not found then return false,"pf_sss_invalid" end
        elseif value < item.min or value > item.max then return false,"pf_sss_invalid" end
    end
    return true
end
function impl.normalize(values)
    local result=impl.copy(values)
    for _,item in ipairs(schema)do
        if item.key:match("_enabled$") and item.key~="puddles_enabled" and item.key~="footsteps_enabled" and item.key~="wind_enabled" and item.key~="grass_enabled" and item.key~="grass_wind_enabled" then result[item.key]=false end
    end
    result.shadow_sun=false;result.shadow_local=false
    result.fog_enabled=false;result.fog_scattering_enabled=false
    result.enabled=result.puddles_enabled or result.grass_enabled;result.ssr_enabled=result.puddles_enabled
    result.water_ice=false;result.grass_anomalies=false
    return result
end
function impl.path(suffix)
    return getFS():update_path("$app_data_root$", "pf_sss.setting" .. (suffix or ""))
end
function get()
    if not state.values then
        local values = defaults()
        local file = io.open(impl.path(), "rb")
        if file then
            local stored = {}
            for line in file:lines() do
                local key,value = line:match("^([%w_]+)=(.-)%s*$")
                if key then stored[key] = value end
            end
            file:close()
            if stored.settings_version == "1" or stored.settings_version == "2" or stored.settings_version == "3" or stored.settings_version == "4" or stored.settings_version == "5" or stored.settings_version == "6" or stored.settings_version == "7" or stored.settings_version == "8" or stored.settings_version == "9" or stored.settings_version == "10" or stored.settings_version == "11" then
                for _, item in ipairs(schema) do
                    local text = stored[item.key]
                    if item.key=="grass_wind_enabled" and stored.settings_version~="11" then text=stored.wind_enabled or "false" end
                    if item.key=="fog_scattering_enabled" and (stored.settings_version~="7" and stored.settings_version~="8" and stored.settings_version~="9" and stored.settings_version~="10" and stored.settings_version~="11") then text="false" end
                    if stored.settings_version == "1" and not text then
                        -- Valid v1 migrates only newly added fields; old mandatory fields remain strict.
                        for index=21,#schema do
                            if schema[index].key == item.key then text = tostring(item.default) end
                        end
                    end
                    -- A truncated file must never enable SSS using missing-field defaults.
                    if item.kind == "check" then
                        if text == "true" then values[item.key] = true
                        elseif text == "false" then values[item.key] = false
                        else values[item.key] = nil end
                    else values[item.key] = tonumber(text) end
                end
                local stored_valid = validate(values)
                if not stored_valid then values = defaults();values.puddles_enabled=false;values.rain_enabled=false;values.parallax_enabled=false;values.wind_enabled=false;values.grass_wind_enabled=false;values.grass_enabled=false
                elseif stored.settings_version == "5" then
                    -- v6: permit complete drying and enable the restored rain-step sounds.
                    -- Keep the player's puddle switch, colours, drying speed and reflection settings.
                    values.puddles_min_wetness=0;values.puddles_always=false
                    values.footsteps_enabled=true;values.ssr_sky=0.5
                    state.profile_update_pending=true
                elseif stored.settings_version == "6" or stored.settings_version == "7" or stored.settings_version == "8" then
                    -- v9: preserve puddle/audio choices and permanently suppress removed modules.
                    values.parallax_enabled=false
                    state.profile_update_pending=true
                elseif stored.settings_version ~= "9" and stored.settings_version ~= "10" and stored.settings_version ~= "11" then
                    -- Preserve OFF and restore the admired puddle profile from its backup.
                    local puddles=values.enabled and values.puddles_enabled
                    values=defaults();values.puddles_enabled=puddles
                    state.profile_update_pending=true
                end
                -- v10 restores tree wind only; retain every valid puddle/audio preference.
                if stored.settings_version ~= "10" and stored.settings_version ~= "11" and stored_valid then
                    values.wind_enabled=true;values.wind_min=0.3;values.wind_tree_bend=0.1
                    state.profile_update_pending=true
                end
                if stored.settings_version~="11" and stored_valid then
                    values.grass_enabled=true;values.grass_anomalies=false
                    state.profile_update_pending=true
                end
            else
                values=defaults();values.puddles_enabled=false;values.wind_enabled=false
                values.grass_wind_enabled=false;values.grass_enabled=false
            end
        end
        state.values = impl.normalize(values)
    end
    return impl.copy(state.values)
end
function available()
    return get_console():get_string("ssfx_enabled") ~= nil
end
function apply(values)
    local valid,why = validate(values)
    if not valid then return false,why end
    if not available() then return false,"pf_sss_unavailable" end
    values=impl.normalize(values)
    -- Gate off first; enable only after every validated SSS parameter is installed.
    local console = get_console()
    console:execute("ssfx_enabled 0")
    for _, item in ipairs(schema) do
        if item.key ~= "enabled" and item.key ~= "fog_scattering_enabled" then
            local value = values[item.key]
            if item.key=="fog_scattering" and not values.fog_scattering_enabled then value=0 end
            if item.key == "footsteps_variation" or item.key == "footsteps_jump" or item.key == "footsteps_land" then
                -- One volume control also scales random variation and jump/landing splashes.
                value = math.min(item.max, value * values.footsteps_volume / 0.4)
            end
            if item.key == "dof_enabled" or item.key == "water_ice" then value=false end
            if item.kind == "check" then value = value and 1 or 0 end
            console:execute("ssfx_" .. item.key .. " " .. string.format("%.6f", value))
        end
    end
    console:execute("ssfx_enabled " .. (values.enabled and "1" or "0"))
    if printf then printf("[SSS] applied master=%s AO=%s SSR=%s puddles=%s water=%s IL=%s",tostring(values.enabled),tostring(values.ao_enabled),tostring(values.ssr_enabled),tostring(values.puddles_enabled),tostring(values.water_enabled),tostring(values.il_enabled)) end
    return true
end
function save(values)
    local valid, why = validate(values)
    if not valid then return false,why end
    if not available() then return false,"pf_sss_unavailable" end
    values=impl.normalize(values)
    local lines = {"settings_version=11"}
    for _, item in ipairs(schema) do lines[#lines+1] = item.key .. "=" .. tostring(values[item.key]) end
    local target,temp,previous = impl.path(),impl.path(".tmp"),impl.path(".previous")
    local file = io.open(temp,"wb")
    if not file then return false,"pf_sss_write_error" end
    local written = file:write(table.concat(lines,"\n") .. "\n")
    local closed = file:close()
    if not written or not closed then os.remove(temp); return false,"pf_sss_write_error" end
    local old = io.open(target,"rb")
    if old then
        old:close(); os.remove(previous)
        if not os.rename(target,previous) then os.remove(temp);return false,"pf_sss_write_error" end
    end
    if not os.rename(temp,target) then
        if old then os.rename(previous,target) end
        os.remove(temp); return false,"pf_sss_write_error"
    end
    if old then os.remove(previous) end
    state.values = impl.copy(values)
    state.profile_update_pending = false
    return apply(state.values)
end

-- Puddle switch acts immediately; numeric controls are drafts until Apply.
function set_enabled(enabled)
    local values=get();values.puddles_enabled=enabled==true
    return save(values)
end

-- Reading the options remains read-only; startup persists a valid legacy reset once.
function profile_update_pending()
    get()
    return state.profile_update_pending == true
end

-- Keep the prior facade's query available while an existing session owns it.
function author_profile_pending()
    return profile_update_pending()
end
