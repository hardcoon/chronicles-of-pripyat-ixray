	self.encryption_value = xml:InitTextWnd("main:form:encryption_value", self.form)
	xml:InitTextWnd("main:form:progress_label", self.form)
	self.progress_value = xml:InitTextWnd("main:form:progress_value", self.form)
	self.encryption_cells = fit_progress_cells(self.encryption_value, 24)
	self.progress_cells = fit_progress_cells(self.progress_value, 64)
	xml:InitTextWnd("main:form:bottom_rule", self.form)
	init_rule_fill(xml, "main:form:bottom_rule_fill", self.form)
	xml:InitTextWnd("main:form:bottom_rule_corner", self.form)
	xml:InitTextWnd("main:form:abort_hint", self.form)

	self.close_button = xml:Init3tButton("main:form:close_button", self.form)
	self:Register(self.close_button, "lz_ph_close")
	self:AddCallback("lz_ph_close", ui_events.BUTTON_CLICKED, self.Abort, self)
	self.help_button = xml:Init3tButton("main:form:help_button", self.form)
	self:Register(self.help_button, "pf_ph_boot_help")
	self:AddCallback("pf_ph_boot_help", ui_events.BUTTON_CLICKED, self.OnHelp, self)
	self.help_dialog = lz_ph_boot_help_dialog()

	self:SetAutoDelete(false)
	self.pda_id = nil
	self.pda_section = nil
	self.loaded_script = nil
	self.pending_command = nil
	self.run_command_queued = false
	self.terminal_entries = {}
	self.terminal_rows = {}
	self.sound = nil
end

function lz_ph_hacking_dialog:__finalize()
end

function lz_ph_hacking_dialog:OnHelp()
	if not self.help_dialog or self.help_dialog:IsShown() then return end
	self.help_dialog:ShowDialog(true)
end

function lz_ph_hacking_dialog:Update()
	CUIScriptWnd.Update(self)
	if not self.run_command_queued then return end
	self.run_command_queued = false
	self:OnRunCommand()
end

function lz_ph_hacking_dialog:RefreshTerminal()
	self.terminal_scroll:Clear()
	self.terminal_rows = {}
	for _, entry in ipairs(self.terminal_entries) do
		local row = lz_ph_terminal_row(entry.text, entry.style)
		self.terminal_scroll:AddWindow(row, true)
		row:SetAutoDelete(false)
		table.insert(self.terminal_rows, row)
	end
	self.terminal_scroll:ScrollToEnd()
end

function lz_ph_hacking_dialog:AppendTerminal(text, style)
	if not text or text == "" then return end
	style = TERM_ROW_COLORS[style] and style or "system"
	local normalized = string.gsub(tostring(text), "\r", "")
	for line in string.gmatch(normalized .. "\n", "(.-)\n") do
		if line ~= "" then
			table.insert(self.terminal_entries, { text = line, style = style })
		end
	end
	while #self.terminal_entries > MAX_TERMINAL_ROWS do
		table.remove(self.terminal_entries, 1)
	end
	self:RefreshTerminal()
end

function lz_ph_hacking_dialog:UpdateLabels()
	self.actions_status:SetText(trf("lz_ph_status_actions", status_count_text(self.commands)))
	self.payloads_status:SetText(trf("lz_ph_status_payloads", status_count_text(self.script_list:GetSize())))
	self.extracts_status:SetText(trf("lz_ph_status_extracts", status_count_text(self.extracts_remaining)))
	self.encryption_value:SetText(progress_bar(self.encryption, self.encryption_cells))
	self.progress_value:SetText(progress_bar(self.decrypted, self.progress_cells))
	self:UpdateBonusStatus()
end

function lz_ph_hacking_dialog:ScriptOffersTrace(script, tier)
	if not script or not TRACE_COMMANDS[tier] then return false end
	local saved = get_pda_state(self.pda_id, self.pda_section)
	local bonus = saved.bonuses[tier]
	if bonus.attempted then return false end
	if self.pda_section == "pf_stash_pda_master" and tier == "red" then
		return script.force_red == true
	end
	local roll = deterministic_percent(
		script.seed,
		self.pda_id,
		self.pda_section,
		"lz_pda_trace_offer_" .. tier .. "_v1"
	)
	return roll < trace_offer_chance(tier)
end

function lz_ph_hacking_dialog:TraceStatus(tier)
	local saved = get_pda_state(self.pda_id, self.pda_section)
	local bonus = saved.bonuses[tier]
	if bonus.unlocked then return "unlocked" end
	if bonus.attempted then return "failed" end
	for index = 0, self.script_list:GetSize() - 1 do
		if self:ScriptOffersTrace(self.script_list:GetItemByIndex(index), tier) then
			return "available"
		end
	end
	return "not_found"
end

function lz_ph_hacking_dialog:UpdateBonusStatus()
	if not self.bonus_status or not self.pda_id then return end
	local parts = {}
	for _, tier in ipairs(TRACE_ORDER) do
		local status = self:TraceStatus(tier)
		if status ~= "not_found" then
			local status_id = status == "unlocked" and "lz_ph_bonus_obtained" or
				(status == "available" and "lz_ph_bonus_available" or "lz_ph_bonus_failed")
			table.insert(parts,
				TRACE_TIER_COLORS[tier] .. tr(TRACE_LABELS[tier]) .. TERM_TEXT .. ": " ..
				TRACE_STATUS_COLORS[status] .. tr(status_id) .. TERM_TEXT
			)
		end
	end
	self.bonus_status:SetText(#parts > 0 and
		(tr("lz_ph_bonus_prefix") .. "  " .. table.concat(parts, "    ")) or "")
end

function lz_ph_hacking_dialog:GenerateScripts(count, initial)
	count = math.max(0, math.floor(tonumber(count) or 0))
	local minimum = clamp(setting_number("script_power_min", 25), 1, 100)
	local maximum = clamp(setting_number("script_power_max", 100), minimum, 100)
	local generated = {}
	for _ = 1, count do
		self.script_serial = self.script_serial + 1
		local name_index = rng_int(self.rng, 1, #SCRIPT_NAMES)
		local name = SCRIPT_NAMES[name_index] .. "_" .. tostring(self.script_serial)
		local power = rng_int(self.rng, minimum, maximum)
		local seed = normalize_seed(rng_next(self.rng) + self.seed + self.script_serial * 3571)
		local script = lz_ph_script_entry(name, power, seed)
		script.serial = self.script_serial
		script.initial = initial == true
		self.script_list:AddExistingItem(script)
		script:SetColor(GetARGB(0, 255, 255, 255))
		table.insert(generated, script)
	end
	if initial and self.pda_section == "pf_stash_pda_master" and #generated > 0 then
		local strongest = generated[1]
		for index = 2, #generated do
			local candidate = generated[index]
			if candidate.power > strongest.power or
				(candidate.power == strongest.power and candidate.serial < strongest.serial) then
				strongest = candidate
			end
		end
		strongest.force_red = true
	end
end

function lz_ph_hacking_dialog:HasCommand(name)
	for index = 0, self.command_list:GetSize() - 1 do
		local item = self.command_list:GetItemByIndex(index)
		if item and item.name == name then return true end
	end
	return false
end

function lz_ph_hacking_dialog:AddCommand(name, power, trace_chance)
	local command = lz_ph_command_entry(name, power, self.encryption, self.base_encryption, trace_chance)
	self.command_list:AddExistingItem(command)
	command:SetColor(GetARGB(0, 255, 255, 255))
end

function lz_ph_hacking_dialog:Open(pda_id, pda_section, usb)
	local profile = PDA_PROFILES[pda_section]
	if not profile or not usb then return false end
	local saved = get_pda_state(pda_id, pda_section)

	self.pda_id = tonumber(pda_id)
	self.pda_section = pda_section
	self.usb = usb
	self.seed = saved.seed
	self.rng = new_rng(self.seed)
	self.base_encryption = clamp(
		setting_number(profile.setting, profile.encryption),
		0,
		100
	)
	self.encryption = self.base_encryption
	self.decrypted = 0
	self.commands = usb.commands
	self.extracts_remaining = math.max(0, usb.extracts - saved.extracts_used)
	self.script_serial = 0
	self.loaded_script = nil
	self.pending_command = nil
	self.run_command_queued = false
	self.terminal_entries = {}
	self.terminal_rows = {}
	self.terminal_scroll:Clear()

	self.script_list:RemoveAll()
	self.command_list:RemoveAll()
	self.selected_script:SetText(tr("lz_ph_selected_none"))
	if self.help_dialog and self.help_dialog:IsShown() then self.help_dialog:HideDialog() end
	self.pda_title:SetText("# " .. tr(profile.title))
	self:AppendTerminal(tr("pf_ph_boot_intro"), "system")
	self:AppendTerminal(trf("lz_ph_active_usb", usb.level), "system")
	self:GenerateScripts(usb.scripts, true)
	self:UpdateLabels()
	self:ShowDialog(true)
	return true
end

function lz_ph_hacking_dialog:BuildCommands(script)
	self.command_list:RemoveAll()
	local rng = new_rng(script.seed)
	local chance = clamp(setting_number("command_chance", 40), 0, 100)
	local rescan_chance = clamp(setting_number("rescan_chance", 35), 0, 100)
	-- The primary action is always first and always available. Optional commands
	-- offer resource recovery, protection reduction or a deliberate gamble.
	self:AddCommand("Decrypt", script.power)
	local profile = PDA_PROFILES[self.pda_section]
	for _, tier in ipairs(TRACE_ORDER) do
		if self:ScriptOffersTrace(script, tier) then
			self:AddCommand(
				TRACE_COMMANDS[tier],
				script.power,
				trace_success_chance(tier, profile.rank, script.power)
			)
		end
	end
	if rng_percent(rng) < chance then self:AddCommand("CommandUp", script.power) end
	if rng_percent(rng) < rescan_chance then self:AddCommand("Re-Scan", script.power) end
	if rng_percent(rng) < chance then self:AddCommand("BruteForce", script.power) end
	if rng_percent(rng) < chance and self.encryption > 0 then self:AddCommand("Nuke", script.power) end
	if rng_percent(rng) < clamp(setting_number("skeleton_key_chance", 0.25), 0, 100) then
		self:AddCommand("SkeletonKey", script.power)
	end
	if self.extracts_remaining > 0 and
		rng_percent(rng) < clamp(setting_number("extract_chance", 10), 0, 100) then
		self:AddCommand("Extract", script.power)
	end
	if self.commands <= 0 and not self:HasCommand("CommandUp") then
		self:AddCommand("CommandUp", script.power)
	end
end

function lz_ph_hacking_dialog:LoadScript(script)
	if not self.pda_id or self.decrypted >= 100 then return end
	if not script then return end
	-- IX-Ray userdata for CUIListBoxItem has no exported __eq operator.
	-- Compare the stable per-trial script seed instead of the UI objects.
	if self.loaded_script and script.seed == self.loaded_script.seed then return end
	self.loaded_script = script
	self.pending_command = nil
	self.run_command_queued = false
	for index = 0, self.script_list:GetSize() - 1 do
		local item = self.script_list:GetItemByIndex(index)
		if item then item:SetActive(item.seed == script.seed) end
	end
	self.selected_script:SetText(trf("lz_ph_selected", script.name, script.power))
	self:BuildCommands(script)
	self:UpdateLabels()
end

function lz_ph_hacking_dialog:OnSelectScript()
	self:LoadScript(self.script_list:GetSelectedItem())
end

function lz_ph_hacking_dialog:SelectFirstScript()
	if self.script_list:GetSize() <= 0 then return false end
	self.script_list:SetSelectedIndex(0)
	-- SetSelectedIndex changes the selection but IX-Ray keeps the previous
	-- scroll offset. Keep the automatically loaded first script visible too.
	self.script_list:ScrollToBegin()
	local script = self.script_list:GetItemByIndex(0)
	if not script then return false end
	self:LoadScript(script)
	return true
end

function lz_ph_hacking_dialog:ApplySkeletonKey()
	play_sound("pda_hacking\\normal_hacking_sound", 1)
	if not db.actor then return end
	local attack = hit()
	attack.type = hit.telepatic
	attack.power = 0.2
	attack.impulse = 1
	attack.direction = vector():set(0, 0, 1)
	attack.draftsman = db.actor
	db.actor:hit(attack)
end

function lz_ph_hacking_dialog:OnSelectCommand()
	if not self.pda_id or not self.loaded_script or self.decrypted >= 100 then return end
	local command = self.command_list:GetSelectedItem()
	if not command then return end
	self.pending_command = command
	-- Execute on the next UI frame so the list-item click can finish before the
	-- command rebuild removes that row. The user still gets one-click [RUN].
	self.run_command_queued = true
end

function lz_ph_hacking_dialog:OnRunCommand()
	if not self.pda_id or not self.loaded_script or self.decrypted >= 100 then return end
	local command = self.pending_command or self.command_list:GetSelectedItem()
	if not command then
		self:AppendTerminal(tr("lz_ph_select_hack_first"), "warning")
		return
	end
	local name = command.name
	local action_cost = command_action_cost(name)
	if self.commands < action_cost then
		local warning = trf("lz_ph_need_command_points_for_hack", action_cost, self.commands)
		self:AppendTerminal(warning, "warning")
		return
	end

	local power = command.power
	local effect = ""
	local success = false
	local trace_outcome = nil

	if name == "Nuke" then
		local value = get_nuke_effect(power, self.encryption)
		self.encryption = clamp(self.encryption - value, 0, 100)
		effect = trf("lz_ph_effect_nuke", value)
	elseif name == "Decrypt" then
		local value = get_decrypt_effect(power, self.encryption)
		self.decrypted = clamp(self.decrypted + value, 0, 100)
		effect = trf("lz_ph_effect_decrypt", value)
		success = self.decrypted >= 100
	elseif name == "Re-Scan" then
		local count = get_rescan_count(power)
		self:GenerateScripts(count)
		effect = trf("lz_ph_effect_rescan", count)
	elseif name == "CommandUp" then
		local count = get_command_up(power)
		self.commands = self.commands + count
		effect = trf("lz_ph_effect_cmdup", count)
	elseif name == "BruteForce" then
		local chance = get_brute_chance(power)
		if rng_percent(self.rng) < chance then
			self.decrypted = 100
			success = true
			effect = trf("lz_ph_effect_brute_success", chance)
		else
			effect = trf("lz_ph_effect_brute_fail", chance)
		end
	elseif name == "Extract" and self.extracts_remaining > 0 then
		local money = get_extract_money(power, self.base_encryption)
		db.actor:give_money(money)
		self.extracts_remaining = self.extracts_remaining - 1
		local saved = get_pda_state(self.pda_id, self.pda_section)
		saved.extracts_used = saved.extracts_used + 1
		db.actor:give_game_news(
			tr("lz_ph_extract_title"),
			trf("lz_ph_extract_message", money),
			"ui_inGame2_PD_Sostoyatelniy_klient",
			0,
			5000,
			0
		)
		effect = trf("lz_ph_effect_extract", money)
	elseif name == "SkeletonKey" then
		self.decrypted = 100
		success = true
		self:ApplySkeletonKey()
		effect = tr("lz_ph_effect_skeleton")
	elseif TRACE_TIERS[name] then
		local tier = TRACE_TIERS[name]
		local saved = get_pda_state(self.pda_id, self.pda_section)
		local bonus = saved.bonuses[tier]
		local chance = tonumber(command.trace_chance) or 0
		bonus.attempted = true
		if bonus.success_roll < chance then
			bonus.unlocked = true
			trace_outcome = "success"
			effect = trf("lz_ph_effect_trace_success", command_label(name), chance)
		else
			bonus.unlocked = false
			trace_outcome = "failed"
			effect = trf("lz_ph_effect_trace_failed", command_label(name), chance)
		end
	end

	local used_script = self.loaded_script
	self.loaded_script = nil
	self.pending_command = nil
	self.script_list:RemoveItem(used_script)
	self.command_list:RemoveAll()
	self.selected_script:SetText(tr("lz_ph_selected_none"))
	self.commands = self.commands - action_cost
	local command_color = TERM_COMMAND_COLORS[name] or TERM_COLORS.hack
	local terminal_style = success and "success" or
		(trace_outcome == "success" and "success" or
		(trace_outcome == "failed" and "warning" or
		(name == "BruteForce" and "warning" or "hack")))
	self:AppendTerminal(trf(
		"lz_ph_running",
		command_color .. command_label(name) .. TERM_TEXT,
		command_color .. effect .. TERM_TEXT
	), terminal_style)
	self:UpdateLabels()

	if success then
		self:Success()
	elseif self.script_list:GetSize() <= 0 then
		self:Fail("lz_ph_failed_scripts")
	else
		self:SelectFirstScript()
	end
end

function lz_ph_hacking_dialog:Success()
	local id = self.pda_id
	if not id then return end
	local section = self.pda_section
	local saved = get_pda_state(id, section)
	local reward_spec = {
		base_tier = saved.base_tier,
		base_roll = saved.base_roll,
		bonus_tiers = {}
	}
	for _, tier in ipairs(TRACE_ORDER) do
		local bonus = saved.bonuses[tier]
		if bonus.unlocked then reward_spec.bonus_tiers[tier] = bonus.slot_roll end
	end
	self:AppendTerminal(tr("lz_ph_success"), "success")
	if self.help_dialog and self.help_dialog:IsShown() then self.help_dialog:HideDialog() end
	self.pda_id = nil
	self:HideDialog()

	-- Never release the inventory PDA or create map stashes from inside the
	-- button callback that completed the hack. IX-Ray still owns that callback's
	-- UI stack until the frame ends; doing the reward work synchronously can
	-- raise a native Lua fatal with an empty traceback.
	local ready_at = time_global() + 1
	level.add_call(
		function()
			return time_global() >= ready_at
		end,
		function()
			local manager = rawget(_G, "pf_dynamic_stashes")
			if not manager or not manager.complete_stash_pda_hack then
				printf("! lz_pda_hacking: pf_dynamic_stashes completion API is unavailable")
				message("lz_ph_open_failed")
				return
			end

			local ok, completed = pcall(
				manager.complete_stash_pda_hack,
				id,
				section,
				reward_spec
			)
			if not ok then
				printf("! lz_pda_hacking: stash reward failed for PDA %s: %s", tostring(id), tostring(completed))
				message("lz_ph_open_failed")
				return
			end
			if not completed then
				printf("! lz_pda_hacking: stash reward rejected PDA %s", tostring(id))
				message("lz_ph_open_failed")
				return
			end

			forget_pda(id)
			play_sound("pda_hacking\\unlocked", 1)
		end
	)
end

function lz_ph_hacking_dialog:Fail(reason)
	local id = self.pda_id
	local profile = PDA_PROFILES[self.pda_section]
	if not id or not profile then return end
	local failed_section = profile.failed
	if self.help_dialog and self.help_dialog:IsShown() then self.help_dialog:HideDialog() end
	self.pda_id = nil
	self:AppendTerminal(tr(reason), "error")
	self:HideDialog()

	-- Replacing an inventory item and sending PDA news from the list/button
	-- callback can leave IX-Ray's native UI stack in an invalid state. Finish
	-- the failure transaction on the next frame, just like successful rewards.
	local ready_at = time_global() + 1
	level.add_call(
		function()
			return time_global() >= ready_at
		end,
		function()
			local ok, replaced = pcall(replace_actor_item, id, failed_section)
			if not ok then
				printf("! lz_pda_hacking: failed PDA replacement error for %s: %s", tostring(id), tostring(replaced))
				message("lz_ph_open_failed")
				return
			end
			if not replaced then
				printf("! lz_pda_hacking: failed PDA replacement rejected for %s", tostring(id))
				message("lz_ph_open_failed")
				return
			end

			forget_pda(id)
			play_sound("pda_hacking\\failed", 0.8)
			message("lz_ph_hack_failed_message")
		end
	)
end

function lz_ph_hacking_dialog:Abort()
	if not self.pda_id then
		self:HideDialog()
		return
	end
	-- A manual exit is a real failed intrusion. Route it through the same
	-- deferred replacement as every other loss so Extract cannot be cashed out
	-- while keeping the original PDA for another attempt.
	self:Fail("lz_ph_abort_log")
end

function lz_ph_hacking_dialog:OnKeyboard(dik, keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED and
		dik_to_bind(dik) == key_bindings.kQUIT then
		self:Abort()
		return true
	end
	return CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
end

local function open_hacking_dialog(request, pda_id, pda_section, usb)
	if request ~= open_request then return end
	local server_pda = alife():object(pda_id, true)
	if not server_pda or server_pda:section_name() ~= pda_section then
		message("lz_ph_open_failed")
		return
	end
	local hud = get_hud()
	if hud then hud:HideActorMenu() end

	if not dialog_singleton then
		local ok, created = pcall(function() return lz_ph_hacking_dialog() end)
		if not ok then
			printf("! lz_pda_hacking: UI creation failed: %s", tostring(created))
			message("lz_ph_open_failed")
			return
		end
		dialog_singleton = created
	end
	if not dialog_singleton:Open(pda_id, pda_section, usb) then
		message("lz_ph_open_failed")
	end
end

function use_stash_pda(pda)
	if not pda or not db.actor or level.name() ~= "pripyat_full" then return false end
	if not require_actor_item(pda) then return false end
	local section = pda:section()
	local profile = PDA_PROFILES[section]
	if not profile then return false end
	local usb = installed_usb()
	if not usb then
		message("lz_ph_no_usb")
		return false
	end
	local required_level = math.max(1, math.floor(tonumber(profile.required_usb_level) or 1))
	if usb.level < required_level then
		message("lz_ph_usb_level_too_low", required_level, usb.level)
		return false
	end

	get_pda_state(pda:id(), section)
	open_request = open_request + 1
	local request = open_request
	local pda_id = pda:id()
	local ready_at = time_global() + 1
	level.add_call(
		function()
			return time_global() >= ready_at
		end,
		function()
			open_hacking_dialog(request, pda_id, section, usb)
		end
	)
	return false
end

-- Console helpers for an explicit test spawn. Items taken from these boxes go
-- through the normal acquisition callback and therefore become permanently
-- registered in the USB progression state of the current save.
function debug_spawn_usb_stash(usb_level)
	if not db.actor or not alife() then return false end
	usb_level = math.floor(tonumber(usb_level) or 0)
	local usb_section = USB_SECTIONS[usb_level]
	if not usb_section then
		printf("! lz_pda_hacking: debug USB level must be 1, 2 or 3")
		return false
	end

	local actor = db.actor
	local position = actor:position()
	local direction = actor:direction()
	local horizontal = math.sqrt(direction.x * direction.x + direction.z * direction.z)
	if horizontal < 0.001 then
		direction.x = 0
		direction.z = 1
		horizontal = 1
	end
	position.x = position.x + direction.x / horizontal * 2.0
	position.z = position.z + direction.z / horizontal * 2.0
	position.y = position.y + 0.05

	local stash = alife():create(
		"pf_stash_box_metal",
		position,
		level.vertex_id(position),
		actor:game_vertex_id()
	)
	if not stash then
		printf("! lz_pda_hacking: failed to create debug USB stash")
		return false
	end

	if not alife():create(usb_section, vector(), 0, 0, stash.id) then
		alife():release(stash, true)
		printf("! lz_pda_hacking: failed to put %s into debug stash", usb_section)
		return false
	end

	printf("lz_pda_hacking: spawned debug stash with USB-%d", usb_level)
	return true
end

function debug_spawn_next_usb_stash()
	local next_level = debug_usb_level % 3 + 1
	if not debug_spawn_usb_stash(next_level) then return false end
	debug_usb_level = next_level
	return true
end

function on_game_load()
	usb_install_pending = false
	reflash_pending = false
end

function on_game_start()
	if load_callback_registered then return true end
	if type(RegisterScriptCallback) ~= "function" then
		printf("! lz_pda_hacking: RegisterScriptCallback is unavailable")
		return false
	end
	RegisterScriptCallback("load", on_game_load)
	load_callback_registered = true
	on_game_load()
	printf("lz_pda_hacking: IX-Ray port initialized (locked-PDA-only reflash actions)")
	return true
end

-- mod_script imports this namespace but does not invoke on_game_start.
-- Register only after every public callback above has been defined.
on_game_start()
