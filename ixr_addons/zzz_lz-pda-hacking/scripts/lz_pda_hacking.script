local function tr(id)
	local value = game.translate_string(id) or id
	return (string.gsub(value, "\\n", "\n"))
end

local function trf(id, ...)
	local source = tr(id)
	local ok, result = pcall(string.format, source, ...)
	return ok and result or source
end

local function init_rule_fill(xml, path, parent)
	local fill = xml:InitTextWnd(path, parent)
	local target_width = fill:GetWidth()
	fill:SetText("--")
	fill:AdjustWidthToText()
	local pair_width = fill:GetWidth()
	fill:SetText("-")
	fill:AdjustWidthToText()
	local single_width = fill:GetWidth()
	local dash_advance = math.max(0.1, pair_width - single_width)
	local cells = math.max(0, math.floor((target_width - single_width - 2) / dash_advance) + 1)
	fill:SetWidth(target_width)
	fill:SetText(string.rep("-", cells))
end

local function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

local function round(value)
	return math.floor(value + 0.5)
end

local function round1(value)
	return math.floor(value * 10 + 0.5) / 10
end

local function status_count_text(value)
	value = math.max(0, math.floor(tonumber(value) or 0))
	local color = value <= 3 and TERM_COLORS.error or
		(value <= 5 and TERM_COLORS.hack or TERM_COLORS.success)
	return color .. tostring(value) .. TERM_TEXT
end

local function fit_progress_cells(widget, maximum)
	local target_width = widget:GetWidth()
	widget:SetText("[] 100.0%")
	widget:AdjustWidthToText()
	local fixed_width = widget:GetWidth()
	widget:SetText("░░")
	widget:AdjustWidthToText()
	local pair_width = widget:GetWidth()
	widget:SetText("░")
	widget:AdjustWidthToText()
	local single_width = widget:GetWidth()
	local cell_advance = math.max(0.1, pair_width - single_width)
	local cells = math.max(1, math.floor((target_width - fixed_width - 2) / cell_advance))
	widget:SetWidth(target_width)
	return math.min(maximum, cells)
end

local function progress_bar(value, cells)
	local normalized = clamp(value, 0, 100)
	local scaled = normalized / 100 * cells
	local filled = math.floor(scaled)
	local fraction = scaled - filled
	local transition = ""
	if filled < cells and fraction >= 0.2 then
		transition = fraction >= 0.67 and "▓" or "▒"
	end
	local empty = cells - filled - (transition ~= "" and 1 or 0)
	return string.format(
		"[%s%s%s] %5.1f%%",
		string.rep("▓", filled),
		transition,
		string.rep("░", empty),
		round1(normalized)
	)
end

local function setting_number(key, default)
	local ini = system_ini()
	if not ini:section_exist(SETTINGS_SECTION) or
		not ini:line_exist(SETTINGS_SECTION, key) then
		return default
	end
	return tonumber(ini:r_string(SETTINGS_SECTION, key)) or default
end

local function section_number(section, key, default)
	local ini = system_ini()
	if not ini:section_exist(section) or not ini:line_exist(section, key) then
		return default
	end
	return tonumber(ini:r_string(section, key)) or default
end

local function get_state()
	local root = alife_storage_manager.get_state()
	local state = root[STATE_KEY]
	if type(state) ~= "table" then
		state = {
			version = STATE_VERSION,
			acquired = {},
			reservation = nil,
			installed_usb_level = nil,
			pdas = {}
		}
		root[STATE_KEY] = state
	end
	state.acquired = type(state.acquired) == "table" and state.acquired or {}
	state.pdas = type(state.pdas) == "table" and state.pdas or {}
	if type(state.reservation) ~= "table" then state.reservation = nil end
	local installed = tonumber(state.installed_usb_level)
	state.installed_usb_level = installed and USB_SECTIONS[installed] and installed or nil
	state.version = STATE_VERSION
	return state
end

local function pda_key(id)
	return tostring(tonumber(id) or 0)
end

local function normalize_seed(value)
	value = math.floor(math.abs(tonumber(value) or 1)) % 2147483647
	return value > 0 and value or 1
end

local function new_rng(seed)
	return { value = normalize_seed(seed) }
end

local function rng_next(rng)
	rng.value = (rng.value * 48271) % 2147483647
	return rng.value
end

local function rng_int(rng, low, high)
	if high <= low then return low end
	return low + (rng_next(rng) % (high - low + 1))
end

local function rng_percent(rng)
	return (rng_next(rng) % 10000) / 100
end

local function deterministic_seed(...)
	local value = 104729
	for argument = 1, select("#", ...) do
		local source = tostring(select(argument, ...))
		for index = 1, #source do
			value = (value * 131 + string.byte(source, index) + index) % 2147483647
		end
		value = (value + argument * 7919) % 2147483647
	end
	return normalize_seed(value)
end

local function deterministic_percent(...)
	return rng_percent(new_rng(deterministic_seed(...)))
end

local function message(id, ...)
	if not db.actor then return end
	local text = select("#", ...) > 0 and trf(id, ...) or tr(id)
	xr_sound.set_sound_play(db.actor:id(), "pda_tips")
	db.actor:give_game_news(
		tr("st_tip"),
		text,
		"pf_actor_thought_icon",
		0,
		6000,
		0
	)
end

local function actor_owns_item(item)
	if not item or not db.actor then return false end
	local object = alife():object(item:id(), true)
	return object ~= nil and tonumber(object.parent_id) == db.actor:id()
end

local function actual_item_section(item)
	if not item then return nil end
	local object = alife():object(item:id(), true)
	return object and object:section_name() or item:section()
end

local function require_actor_item(item)
	if actor_owns_item(item) then return true end
	message("lz_ph_requires_actor_inventory")
	return false
end

local function play_sound(path, volume)
	if not db.actor or setting_number("sound_volume", 1) <= 0 then return end
	-- get_safe_sound_object is an Anomaly helper and does not exist in IX-Ray.
	-- Use the engine's native sound_object API, which is already used by the
	-- target project's detector and UI scripts. Keep failures non-fatal.
	local created, sound = pcall(sound_object, path)
	if not created or not sound then
		printf("! lz_pda_hacking: cannot create sound [%s]: %s", tostring(path), tostring(sound))
		return
	end
	active_sound = sound
	local gain = clamp((tonumber(volume) or 1) * setting_number("sound_volume", 1), 0, 1)
	local played, err = pcall(function()
		active_sound:play_no_feedback(
			db.actor,
			sound_object.s2d,
			0,
			vector():set(0, 0, 0),
			gain
		)
	end)
	if not played then
		printf("! lz_pda_hacking: cannot play sound [%s]: %s", tostring(path), tostring(err))
	end
end

local function get_pda_state(id, section)
	local state = get_state()
	local key = pda_key(id)
	local saved = state.pdas[key]
	if type(saved) ~= "table" or saved.section ~= section then
		saved = {
			section = section,
			seed = deterministic_seed(id, section, "lz_pda_trial_seed_v2"),
			extracts_used = 0
		}
		state.pdas[key] = saved
	end
	-- Keep the old trial seed intact when migrating an existing PDA. Only newly
	-- missing reward fields are derived from the physical ID, section and fixed
	-- salts, so loading a save never rerolls a coordinate or trace result.
	saved.seed = normalize_seed(saved.seed)
	saved.extracts_used = math.max(0, math.floor(tonumber(saved.extracts_used) or 0))
	local profile = PDA_PROFILES[section]
	saved.base_tier_roll = tonumber(saved.base_tier_roll) or
		deterministic_seed(id, section, "lz_pda_base_tier_v1")
	if saved.base_tier ~= "green" and saved.base_tier ~= "cyan" and
		saved.base_tier ~= "purple" and saved.base_tier ~= "orange" then
		if profile and profile.base_tier == "master" then
			saved.base_tier = saved.base_tier_roll % 10000 < 5000 and "purple" or "orange"
		else
			saved.base_tier = profile and profile.base_tier or "green"
		end
	end
	saved.base_roll = tonumber(saved.base_roll) or
		deterministic_seed(id, section, "lz_pda_base_slot_v1")
	saved.bonuses = type(saved.bonuses) == "table" and saved.bonuses or {}
	for _, tier in ipairs(TRACE_ORDER) do
		local bonus = type(saved.bonuses[tier]) == "table" and saved.bonuses[tier] or {}
		bonus.success_roll = tonumber(bonus.success_roll) or deterministic_percent(
			id, section, "lz_pda_trace_success_" .. tier .. "_v1"
		)
		bonus.slot_roll = tonumber(bonus.slot_roll) or deterministic_seed(
			id, section, "lz_pda_trace_slot_" .. tier .. "_v1"
		)
		bonus.attempted = bonus.attempted == true
		bonus.unlocked = bonus.unlocked == true
		if bonus.unlocked then bonus.attempted = true end
		saved.bonuses[tier] = bonus
	end
	return saved
end

local function forget_pda(id)
	get_state().pdas[pda_key(id)] = nil
end

local function replace_actor_item(id, section)
	if not db.actor or not system_ini():section_exist(section) then return false end
	local old = alife():object(tonumber(id), true)
	if not old then return false end
	local created = alife():create(section, vector(), 0, 0, db.actor:id())
	if not created then return false end
	alife():release(old, true)
	return true
end

local function usb_profile(level)
	level = tonumber(level)
	local section = USB_SECTIONS[level]
	if not section then return nil end
	return {
		level = level,
		section = section,
		commands = math.max(1, math.floor(section_number(section, "command_points", 20))),
		scripts = math.max(1, math.floor(section_number(section, "initial_scripts", 5))),
		extracts = math.max(0, math.floor(section_number(section, "currency_extracts", 0)))
	}
end

local function installed_usb()
	return usb_profile(get_state().installed_usb_level)
end

function usb_level_from_section(section)
	return USB_LEVELS[section]
end

function usb_section_for_level(level)
	return USB_SECTIONS[tonumber(level)]
end

function usb_level_is_acquired(level)
	return get_state().acquired[tonumber(level)] == true
end

function can_grant_usb(max_level)
	max_level = clamp(math.floor(tonumber(max_level) or 0), 0, 3)
	local state = get_state()
	if state.reservation then return false, nil end
	for level = 1, max_level do
		if not state.acquired[level] then return true, level end
	end
	return false, nil
end

-- Returns attempted, level, section. attempted=false means another reservation
-- or no eligible missing level; the stash must not consume its one-time roll.
function reserve_next_usb(max_level, slot_index, fixed_roll, guaranteed)
	local state = get_state()
	if state.reservation and state.acquired[state.reservation.level] then
		state.reservation = nil
	end
	if state.reservation then return false, nil, nil end

	local eligible, level = can_grant_usb(max_level)
	if not eligible then return false, nil, nil end
	local chance = clamp(setting_number("usb_roll_chance", 50), 0, 100)
	local roll = tonumber(fixed_roll)
	if roll then
		roll = math.max(1, math.min(100, math.floor(roll)))
	else
		roll = math.random(100)
	end
	if not guaranteed and roll > chance then return true, nil, nil end

	state.reservation = {
		level = level,
		slot = tonumber(slot_index) or 0
	}
	return true, level, USB_SECTIONS[level]
end

-- Story/progression guarantees use the same global reservation and ordered
-- level selection as ordinary stash rolls, but bypass only the percentage
-- check. This keeps USB uniqueness intact while allowing a fixed milestone.
function reserve_next_usb_guaranteed(max_level, slot_index)
	return reserve_next_usb(max_level, slot_index, 1, true)
end

function release_usb_reservation(slot_index)
	local state = get_state()
	local reservation = state.reservation
	if reservation and tonumber(reservation.slot) == tonumber(slot_index) then
		state.reservation = nil
		return true
	end
	return false
end

function register_usb_acquired(level, item_id)
	level = tonumber(level)
	if not level or not USB_SECTIONS[level] then return false end
	local state = get_state()
	local first_time = state.acquired[level] ~= true
	state.acquired[level] = true
	if state.reservation and tonumber(state.reservation.level) == level then
		state.reservation = nil
	end
	if first_time then
		printf(
			"lz_pda_hacking: USB-%d permanently registered, item=[%s]",
			level,
			tostring(item_id)
		)
	end
	return first_time
end

-- Future traders and quests must call this before creating an external USB.
-- It returns false after that level has already been acquired.
function register_external_usb_grant(level, item_id)
	level = tonumber(level)
	if not level or usb_level_is_acquired(level) then return false end
	register_usb_acquired(level, item_id)
	return true
end

function scan_actor_usb_inventory()
	if not db.actor then return 0 end
	local found = 0
	db.actor:iterate_inventory(function(_, item)
		local level = USB_LEVELS[item:section()]
		if level then
			register_usb_acquired(level, item:id())
			found = found + 1
		end
	end, db.actor)
	return found
end

function install_usb_software(item)
	if not item or not db.actor then return false end
	if not require_actor_item(item) then return false end
	if usb_install_pending then return false end
	local usb_level = USB_LEVELS[item:section()]
	if not usb_level then return false end
	local state = get_state()
	if tonumber(state.installed_usb_level) and state.installed_usb_level >= usb_level then
		message("lz_ph_usb_already_installed")
		return false
	end

	local item_id = item:id()
	local server_item = alife():object(item_id, true)
	if not server_item or server_item:section_name() ~= USB_SECTIONS[usb_level] then
		message("lz_ph_usb_install_failed")
		return false
	end

	usb_install_pending = true
	local ready_at = time_global() + 150
	level.add_call(
		function()
			return time_global() >= ready_at
		end,
		function()
			usb_install_pending = false
			if not db.actor then return end
			local current = alife():object(item_id, true)
			if not current or current:section_name() ~= USB_SECTIONS[usb_level] or
				tonumber(current.parent_id) ~= db.actor:id() then
				message("lz_ph_usb_install_failed")
				return
			end
			local current_state = get_state()
			if tonumber(current_state.installed_usb_level) and
				current_state.installed_usb_level >= usb_level then
				message("lz_ph_usb_already_installed")
				return
			end
			register_usb_acquired(usb_level, item_id)
			current_state.installed_usb_level = usb_level
			-- The property-box callback has finished, so removing the exact
			-- actor-owned instance can no longer invalidate its active UI cell.
			alife():release(current, true)
			message(USB_INSTALL_MESSAGES[usb_level])
		end
	)
	return false
end

function reset_failed_pda(item)
	if not item then return false end
	local section = item:section()
	local normal = FAILED_TO_NORMAL[section]
	if not normal then return false end
	local id = item:id()
	if not replace_actor_item(id, normal) then return false end
	forget_pda(id)
	return true
end

function reset_all_failed_pdas()
	if not db.actor then return 0 end
	local pending = {}
	db.actor:iterate_inventory(function(_, item)
		if FAILED_TO_NORMAL[item:section()] then
			table.insert(pending, {
				id = item:id(),
				section = FAILED_TO_NORMAL[item:section()]
			})
		end
	end, db.actor)
	local reset = 0
	for _, entry in ipairs(pending) do
		if replace_actor_item(entry.id, entry.section) then
			forget_pda(entry.id)
			reset = reset + 1
		end
	end
	return reset
end

function use_failed_pda(item)
	if not require_actor_item(item) then return false end
	message("lz_ph_blocked_message")
	return false
end

local function scan_reflash_inventory()
	local found = {}
	local function inspect(id, section)
		if FAILED_TO_NORMAL[section] then
			local current = found[section]
			if not current or id < current.id then
				found[section] = {
					id = id,
					failed = section,
					normal = FAILED_TO_NORMAL[section]
				}
			end
		end
	end

	-- Section replacement is authoritative on the server object before IX-Ray's
	-- client inventory cell and grouped UI list necessarily catch up. Prefer the
	-- actor's ALife children so a freshly locked PDA cannot disappear from the
	-- reflash transaction merely because the inventory still displays an old cell.
	local server_actor = db.actor and alife():object(db.actor:id(), true) or nil
	local server_scan_ok = false
	if server_actor then
		server_scan_ok = pcall(function()
			for child_id in alife():get_children(server_actor) do
				local object = alife():object(child_id, true)
				if object then inspect(object.id, object:section_name()) end
			end
		end)
	end

	-- Keep the client iterator only as a compatibility fallback for an engine
	-- build that cannot enumerate the actor server object's children.
	if db.actor and not server_scan_ok then
		db.actor:iterate_inventory(function(_, item)
			inspect(item:id(), actual_item_section(item))
		end, db.actor)
	end
	return found
end

local function rewrite_reflash_context_actions(module_section, found)
	local ini = system_ini()
	if not ini or not ini:section_exist(module_section) then return false end

	-- CInifile::w_string cannot overwrite an existing key in this IX-Ray build.
	-- Clear all four native slots first, then pack only ranks for which an exact
	-- lz_ph_failed_pda_* exists. Ordinary pf_stash_pda_* never enter `found`.
	local ok, err = pcall(function()
		ini:set_readonly(false)
		for slot = 1, 4 do
			local text_line = "use" .. tostring(slot) .. "_text"
			local functor_line = "use" .. tostring(slot) .. "_functor"
			if ini:line_exist(module_section, text_line) then
				ini:remove_line(module_section, text_line)
			end
			if ini:line_exist(module_section, functor_line) then
				ini:remove_line(module_section, functor_line)
			end
		end

		local slot = 1
		for _, action in ipairs(REFLASH_ACTIONS) do
			if found[action.failed] then
				ini:w_string(
					module_section,
					"use" .. tostring(slot) .. "_text",
					action.text,
					nil
				)
				ini:w_string(
					module_section,
					"use" .. tostring(slot) .. "_functor",
					action.functor,
					nil
				)
				slot = slot + 1
			end
		end
	end)
	local readonly_ok, readonly_err = pcall(function() ini:set_readonly(true) end)
	if not ok then
		printf(
			"! lz_pda_hacking: cannot refresh reflash actions for %s: %s",
			tostring(module_section), tostring(err)
		)
		return false
	end
	if not readonly_ok then
		printf(
			"! lz_pda_hacking: cannot restore system ini readonly state: %s",
			tostring(readonly_err)
		)
		return false
	end
	return true
end

function refresh_reflash_context_actions(item)
	if not item or not db.actor or not actor_owns_item(item) then return false end
	local module_section = actual_item_section(item)
	if not REFLASH_MODULE_SECTIONS[module_section] then return false end
	return rewrite_reflash_context_actions(module_section, scan_reflash_inventory())
end

local function find_actor_item(id, section)
	if not db.actor then return nil end
	local object = alife():object(tonumber(id), true)
	if object and tonumber(object.parent_id) == db.actor:id() and
		object:section_name() == section then return object end
	return nil
end

local function reflash_reward_spec(pda_id, normal_section)
	if normal_section ~= "pf_stash_pda_master" then return nil end
	local legendary_chance = clamp(
		setting_number("reflash_master_legendary_reward_chance", 40),
		0,
		100
	)
	local roll = deterministic_percent(
		pda_id,
		normal_section,
		"lz_pda_reflash_master_tier_v1"
	)
	return {
		-- Purple is the epic tier; orange is the legendary tier. A dedicated
		-- deterministic roll keeps the 60/40 reflash table save-scum-proof and
		-- separate from the normal master-PDA 50/50 base reward.
		base_tier = roll < legendary_chance and "orange" or "purple",
		bonus_tiers = {}
	}
end

local function use_reflash_section(module, failed_section)
	if not module or not db.actor then return false end
	local module_section = actual_item_section(module)
	if not REFLASH_MODULE_SECTIONS[module_section] then return false end
	if not require_actor_item(module) then return false end
	if reflash_pending then return false end
	-- Resolve the PDA at click time. Inventory sorting can rebuild a grouped cell
	-- after the context menu was opened, so a cached client object or action index
	-- is not a safe transaction target.
	local found = scan_reflash_inventory()
	local target = failed_section and found[failed_section] or nil
	local server_module = alife():object(module:id(), true)
	if not target or not server_module or not REFLASH_MODULE_SECTIONS[server_module:section_name()] then
		printf(
			"! lz_pda_hacking: reflash target missing, module=%s requested=%s",
			tostring(module_section), tostring(failed_section)
		)
		message("lz_ph_reflash_no_target")
		return false
	end
	if not find_actor_item(target.id, target.failed) then
		message("lz_ph_reflash_no_target")
		return false
	end
	local module_id = module:id()
	local target_id = target.id
	local failed_section = target.failed
	local normal_section = target.normal
	local reward_spec = reflash_reward_spec(target_id, normal_section)
	reflash_pending = true

	-- The native inventory still owns the context-menu callback. Complete the
	-- locked PDA through the ordinary stash-reward API on the next frame, then
	-- consume this exact module only after that transaction succeeds.
	local ready_at = time_global() + 1
	level.add_call(
		function()
			return time_global() >= ready_at
		end,
		function()
			reflash_pending = false
			local current_module = alife():object(module_id, true)
			local current_pda = find_actor_item(target_id, failed_section)
			if not current_module or not REFLASH_MODULE_SECTIONS[current_module:section_name()] or
				tonumber(current_module.parent_id) ~= db.actor:id() or not current_pda then
				message("lz_ph_reflash_no_target")
				return
			end

			local manager = rawget(_G, "pf_dynamic_stashes")
			if not manager or not manager.complete_stash_pda_hack then
				printf("! lz_pda_hacking: pf_dynamic_stashes completion API is unavailable for reflash")
				message("lz_ph_reflash_failed")
				return
			end

			local ok, completed = pcall(
				manager.complete_stash_pda_hack,
				target_id,
				normal_section,
				reward_spec
			)
			if not ok then
				printf(
					"! lz_pda_hacking: PDA reflash error for %s: %s",
					tostring(target_id), tostring(completed)
				)
				message("lz_ph_reflash_failed")
				return
			end
			if not completed then
				printf("! lz_pda_hacking: PDA reflash rejected for %s", tostring(target_id))
				message("lz_ph_reflash_failed")
				return
			end

			forget_pda(target_id)
			alife():release(current_module, true)
			play_sound("pda_hacking\\unlocked", 0.8)
		end
	)
	return false
end

function use_reflash_novice(module)
	return use_reflash_section(module, "lz_ph_failed_pda_novice")
end

function use_reflash_stalker(module)
	return use_reflash_section(module, "lz_ph_failed_pda_stalker")
end

function use_reflash_veteran(module)
	return use_reflash_section(module, "lz_ph_failed_pda_veteran")
end

function use_reflash_master(module)
	return use_reflash_section(module, "lz_ph_failed_pda_master")
end

-- Compatibility for a context box already opened by an older cached script.
function use_reflash_target_1(module) return use_reflash_section(module, FAILED_ORDER[1]) end
function use_reflash_target_2(module) return use_reflash_section(module, FAILED_ORDER[2]) end
function use_reflash_target_3(module) return use_reflash_section(module, FAILED_ORDER[3]) end
function use_reflash_target_4(module) return use_reflash_section(module, FAILED_ORDER[4]) end

-- lz_new_mechanics owns IX-Ray's single inventory-focus callback and forwards
-- it here before RMB builds the properties box. Rebuild the module's native
-- slots from authoritative ALife children; the click handler still rescans and
-- validates its exact target so a stale open menu cannot consume the wrong PDA.
function on_item_focus_receive(item)
	refresh_reflash_context_actions(item)
	return true
end

local function get_nuke_effect(power, encryption)
	return encryption * (power * 0.2 / 100)
end

local function get_decrypt_effect(power, encryption)
	local multiplier = clamp(setting_number("decrypt_power_mult", 0.40), 0, 1)
	return power * multiplier * (1 - encryption / 100)
end

local function get_brute_chance(power)
	return power / 8
end

local function get_command_up(power)
	return math.floor(power / 12) + 1
end

local function get_rescan_count(power)
	return math.floor(power / 20) + 1
end

local function get_extract_money(power, base_encryption)
	local multiplier = math.max(0, setting_number("extract_reward_mult", 3))
	return math.ceil(power * 0.2 * clamp(base_encryption, 20, 100) * multiplier)
end

local function trace_success_chance(tier, rank, power)
	local defaults = TRACE_CHANCE_DEFAULTS[tier] and TRACE_CHANCE_DEFAULTS[tier][rank]
	if not defaults then return 0 end
	local minimum = setting_number("trace_" .. tier .. "_" .. rank .. "_min", defaults[1])
	local maximum = setting_number("trace_" .. tier .. "_" .. rank .. "_max", defaults[2])
	local factor = (clamp(tonumber(power) or 25, 25, 100) - 25) / 75
	return clamp(minimum + (maximum - minimum) * factor, 0, 100)
end

local function trace_offer_chance(tier)
	local defaults = { purple = 15, orange = 8, red = 3 }
	return clamp(setting_number("trace_" .. tier .. "_offer_chance", defaults[tier] or 0), 0, 100)
end

local function command_action_cost(name)
	if name == "CommandUp" then return 0 end
	local tier = TRACE_TIERS[name]
	if tier then
		local defaults = { purple = 2, orange = 3, red = 4 }
		return math.max(1, math.floor(setting_number("trace_" .. tier .. "_action_cost", defaults[tier] or 1)))
	end
	return 1
end

local function command_label(name)
	return tr(COMMAND_TEXT[name] or name)
end

local function command_preview(name, power, encryption, base_encryption, trace_chance)
	if name == "Decrypt" then
		return string.format("%s  +%.1f%%", command_label(name), get_decrypt_effect(power, encryption))
	elseif name == "Nuke" then
		return string.format("%s  -%.1f%%", command_label(name), get_nuke_effect(power, encryption))
	elseif name == "Re-Scan" then
		return string.format("%s  +%d", command_label(name), get_rescan_count(power))
	elseif name == "CommandUp" then
		return string.format("%s  +%d", command_label(name), get_command_up(power))
	elseif name == "BruteForce" then
		return string.format("%s  %.1f%%", command_label(name), get_brute_chance(power))
	elseif name == "Extract" then
		return string.format("%s  +%d RU", command_label(name), get_extract_money(power, base_encryption))
	elseif TRACE_TIERS[name] then
		return string.format("%s  %.1f%%  [-%d]", command_label(name), tonumber(trace_chance) or 0, command_action_cost(name))
	end
	return command_label(name)
end

local function script_power_color(power)
	if power >= 90 then return GetARGB(255, 105, 220, 120) end
	if power >= 75 then return GetARGB(255, 230, 190, 80) end
	if power >= 50 then return GetARGB(255, 210, 210, 205) end
	return GetARGB(255, 145, 155, 150)
end

local function command_text_color(name)
	if name == "Decrypt" or name == "SkeletonKey" then
		return GetARGB(255, 105, 220, 120)
	elseif name == "CommandUp" or name == "Re-Scan" then
		return GetARGB(255, 105, 185, 225)
	elseif name == "Nuke" or name == "Extract" then
		return GetARGB(255, 230, 190, 80)
	elseif name == "BruteForce" then
		return GetARGB(255, 225, 120, 80)
	elseif name == "PurpleTrace" then
		return GetARGB(255, 190, 140, 230)
	elseif name == "LegendaryTrace" then
		return GetARGB(255, 255, 170, 80)
	elseif name == "RedTrace" then
		return GetARGB(255, 235, 85, 75)
	end
	return GetARGB(255, 210, 210, 205)
end

class "lz_ph_script_entry" (CUIListBoxItem)

function lz_ph_script_entry:__init(name, power, seed) super(LIST_ROW_HEIGHT)
	self.name = name
	self.power = power
	self.seed = seed
	self:SetTextColor(script_power_color(power))
	self.text = self:GetTextItem()
	self.text:SetFont(GetFontLetterica16Russian())
	self.text:SetEllipsis(true)
	self.text:SetWndPos(vector2():set(0, 0))
	self:SetWndSize(vector2():set(SCRIPT_ROW_WIDTH, LIST_ROW_HEIGHT))
	self.text:SetWndSize(vector2():set(SCRIPT_TEXT_WIDTH, LIST_ROW_HEIGHT))
	self.text:SetText(string.format("  [%03d] /boot/%s", power, name))
end

function lz_ph_script_entry:SetActive(active)
	self.text:SetText(string.format("%s [%03d] /boot/%s", active and ">" or " ", self.power, self.name))
end

class "lz_ph_command_entry" (CUIListBoxItem)

function lz_ph_command_entry:__init(name, power, encryption, base_encryption, trace_chance)
	super(LIST_ROW_HEIGHT)
	self.name = name
	self.power = power
	self.trace_chance = trace_chance
	self:SetWndSize(vector2():set(COMMAND_ROW_WIDTH, LIST_ROW_HEIGHT))
	self:SetTextColor(command_text_color(name))
	self.text = self:GetTextItem()
	self.text:SetFont(GetFontLetterica16Russian())
	self.text:SetEllipsis(true)
	self.text:SetWndPos(vector2():set(0, 0))
	self.text:SetWndSize(vector2():set(COMMAND_TEXT_WIDTH, LIST_ROW_HEIGHT))
	self.text:SetText("[RUN] " .. command_preview(name, power, encryption, base_encryption, trace_chance))
end

class "lz_ph_terminal_row" (CUIScriptWnd)

function lz_ph_terminal_row:__init(text, style) super()
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_lz_pda_hacking.xml")
	xml:InitWindow("terminal_row", 0, self)
	self.label = xml:InitTextWnd("terminal_row:label", self)
	self.body = xml:InitTextWnd("terminal_row:body", self)

	local row_width = math.max(120, math.floor(self:GetWidth()))
	local body_x = 80
	local body_width = math.max(20, row_width - body_x)
	self.label:SetText(tr(TERM_LABELS[style] or TERM_LABELS.system))
	self.label:SetTextColor(TERM_ROW_COLORS[style] or TERM_ROW_COLORS.system)
	self.body:SetWndPos(vector2():set(body_x, 0))
	self.body:SetWndSize(vector2():set(body_width, 20))
	self.body:SetText(text or "")
	self.body:AdjustHeightToText()

	local row_height = math.max(20, math.ceil(self.body:GetHeight()))
	self.label:SetWndSize(vector2():set(78, row_height))
	self.body:SetWndSize(vector2():set(body_width, row_height))
	self:SetWndSize(vector2():set(row_width, row_height))
	self:SetAutoDelete(false)
	self:Show(true)
end

function lz_ph_terminal_row:__finalize()
end

class "lz_ph_boot_help_dialog" (CUIScriptWnd)

function lz_ph_boot_help_dialog:__init() super()
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_lz_pda_hacking.xml")
	xml:InitWindow("help", 0, self)
	xml:InitStatic("help:shade", self)
	self.form = xml:InitStatic("help:form", self)
	xml:InitTextWnd("help:form:title", self.form)
	init_rule_fill(xml, "help:form:title_fill", self.form)
	xml:InitTextWnd("help:form:title_corner", self.form)
	xml:InitTextWnd("help:form:left_edge", self.form):SetText("")
	xml:InitTextWnd("help:form:right_edge", self.form):SetText("")
	xml:InitTextWnd("help:form:subtitle", self.form)
	xml:InitTextWnd("help:form:body", self.form)
	xml:InitTextWnd("help:form:footer", self.form)
	init_rule_fill(xml, "help:form:footer_fill", self.form)
	xml:InitTextWnd("help:form:footer_corner", self.form)
	self.close_button = xml:Init3tButton("help:form:close_button", self.form)
	self:Register(self.close_button, "pf_ph_boot_help_close")
	self:AddCallback("pf_ph_boot_help_close", ui_events.BUTTON_CLICKED, self.Close, self)
	self:SetAutoDelete(false)
end

function lz_ph_boot_help_dialog:__finalize()
end

function lz_ph_boot_help_dialog:Close()
	self:HideDialog()
end

function lz_ph_boot_help_dialog:OnKeyboard(dik, keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED and
		dik_to_bind(dik) == key_bindings.kQUIT then
		self:Close()
		return true
	end
	return CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
end

