; One-use emergency decoding tool. IX-Ray reads up to four native inventory
; actions directly from the physical item's section. The section deliberately
; has no static useN entries: lz_pda_hacking.on_item_focus_receive rebuilds
; them immediately before RMB, only for locked-PDA ranks actually carried by
; the actor. Every generated action validates its target again at click time.
[lz_ph_reflash_module]:identity_immunities
GroupControlSection = spawn_group
$spawn = "devices\lz_ph_reflash_module"
class = II_ATTCH
cform = skeleton
visual = dynamics\equipments\quest\scanner_anomaly.ogf
description = lz_ph_reflash_module_descr
inv_name = lz_ph_reflash_module_name
inv_name_short = lz_ph_reflash_module_name
inv_weight = 0.8
icons_texture = ui\ui_pdahacking
inv_grid_width = 1
inv_grid_height = 1
inv_grid_x = 0
inv_grid_y = 8
cost = 15000
can_trade = true
use_condition = false

