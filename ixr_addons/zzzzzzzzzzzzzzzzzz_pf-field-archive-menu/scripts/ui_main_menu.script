-- Normal installs share the exact game version recorded by the launcher.
-- A local DEVELOPER copy uses the game version approved for this change.
local function launcher_game_version()
    local file = io.open(getFS():update_path("$fs_root$", ".launcher\\installed-state.json"), "rb")
    if file then
        local text = file:read(4096)
        file:close()
        local version = text and text:match('"version"%s*:%s*"([^"\\]+)"')
        if version and version ~= "" and version ~= "DEVELOPER" then
            return version
        end
    end
    return "2026.10.07-dev.76"
end

class "main_menu" (CUIScriptWnd)

function main_menu:__init() super()
	pf_video_settings.apply_defaults_once()
	self.mbox_mode = 0
    self:InitControls()
    self:InitCallBacks()
	if pf_stash_qa and pf_stash_qa.clear_new_game_mode_request then
		pf_stash_qa.clear_new_game_mode_request()
	end
	pf_copyright_music.menu_opened()
    xr_s.on_main_menu_on()     						 --' Distemper 03.2008 --
end

function main_menu:__finalize()
	pf_copyright_music.menu_closed()
end

function main_menu:InitControls()
	self:SetWndRect					(Frect():set(0,0,1024,768))

    local xml						= CScriptXmlInit()
    xml:ParseFile					("ui_mm_main.xml")

    xml:InitStatic					("background", self)
	self.use_instant_main_hover = alife() == nil
	if self.use_instant_main_hover then
		self.main_hover_selector = xml:InitStatic("main_hover_selector", self)
		self.main_hover_selector:Enable(false)
		self.main_hover_selector:Show(false)
		self.main_hover_hits = {}
		for index = 1, 4 do
			local hit = xml:InitStatic("main_hover_hit_" .. index, self)
			hit:Enable(false)
			table.insert(self.main_hover_hits, hit)
		end
	end
	local shniaga_node			= alife() == nil and "shniaga_wnd" or "shniaga_wnd_pause"
    self.shniaga					= xml:InitMMShniaga(shniaga_node,self);
	self:RefreshNewGameMenu()

	-- A dedicated XML pause stack keeps the approved two group gaps without
	-- changing the engine's generic menu list or the main-menu composition.
	-- The actor proxy can be temporarily absent while the loaded level is still
	-- returnable.  ALife owns the session lifetime, so it is the stable pause
	-- menu discriminator.
	self.use_custom_pause_menu = alife() ~= nil and IsGameTypeSingle()
	if self.use_custom_pause_menu then
		self:InitCustomPauseMenu(xml)
	end

	self.message_box				= CUIMessageBoxEx()
	self:Register					(self.message_box, "msg_box")

	local _ver = xml:InitStatic		("static_version",self)
	_ver:TextControl():SetText		(launcher_game_version())

	-- The approved composition keeps EXIT isolated from the main stack.
	-- It uses the same instant selector as the main stack, so every startup
	-- menu item has identical hover feedback.
	if alife() == nil and xml:NodeExist("main_quit", 0) then
		self.main_quit = xml:Init3tButton("main_quit", self)
		self:Register(self.main_quit, "btn_quit")
	end

	-- IX-Ray start
	local btn
	if xml:NodeExist("english_lang", 0) then
		btn = xml:Init3tButton("english_lang", self)
		self:Register(btn, "english_lang")
	end

	if xml:NodeExist("russian_lang", 0) then
		btn = xml:Init3tButton("russian_lang", self)
		self:Register(btn, "russian_lang")
	end
	-- IX-Ray end
end

function main_menu:InitCustomPauseMenu(xml)
	self.pause_button_defs = {
		{ xml = "pause_ret",        name = "btn_ret",        y = 198 },
		{ xml = "pause_load",       name = "btn_load",       y = 288 },
		{ xml = "pause_save",       name = "btn_save",       y = 348 },
		{ xml = "pause_options",    name = "btn_options",    y = 408 },
		{ xml = "pause_quit_to_mm", name = "btn_quit_to_mm", y = 468 },
		{ xml = "pause_quit",       name = "btn_quit",       y = 558 }
	}
	self.pause_buttons = {}
	self.pause_selector = xml:InitStatic("pause_selector", self)
	self.pause_selector:Enable(false)

	for _, definition in ipairs(self.pause_button_defs) do
		local button = xml:Init3tButton(definition.xml, self)
		self:Register(button, definition.name)
		table.insert(self.pause_buttons, button)
	end

	self.pause_selected = 1
	self.shniaga:Show(false)
	self:SelectCustomPauseButton(self.pause_selected)
end

function main_menu:SelectCustomPauseButton(index)
	if not self.use_custom_pause_menu or index < 1 or index > #self.pause_button_defs then
		return
	end
	if self.pause_selected == index and self.pause_selector:GetWndPos().y == self.pause_button_defs[index].y then
		return
	end

	self.pause_selected = index
	local position = self.pause_selector:GetWndPos()
	position.y = self.pause_button_defs[index].y
	self.pause_selector:SetWndPos(position)
end

function main_menu:ActivateCustomPauseButton()
	if self.pause_selected == 1 then
		self:OnButton_return_game()
	elseif self.pause_selected == 2 then
		self:OnButton_load_clicked()
	elseif self.pause_selected == 3 then
		self:OnButton_save_clicked()
	elseif self.pause_selected == 4 then
		self:OnButton_options_clicked()
	elseif self.pause_selected == 5 then
		self:OnButton_disconnect_clicked()
	elseif self.pause_selected == 6 then
		self:OnButton_quit_clicked()
	end
end

function main_menu:Show(f)
	self.shniaga:SetVisibleMagnifier(f)
	if f then pf_copyright_music.menu_opened() end
end

function main_menu:RefreshNewGameMenu()
	local developer_enabled = pf_stash_qa and
		pf_stash_qa.is_developer_access_enabled and
		pf_stash_qa.is_developer_access_enabled() == true
	local menu_path = developer_enabled and
		"menu_new_game_developer" or "menu_new_game"
	self.shniaga:SetPage(
		CUIMMShniaga.epi_new_game, "ui_mm_main.xml", menu_path
	)
end

function main_menu:Update()
	CUIScriptWnd.Update(self)
	self:UpdateInstantMainHover()
	if self.use_custom_pause_menu then
		for index, button in ipairs(self.pause_buttons) do
			if button:IsCursorOverWindow() then
				self:SelectCustomPauseButton(index)
				break
			end
		end
	end
	pf_copyright_music.update()
end

function main_menu:UpdateInstantMainHover()
	if not self.use_instant_main_hover or self.main_hover_selector == nil then
		return
	end

	if self.main_quit ~= nil and self.main_quit:IsCursorOverWindow() then
		local position = self.main_hover_selector:GetWndPos()
		position.y = 530
		self.main_hover_selector:SetWndPos(position)
		self.main_hover_selector:Show(true)
		return
	end

	for index, hit in ipairs(self.main_hover_hits) do
		if hit:IsCursorOverWindow() then
			local position = self.main_hover_selector:GetWndPos()
			position.y = 198 + (index - 1) * 60
			self.main_hover_selector:SetWndPos(position)
			self.main_hover_selector:Show(true)
			return
		end
	end
end


function main_menu:InitCallBacks()
	-- new game
	self:AddCallback("btn_stalker",		ui_events.BUTTON_CLICKED,				self.OnButton_new_stalker_game,		self)
	self:AddCallback("btn_master",		ui_events.BUTTON_CLICKED,				self.OnButton_new_master_game,		self)
	self:AddCallback("btn_developer",	ui_events.BUTTON_CLICKED,				self.OnButton_new_developer_game,	self)
	self:AddCallback("btn_spawn",		ui_events.BUTTON_CLICKED,				self.OnButton_load_spawn,			self)
	-- options
	self:AddCallback("btn_options",     ui_events.BUTTON_CLICKED,				self.OnButton_options_clicked,		self)
	-- load
	self:AddCallback("btn_load",        ui_events.BUTTON_CLICKED,				self.OnButton_load_clicked,			self)
	-- save
	self:AddCallback("btn_save",		ui_events.BUTTON_CLICKED,				self.OnButton_save_clicked,			self)

	-- multiplayer
	if (IsSupportMP()) then -- IX-Ray: Optional multiplayer check
		self:AddCallback("btn_net_game",	ui_events.BUTTON_CLICKED,				self.OnButton_network_game_clicked,	self)
		self:AddCallback("btn_internet",	ui_events.BUTTON_CLICKED,				self.OnButton_internet_clicked,		self)
		self:AddCallback("btn_localnet",	ui_events.BUTTON_CLICKED,				self.OnButton_localnet_clicked,		self)
		self:AddCallback("btn_multiplayer", ui_events.BUTTON_CLICKED,				self.OnButton_multiplayer_clicked,	self)
	end

	self:AddCallback("btn_logout",		ui_events.BUTTON_CLICKED,				self.OnButton_logout_clicked,		self)

	-- quit
	self:AddCallback("btn_quit",		ui_events.BUTTON_CLICKED,				self.OnButton_quit_clicked,			self)
	self:AddCallback("btn_quit_to_mm",	ui_events.BUTTON_CLICKED,				self.OnButton_disconnect_clicked,	self)
	self:AddCallback("btn_ret",			ui_events.BUTTON_CLICKED,				self.OnButton_return_game,			self)
	self:AddCallback("btn_lastsave",	ui_events.BUTTON_CLICKED,				self.OnButton_last_save,			self)
	self:AddCallback("btn_credits",		ui_events.BUTTON_CLICKED,				self.OnButton_credits_clicked,		self)

	-- IX-Ray start
	self:AddCallback("english_lang",	ui_events.BUTTON_CLICKED,				self.OnBtnEnglish,			self)
	self:AddCallback("russian_lang",	ui_events.BUTTON_CLICKED,				self.OnBtnRussian,			self)
	-- IX-Ray end

	-- message box
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_OK_CLICKED,		self.OnMsgOk,						self)
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_CANCEL_CLICKED,	self.OnMsgCancel,					self)
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_YES_CLICKED,		self.OnMsgYes,						self)
	self:AddCallback("msg_box",     ui_events.MESSAGE_BOX_NO_CLICKED,		self.OnMsgNo,						self)
	self:AddCallback("msg_box",			ui_events.MESSAGE_BOX_QUIT_GAME_CLICKED,self.OnMessageQuitGame,				self)
	self:AddCallback("msg_box",			ui_events.MESSAGE_BOX_QUIT_WIN_CLICKED,	self.OnMessageQuitWin,				self)

	self:Register(self, "self")
	self:AddCallback("self",	ui_events.MAIN_MENU_RELOADED, self.OnMenuReloaded, self)
end
function main_menu:OnMsgOk()
	self.mbox_mode = 0
end

function main_menu:OnMsgCancel()
	self.mbox_mode = 0
end

function main_menu:OnMsgYes()

	if 	self.mbox_mode == 1 then
		self:LoadLastSave()
	end

	self.mbox_mode = 0
end

function main_menu:OnMsgNo()
	self.mbox_mode = 0
end

function main_menu:LoadLastSave()
	local					console = get_console()
	pf_copyright_music.menu_closed()
	console:execute			("main_menu off")
	console:execute			("load_last_save")
end

function main_menu:OnButton_last_save()
	if ( alife() == nil) then
		self:LoadLastSave	()
		return
	end

	if ( (db.actor ~= nil) and (db.actor:alive() == false) ) then
		self:LoadLastSave	()
		return
	end

	self.mbox_mode			= 1
	self.message_box:InitMessageBox	("message_box_confirm_load_save")
	self.message_box:ShowDialog(true)
end

function main_menu:OnButton_credits_clicked()
--	local console = get_console()
--	console:execute("main_menu off")
	game.start_tutorial("credits_seq")
end

function main_menu:OnButton_quit_clicked()
	self.message_box:InitMessageBox("message_box_quit_windows")
	self.message_box:ShowDialog(true)
end


function main_menu:OnButton_disconnect_clicked()
	self.message_box:InitMessageBox("message_box_quit_game")

	if (level.game_id() ~= 1) then
		self.message_box:SetText("ui_mm_disconnect_message")	-- MultiPlayer
	else
		self.message_box:SetText("ui_mm_quit_game_message")		-- SinglePlayer
	end
	self.message_box:ShowDialog(true)
end

function main_menu:OnMessageQuitGame()
	local console = get_console()
	console:execute("disconnect")
end

function main_menu:OnMessageQuitWin()
	local console = get_console()
	console:execute("quit")
end

function main_menu:OnButton_return_game()
	local console = get_console()
	pf_copyright_music.menu_closed()
	console:execute("main_menu off")
	xr_s.on_main_menu_off()      						--' Distemper 03.2008 --
end

function main_menu:OnButton_new_novice_game()
	local console = get_console()
	pf_stash_qa.request_new_game_mode("novice")
	console:execute("g_game_difficulty gd_novice")
	self:StartGame()
end

function main_menu:OnButton_new_stalker_game()
	local console = get_console()
	pf_stash_qa.request_new_game_mode("stalker")
	console:execute("g_game_difficulty gd_stalker")
	self:StartGame()
end

function main_menu:OnButton_new_veteran_game()
	local console = get_console()
	pf_stash_qa.request_new_game_mode("veteran")
	console:execute("g_game_difficulty gd_veteran")
	self:StartGame()
end

function main_menu:OnButton_new_master_game()
	local console = get_console()
	pf_stash_qa.request_new_game_mode("master")
	console:execute("g_game_difficulty gd_master")
	self:StartGame()
end

function main_menu:OnButton_new_developer_game()
	if not (pf_stash_qa and pf_stash_qa.is_developer_access_enabled and
		pf_stash_qa.is_developer_access_enabled() == true) then
		printf("[PF MAIN MENU] Developer new game rejected: access is disabled")
		return
	end
	-- The engine has four fixed difficulty enum values. Developer deliberately
	-- reuses the otherwise hidden novice slot. The one-shot appdata request
	-- persists that separate choice across the gameplay Lua-state rebuild.
	local console = get_console()
	pf_stash_qa.request_new_game_mode("developer")
	console:execute("g_game_difficulty gd_novice")
	self:StartGame()
end

function main_menu:StartGame()
	local console = get_console()
	pf_copyright_music.menu_closed()

	if (alife() ~= nil) then
		console:execute	("disconnect")
	end
	device():pause(false)
	console:execute("start server(all/single/alife/new) client(localhost)")
	console:execute("main_menu off")
end

function main_menu:OnButton_load_spawn()
	if not db.actor or not pf_stash_qa or
		not pf_stash_qa.is_developer_access_enabled or
		pf_stash_qa.is_developer_access_enabled() ~= true then
		return
	end

	if self.f1_item_spawner == nil then
		self.f1_item_spawner = ui_pf_f1_item_spawner.item_spawner_dialog(self)
	end

	self.f1_item_spawner:RefreshCatalog()
	self.f1_item_spawner:ShowDialog(true)
	self:HideDialog()
	self:Show(false)
end

function main_menu:OnButton_save_clicked()
	if self.save_dlg == nil then
		self.save_dlg = ui_save_dialog.save_dialog()
		self.save_dlg.owner = self
	end

	self.save_dlg:FillList()
	self.save_dlg:ShowDialog(true)
	self:HideDialog()
	self:Show(false)
end

function main_menu:OnButton_options_clicked()
	if self.opt_dlg == nil then
		self.opt_dlg = ui_mm_opt_main.options_dialog()
		self.opt_dlg.owner = self
	end

	self.opt_dlg:SetCurrentValues()
	self.opt_dlg:ShowDialog(true)
	self:HideDialog()
	self:Show(false)
end

-- IX-Ray start
