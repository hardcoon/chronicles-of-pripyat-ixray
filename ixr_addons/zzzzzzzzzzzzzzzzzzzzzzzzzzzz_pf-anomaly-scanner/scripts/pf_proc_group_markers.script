-- Generated from reference_group_catalog_20260821.json.
-- Group coordinates start hidden. A serialized marker is revealed only after
-- the actor physically enters the group's main aura or buys its coordinates
-- from Novikov. Dialogue queries use the constant-time availability API below.

local SPOT_TYPE = "primary_object"
local DISCOVERY_PSTOR = "pf_proc_discovered_groups_v1"
local CHECK_INTERVAL_MS = 200
local DISCOVERY_SYNC_MS = 1000
local RETRY_DELAY_MS = 1000
local EXPECTED_GROUPS = 41
local MAX_GROUP_RADIUS_SQR = 50 * 50
local DISCOVERY_MESSAGE = "pf_proc_anomaly_zone_discovered"

-- Color only the hover label, using the real main-aura section.
-- Psi has no override and keeps its existing white label.
local MAP_HINT_COLORS = {
	pf_proc_aura_thermal = "255,255,145,40",
	pf_proc_aura_chemical = "255,105,220,120",
	pf_proc_aura_electric = "255,105,185,235",
	pf_proc_aura_gravitational = "255,255,220,70"
}

local entries = {
	{ group_id = 1, object_name = "pf_proc_fixed_g01_a_base", hint = "st_pf_proc_group_01" },
	{ group_id = 2, object_name = "pf_proc_fixed_g02_a_base", hint = "st_pf_proc_group_02" },
	{ group_id = 3, object_name = "pf_proc_fixed_g03_a_base", hint = "st_pf_proc_group_03" },
	{ group_id = 4, object_name = "pf_proc_fixed_g04_a_base", hint = "st_pf_proc_group_04" },
	{ group_id = 5, object_name = "pf_proc_fixed_g05_a_base", hint = "st_pf_proc_group_05" },
	{ group_id = 6, object_name = "pf_proc_fixed_g06_a_base", hint = "st_pf_proc_group_06" },
	{ group_id = 7, object_name = "pf_proc_fixed_g07_a_base", hint = "st_pf_proc_group_07" },
	{ group_id = 8, object_name = "pf_proc_fixed_g08_a_base", hint = "st_pf_proc_group_08" },
	{ group_id = 9, object_name = "pf_proc_fixed_g09_a_base", hint = "st_pf_proc_group_09" },
	{ group_id = 10, object_name = "pf_proc_fixed_g10_a_base", hint = "st_pf_proc_group_10" },
	{ group_id = 11, object_name = "pf_proc_fixed_g11_a_base", hint = "st_pf_proc_group_11" },
	{ group_id = 12, object_name = "pf_proc_fixed_g12_a_base", hint = "st_pf_proc_group_12" },
	{ group_id = 13, object_name = "pf_proc_fixed_g13_a_base", hint = "st_pf_proc_group_13" },
	{ group_id = 14, object_name = "pf_proc_fixed_g14_a_base", hint = "st_pf_proc_group_14" },
	{ group_id = 15, object_name = "pf_proc_fixed_g15_a_base", hint = "st_pf_proc_group_15" },
	{ group_id = 16, object_name = "pf_proc_fixed_g16_a_base", hint = "st_pf_proc_group_16" },
	{ group_id = 17, object_name = "pf_proc_fixed_g17_a_base", hint = "st_pf_proc_group_17" },
	{ group_id = 18, object_name = "pf_proc_fixed_g18_a_base", hint = "st_pf_proc_group_18" },
	{ group_id = 19, object_name = "pf_proc_fixed_g19_a_base", hint = "st_pf_proc_group_19" },
	{ group_id = 20, object_name = "pf_proc_fixed_g20_a_base", hint = "st_pf_proc_group_20" },
	{ group_id = 21, object_name = "pf_proc_fixed_g21_a_base", hint = "st_pf_proc_group_21" },
	{ group_id = 22, object_name = "pf_proc_fixed_g22_a_base", hint = "st_pf_proc_group_22" },
	{ group_id = 23, object_name = "pf_proc_fixed_g23_a_base", hint = "st_pf_proc_group_23" },
	{ group_id = 24, object_name = "pf_proc_fixed_g24_a_base", hint = "st_pf_proc_group_24" },
	{ group_id = 25, object_name = "pf_proc_fixed_g25_a_base", hint = "st_pf_proc_group_25" },
	{ group_id = 26, object_name = "pf_proc_fixed_g26_a_base", hint = "st_pf_proc_group_26" },
	{ group_id = 27, object_name = "pf_proc_fixed_g27_a_base", hint = "st_pf_proc_group_27" },
	{ group_id = 28, object_name = "pf_proc_fixed_g28_a_base", hint = "st_pf_proc_group_28" },
	{ group_id = 29, object_name = "pf_proc_fixed_g29_a_base", hint = "st_pf_proc_group_29" },
	{ group_id = 30, object_name = "pf_proc_fixed_g30_a_base", hint = "st_pf_proc_group_30" },
	{ group_id = 31, object_name = "pf_proc_fixed_g31_a_base", hint = "st_pf_proc_group_31" },
	{ group_id = 32, object_name = "pf_proc_fixed_g32_a_base", hint = "st_pf_proc_group_32" },
	{ group_id = 33, object_name = "pf_proc_fixed_g33_a_base", hint = "st_pf_proc_group_33" },
	{ group_id = 34, object_name = "pf_proc_fixed_g34_a_base", hint = "st_pf_proc_group_34" },
	{ group_id = 35, object_name = "pf_proc_fixed_g35_a_base", hint = "st_pf_proc_group_35" },
	{ group_id = 36, object_name = "pf_proc_fixed_g36_a_base", hint = "st_pf_proc_group_36" },
	{ group_id = 37, object_name = "pf_proc_fixed_g37_a_base", hint = "st_pf_proc_group_37" },
	{ group_id = 38, object_name = "pf_proc_fixed_g38_a_base", hint = "st_pf_proc_group_38" },
	{ group_id = 39, object_name = "pf_proc_fixed_g39_a_base", hint = "st_pf_proc_group_39" },
	{ group_id = 40, object_name = "pf_proc_fixed_g40_a_base", hint = "st_pf_proc_group_40" },
	{ group_id = 41, object_name = "pf_proc_fixed_g41_a_base", hint = "st_pf_proc_group_41" },
}

local ready = false
local next_action = 0
local discovered = {}
local entries_by_id = {}
local previous_actor_position = nil
local recovery = { last_raw = nil, next_read = 0, pending = {} }
local scanner_indications = {}
local scanner_details = { tiers = {}, targets = {} }

local function gate_open()
	return db.actor ~= nil
		and level.name() == "pripyat_full"
end

local function copy_position(position)
	return vector():set(position.x, position.y, position.z)
end

local function read_discovered(raw)
	-- Missing/corrupt state is not evidence that no fields were discovered.
	-- An explicitly saved empty string remains authoritative for fresh saves.
	if type(raw) ~= "string" then return nil end
	local result = {}
	if raw == "" then return result end
	for value in string.gmatch(raw .. ",", "(.-),") do
		if not string.match(value, "^%d+$") then return nil end
		local group_id = tonumber(value)
		if not entries_by_id[group_id] then return nil end
		result[group_id] = true
	end
	return result
end

local function save_discovered()
	local encoded = {}
	for group_id = 1, EXPECTED_GROUPS do
		if discovered[group_id] then encoded[#encoded + 1] = tostring(group_id) end
	end
	local raw = table.concat(encoded, ",")
	if raw ~= recovery.last_raw then
		xr_logic.pstor_store(db.actor, DISCOVERY_PSTOR, raw)
		recovery.last_raw = raw
	end
end

local function apply_scanner_tint(entry)
	local mode = scanner_indications[entry.group_id]
	local color = fcolor():set(255, 255, 255, 255)
	if mode == "green" then color:set(0, 255, 0, 255)
	elseif mode == "gold" then color:set(188, 138, 53, 255) end
	local compound = scanner_details.tiers[entry.group_id] ~= nil
	if compound then color:set(0, 0, 0, 0) end
	local manager = level.map_manager()
	if not manager then return end
	manager:MapLocationsForEach(SPOT_TYPE, entry.id, function(location)
		location:HighlightSpot(compound or mode == "green" or mode == "gold", color)
		return false
	end)
end

-- Called only for load/install/removal and artifact/emission change messages.
function set_scanner_indications(colors, replace)
	if replace then scanner_indications = {} end
	for group_id, mode in pairs(colors or {}) do
		scanner_indications[group_id] = mode
		local entry = entries_by_id[group_id]
		if ready and entry and discovered[group_id] then apply_scanner_tint(entry) end
	end
end

local function auxiliary_visibility(id, kind, visible)
	local manager = level.map_manager()
	if not manager then return end
	manager:MapLocationsForEach(kind, id, function(location)
		if visible and not location:SpotEnabled() then location:EnableSpot()
		elseif not visible and location:SpotEnabled() then location:DisableSpot() end
		return false
	end)
end

local function scanner_visibility(entry)
	local visible = false
	local manager = level.map_manager()
	if manager then
		manager:MapLocationsForEach(SPOT_TYPE, entry.id, function(location)
			visible = visible or location:SpotEnabled()
			return false
		end)
	end
	if entry.scanner_kind then auxiliary_visibility(entry.id, entry.scanner_kind, visible) end
	if entry.scanner_artifact then
		auxiliary_visibility(entry.scanner_artifact.id, "pf_scanner_artifact", visible)
	end
end

local function sync_scanner_details(entry)
	local tier = discovered[entry.group_id] and scanner_details.tiers[entry.group_id]
	local mode = scanner_indications[entry.group_id]
	local kind = tier and ("pf_scanner_m" .. tier ..
		(mode == "green" and "_green" or (tier == 1 and mode == "gold" and "_gold" or "")))
	if entry.scanner_kind and entry.scanner_kind ~= kind then
		level.map_remove_object_spot(entry.id, entry.scanner_kind)
	end
	entry.scanner_kind = kind
	if kind and level.map_has_object_spot(entry.id, kind) == 0 then
		-- Original zone circle and badge are one image; the native spot owns the
		-- filter, position and hint, with its own texture transparent while equipped.
		local title = entry.hint_text or game.translate_string(entry.hint)
		-- Put the line break before the color reset: a leading break in an
		-- empty colored subline is skipped by the native text renderer.
		title = title:gsub("%%c%[default%]$", "")
		level.map_add_object_spot(entry.id, kind,
			title .. "\\n%c[default]" ..
			game.translate_string("pf_scanner_m" .. tier .. "_installed"))
	end
	local target = tier == 2 and scanner_details.targets[entry.group_id] or nil
	local previous = entry.scanner_artifact
	if previous and (not target or target.id ~= previous.id or target.name ~= previous.name) then
		level.map_remove_object_spot(previous.id, "pf_scanner_artifact")
		entry.scanner_artifact = nil
	end
	if target then
		if level.map_has_object_spot(target.id, "pf_scanner_artifact") == 0 then
			-- An object spot follows native client coordinates online and ALife offline.
			level.map_add_object_spot(target.id, "pf_scanner_artifact",
				game.translate_string("pf_scanner_artifact_hint"))
		end
		entry.scanner_artifact = { id = target.id, name = target.name }
	end
	scanner_visibility(entry)
end

-- Complete snapshots arrive through the facade on load, installation, removal
-- and natural population events. No second ALife search or artifact timer.
function set_scanner_details(tiers, targets)
	scanner_details.tiers = tiers or {}
	scanner_details.targets = targets or {}
	if not ready or not gate_open() then return end
	for _, entry in ipairs(entries) do
		if discovered[entry.group_id] then apply_scanner_tint(entry) end
		sync_scanner_details(entry)
	end
end

local function set_marker(entry, visible)
	local has_spot = level.map_has_object_spot(entry.id, SPOT_TYPE) ~= 0
	if visible and not has_spot then
		level.map_add_object_spot_ser(entry.id, SPOT_TYPE,
			entry.hint_text or game.translate_string(entry.hint))
	elseif visible and has_spot and entry.hint_text then
		-- Refresh serialized labels once on load/reveal, preserving map filters.
		level.map_change_spot_hint(entry.id, SPOT_TYPE, entry.hint_text)
	elseif not visible and has_spot then
		level.map_remove_object_spot(entry.id, SPOT_TYPE)
	end
	if visible then apply_scanner_tint(entry) end
	sync_scanner_details(entry)
end

local function synchronize_discovered(initial)
	local raw = xr_logic.pstor_retrieve(db.actor, DISCOVERY_PSTOR, false)
	if not initial and raw == recovery.last_raw and not next(recovery.pending) then return end
	local loaded = read_discovered(raw)
	recovery.last_raw = raw
	for _, entry in ipairs(entries) do
		local group_id = entry.group_id
		local previous = discovered[group_id]
		local known = previous or (loaded and loaded[group_id]) or recovery.pending[group_id]
		-- Recover only exact catalogue anchors, never arbitrary/user map spots.
		if initial and not loaded and level.map_has_object_spot(entry.id, SPOT_TYPE) ~= 0 then
			known = true
		end
		if known then discovered[group_id] = true end
		if initial or (known and not previous) then set_marker(entry, known == true) end
	end
	recovery.pending = {}
	-- Do not create an empty key while waiting for late actor save data.
	if loaded or next(discovered) then save_discovered() end
end

-- The facade supplies groups proven by validated, still-existing scanners.
-- Queue them when the actor load callback precedes the zone registry.
function restore_discovered_groups(groups)
	for value, known in pairs(groups or {}) do
		local group_id = tonumber(value)
		if known == true and group_id and group_id == math.floor(group_id)
			and group_id >= 1 and group_id <= EXPECTED_GROUPS then
			recovery.pending[group_id] = true
		end
	end
	if ready and gate_open() then synchronize_discovered(false) end
end

local function build_registry()
	local simulator = alife()
	if not simulator then return false end
	local wanted = {}
	for _, entry in ipairs(entries) do wanted[entry.object_name] = entry end
	for _, object in simulator:objects() do
		local entry = wanted[object:name()]
		if entry and not entry.id then
			entry.id = object.id
			entry.center = copy_position(object.position)
			local color = MAP_HINT_COLORS[object:section_name()]
			entry.hint_text = color and ("%c[" .. color .. "]" ..
				game.translate_string(entry.hint) .. "%c[default]") or nil
		end
	end
	local count = 0
	for _, entry in ipairs(entries) do
		if entry.id then count = count + 1 end
	end
	if count ~= EXPECTED_GROUPS then return false end
	entries_by_id = {}
	for _, entry in ipairs(entries) do entries_by_id[entry.group_id] = entry end
	synchronize_discovered(true)
	previous_actor_position = copy_position(db.actor:position())
	ready = true
	return true
end

local function segment_distance_sqr(center, from, to)
	local vx = to.x - from.x
	local vy = to.y - from.y
	local vz = to.z - from.z
	local length_sqr = vx * vx + vy * vy + vz * vz
	local t = 0
	if length_sqr > 0.000001 then
		t = ((center.x - from.x) * vx + (center.y - from.y) * vy +
			(center.z - from.z) * vz) / length_sqr
		t = math.max(0, math.min(1, t))
	end
	local dx = center.x - (from.x + vx * t)
	local dy = center.y - (from.y + vy * t)
	local dz = center.z - (from.z + vz * t)
	return dx * dx + dy * dy + dz * dz
end

local function actor_crossed_aura(entry, from, to)
	if segment_distance_sqr(entry.center, from, to) > MAX_GROUP_RADIUS_SQR then return false end
	local zone = level.object_by_id(entry.id)
	if not zone then return false end
	for _, t in ipairs({ 0, 0.25, 0.5, 0.75, 1 }) do
		local position = vector():set(
			from.x + (to.x - from.x) * t,
			from.y + (to.y - from.y) * t,
			from.z + (to.z - from.z) * t
		)
		local ok, inside = pcall(function() return zone:inside(position) end)
		if ok and inside then return true end
	end
	return false
end

function reveal_group(group_id)
	group_id = math.floor(tonumber(group_id) or 0)
	local entry = entries_by_id[group_id]
	if not ready or not entry or not gate_open() then return false end
	-- A discovery between polling ticks must not overwrite late loaded groups.
	synchronize_discovered(false)
	if not discovered[group_id] then
		discovered[group_id] = true
		save_discovered()
	end
	set_marker(entry, true)
	return true
end

-- On-demand placement query: exact same main-aura geometry as discovery.
function placement_group(actor_position, placement_position)
	if not ready or not gate_open() then return nil end
	local best, best_distance = nil, nil
	for _, entry in ipairs(entries) do
		local distance = segment_distance_sqr(entry.center, actor_position, actor_position)
		if distance <= MAX_GROUP_RADIUS_SQR then
			local zone = level.object_by_id(entry.id)
			if zone then
				local ok, inside = pcall(function()
					return zone:inside(actor_position) and zone:inside(placement_position)
				end)
				if ok and inside and (not best or distance < best_distance
					or (distance == best_distance and entry.group_id < best)) then
					best, best_distance = entry.group_id, distance
				end
			end
		end
	end
	return best
end

function is_ready()
	return ready and gate_open()
end

function is_group_available(group_id)
	group_id = math.floor(tonumber(group_id) or 0)
	return ready and gate_open() and entries_by_id[group_id] ~= nil
		and not discovered[group_id]
end

function is_discovered(group_id)
	group_id = math.floor(tonumber(group_id) or 0)
	return ready and entries_by_id[group_id] ~= nil
		and discovered[group_id] == true
end

function update(now)
	if now < next_action or not gate_open() then return end
	if not ready then
		if not build_registry() then
			next_action = now + RETRY_DELAY_MS
			return
		end
	end
	next_action = now + CHECK_INTERVAL_MS
	if now >= recovery.next_read then
		synchronize_discovered(false)
		recovery.next_read = now + DISCOVERY_SYNC_MS
	end
	-- Mirror the existing Locations filter in the discovery owner's 200 ms pass.
	-- Artifact movement itself is handled by the engine's object map locations.
	for _, entry in ipairs(entries) do
		if scanner_details.tiers[entry.group_id] then scanner_visibility(entry) end
	end
	local actor_position = copy_position(db.actor:position())
	local from = previous_actor_position or actor_position
	for _, entry in ipairs(entries) do
		if not discovered[entry.group_id] and actor_crossed_aura(entry, from, actor_position) then
			if reveal_group(entry.group_id) then
				news_manager.send_tip(db.actor, DISCOVERY_MESSAGE, nil, nil, nil, nil)
			end
			break
		end
	end
	previous_actor_position = actor_position
end

function reset()
	for _, entry in ipairs(entries) do
		entry.id = nil
		entry.center = nil
		entry.hint_text = nil
		entry.scanner_artifact = nil
		entry.scanner_kind = nil
	end
	ready = false
	next_action = 0
	discovered = {}
	entries_by_id = {}
	previous_actor_position = nil
	recovery = { last_raw = nil, next_read = 0, pending = {} }
	scanner_indications = {}
	scanner_details = { tiers = {}, targets = {} }
end
