-- Passive dialog. It has no frame callback; the facade supplies the action.
class "pf_scanner_destroy_dialog" (CUIScriptWnd)

function pf_scanner_destroy_dialog:__init(confirm, replace_confirm) super()
	self.confirm = confirm
	self.replace_confirm = replace_confirm
	local xml = CScriptXmlInit()
	xml:ParseFile("pf_anomaly_scanner.xml")
	xml:InitWindow("destroy_dialog", 0, self)
	local form = xml:InitStatic("destroy_dialog:form", self)
	self.question = xml:InitTextWnd("destroy_dialog:form:question", form)
	self.name = xml:InitTextWnd("destroy_dialog:form:name", form)
	self.warning = xml:InitTextWnd("destroy_dialog:form:warning", form)
	local yes = xml:Init3tButton("destroy_dialog:form:confirm_button", form)
	local no = xml:Init3tButton("destroy_dialog:form:cancel_button", form)
	self:Register(yes, "scanner_destroy_yes")
	self:Register(no, "scanner_destroy_no")
	self:AddCallback("scanner_destroy_yes", ui_events.BUTTON_CLICKED, self.Confirm, self)
	self:AddCallback("scanner_destroy_no", ui_events.BUTTON_CLICKED, self.Cancel, self)
	self:SetAutoDelete(false)
end

function pf_scanner_destroy_dialog:__finalize()
end

function pf_scanner_destroy_dialog:Open(id, tier)
	self.scanner_id = id
	self.replacement = nil
	self.question:SetText(game.translate_string("pf_scanner_destroy_question"))
	self.name:SetText(game.translate_string(tier == 2 and "pf_scanner_m2_name" or "pf_scanner_name"))
	self.warning:SetText(game.translate_string("pf_scanner_destroy_warning"))
	self:ShowDialog(true)
end

function pf_scanner_destroy_dialog:OpenReplacement(request)
	self.scanner_id = nil
	self.replacement = request
	self.question:SetText(game.translate_string("pf_scanner_replace_question"))
	self.name:SetText(game.translate_string("pf_scanner_replace_name"))
	self.warning:SetText(game.translate_string("pf_scanner_replace_warning"))
	self:ShowDialog(true)
end

function pf_scanner_destroy_dialog:Confirm()
	local id = self.scanner_id
	local replacement = self.replacement
	self:Cancel()
	if replacement then self.replace_confirm(replacement)
	elseif id then self.confirm(id) end
end

function pf_scanner_destroy_dialog:Cancel()
	self.scanner_id = nil
	self.replacement = nil
	self:HideDialog()
end

function pf_scanner_destroy_dialog:OnKeyboard(dik, action)
	CUIScriptWnd.OnKeyboard(self, dik, action)
	if action == ui_events.WINDOW_KEY_PRESSED then
		if dik_to_bind(dik) == key_bindings.kQUIT then self:Cancel()
		elseif dik == 28 or dik == 156 then self:Confirm() end
	end
	return true
end

function create(confirm, replace_confirm)
	return pf_scanner_destroy_dialog(confirm, replace_confirm)
end
