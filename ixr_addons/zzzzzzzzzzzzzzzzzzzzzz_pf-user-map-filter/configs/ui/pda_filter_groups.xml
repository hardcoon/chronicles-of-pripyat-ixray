<?xml version="1.0" encoding="utf-8"?>
<pda_filter_groups>
    <!-- Keep each slot stable across updates. Use a free slot from 7 to 27
         for a new group. Slot 6 is reserved for user-created map markers. -->
    <group id="common_stashes" slot="0">
        <spot type="treasure"/>
        <spot type="pf_stash_green"/>
        <spot type="pf_stash_cyan"/>
        <spot type="pf_stash_green_eye"/>
        <spot type="pf_stash_cyan_eye"/>
    </group>
    <group id="rare_stashes" slot="1">
        <spot type="pf_stash_purple"/>
        <spot type="pf_stash_orange"/>
        <spot type="pf_stash_red"/>
        <spot type="pf_stash_pink"/>
        <spot type="pf_stash_purple_eye"/>
        <spot type="pf_stash_orange_eye"/>
        <spot type="pf_stash_red_eye"/>
        <spot type="pf_stash_pink_eye"/>
    </group>
    <group id="anomalies" slot="2">
        <spot type="primary_object"/>
        <spot type="lz_nlc_cooked_artifact_location"/>
        <spot type="pf_scanner_m1"/>
        <spot type="pf_scanner_m1_green"/>
        <spot type="pf_scanner_m1_gold"/>
        <spot type="pf_scanner_m2"/>
        <spot type="pf_scanner_m2_green"/>
        <spot type="pf_scanner_artifact"/>
    </group>
    <group id="radio_beacons" slot="3">
        <spot type="lz_nm_beacon_location"/>
        <spot type="lz_nm_beacon_focus_location"/>
    </group>
    <group id="tasks" slot="4">
        <spot type="storyline_task_location"/>
        <spot type="storyline_task_location_complex_timer"/>
        <spot type="secondary_task_location"/>
        <spot type="secondary_task_location_complex_timer"/>
        <spot type="primary_task_location"/>
        <spot type="third_task_location"/>
        <spot type="ui_storyline_task_blink"/>
        <spot type="ui_secondary_task_blink"/>
        <spot type="storyline_task_on_guider"/>
        <spot type="secondary_task_on_guider"/>
    </group>
    <group id="important" slot="5">
        <spot type="ui_pda2_trader_location"/>
        <spot type="ui_pda2_mechanic_location"/>
        <spot type="ui_pda2_scout_location"/>
        <spot type="ui_pda2_quest_npc_location"/>
        <spot type="ui_pda2_medic_location"/>
        <spot type="ui_pda2_actor_box_location"/>
        <spot type="ui_pda2_actor_sleep_location"/>
        <spot type="pf_yanov_nimble_uaz_location"/>
        <spot type="pf_interior_map_focus"/>
        <spot type="pf_vehicle_gps_location"/>
    </group>
    <group id="user_markers" slot="6">
        <spot type="pf_user_gps_task_location"/>
    </group>
</pda_filter_groups>
