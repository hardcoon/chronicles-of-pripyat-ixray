-- Sleep Timelapse port settings. Native camera/input ownership: COP-ENG-185.
-- Missing preference means enabled; never overwrite an existing user choice.
local state = {enabled = nil, cover_reference = false}

local function path()
    return getFS():update_path("$app_data_root$", "pf_sleep_timelapse.setting")
end

local function release_cover_reference(discard)
    if not state.cover_reference then return end
    local cover = rawget(_G, "lz_nm_surge_cover")
    if cover then cover.end_sleep_reference(discard) end
    state.cover_reference = false
end

local function forward_sleep_result(runtime)
    local result = runtime.take_result()
    if result ~= nil then lz_nm_world.finish_sleep_autosave(result) end
end

function is_enabled()
    if state.enabled ~= nil then return state.enabled end
    local file = io.open(path(), "r")
    local value = ""
    if file then
        value = string.lower(file:read("*l") or "")
        file:close()
    end
    value = string.match(value, "^%s*(.-)%s*$")
    state.enabled = value ~= "0" and value ~= "false" and value ~= "off"
    return state.enabled
end

function set_enabled(enabled)
    enabled = enabled == true
    local file = io.open(path(), "w")
    if not file then
        printf("[Sleep Timelapse] Cannot save preference")
        return false
    end
    local written = file:write(enabled and "1\n" or "0\n")
    local closed = file:close()
    if not written or not closed then
        printf("[Sleep Timelapse] Cannot write preference")
        return false
    end
    state.enabled = enabled
    local runtime = rawget(_G,"pf_sleep_runtime")
    if not enabled then
        if runtime then
            runtime.finish(false)
            forward_sleep_result(runtime)
        end
        release_cover_reference(false)
    end
    return true
end

function begin(hours)
    if not is_enabled() then return false end
    if not pf_sleep_runtime.begin(hours) then
        pf_sleep_runtime.take_result() -- A failed start falls back to ordinary sleep.
        return false
    end
    lz_nm_world.begin_sleep_autosave()
    -- No render update has run yet: cam_pos still holds the ordinary eye point.
    -- The facade coordinates both systems; the camera runtime stays independent.
    if getFS():exist("$game_scripts$", "lz_nm_surge_cover.script") then
        state.cover_reference = lz_nm_surge_cover.begin_sleep_reference()
    end
    return true
end

local function reset()
    local runtime=rawget(_G,"pf_sleep_runtime")
    if runtime then
        runtime.finish(false)
        runtime.take_result()
    end
    local world = rawget(_G,"lz_nm_world")
    if world then world.cancel_sleep_autosave() end
    release_cover_reference(true)
end
local function update()
    local runtime=rawget(_G,"pf_sleep_runtime")
    if runtime then
        runtime.update()
        forward_sleep_result(runtime)
    end
    if state.cover_reference and (not runtime or not runtime.is_active()) then
        release_cover_reference(false)
    end
end
local registered=false
function on_game_start()
    if registered then return end
    -- The existing actor binder stays the lifecycle owner. Run cleanup before it
    -- releases the actor/HUD/ALife objects; the engine also guards lost Lua updates.
    local owner=bind_stalker.actor_binder
    if not owner.pf_sleep_destroy_wrapped then
        local previous=owner.net_destroy
        owner.net_destroy=function(self,...)
            reset()
            if previous then return previous(self,...) end
        end
        owner.pf_sleep_destroy_wrapped=true
    end
    RegisterScriptCallback("update",update)
    RegisterScriptCallback("load",reset)
    registered=true
end
on_game_start()
