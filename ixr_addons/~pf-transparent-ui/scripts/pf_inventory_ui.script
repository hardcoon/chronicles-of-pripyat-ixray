-- Installation-local choice. Do not put this preference in actor save data.
local opaque_mode, translucent_mode, combined_mode = 0, 1, 2
local saved_modes = {["0"] = opaque_mode, ["1"] = translucent_mode, ["2"] = combined_mode}
local cached_mode = nil

local function setting_path()
    return getFS():update_path("$app_data_root$", "pf_transparent_interface.setting")
end

function get_mode()
    if cached_mode ~= nil then return cached_mode end
    local file = io.open(setting_path(), "r")
    cached_mode = combined_mode
    if file then
        local value = file:read("*l")
        cached_mode = saved_modes[value] or combined_mode
        file:close()
    end
    return cached_mode
end

function set_mode(mode)
    if mode ~= opaque_mode and mode ~= translucent_mode and mode ~= combined_mode then return false end
    if mode == get_mode() then return true end
    local file = io.open(setting_path(), "w")
    if not file then
        printf("[PF TRANSPARENT UI] Unable to save client preference")
        return false
    end
    local written = file:write(mode, "\n")
    local closed = file:close()
    if not written or not closed then
        printf("[PF TRANSPARENT UI] Unable to finish saving client preference")
        return false
    end
    cached_mode = mode
    printf("[PF TRANSPARENT UI] Client interface mode saved: %d", mode)
    -- The game UI picks up the saved layout when it is created or reloaded.
    if alife() ~= nil then
        get_console():execute("ui_reload")
        get_console():execute("flush")
    end
    return true
end

function is_enabled()
    return get_mode() == translucent_mode
end

function set_enabled(enabled)
    return set_mode(enabled == true and translucent_mode or opaque_mode)
end
