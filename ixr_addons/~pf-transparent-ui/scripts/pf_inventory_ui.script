-- Installation-local choice. Do not put this preference in actor save data.
local cached_enabled = nil

local function setting_path()
    return getFS():update_path("$app_data_root$", "pf_transparent_interface.setting")
end

function is_enabled()
    if cached_enabled ~= nil then return cached_enabled end
    local file = io.open(setting_path(), "r")
    cached_enabled = false
    if file then
        cached_enabled = file:read("*l") == "1"
        file:close()
    end
    return cached_enabled
end

function set_enabled(enabled)
    enabled = enabled == true
    if enabled == is_enabled() then return true end
    local file = io.open(setting_path(), "w")
    if not file then
        printf("[PF TRANSPARENT UI] Unable to save client preference")
        return false
    end
    local written = file:write(enabled and "1\n" or "0\n")
    local closed = file:close()
    if not written or not closed then
        printf("[PF TRANSPARENT UI] Unable to finish saving client preference")
        return false
    end
    cached_enabled = enabled
    printf("[PF TRANSPARENT UI] Client preference saved: %s", enabled and "on" or "off")
    -- The built-in UI reload recreates inventory/repair windows using the chosen
    -- XML family. At startup they are created on the next game load instead.
    if alife() ~= nil then
        get_console():execute("ui_reload")
        get_console():execute("flush")
    end
    return true
end
