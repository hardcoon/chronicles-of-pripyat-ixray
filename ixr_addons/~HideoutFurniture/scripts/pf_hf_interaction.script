-- A short USE gesture invokes the object; a 1.4-second gesture picks it up.
local token=nil
local held=nil
local mode_keys={}
local registered=false
local HOLD_MS=1400
local HINT_DELAY_MS=200
local MAX_RANGE=3.25

local function set_hold_tip(text)
    if not held then return end
    local object=level.object_by_id(held.id)
    if object then pf_hf_furniture.apply_tip(object,text) end
    -- The engine displays the aimed weapon proxy's hint, not its parent rack's.
    if held.tip_id~=held.id then
        local proxy=level.object_by_id(held.tip_id)
        if proxy then pf_hf_furniture.apply_tip(proxy,text) end
    end
end
local function restore_hold_tip()
    if held and held.hint_shown then
        set_hold_tip(pf_hf_furniture.tip(held.section,held.id))
        held.hint_shown=false
    end
end
local function show_countdown()
    if not held or held.done or held.cancelled then return end
    if time_global()-held.started<HINT_DELAY_MS then return end
    local aimed=level.get_target_obj()
    if aimed and aimed:id()~=held.tip_id then
        restore_hold_tip();held.tip_id=aimed:id()
    end
    local remaining=math.ceil(math.max(0,HOLD_MS-(time_global()-held.started))/100)/10
    set_hold_tip(string.format(game.translate_string("pf_hf_pickup_countdown"),remaining))
    held.hint_shown=true
end

local function target()
    if not db.actor or pf_runtime_editor.is_active() or level.main_input_receiver() then return nil end
    if not db.actor:alive() then return nil end
    local object=level.get_target_obj()
    if not object then return nil end
    if object:section()=="pf_hf_weapon_display_visual" then
        local _,case_id=pf_hf_displays.proxy_record(object:id())
        object=case_id and level.object_by_id(case_id)
        if not object then return nil end
    end
    local entry=pf_hf_furniture.definition(object:section())
    if not entry or not pf_hf_furniture.in_interaction_range(object) then return nil end
    if entry.kind~="light" and level.get_target_dist()>MAX_RANGE then return nil end
    return object
end

function suspend()
    restore_hold_tip()
    held=nil
    mode_keys={}
    if token then level.release_editor_input(token);token=nil end
end

local function valid_gesture()
    if not held or held.cancelled or not db.actor or held.actor_id~=db.actor:id() or
        held.level~=level.name() then return false end
    local object=target()
    return object and object:id()==held.id
end

local function finish_hold()
    if held and not held.done and time_global()-held.started>=HOLD_MS then
        held.done=true
        restore_hold_tip()
        if valid_gesture() then pf_hf_furniture.pickup(held.id) end
    end
end

function handle_input(event,key,action)
    -- Consume the whole reload gesture, including repeats and release. A new
    -- physical press toggles once; ordinary reload remains available elsewhere.
    if mode_keys[key] and (event==0 or event==1 or event==2) then
        if event==2 then mode_keys[key]=nil end
        return true
    end
    if action==key_bindings.kWPN_RELOAD and event==0 then
        local object=target()
        local entry=object and pf_hf_furniture.definition(object:section())
        if not entry or entry.kind~="light" then return false end
        mode_keys[key]=true
        pf_hf_furniture.toggle_light_mode(object:id())
        if not held or not held.hint_shown then pf_hf_furniture.apply_tip(object) end
        return true
    end
    if action~=key_bindings.kUSE then return false end
    if event==0 then
        if held then return true end
        local object=target()
        if not object then return false end
        local aimed=level.get_target_obj()
        held={id=object:id(),tip_id=aimed and aimed:id() or object:id(),section=object:section(),
            actor_id=db.actor:id(),level=level.name(),key=key,started=time_global()}
        show_countdown()
        return true
    elseif held and (event==1 or event==2) then
        if key~=held.key then return true end
        finish_hold()
        if event==2 then
            local id=held.id
            local use=not held.done and valid_gesture()
            suspend()
            if use then pf_hf_furniture.interact(id) end
        end
        return true
    end
    return false
end

function update()
    if token and level.editor_input_owner()~=token then restore_hold_tip();token=nil;held=nil;mode_keys={} end
    if not db.actor or not db.actor:alive() or pf_runtime_editor.is_active() or level.main_input_receiver() then suspend();return end
    for key in pairs(mode_keys) do
        if not pf_runtime_editor.key_down(key) then mode_keys[key]=nil end
    end
    if held then
        -- A lost focus/release must never leave a latent pickup timer.
        if not pf_runtime_editor.key_down(held.key) then suspend();return end
        if not valid_gesture() then held.cancelled=true;restore_hold_tip() end
        show_countdown()
        finish_hold()
        return
    end
    local object=target()
    if not object and not next(mode_keys) then suspend();return end
    if object then
        pf_hf_furniture.apply_tip(object)
        local aimed=level.get_target_obj()
        if aimed and aimed:id()~=object:id() then
            pf_hf_furniture.apply_tip(aimed,pf_hf_furniture.tip(object:section(),object:id()))
        end
    end
    if not token and level.editor_input_owner()==0 then
        local owner=level.capture_editor_input(handle_input)
        if owner and owner~=0 then token=owner end
    end
end

function on_game_start()
    if registered then return end
    RegisterScriptCallback("update",update)
    RegisterScriptCallback("load",suspend)
    registered=true
end
on_game_start()
