-- Optional console-only acceptance helpers. Never registered for normal startup.
function probe()
    local native=debug_render
    assert(native and native.api_version()==1 and native.available(),"R4 editor API unavailable")
    local ray=ray_pick()
    ray:set_position(device().cam_pos)
    ray:set_direction(vector():set(0,-1,0))
    ray:set_range(100)
    ray:set_flags(2) -- rqtStatic
    ray:set_ignore_object(db.actor)
    assert(ray:query(),"no static floor below camera")
    assert(ray:get_object()==nil and ray:get_element()>=0,"bad static result")
    ray:get_material()
    ray:set_flags(0) -- guaranteed miss, independent of indoor ceilings
    assert(not ray:query(),"rqtNone should miss")
    assert(ray:get_object()==nil and ray:get_element()==-1 and ray:get_distance()==0,"stale hit after miss")
    printf("[pf_runtime_editor_qa] PASS static -> miss; material=%s; primitive_count=%d",
        tostring(ray:get_material()),native.object_count())
    local token=level.capture_editor_input(function() return false end)
    assert(token~=0,"capture busy")
    assert(level.capture_editor_input(function() return false end)==0,"duplicate capture accepted")
    assert(not level.release_editor_input(token+1),"foreign release accepted")
    assert(level.release_editor_input(token),"capture release failed")
    printf("[pf_runtime_editor_qa] PASS input ownership; ready")
end

function probe_dynamic()
    for _,obj in alife():objects() do
        if obj:section_name()=="pf_hf_test_crate" and level.object_by_id(obj.id) then
            local center=vector():set(obj.position):add(vector():set(0,.4,0))
            local ray=ray_pick()
            ray:set_position(vector():set(center):add(vector():set(0,0,-1)))
            ray:set_direction(vector():set(0,0,1));ray:set_range(2)
            ray:set_flags(1);ray:set_ignore_object(db.actor)
            assert(ray:query() and ray:get_object(),"no dynamic crate hit")
            assert(ray:get_material()==65535,"dynamic bone used static material index")
            ray:set_flags(0)
            assert(not ray:query() and ray:get_object()==nil and ray:get_element()==-1,"stale dynamic hit after miss")
            printf("[pf_runtime_editor_qa] PASS dynamic -> miss, material=65535")
            return true
        end
    end
    error("place a crate first")
end

function begin()
    if pf_runtime_editor.is_active() then return false end
    local sim=alife()
    local actor=db.actor
    local item=sim:create("pf_hf_test_crate_item",actor:position(),actor:level_vertex_id(),actor:game_vertex_id(),actor:id())
    assert(item,"cannot create test item")
    local id=item.id
    level.add_call(function() return level.object_by_id(id)~=nil end,function()
        pf_hf_test_crate.place_item(level.object_by_id(id))
    end)
    return true
end

function status()
    local pose=pf_runtime_editor.get_pose()
    printf("[pf_runtime_editor_qa] state=%s input=%d primitives=%d pose=%s",
        pf_runtime_editor.get_state(),level.editor_input_owner(),debug_render.object_count(),
        pose and string.format("%.6f %.6f %.6f / %.6f %.6f %.6f",pose.position.x,pose.position.y,pose.position.z,
            pose.rotation.x,pose.rotation.y,pose.rotation.z) or "none")
end
