local RECIPE_BY_OUTPUT = {}
for _, recipe in ipairs(RECIPES) do
	RECIPE_BY_OUTPUT[recipe.output] = recipe
end

local function inventory_order()
	local order = {}
	for _, section in ipairs(MATERIAL_ORDER) do order[#order + 1] = section end
	-- Use the cooking registry's explicit tier-five list; suffixes and price
	-- do not identify an Absolute. Resolve lazily after modules are loaded.
	for _, section in ipairs(lz_nlc_anomaly_registry.absolute_artifacts()) do
		order[#order + 1] = section
	end
	return order
end

local function inventory_materials(bench_id)
	return pf_hf_workbench_materials.collect(inventory_order(), bench_id)
end

local function enough(recipe, counts)
	if not recipe then return false end
	for section, amount in pairs(recipe.materials) do
		if (counts[section] or 0) < amount then return false end
	end
	return true
end

local function recipe_category(recipe)
	local output = recipe and recipe.output or ""
	if string.find(output, "itm_repairkit_", 1, true) == 1 or
		string.find(output, "itm_field_upgrade_kit_", 1, true) == 1 then
		return "upgrades"
	end
	return "misc"
end

function recipes(category)
	local filtered = {}
	for _, entry in ipairs(RECIPES) do
		if is_unlocked(entry.output) and
			(not category or category == "all" or recipe_category(entry) == category) then
			filtered[#filtered + 1] = entry
		end
	end
	return filtered
end

function recipe(output)
	return RECIPE_BY_OUTPUT[output]
end

function is_unlocked(output)
	local selected = recipe(output)
	if not selected then return false end
	-- This is the same permanent info portion used by the shared encyclopedia
	-- article. Reading the article or using/selling a kit never clears it.
	return not selected.unlock_info or
		(db.actor ~= nil and db.actor:has_info(selected.unlock_info))
end

function material_order()
	return MATERIAL_ORDER
end

function material_counts(bench_id)
	return inventory_materials(bench_id)
end

function absolute_options(counts)
	local options = {}
	for _, section in ipairs(lz_nlc_anomaly_registry.absolute_artifacts()) do
		if (counts[section] or 0) > 0 then options[#options + 1] = section end
	end
	return options
end

function choose_absolute(counts, preferred)
	local options = absolute_options(counts)
	for _, section in ipairs(options) do
		if section == preferred then return section end
	end
	return options[1]
end

function ingredient_rows(output, counts, absolute_section)
	local selected, rows = recipe(output), {}
	if not selected then return rows end
	for _, section in ipairs(MATERIAL_ORDER) do
		local amount = selected.materials[section]
		if amount then
			rows[#rows + 1] = { section = section, required = amount, owned = counts[section] or 0 }
		end
	end
	if selected.absolute then
		local owned = 0
		for _, section in ipairs(absolute_options(counts)) do owned = owned + counts[section] end
		rows[#rows + 1] = { section = absolute_section or
			lz_nlc_anomaly_registry.absolute_artifacts()[1],
			label = "pf_hf_craft_any_absolute", required = selected.absolute, owned = owned }
	end
	return rows
end

function item_label(section)
	local ini = core.get_sysini()
	if ini:section_exist(section) and ini:line_exist(section, "inv_name") then
		return core.text_for_utf8(game.translate_string(ini:r_string(section, "inv_name")))
	end
	return section
end

function item_description(section)
	local ini = core.get_sysini()
	if ini:section_exist(section) and ini:line_exist(section, "description") then
		return core.text_for_utf8(game.translate_string(ini:r_string(section, "description")))
	end
	return ""
end

function item_effect(section)
	local text_id = EFFECT_BY_OUTPUT[section]
	return text_id and game.translate_string(text_id) or ""
end

function can_craft(output, bench_id, counts, absolute_section)
	if not is_unlocked(output) then return false end
	local selected = recipe(output)
	counts = counts or inventory_materials(bench_id)
	if not enough(selected, counts) then return false end
	if not selected.absolute then return true end
	local section = absolute_section or choose_absolute(counts)
	return section ~= nil and lz_nlc_anomaly_registry.is_absolute(section) and
		(counts[section] or 0) >= selected.absolute
end

function craft(output, bench_id, absolute_section)
	local selected = recipe(output)
	if not selected or not db.actor then return false, "pf_hf_craft_failed" end
	if not is_unlocked(output) then return false, "pf_hf_craft_recipe_locked" end
	local needed = {}
	for section, amount in pairs(selected.materials) do needed[section] = amount end
	if selected.absolute then
		local counts = inventory_materials(bench_id)
		-- An explicit choice must still exist. Never replace a missing selected
		-- Absolute with another valuable artifact when the action is committed.
		if not can_craft(output, bench_id, counts, absolute_section) then
			return false, "pf_hf_need_materials"
		end
		local section = absolute_section or choose_absolute(counts)
		needed[section] = (needed[section] or 0) + selected.absolute
	end
	local plan = pf_hf_workbench_materials.prepare(needed, inventory_order(), bench_id)
	if not plan then
		return false, "pf_hf_need_materials"
	end

	local simulation = alife()
	local result = simulation and simulation:create(output, db.actor:position(),
		db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	if not result then return false, "pf_hf_craft_failed" end

	local consumed_ids = pf_hf_workbench_materials.consume(plan)
	return true, "pf_hf_crafted", consumed_ids
end
