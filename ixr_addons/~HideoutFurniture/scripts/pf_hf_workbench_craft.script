local RECIPE_BY_OUTPUT = {}
for _, recipe in ipairs(RECIPES) do
	RECIPE_BY_OUTPUT[recipe.output] = recipe
end

local function inventory_materials()
	local counts, objects = {}, {}
	for _, section in ipairs(MATERIAL_ORDER) do
		counts[section], objects[section] = 0, {}
	end
	if not db.actor then return counts, objects end
	db.actor:iterate_inventory(function(_, item)
		local section = item:section()
		if objects[section] and core.is_actor_owned_item(item) then
			counts[section] = counts[section] + 1
			objects[section][#objects[section] + 1] = item
		end
	end, db.actor)
	for _, entries in pairs(objects) do
		table.sort(entries, function(left, right) return left:id() < right:id() end)
	end
	return counts, objects
end

local function enough(recipe, counts)
	if not recipe then return false end
	for section, amount in pairs(recipe.materials) do
		if (counts[section] or 0) < amount then return false end
	end
	return true
end

local function recipe_category(recipe)
	local output = recipe and recipe.output or ""
	if string.find(output, "itm_repairkit_", 1, true) == 1 or
		string.find(output, "itm_field_upgrade_kit_", 1, true) == 1 then
		return "upgrades"
	end
	return "misc"
end

function recipes(category)
	if not category or category == "all" then return RECIPES end
	local filtered = {}
	for _, entry in ipairs(RECIPES) do
		if recipe_category(entry) == category then
			filtered[#filtered + 1] = entry
		end
	end
	return filtered
end

function recipe(output)
	return RECIPE_BY_OUTPUT[output]
end

function material_order()
	return MATERIAL_ORDER
end

function material_counts()
	return inventory_materials()
end

function item_label(section)
	local ini = core.get_sysini()
	if ini:section_exist(section) and ini:line_exist(section, "inv_name") then
		return game.translate_string(ini:r_string(section, "inv_name"))
	end
	return section
end

function item_description(section)
	local ini = core.get_sysini()
	if ini:section_exist(section) and ini:line_exist(section, "description") then
		return game.translate_string(ini:r_string(section, "description"))
	end
	return ""
end

function item_effect(section)
	local text_id = EFFECT_BY_OUTPUT[section]
	return text_id and game.translate_string(text_id) or ""
end

function can_craft(output)
	local selected = recipe(output)
	local counts = inventory_materials()
	return enough(selected, counts)
end

function craft(output)
	local selected = recipe(output)
	if not selected or not db.actor then return false, "pf_hf_craft_failed" end
	local counts, objects = inventory_materials()
	if not enough(selected, counts) then
		return false, "pf_hf_need_materials"
	end

	-- Resolve every source server object before changing inventory. A failed
	-- lookup leaves both the materials and the result untouched.
	for section, amount in pairs(selected.materials) do
		for index = 1, amount do
			if not core.server_object(objects[section][index]) then
				return false, "pf_hf_craft_failed"
			end
		end
	end

	local simulation = alife()
	local result = simulation and simulation:create(output, db.actor:position(),
		db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	if not result then return false, "pf_hf_craft_failed" end

	local consumed_ids = {}
	for section, amount in pairs(selected.materials) do
		for index = 1, amount do
			local material = objects[section][index]
			consumed_ids[#consumed_ids + 1] = material:id()
			core.release_item(material)
		end
	end
	return true, "pf_hf_crafted", consumed_ids
end
