	"pf_hf_fabric", "pf_hf_straps", "pf_hf_rubber", "pf_hf_plastic",
	"pf_hf_scrap", "pf_hf_ceramic", "pf_hf_electronics", "pf_hf_dampers",
	"pf_hf_oil", "lz_nm_metal_part", "jup_b200_tech_materials_wire",
	"jup_b200_tech_materials_textolite", "jup_b200_tech_materials_transistor",
	"jup_b200_tech_materials_capacitor", "lz_ph_reflash_module"
}

