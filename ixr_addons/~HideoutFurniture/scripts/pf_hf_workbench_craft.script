	itm_repairkit_tier_3 = "pf_hf_craft_effect_calibration",
	itm_field_upgrade_kit_blue = "pf_hf_craft_effect_magazine",
	itm_field_upgrade_kit_red = "pf_hf_craft_effect_reload",
	itm_field_upgrade_kit_yellow = "pf_hf_craft_effect_caliber",
	itm_field_upgrade_kit_green = "pf_hf_craft_effect_weight",
