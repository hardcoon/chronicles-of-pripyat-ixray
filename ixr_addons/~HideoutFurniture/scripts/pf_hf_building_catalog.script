-- The six Even More HF walls explicitly supported by the original snap solver.
-- Copy their existing definitions; do not change the ordinary furniture catalog.
local compatible_walls={
    pf_hfm_wall={w=4.70895,t=.114076},
    pf_hfm_wall_metal={w=4.70895,t=.114076},
    pf_hfm_wall_doorway={w=4.70895,t=.114076},
    pf_hfm_wall_doorway_metal={w=4.70895,t=.114076},
    pf_hfm_wall02={w=2.35459,t=.109478,half=true},
    pf_hfm_wall02_metal={w=2.35459,t=.109478,half=true},
}
for _,original in ipairs(pf_hf_even_more_catalog.entries) do
    local wall=compatible_walls[original.object]
    if wall then
        local entry={}
        for key,value in pairs(original) do entry[key]=value end
        entry.building=true
        entry.snap_class="wall"
        entry.snap_width=wall.w;entry.snap_thickness=wall.t;entry.snap_half=wall.half
        entry.pivot={0,0,0}
        entry.placement_min={-wall.w/2,0,-.008-wall.t/2}
        entry.placement_max={wall.w/2,2.58663,-.008+wall.t/2}
        entries[#entries+1]=entry
    end
end
by_item={};by_object={}
for _,entry in ipairs(entries) do by_item[entry.item]=entry;by_object[entry.object]=entry end
