-- Replenish the isolated house-building catalog: 24 new pieces and six HF walls.
-- Other furniture stock is owned by the native full-shelf purchase list.
local catalog=pf_hf_building_catalog

function restock(npc)
    if not npc or npc:section()~="pf_yanov_savka" or not db.actor then return false end
    local sim=alife()
    if not sim then return false end
    local held={}
    -- A greeting may have created server children in this same frame. Counting
    -- only online inventory would duplicate them before they bind. This one
    -- snapshot runs on explicit trade entry, never from an update callback.
    for _,object in sim:objects() do
        if tonumber(object.parent_id)==npc:id() then
            local section=object:section_name()
            if catalog.by_item[section] then
                local items=held[section] or {}
                items[#items+1]=object
                held[section]=items
            end
        end
    end
    for _,entry in ipairs(catalog.entries) do
        local items=held[entry.item] or {}
        for index=4,#items do sim:release(items[index],true) end
        for index=#items+1,3 do
            sim:create(entry.item,npc:position(),npc:level_vertex_id(),npc:game_vertex_id(),npc:id())
        end
    end
    return true
end
