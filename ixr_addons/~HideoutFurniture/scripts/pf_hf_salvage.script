-- Cost brackets retain approximately the previous average component yield.
-- Components use the same range draw as basic and electronic materials.
local ARMOR_COMPONENTS = {
	{ section = "lz_nm_armor_pouch", salt = 261, multiple = true },
	{ section = "lz_nm_rubber_padding", salt = 262, multiple = true },
	{ section = "lz_nm_combat_boots", salt = 263, multiple = false }
}

local ARMOR_COMPONENT_TIERS = {
	{ max_cost = 7500, min = 0, max = 1 },
	{ max_cost = 15000, min = 0, max = 1 },
	{ max_cost = 30000, min = 0, max = 3 },
	{ max_cost = math.huge, min = 0, max = 4 }
}

local COMPONENT_PROFILES = {
	lz_nm_armor_pouch = {
		profile = "component_pouch",
		craft_output = "lz_nm_armor_pouch",
		workbench_category = "armor",
		return_fraction = 0.5
	},
	lz_nm_rubber_padding = {
		profile = "component_lead_insert",
		craft_output = "lz_nm_rubber_padding",
		workbench_category = "armor",
		return_fraction = 0.5
	},
	lz_nm_radio_beacon = {
		profile = "crafted_radio_beacon", craft_output = "lz_nm_radio_beacon",
		workbench_category = "detectors", return_fraction = 0.5
	},
	pf_anomaly_scanner = {
		profile = "crafted_anomaly_scanner", craft_output = "pf_anomaly_scanner",
		workbench_category = "detectors", return_fraction = 0.5
	},
	lz_nm_combat_boots = {
		profile = "component_boots",
		workbench_category = "armor",
		materials = {
			{ "pf_hf_rubber", 2 }, { "pf_hf_fabric", 1 }
		}
	}
}

local function deterministic_value(item_id, salt)
	local value = ((tonumber(item_id) or 0) + salt * 104729) % 2147483647
	for _ = 1, 2 do
		value = (value * (48271 + salt) + 12345 + salt * 69621) % 2147483647
	end
	return value
end

local function material_amount(entry, item_id)
	local minimum, maximum = entry[2], entry[3] or entry[2]
	if minimum == maximum then return minimum end
	return minimum + deterministic_value(item_id, entry[4]) % (maximum - minimum + 1)
end

local function item_cost(section)
	local ini = core.get_sysini()
	if not ini:line_exist(section, "cost") then return 0 end
	return tonumber(ini:r_string(section, "cost")) or 0
end

local function weapon_profile(target)
	local cost = item_cost(target:section())
	if cost <= 12000 then return "cheap" end
	if cost <= 35000 then return "standard" end
	return "advanced"
end

local function append_reward(rewards, counts, section, amount)
	if not section or not amount or amount < 1 then return end
	rewards[#rewards + 1] = { section = section, count = amount }
	counts[section] = (counts[section] or 0) + amount
end

local function armor_component_tier(target)
	local minimum, maximum = 1, 5
	local section = target:section()
	if not string.find(section, "exo", 1, true) then
		local cost = item_cost(section)
		for _, tier in ipairs(ARMOR_COMPONENT_TIERS) do
			if cost <= tier.max_cost then
				minimum, maximum = tier.min, tier.max
				break
			end
		end
	end
	return minimum, maximum
end

local function armor_component_entries(target)
	local minimum, maximum = armor_component_tier(target)
	local entries = {}
	for _, component in ipairs(ARMOR_COMPONENTS) do
		entries[#entries + 1] = { component.section, component.multiple and minimum or 0,
			component.multiple and maximum or 1, component.salt }
	end
	return entries
end

local function append_entries(rewards, counts, entries, item_id)
	for _, entry in ipairs(entries or {}) do
		append_reward(rewards, counts, entry[1], material_amount(entry, item_id))
	end
end

local function item_section(item_or_section)
	if type(item_or_section) == "string" then
		return core.canonical_item_section(item_or_section)
	end
	return item_or_section and core.canonical_item_section(item_or_section:section()) or nil
end

function is_component(item_or_section)
	return COMPONENT_PROFILES[item_section(item_or_section)] ~= nil
end

-- A category also marks products/devices that may only be dismantled at
-- the workbench. Inventory callbacks must not accept these objects.
function workbench_category(item_or_section)
	local section = item_section(item_or_section)
	if DETECTOR_SECTIONS[section] then return "detectors" end
	local definition = COMPONENT_PROFILES[section]
	return definition and definition.workbench_category or nil
end

function detector_profile(item_or_section)
	return DETECTOR_SECTIONS[item_section(item_or_section)]
end

-- Compatibility for inventory text; these are per-kind bounds, not a total.
function detector_range(item_or_section)
	local definition = DETECTOR_PROFILES[detector_profile(item_or_section)]
	if definition then return definition.min, definition.max end
end

local function component_definition(target)
	local definition = COMPONENT_PROFILES[item_section(target)]
	if not definition or not definition.craft_output then return definition end
	local recipe = pf_hf_workbench_craft.recipe(definition.craft_output)
	if not recipe or not recipe.materials then return nil end

	local materials, sections = {}, {}
	-- Read every ingredient, including technical parts and future recipe
	-- additions; a UI/basic-material whitelist would silently lose resources.
	for section in pairs(recipe.materials) do sections[#sections + 1] = section end
	table.sort(sections)
	for _, section in ipairs(sections) do
		local amount = math.floor((recipe.materials[section] or 0) *
			definition.return_fraction)
		if amount > 0 then materials[#materials + 1] = { section, amount } end
	end
	return { profile = definition.profile, materials = materials }
end

function rewards(target)
	if not target then return nil end
	local profile
	local definition
	local armor = false
	local detector_tier = detector_profile(target)
	if detector_tier then
		profile = "detector_" .. detector_tier
		definition = DETECTOR_PROFILES[detector_tier]
	elseif is_component(target) then
		definition = component_definition(target)
		profile = definition and definition.profile or nil
	elseif core.is_weapon_mechanics_target(target) then
		profile = weapon_profile(target)
		definition = WEAPON_PROFILES[profile]
	else
		profile = pf_hf_workbench_repair.profile(target)
		definition = EQUIPMENT_PROFILES[profile]
		armor = core.is_outfit_or_helmet(target) and not core.is_helmet(target)
	end
	if not definition then return nil end

	local item_id = target:id()
	local result, counts = {}, {}
	append_entries(result, counts, definition.materials, item_id)
	if armor then append_entries(result, counts, armor_component_entries(target), item_id) end

	local base_total, special_total = 0, 0
	for section, amount in pairs(counts) do
		if BASE_MATERIALS[section] then
			base_total = base_total + amount
		else
			special_total = special_total + amount
		end
	end
	return result, {
		profile = profile,
		counts = counts,
		base_total = base_total,
		special_total = special_total
	}
end

-- The portable kit and workbench share the complete result, including the
-- installed weapon modules. Previewing never rolls a second set of rewards.
function equipment_rewards(target)
	local result, metadata = rewards(target)
	if not result then return nil end
	metadata.upgrade_ids = {}
	if not core.is_weapon_mechanics_target(target) then return result, metadata end
	if type(target.iterate_installed_upgrades) ~= "function" then return nil end
	local unique, last_regular = {}, nil
	target:iterate_installed_upgrades(function(id)
		id = tostring(id)
		local _, kind = recovered_field_tool(id)
		if kind == "anomalous_nozzle" or kind == "anomalous_barrel" then
			if not unique[kind] then
				unique[kind] = true
				metadata.upgrade_ids[#metadata.upgrade_ids + 1] = id
			end
		else last_regular = id end
		return false
	end)
	if last_regular then metadata.upgrade_ids[#metadata.upgrade_ids + 1] = last_regular end
	for _, id in ipairs(metadata.upgrade_ids) do
		local section = recovered_field_tool(id) or "lz_nm_recovered_upgrade"
		result[#result + 1] = { section = section, count = 1, id = id }
		metadata.counts[section] = (metadata.counts[section] or 0) + 1
	end
	return result, metadata
end

-- Describe possibilities from the same profiles that produce the rewards.
-- Zero-drop materials still appear with their possible range. UI descriptions
-- never reroll or hide sections based on the current item's actual result.
function reward_options(target, actual_rewards, metadata)
	if not target or not metadata then return {} end
	local tier = detector_profile(target)
	local definition = tier and DETECTOR_PROFILES[tier] or
		WEAPON_PROFILES[metadata.profile] or EQUIPMENT_PROFILES[metadata.profile] or
		component_definition(target)
	local result, by_section = {}, {}
	local function row(section)
		if not by_section[section] then
			by_section[section] = { section = section, minimum = 0, maximum = 0 }
			-- Preserve material order, including rows whose current draw is zero.
			result[#result + 1] = by_section[section]
		end
		return by_section[section]
	end
	local function entries(values)
		for _, entry in ipairs(values or {}) do
			local reward = row(entry[1])
			reward.minimum = reward.minimum + entry[2]
			reward.maximum = reward.maximum + (entry[3] or entry[2])
		end
	end
	if definition then
		entries(definition.materials)
		if not tier and not is_component(target) and core.is_outfit_or_helmet(target) and not core.is_helmet(target) then
			entries(armor_component_entries(target))
		end
	end
	-- Installed modules are guaranteed. Future provider extensions without a
	-- profile description still appear; never filter returned sections in UI.
	local described = {}
	for section in pairs(by_section) do described[section] = true end
	for _, reward in ipairs(actual_rewards or {}) do
		if reward.id or not described[reward.section] then
			local option = row(reward.section)
			option.minimum = option.minimum + reward.count
			option.maximum = option.maximum + reward.count
		end
	end
	return result
end
