-- Every material has a fixed amount or an inclusive, independent range.
-- The item ID fixes each draw across preview, save/load and both salvage tools.
local core = lz_nm_core
local RECOVERED_FIELD_TOOLS = {
	rough = "itm_repairkit_tier_1", fine = "itm_repairkit_tier_2",
	soft = "itm_repairkit_tier_soft", calibration = "itm_repairkit_tier_3",
	magazine = "itm_field_upgrade_kit_blue", reload = "itm_field_upgrade_kit_red",
	caliber = "itm_field_upgrade_kit_yellow", weight = "itm_field_upgrade_kit_green",
	anomalous_nozzle = "itm_field_upgrade_kit_anomalous_nozzle",
	anomalous_barrel = "itm_field_upgrade_kit_anomalous_barrel"
}

function recovered_field_tool(upgrade_id)
	if not upgrade_id or string.sub(upgrade_id, 1, 9) ~= "lz_nm_up_" then return nil end
	for kind, section in pairs(RECOVERED_FIELD_TOOLS) do
		if string.match(upgrade_id, "_" .. kind .. "_%d+$") or
			string.match(upgrade_id, "_" .. kind .. "$") then return section, kind end
	end
	return nil
end

local BASE_MATERIALS = {
	pf_hf_fabric = true,
	pf_hf_straps = true,
	pf_hf_rubber = true,
	pf_hf_plastic = true,
	pf_hf_scrap = true,
	pf_hf_ceramic = true,
	pf_hf_electronics = true,
	pf_hf_dampers = true,
	lz_nm_metal_part = true
}

local TECH_COMPONENTS = {
	"jup_b200_tech_materials_wire",
	"jup_b200_tech_materials_capacitor",
	"jup_b200_tech_materials_transistor",
	"jup_b200_tech_materials_textolite"
}

-- Both detector families share per-material tiers. There is no shared pool
-- or total limit: every section gets its own amount draw.
local DETECTOR_SECTIONS = {
	detector_simple = 1, detector_advanced = 2, detector_elite = 3,
	detector_scientific = 4, pf_metal_detector_homemade = 1,
	pf_metal_detector_wave = 2, pf_metal_detector_magnet = 3
}
local DETECTOR_PROFILES = {
	{ min = 0, max = 1, sections = {
		"jup_b200_tech_materials_wire", "jup_b200_tech_materials_capacitor",
		"jup_b200_tech_materials_transistor" } },
	{ min = 1, max = 2, sections = TECH_COMPONENTS },
	{ min = 2, max = 3, sections = {
		"jup_b200_tech_materials_wire", "jup_b200_tech_materials_capacitor",
		"jup_b200_tech_materials_transistor", "jup_b200_tech_materials_textolite",
		"jup_b200_tech_materials_acetone" } },
	{ min = 3, max = 4, sections = {
		"jup_b200_tech_materials_wire", "jup_b200_tech_materials_capacitor",
		"jup_b200_tech_materials_transistor", "jup_b200_tech_materials_textolite",
		"jup_b200_tech_materials_acetone" } }
}
for _, definition in ipairs(DETECTOR_PROFILES) do
	definition.materials = {}
	for index, section in ipairs(definition.sections) do
		definition.materials[#definition.materials + 1] =
			{ section, definition.min, definition.max, 420 + index }
	end
	for _, entry in ipairs({
		{ "lz_nm_krona_battery", 0, 1, 401 }, { "pf_hf_plastic", 0, 1, 402 },
		{ "pf_hf_scrap", 0, 1, 403 }, { "pf_hf_electronics", 0, 1, 405 }
	}) do definition.materials[#definition.materials + 1] = entry end
end

