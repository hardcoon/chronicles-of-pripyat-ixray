-- Base-material yields for dismantling weapons, outfits, and helmets.
-- Guaranteed bundles prevent bad rolls from breaking the salvage economy.
-- Every percentage is an independent deterministic bonus tied to the item id.
local core = lz_nm_core

local BASE_MATERIALS = {
	pf_hf_fabric = true,
	pf_hf_straps = true,
	pf_hf_rubber = true,
	pf_hf_plastic = true,
	pf_hf_scrap = true,
	pf_hf_ceramic = true,
	pf_hf_electronics = true,
	pf_hf_dampers = true,
	lz_nm_metal_part = true
}

