<?xml version='1.0' encoding='utf-8'?>
<scroll_bar override="add">
  <pf_hf_tv_compact height="6" height_v="6" hold_delay="40">
    <up_arrow width="6" height="10" stretch="1">
      <texture_e>pf_hf_tv_scroll_up_e</texture_e>
      <texture_h>pf_hf_tv_scroll_up_h</texture_h>
      <texture_t>pf_hf_tv_scroll_up_t</texture_t>
      <texture_d>pf_hf_tv_scroll_up_d</texture_d>
    </up_arrow>
    <down_arrow width="6" height="10" stretch="1">
      <texture_e>pf_hf_tv_scroll_down_e</texture_e>
      <texture_h>pf_hf_tv_scroll_down_h</texture_h>
      <texture_t>pf_hf_tv_scroll_down_t</texture_t>
      <texture_d>pf_hf_tv_scroll_down_d</texture_d>
    </down_arrow>
    <back_v width="6" height="12" vertical="1">
      <texture>pf_hf_tv_scroll_track</texture>
    </back_v>
    <box_v width="6" height="24" vertical="1">
      <texture>pf_hf_tv_scroll_thumb</texture>
    </box_v>
  </pf_hf_tv_compact>
</scroll_bar>