; Native ph_door owns hinge/NPC/save state; immune furniture; authored QA collision setup.
[collide]
ignore_static = true

[logic]
active = ph_door@close

[ph_door@close]
not_for_npc = false
tip_open = tip_door_open
tip_close = tip_door_close
locked = false
closed = true
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
on_use = ph_door@open

[ph_door@open]
not_for_npc = false
tip_open = tip_door_open
tip_close = tip_door_close
locked = false
closed = false
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
on_use = ph_door@close

