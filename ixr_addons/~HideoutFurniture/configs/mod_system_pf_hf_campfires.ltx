inv_weight = 1

[pf_hfc_medium_fire]:campfire
; Separate furniture particle variants; native lighting is unchanged.
idle_particles = pf_hf_campfires\medium\idle
enabling_particles = pf_hf_campfires\medium\enabled
disabled_particles = pf_hf_campfires\medium\disabled
blowout_particles = pf_hf_campfires\medium\disabled
script_binding = pf_hf_campfire_zone_binder.init
; Furniture fires are decorative: no anomaly damage, detector response or blowout.
max_start_power = 0
blowout_light = off
idle_particles_dont_stop = false
ignore_nonalive = true
ignore_small = true
ignore_artefacts = true
idle_light_range = 6.5
idle_light_height = 0.4666666666666666

