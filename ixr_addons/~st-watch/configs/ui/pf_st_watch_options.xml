<w>
  <watch_tab x="0" y="0" width="123" height="34">
    <button x="0" y="0" width="123" height="34" id="immersive" stretch="1">
      <texture>pf_fa_tab</texture>
      <text font="ui_font_pf_fa_menu" align="l" vert_align="c" r="190" g="184" b="169" x="12">pf_st_watch_immersive</text>
      <text_color><e r="190" g="184" b="169"/><h r="210" g="203" b="187"/><t r="181" g="121" b="30"/><d r="91" g="88" b="80"/></text_color>
    </button>
  </watch_tab>
  <enabled>
    <label x="16" y="2" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_enabled</text></label>
    <check x="228" y="3" width="20" height="27" stretch="1"><texture>pf_fa_checkbox</texture></check>
  </enabled>
  <red>
    <label x="16" y="36" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_red</text></label>
    <track x="228" y="45" width="184" height="18" mode="float" step="0.01" show_value="1" out_num_of_signs="2"/>
  </red>
  <green>
    <label x="16" y="68" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_green</text></label>
    <track x="228" y="77" width="184" height="18" mode="float" step="0.01" show_value="1" out_num_of_signs="2"/>
  </green>
  <blue>
    <label x="16" y="100" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_blue</text></label>
    <track x="228" y="109" width="184" height="18" mode="float" step="0.01" show_value="1" out_num_of_signs="2"/>
  </blue>
  <brightness>
    <label x="16" y="132" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_brightness</text></label>
    <track x="228" y="141" width="184" height="18" mode="float" step="0.05" show_value="1" out_num_of_signs="2"/>
  </brightness>
  <backlight>
    <label x="16" y="164" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_backlight</text></label>
    <track x="228" y="173" width="184" height="18" mode="float" step="0.25" show_value="1" out_num_of_signs="2"/>
  </backlight>
  <mode>
    <label x="16" y="196" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_mode</text></label>
    <list x="228" y="196" width="184" height="30" list_length="3" always_show_scroll="0">
      <list_font font="letterica16" r="190" g="184" b="169"/>
      <text_color><e r="190" g="184" b="169"/><d r="70" g="70" b="70"/></text_color>
    </list>
  </mode>
  <inspect>
    <label x="16" y="234" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_inspect</text></label>
    <button x="228" y="234" width="184" height="30" stretch="1" hint="pf_st_watch_hint"><texture>pf_fa_button</texture><text font="letterica16" align="c" vert_align="c" r="190" g="184" b="169"></text></button>
  </inspect>
  <switch>
    <label x="16" y="272" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_switch</text></label>
    <button x="228" y="272" width="184" height="30" stretch="1" hint="pf_st_watch_hint"><texture>pf_fa_button</texture><text font="letterica16" align="c" vert_align="c" r="190" g="184" b="169"></text></button>
  </switch>
  <editor>
    <label x="16" y="310" width="204" height="30"><text font="letterica16" r="190" g="184" b="169" vert_align="c">pf_st_watch_editor_key</text></label>
    <button x="228" y="310" width="184" height="30" stretch="1" hint="pf_st_watch_editor_binding_hint"><texture>pf_fa_button</texture><text font="letterica16" align="c" vert_align="c" r="190" g="184" b="169"></text></button>
  </editor>
  <hint x="16" y="358" width="400" height="48"><text font="letterica16" r="145" g="141" b="132" complex_mode="1">pf_st_watch_credits</text></hint>
</w>
