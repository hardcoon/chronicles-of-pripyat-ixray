local state={installed=false}
class "watch_page" (CUIWindow)
function watch_page:__init(handler) super()
    self:SetAutoDelete(true)
    self.handler=handler
    local xml=CScriptXmlInit()
    xml:ParseFile("pf_st_watch_options.xml")
    xml:InitStatic("enabled:label",self)
    self.enabled=xml:InitCheck("enabled:check",self)
    self.color={}
    for _,channel in ipairs({"red","green","blue"}) do
        xml:InitStatic(channel..":label",self)
        local control=xml:InitTrackBar(channel..":track",self)
        control:SetOptFBounds(0,1)
        self.color[channel]=control
    end
    xml:InitStatic("brightness:label",self)
    self.brightness=xml:InitTrackBar("brightness:track",self)
    self.brightness:SetOptFBounds(.25,6)
    xml:InitStatic("backlight:label",self)
    self.backlight=xml:InitTrackBar("backlight:track",self)
    self.backlight:SetOptFBounds(0,30)
    xml:InitStatic("mode:label",self)
    self.mode=xml:InitComboBox("mode:list",self)
    for i,key in ipairs({"pf_st_watch_time","pf_st_watch_condition","pf_st_watch_radiation"}) do
        self.mode:AddItem(game.translate_string(key),i)
    end
    xml:InitStatic("inspect:label",self)
    self.inspect_button=xml:Init3tButton("inspect:button",self)
    xml:InitStatic("switch:label",self)
    self.switch_button=xml:Init3tButton("switch:button",self)
    xml:InitStatic("hint",self)
    handler:Register(self.inspect_button,"pf_st_watch_inspect_key")
    handler:Register(self.switch_button,"pf_st_watch_mode_key")
    handler:AddCallback("pf_st_watch_inspect_key",ui_events.BUTTON_CLICKED,function() self:Capture("inspect_key") end,self)
    handler:AddCallback("pf_st_watch_mode_key",ui_events.BUTTON_CLICKED,function() self:Capture("mode_key") end,self)
    self:SetValues(pf_st_watch_settings.get())
end
function watch_page:SetValues(value)
    self.waiting=nil
    self.keys={inspect_key=value.inspect_key,mode_key=value.mode_key}
    self.enabled:SetCheck(value.enabled==1)
    for channel,control in pairs(self.color) do control:SetFValue(value[channel]) end
    self.brightness:SetFValue(value.brightness)
    self.backlight:SetFValue(value.backlight)
    self.mode:SetCurrentIdx(value.mode-1)
    self.mode:SetText(self.mode:GetTextOf(value.mode-1))
    self:RefreshKeys()
end
function watch_page:RefreshKeys()
    self.inspect_button:TextControl():SetText(pf_st_watch_settings.key_name(self.keys.inspect_key))
    self.switch_button:TextControl():SetText(pf_st_watch_settings.key_name(self.keys.mode_key))
end
function watch_page:Capture(key)
    self.waiting=key
    local button=key=="inspect_key" and self.inspect_button or self.switch_button
    button:TextControl():SetTextST("pf_st_watch_press_key")
end
function watch_page:Key(dik,action)
    if not self.waiting then return false end
    if action~=ui_events.WINDOW_KEY_PRESSED then return true end
    if dik~=DIK_keys.DIK_ESCAPE then
        self.keys[self.waiting]=dik
    end
    self.waiting=nil;self:RefreshKeys();return true
end
function watch_page:Save()
    local value={enabled=self.enabled:GetCheck() and 1 or 0,inspect_key=self.keys.inspect_key,mode_key=self.keys.mode_key,mode=self.mode:GetCurrentIdx()+1}
    for channel,control in pairs(self.color) do value[channel]=control:GetFValue() end
    value.brightness=self.brightness:GetFValue()
    value.backlight=self.backlight:GetFValue()
    return pf_st_watch_settings.save(value)
end
function install()
    if state.installed then return end
    local owner=ui_mm_opt_main.options_dialog
    local init=owner.InitControls
    owner.InitControls=function(self)
        init(self)
        self.dlg_st_watch=watch_page(self)
        self.dialog:AttachChild(self.dlg_st_watch)
        self.dlg_st_watch:SetWndPos(self.dlg_gameplay:GetWndPos())
        self.dlg_st_watch:SetWndSize(vector2():set(self.dlg_gameplay:GetWidth(),self.dlg_gameplay:GetHeight()))
        self.dlg_st_watch:Show(false)
        local xml=CScriptXmlInit()
        xml:ParseFile("pf_st_watch_options.xml")
        self.st_watch_tab=xml:InitTab("watch_tab",self.dialog)
        local position=self.tab:GetWndPos()
        self.st_watch_tab:SetWndPos(vector2():set(position.x,position.y+self.tab:GetTabsCount()*42))
        self:Register(self.st_watch_tab,"pf_st_watch_tab")
        self:AddCallback("pf_st_watch_tab",ui_events.TAB_CHANGED,function()
            if self.st_watch_tab:GetActiveId()=="immersive" then self.tab:SetActiveTab("immersive") end
        end,self)
    end
    local values=owner.SetCurrentValues
    owner.SetCurrentValues=function(self)
        values(self)
        self.dlg_st_watch:SetValues(pf_st_watch_settings.get())
    end
    local tab=owner.OnTabChange
    owner.OnTabChange=function(self)
        tab(self)
        self.dlg_st_watch.waiting=nil
        local selected=self.tab:GetActiveId()=="immersive"
        self.dlg_st_watch:Show(selected)
        self.dlg_st_watch:RefreshKeys()
        -- Reuse the active menu's footer: same parent, position, font and states.
        if selected then self.btn_default_footer:Show(true) end
        if not selected then self.st_watch_tab:SetActiveTab("") end
    end
    local defaults=owner.OnBtnKeybDefault
    owner.OnBtnKeybDefault=function(self)
        if self.tab:GetActiveId()~="immersive" then return defaults(self) end
        self.dlg_st_watch:SetValues(pf_st_watch_settings.get_defaults())
    end
    local keyboard=owner.OnKeyboard
    owner.OnKeyboard=function(self,dik,action)
        if self.dlg_st_watch:IsShown() and self.dlg_st_watch:Key(dik,action) then return true end
        return keyboard(self,dik,action)
    end
    local accept=owner.OnBtnAccept
    owner.OnBtnAccept=function(self)
        if self.tab:GetActiveId()~="immersive" then return accept(self) end
        if not self.dlg_st_watch:Save() then return end
        self.owner:ShowDialog(true);self:HideDialog();self.owner:Show(true)
    end
    local cancel=owner.OnBtnCancel
    owner.OnBtnCancel=function(self)
        if self.tab:GetActiveId()~="immersive" then return cancel(self) end
        self.dlg_st_watch:SetValues(pf_st_watch_settings.get())
        self.owner:ShowDialog(true);self:HideDialog();self.owner:Show(true)
    end
    state.installed=true
end
