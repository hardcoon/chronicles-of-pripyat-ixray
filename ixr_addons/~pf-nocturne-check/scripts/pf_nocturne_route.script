-- Legacy explicit issue entry point; automatic grants have one owner.
function issue_new_game_tool() return pf_dev_loadout.request() end

function use_route_tool(_item)
    pf_nocturne_check.teleport_next()
    -- Context-menu use must not also invoke the native Eat callback.
    return false
end

function on_inventory_eat(_actor,item)
    if not item or item:section()~=TOOL then return false end
    local max_uses=item:get_max_uses()
    if max_uses and max_uses>0 then item:set_remaining_uses(max_uses) end
    pf_nocturne_check.teleport_next()
    return true
end
