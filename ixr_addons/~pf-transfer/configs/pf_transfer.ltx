; Быстрое перекладывание: удерживайте клавишу и проводите курсором по стопкам предметов.
; key — основная клавиша, key_alt — дополнительная (не сочетание клавиш).
; none отключает соответствующую привязку. После изменения полностью перезапустите игру.
; Пример только для левого Ctrl: key = kLCONTROL, key_alt = none.
;
; Fast item transfer: hold a configured key and move the pointer over item stacks.
; Restart the game after editing this file. The MOD OPTIONS checkbox enables/disables the feature.
; Use keyboard names from userdata/user.ltx: kLSHIFT, kRSHIFT, kLCONTROL, kRCONTROL,
; kLMENU (left Alt), kRMENU (right Alt), kX, kF6, etc. Names are case-insensitive.
; key_alt is an alternative key, not a key combination. Use none to disable either binding.
; Example: key = kLCONTROL / key_alt = none selects only left Ctrl.
; Missing file/entries or invalid names fall back to the original Shift bindings.
; Mouse buttons are not supported.

[fast_transfer]
key = kLSHIFT
key_alt = kRSHIFT
