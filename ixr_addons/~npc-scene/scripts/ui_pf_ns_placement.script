class "pf_ns_placement_hud" (CUIScriptWnd)
function pf_ns_placement_hud:__init() super()
    local xml=CScriptXmlInit()
    xml:ParseFile("ui_pf_ns_placement.xml")
    xml:InitWindow("main",0,self)
    self.controls_background=xml:InitStatic("main:controls_background",self)
    self.status_background=xml:InitStatic("main:status_background",self)
    self.title=xml:InitTextWnd("main:title",self)
    self.status=xml:InitTextWnd("main:status",self)
    self.control_rows={}
    for index=1,14 do
        local key=xml:InitTextWnd("main:control_key",self)
        local action=xml:InitTextWnd("main:control_action",self)
        local accent=xml:InitTextWnd("main:control_action",self)
        key:SetWndPos(vector2():set(20,286+(index-1)*24))
        action:SetWndPos(vector2():set(96,286+(index-1)*24))
        accent:Show(false)
        self.control_rows[index]={key=key,action=action,accent=accent}
    end
    self.hold_rows={}
    for index=1,2 do
        local key=xml:InitTextWnd("main:control_key",self)
        local action=xml:InitTextWnd("main:control_action",self)
        key:Show(false);action:Show(false)
        self.hold_rows[index]={key=key,action=action}
    end
end
function pf_ns_placement_hud:refresh(session)
    self.title:SetText(game.translate_string(session.spec.title or "pf_rt_title"))
    self.title:AdjustWidthToText()
    local ready=session.valid and not session.error
    self.status:SetText(game.translate_string(session.error or (ready and "pf_rt_ready" or "pf_rt_no_surface"))..pf_ns_main.placement_status())
    self.status:SetTextColor(ready and GetARGB(255,110,220,110) or GetARGB(255,240,100,100))
    local mode=session.state=="ADV_CTRL" and "advanced" or string.lower(session.state)
    local message=game.translate_string("pf_ns_controls_"..mode)
    local labels=pf_ns_placement.control_labels()
    labels.collision_state=game.translate_string(session.check_collision and "pf_rt_value_on" or "pf_rt_value_off")
    labels.alignment_mode=game.translate_string(session.align_surface and "pf_rt_align_surface" or "pf_rt_align_direction")
    message=message:gsub("%$([%w_]+)",function(key) return labels[key] or key end)
    -- Every row remains single-line. The coloured axis suffix uses its own
    -- sibling widget, so inline colouring cannot enable automatic wrapping.
    local index=0
    local key_width=0
    for line in message:gsub("\\n","\n"):gmatch("[^\r\n]+") do
        local key,action=line:match("^(.-) %- (.+)$")
        if key and index<#self.control_rows then
            index=index+1
            local row=self.control_rows[index]
            local prefix,a,r,g,b,suffix=action:match("^(.-)%%c%[(%d+),(%d+),(%d+),(%d+)%](.-)%%c%[[^%]]+%]$")
            row.key:SetText(key)
            row.action:SetText(action:gsub("%%c%[[^%]]+%]",""))
            row.key:AdjustWidthToText();row.action:AdjustWidthToText()
            row.width=row.action:GetWidth()
            row.accent:Show(suffix~=nil)
            if suffix then
                row.accent:SetText(suffix)
                row.accent:SetTextColor(GetARGB(tonumber(a),tonumber(r),tonumber(g),tonumber(b)))
                row.accent:AdjustWidthToText()
                -- Full text minus suffix keeps the font's inter-letter spacing.
                row.action:SetText(prefix)
                row.action:SetWidth(row.width-row.accent:GetWidth())
            end
            key_width=math.max(key_width,row.key:GetWidth())
            row.key:Show(true);row.action:Show(true)
        end
    end
    for hidden=index+1,#self.control_rows do
        local row=self.control_rows[hidden]
        row.key:Show(false);row.action:Show(false);row.accent:Show(false)
    end
    -- Use the same physical-key labels as the controls above. ACTION macros
    -- return layout-dependent ANSI names and would mix encodings with UTF-8.
    for _,row in ipairs(self.hold_rows) do row.key:Show(false);row.action:Show(false) end
    -- Measure with the active engine font and UI scale, including rebound keys.
    local action_x=20+key_width+10
    local right=20+self.title:GetWidth()
    for visible=1,index do
        local row=self.control_rows[visible]
        row.action:SetWndPos(vector2():set(action_x,286+(visible-1)*24))
        if row.accent:IsShown() then
            row.accent:SetWndPos(vector2():set(action_x+row.action:GetWidth(),286+(visible-1)*24))
        end
        right=math.max(right,action_x+row.width)
    end
    for _,row in ipairs(self.hold_rows) do right=math.max(right,action_x+row.action:GetWidth()) end
    local width=right+12-8
    local height=50+index*24
    self.controls_background:SetWidth(width)
    self.controls_background:SetHeight(height)
    local status_y=244+height+8
    self.status_background:SetWndPos(vector2():set(8,status_y))
    self.status:SetWndPos(vector2():set(20,status_y+8))
    self.status:SetWidth(width-24)
    self.status:AdjustHeightToText()
    local hold_y=status_y+8+self.status:GetHeight()+4
    self.status_background:SetWidth(width)
    self.status_background:SetHeight(self.status:GetHeight()+20)
end
function create_hud() return pf_ns_placement_hud() end

function pf_ns_placement_hud:Update()
    CUIScriptWnd.Update(self)
    -- CDialogHolder updates rendered windows every frame, including HOLDING.
    pf_ns_placement.update()
    pf_ns_main.placement_frame()
end

class "pf_runtime_editor_controls" (CUIScriptWnd)
function pf_runtime_editor_controls:__init() super()
    self:SetWndRect(Frect():set(0,0,1024,768))
    self:SetWindowName("pf_runtime_editor_controls")
end
function pf_runtime_editor_controls:OnKeyboard(dik,action) return true end
function create_controls() return pf_runtime_editor_controls() end

-- A blank, non-modal window dispatches inventory requests on the UI thread.
-- It has no children, draws nothing, and is retained/reused by the library.
class "pf_ns_placement_dispatcher" (CUIScriptWnd)
function pf_ns_placement_dispatcher:__init() super()
    self:SetWndRect(Frect():set(0,0,0,0))
    self:SetWindowName("pf_ns_placement_dispatcher")
end
function pf_ns_placement_dispatcher:Update()
    pf_ns_placement.flush_start()
end
function create_dispatcher() return pf_ns_placement_dispatcher() end

