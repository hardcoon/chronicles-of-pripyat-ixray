[controls]
; Use a DIK name, for example DIK_HOME, DIK_END or DIK_F10.
open_key = DIK_HOME
; Toggle the same furniture lights as the on/off buttons in Light Control.
lights_toggle_key = DIK_END

[capture]
default_radius = 12
; Maximum capture radius in metres. Edit only this value; restart the game.
maximum_radius = 200
; Position tolerance in metres; applies to the overlap warning.
coordinate_tolerance = 0.08

[safety]
maximum_objects = 512
; Removing a layout requires matching furniture type, position and rotation.
rotation_tolerance = 0.02
