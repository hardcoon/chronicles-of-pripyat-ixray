-- Generated from reference_group_catalog_20260821.json.
-- Dialogue-only facade for Novikov's anomaly-coordinate service. It performs
-- no ALife scan and delegates persistent discovery to pf_proc_group_markers.

local PRICE = 1000
local selected_group_id = nil
local family_groups = {
	thermal = { 7, 8, 13, 14, 23, 31, 34, 38 },
	chemical = { 2, 4, 12, 16, 25, 27, 37, 39 },
	electric = { 3, 10, 15, 20, 24, 30, 33, 40 },
	gravitational = { 1, 9, 11, 17, 22, 26, 28, 32, 36 },
	psi = { 5, 6, 18, 19, 21, 29, 35, 41 },
}

local function marker_api_ready()
	return pf_proc_group_markers ~= nil
		and type(pf_proc_group_markers.is_ready) == "function"
		and type(pf_proc_group_markers.is_group_available) == "function"
		and type(pf_proc_group_markers.reveal_group) == "function"
		and pf_proc_group_markers.is_ready() == true
end

local function group_available(group_id)
	return marker_api_ready()
		and pf_proc_group_markers.is_group_available(group_id) == true
end

local function family_available(family)
	local groups = family_groups[family]
	if not groups then return false end
	for _, group_id in ipairs(groups) do
		if group_available(group_id) then return true end
	end
	return false
end

local function select_group(group_id)
	selected_group_id = group_available(group_id) and group_id or nil
end

function any_available(first_speaker, second_speaker)
	if not marker_api_ready() then return false end
	for group_id = 1, 41 do
		if pf_proc_group_markers.is_group_available(group_id) then return true end
	end
	return false
end

function service_available(first_speaker, second_speaker)
	return marker_api_ready()
end

function begin_purchase(first_speaker, second_speaker)
	selected_group_id = nil
end

function clear_selection(first_speaker, second_speaker)
	selected_group_id = nil
end

function can_pay_selected(first_speaker, second_speaker)
	return selected_group_id ~= nil and group_available(selected_group_id)
		and db.actor ~= nil and db.actor:money() >= PRICE
end

function cannot_pay_selected(first_speaker, second_speaker)
	return selected_group_id ~= nil and group_available(selected_group_id)
		and (db.actor == nil or db.actor:money() < PRICE)
end

function pay_selected(first_speaker, second_speaker)
	local group_id = selected_group_id
	if group_id == nil or db.actor == nil or db.actor:money() < PRICE
		or not group_available(group_id) then
		selected_group_id = nil
		return false
	end
	-- Reveal first. Money is removed only after the persistent marker update
	-- succeeds, preventing payment for a stale or unavailable catalogue item.
	if not pf_proc_group_markers.reveal_group(group_id) then
		selected_group_id = nil
		return false
	end
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, PRICE)
	selected_group_id = nil
	return true
end

function family_thermal_available(first_speaker, second_speaker)
	return family_available("thermal")
end

function family_chemical_available(first_speaker, second_speaker)
	return family_available("chemical")
end

function family_electric_available(first_speaker, second_speaker)
	return family_available("electric")
end

function family_gravitational_available(first_speaker, second_speaker)
	return family_available("gravitational")
end

function family_psi_available(first_speaker, second_speaker)
	return family_available("psi")
end

