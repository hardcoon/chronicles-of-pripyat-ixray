<?xml version="1.0" encoding="utf-8"?>
<string_table>
	<string id="pf_novikov_anomaly_intro_actor"><text>Could you tell me where to find anomaly fields around here?</text></string>
	<string id="pf_novikov_anomaly_intro_novikov"><text>Want to try your luck? Your choice. We have field data on anomaly activity, including cluster coordinates. I can share it, but not for free.</text></string>
	<string id="pf_novikov_anomaly_understood_actor"><text>Understood.</text></string>
	<string id="pf_novikov_anomaly_purchase_actor"><text>I would like to buy data on anomaly clusters.</text></string>
	<string id="pf_novikov_anomaly_choose_family_novikov"><text>As I said, the service is not free. What type of anomaly field interests you?</text></string>
	<string id="pf_novikov_anomaly_choose_family_again_novikov"><text>Which type of anomaly field interests you?</text></string>
	<string id="pf_novikov_anomaly_family_thermal_actor"><text>Thermal</text></string>
	<string id="pf_novikov_anomaly_family_chemical_actor"><text>Chemical</text></string>
	<string id="pf_novikov_anomaly_family_electric_actor"><text>Electrical</text></string>
	<string id="pf_novikov_anomaly_family_gravitational_actor"><text>Gravitational</text></string>
	<string id="pf_novikov_anomaly_family_psi_actor"><text>Psi fields</text></string>
	<string id="pf_novikov_anomaly_known_list_novikov"><text>At present, we have information on the following clusters:</text></string>
	<string id="pf_novikov_anomaly_back_actor"><text>I am interested in another type.</text></string>
	<string id="pf_novikov_anomaly_price_novikov"><text>That will be 1,000 rubles.</text></string>
	<string id="pf_novikov_anomaly_pay_actor"><text>Here you go.</text></string>
	<string id="pf_novikov_anomaly_no_money_actor"><text>I do not have that much right now.</text></string>
	<string id="pf_novikov_anomaly_not_now_actor"><text>Not now.</text></string>
	<string id="pf_novikov_anomaly_coordinates_added_novikov"><text>Done. The coordinates are in your PDA.</text></string>
</string_table>
