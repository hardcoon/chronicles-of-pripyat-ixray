; Fixed static-spawn population for normal and developer games.
; The mode and native ALife distance policy are read once per process.
[pf_procedural_anomalies_test]
mode = static_spawn_test
online_distance = 100
offline_distance = 125
online_transition_delay_ms = 50

#include "zones\pf_procedural_anomaly_zones.ltx"

; Point anomalies and the four damaging group auras are registered with the
; HUD detector.  Neutral gravitational/electric shells stay unregistered.
![all_zone_detector]
zone_class_65 = pf_proc_gravitational_weak
zone_freq_65 = 0.05, 2
zone_sound_65_ = detectors\DA-2_beep1
