; Group aura objects also anchor serialized PDA markers.  Gravitational and
; electric shells remain neutral because their frequent hit packets caused the
; original movement problem.  Chemical and thermal fields intentionally omit
; postprocess: their screen effects are unpleasant, but their damage remains.
[pf_proc_aura_gravitational]:zone_base
$spawn = "zones\pf procedural aura gravitational"
GroupControlSection = spawn_group_zone
$def_sphere = 15
class = ZS_RADIO
hit_impulse_scale = 0.01
effective_radius = 1.0
ef_anomaly_type = 3
ef_weapon_type = 15
hit_type = strike
max_start_power = 0.0
attenuation = 0.5
disable_time = -1
disable_time_small = -1
disable_idle_time = -1
ignore_nonalive = true
ignore_small = false
ignore_artefacts = true
blowout_light = off
awaking_time = 100
blowout_time = 100
accamulate_time = 100
blowout_wind = off
idle_particles =
idle_sound = ambient\no_sound
idle_light = off
artefact_spawn_rnd = 0
artefact_spawn_count = 0

