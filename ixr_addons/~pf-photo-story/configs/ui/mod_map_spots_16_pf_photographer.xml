<?xml version="1.0" encoding="utf-8"?>
<!-- Load-only aliases for serialized markers in older saves. The stash
     manager converts their existing containers to green without losing loot. -->
<map_spots override="add">
<pf_stash_pink hint="pf_dynamic_stash_name">
<level_map spot="pf_stash_green_spot" pointer="quest_pointer"/>
<mini_map spot="pf_stash_green_spot_mini"/>
</pf_stash_pink>
<pf_stash_pink_eye hint="pf_dynamic_stash_name">
<level_map spot="pf_stash_green_eye_spot" pointer="quest_pointer"/>
<mini_map spot="pf_stash_green_eye_spot_mini"/>
</pf_stash_pink_eye>
</map_spots>
