-- One Yanov radio per ALife world, including saves with lost pstor IDs or
-- accumulated copies. Reconcile once after load/online-spawn notifications;
-- no permanent world scan and no native object references kept between calls.

local settings = {
	section = "pf_yanov_radio",
	pstor_key = "pf_yanov_radio_object_id_v1",
	-- The QA logger records the actor origin. Its saved camera ray hits the
	-- tabletop here; the radio model has a zero-height lower bound, so the
	-- collision-surface Y is also the authored object Y.
	position_x = -957.756230,
	position_y = 1.220000,
	position_z = -1362.252221,
	yaw = 5.029709154,
	level_vertex_id = 2437626,
	game_vertex_id = 377,
	placement_tolerance_sqr = 0.05 * 0.05,
	yaw_tolerance = 0.01,
	retry_ms = 1000
}

local runtime = {
	callbacks_registered = false,
	update_armed = false,
	fallback_complete = false,
	next_try_ms = 0,
	canonical_id = nil,
	pending_removals = {},
	recheck_requested = false
}

local impl = {}

function impl.authored_position()
	return vector():set(settings.position_x, settings.position_y, settings.position_z)
end

function impl.placement_matches(object)
	local position = object.position
	local angle = object.angle
	if not position or not angle then return false end
	local dx = position.x - settings.position_x
	local dy = position.y - settings.position_y
	local dz = position.z - settings.position_z
	if dx * dx + dy * dy + dz * dz > settings.placement_tolerance_sqr then return false end

	local yaw_delta = math.abs(angle.y - settings.yaw) % (2 * math.pi)
	if yaw_delta > math.pi then yaw_delta = 2 * math.pi - yaw_delta end
	return yaw_delta <= settings.yaw_tolerance
end

function impl.stored_id()
	local id = tonumber(xr_logic.pstor_retrieve(db.actor, settings.pstor_key, -1))
	if not id or id < 0 or id >= 65535 or id % 1 ~= 0 then return nil end
	return id
end

function impl.removals_finished(sim)
	local waiting = false
	for id in pairs(runtime.pending_removals) do
		local object = sim:object(id, true)
		if object and object:section_name() == settings.section then
			waiting = true
		else
			runtime.pending_removals[id] = nil
		end
	end
	return not waiting
end

function impl.release_radio(sim, id, reason)
	local object = sim:object(id, true)
	if not object or object:section_name() ~= settings.section then return end
	-- Online destruction may be deferred. Never queue it twice or create a
	-- replacement until the server registry confirms that removal completed.
	runtime.pending_removals[id] = true
	printf("~ [pf_yanov_radio] removing %s id [%s]", reason, tostring(id))
	sim:release(object, true)
end

function impl.spawn_radio(sim)
	local position = impl.authored_position()
	local object = sim:create(
		settings.section,
		position,
		settings.level_vertex_id,
		settings.game_vertex_id
	)
	if not object then return nil end

	-- Mirror the authored transform onto the server record immediately. This
	-- is the same proven path used by addon-owned runtime world objects.
	object.position = position
	object.angle = vector():set(0, settings.yaw, 0)
	object.m_level_vertex_id = settings.level_vertex_id
	object.m_game_vertex_id = settings.game_vertex_id
	xr_logic.pstor_store(db.actor, settings.pstor_key, object.id)
	runtime.canonical_id = object.id
	printf("~ [pf_yanov_radio] created server object id [%s]", tostring(object.id))
	return object
end

function impl.ensure_radio()
	if not db.actor then return false end

	local sim = alife()
	if not sim or not sim:object(db.actor:id(), true) then return false end
	if not impl.removals_finished(sim) then return false end

	local stored_id = impl.stored_id()
	local ids = {}
	local keep_id = nil
	-- Pstor is only a preference: its absence must never mean an empty world.
	-- Collect IDs first; releasing during this iterator invalidates the registry.
	for _, object in sim:objects() do
		if object:section_name() == settings.section then
			local id = object.id
			ids[#ids + 1] = id
			if not keep_id or id == stored_id or (keep_id ~= stored_id and id < keep_id) then
				keep_id = id
			end
		end
	end

	runtime.canonical_id = keep_id
	if not keep_id then return impl.spawn_radio(sim) ~= nil end
	if stored_id ~= keep_id then
		xr_logic.pstor_store(db.actor, settings.pstor_key, keep_id)
		printf("~ [pf_yanov_radio] adopted existing server object id [%s]", tostring(keep_id))
	end

	for _, id in ipairs(ids) do
		if id ~= keep_id then impl.release_radio(sim, id, "duplicate") end
	end
	if next(runtime.pending_removals) then return false end

	local object = sim:object(keep_id, true)
	if not object or object:section_name() ~= settings.section then return false end
	if not impl.placement_matches(object) then
		-- Retain the existing placement-repair behavior, but remove first and
		-- wait for destruction rather than spawning into an occupied position.
		runtime.canonical_id = nil
		impl.release_radio(sim, keep_id, "misplaced receiver")
		return false
	end
	return true
end

function impl.arm_update()
	runtime.fallback_complete = false
	runtime.next_try_ms = 0
	runtime.recheck_requested = true
	if runtime.update_armed then return true end
	RegisterScriptCallback("update", impl.update)
	runtime.update_armed = true
	return true
end

function impl.finish_update()
	-- IX-Ray's callback framework exposes the symmetric unregister operation.
	-- Keep a one-branch fallback only for an unexpected older runtime.
	if type(UnregisterScriptCallback) == "function" then
		UnregisterScriptCallback("update", impl.update)
		runtime.update_armed = false
	else
		runtime.fallback_complete = true
	end
end

function impl.update()
	if runtime.fallback_complete or not db.actor then return end

	local now = time_global()
	if now < runtime.next_try_ms then return end
	runtime.next_try_ms = now + settings.retry_ms
	runtime.recheck_requested = false
	if impl.ensure_radio() and not runtime.recheck_requested then impl.finish_update() end
end

function impl.on_actor_load()
	-- Actor load is sent after pstor_load_all and the ALife registry load. Arm
	-- a fresh one-shot because a quick-load can switch to another save.
	runtime.canonical_id = nil
	runtime.pending_removals = {}
	impl.arm_update()
end

function on_radio_spawn(id)
	-- Called by the object binder, including copies created by other scripts.
	-- Defer all ALife mutations until actor update, outside net_spawn/load.
	impl.arm_update()
end

function is_primary(id)
	-- Extra copies stay silent and noninteractive until deferred removal.
	return runtime.canonical_id == id
end

function on_game_start()
	if runtime.callbacks_registered then return true end
	if type(RegisterScriptCallback) ~= "function" then
		printf("! [pf_yanov_radio] RegisterScriptCallback unavailable")
		return false
	end

	RegisterScriptCallback("load", impl.on_actor_load)
	runtime.callbacks_registered = true
	impl.arm_update()
	return true
end

on_game_start()
