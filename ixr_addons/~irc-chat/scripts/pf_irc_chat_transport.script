local ADDON_DIR = "~irc-chat"
local EXE_RELATIVE_PATH = "bin\\pf_irc_bridge.exe"
local CONFIG_RELATIVE_PATH = "configs\\pf_irc_chat_runtime.ltx"
local PIPE_PREFIX = "pf_irc_chat_"

local ffi_ok, ffi = pcall(require, "ffi")
local kernel32 = nil

if ffi_ok then
    -- Use add-on-specific type names so other Anomaly LuaJIT modules may
    -- declare the common Win32 aliases without causing an FFI redefinition.
    pcall(ffi.cdef, [[
        typedef unsigned long PF_IRC_DWORD;
        typedef int PF_IRC_BOOL;
        typedef unsigned short PF_IRC_WORD;
        typedef unsigned char PF_IRC_BYTE;
        typedef void* PF_IRC_HANDLE;
        typedef struct {
            PF_IRC_DWORD cb; char* lpReserved; char* lpDesktop; char* lpTitle;
            PF_IRC_DWORD dwX; PF_IRC_DWORD dwY; PF_IRC_DWORD dwXSize; PF_IRC_DWORD dwYSize;
            PF_IRC_DWORD dwXCountChars; PF_IRC_DWORD dwYCountChars; PF_IRC_DWORD dwFillAttribute;
            PF_IRC_DWORD dwFlags; PF_IRC_WORD wShowWindow; PF_IRC_WORD cbReserved2;
            PF_IRC_BYTE* lpReserved2; PF_IRC_HANDLE hStdInput; PF_IRC_HANDLE hStdOutput; PF_IRC_HANDLE hStdError;
        } PF_IRC_STARTUPINFOA;
        typedef struct {
            PF_IRC_HANDLE hProcess; PF_IRC_HANDLE hThread;
            PF_IRC_DWORD dwProcessId; PF_IRC_DWORD dwThreadId;
        } PF_IRC_PROCESS_INFORMATION;
    ]])
    pcall(ffi.cdef, [[
        PF_IRC_BOOL __stdcall CreateProcessA(const char* application_name, char* command_line,
            void* process_attributes, void* thread_attributes, PF_IRC_BOOL inherit_handles,
            PF_IRC_DWORD creation_flags, void* environment, const char* current_directory,
            PF_IRC_STARTUPINFOA* startup_info, PF_IRC_PROCESS_INFORMATION* process_information);
        PF_IRC_BOOL __stdcall WaitNamedPipeA(const char* pipe_name, PF_IRC_DWORD timeout);
        PF_IRC_HANDLE __stdcall CreateFileA(const char* file_name, PF_IRC_DWORD desired_access,
            PF_IRC_DWORD share_mode, void* security_attributes, PF_IRC_DWORD creation_disposition,
            PF_IRC_DWORD flags, PF_IRC_HANDLE template_file);
        PF_IRC_BOOL __stdcall PeekNamedPipe(PF_IRC_HANDLE pipe, void* buffer,
            PF_IRC_DWORD buffer_size, PF_IRC_DWORD* bytes_read,
            PF_IRC_DWORD* total_available, PF_IRC_DWORD* bytes_left);
        PF_IRC_BOOL __stdcall ReadFile(PF_IRC_HANDLE file, void* buffer,
            PF_IRC_DWORD bytes_to_read, PF_IRC_DWORD* bytes_read, void* overlapped);
        PF_IRC_BOOL __stdcall WriteFile(PF_IRC_HANDLE file, const void* buffer,
            PF_IRC_DWORD bytes_to_write, PF_IRC_DWORD* bytes_written, void* overlapped);
        PF_IRC_BOOL __stdcall CloseHandle(PF_IRC_HANDLE object);
        PF_IRC_BOOL __stdcall TerminateProcess(PF_IRC_HANDLE process, unsigned int exit_code);
        PF_IRC_DWORD __stdcall WaitForSingleObject(PF_IRC_HANDLE object, PF_IRC_DWORD milliseconds);
        void __stdcall Sleep(PF_IRC_DWORD milliseconds);
        PF_IRC_DWORD __stdcall GetLastError(void);
        PF_IRC_DWORD __stdcall GetCurrentProcessId(void);
    ]])
    local kernel_ok, kernel_value = pcall(ffi.load, "kernel32")
    if kernel_ok then kernel32 = kernel_value end
end

-- Native IPC handles belong to the current Lua context and are never serialized
-- into a save. The helper owns the IRC session and accepts a replacement pipe
-- client after F9; ffi finalizers close stale handles when this context dies.
local STATE_KEY = "__pf_irc_chat_transport_process_state_v2"
local state = rawget(_G, STATE_KEY)
if type(state) ~= "table" then
    state = {
        pipe = nil,
        process = nil,
        pipe_name = nil,
        read_buffer = "",
        started = false
    }
    rawset(_G, STATE_KEY, state)
end

local function handle_is_invalid(handle)
    if handle == nil then return true end
    return tonumber(ffi.cast("intptr_t", handle)) == -1
end

local function own_handle(handle)
    if handle_is_invalid(handle) then return handle end
    return ffi.gc(handle, function(value)
        if kernel32 ~= nil then pcall(kernel32.CloseHandle, value) end
    end)
end

local function percent_encode(value)
    return (tostring(value or ""):gsub(".", function(character)
        local byte = string.byte(character)
        if (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or
            (byte >= 97 and byte <= 122) or character == "-" or character == "_" or
            character == "." or character == "#" or character == " " then
            return character
        end
        return string.format("%%%02X", byte)
    end))
end

local function percent_decode(value)
    return (tostring(value or ""):gsub("%%(%x%x)", function(hex)
        return string.char(tonumber(hex, 16))
    end))
end

local function encode(fields)
    local result = {}
    for index, value in ipairs(fields) do result[index] = percent_encode(value) end
    return table.concat(result, "\t") .. "\n"
end

local function decode(line)
    local fields = {}
    for value in (line .. "\t"):gmatch("(.-)\t") do
        table.insert(fields, percent_decode(value))
    end
    return fields
end

local function executable_path()
    if not getFS or not getFS() then return nil end
    -- MO2 exposes the helper in the game's real/virtual bin directory.  The
    -- $game_data$ parent is the portable way to reach the Anomaly root.
    return getFS():update_path("$arch_dir_addons$", ADDON_DIR .. "\\" .. EXE_RELATIVE_PATH)
end

local function diagnostic_log_path()
    if not getFS or not getFS() then return nil end
    return getFS():update_path("$logs$", "pf_irc_chat_multichannel_bridge.log")
end

local function runtime_config_path()
    if not getFS or not getFS() then return nil end
    return getFS():update_path("$arch_dir_addons$", ADDON_DIR .. "\\" .. CONFIG_RELATIVE_PATH)
end

local function close_handle(name)
    if state[name] ~= nil and not handle_is_invalid(state[name]) then
        local handle = state[name]
        ffi.gc(handle, nil)
        kernel32.CloseHandle(handle)
    end
    state[name] = nil
end

local function terminate_process()
    if state.process ~= nil and not handle_is_invalid(state.process) then
        kernel32.TerminateProcess(state.process, 1)
    end
end

function available()
    return ffi_ok and kernel32 ~= nil and executable_path() ~= nil
end

local function pipe_paths()
    local token = tostring(tonumber(kernel32.GetCurrentProcessId()) or 0)
    if token == "0" then return nil, nil, "process_id_invalid" end
    local pipe_name = PIPE_PREFIX .. token
    return pipe_name, "\\\\.\\pipe\\" .. pipe_name
end

function attach()
    if state.started then return true, "existing" end
    if not ffi_ok or kernel32 == nil then return false, "ffi_unavailable" end

    local pipe_name, full_pipe, pipe_error = pipe_paths()
    if not pipe_name then return false, pipe_error end
    -- A replacement Lua context can arrive while the helper is still switching
    -- named-pipe clients after F5/F9. Give the existing server time to expose
    -- its next pipe instead of treating that short busy window as no helper.
    if kernel32.WaitNamedPipeA(full_pipe, 350) == 0 then
        return false, "helper_not_running_" .. tostring(kernel32.GetLastError())
    end

    local GENERIC_READ_WRITE = 0xC0000000
    local OPEN_EXISTING = 3
    local pipe = kernel32.CreateFileA(full_pipe, GENERIC_READ_WRITE, 0, nil, OPEN_EXISTING, 0, nil)
    if handle_is_invalid(pipe) then
        return false, "helper_attach_failed_" .. tostring(kernel32.GetLastError())
    end

    state.pipe = own_handle(pipe)
    state.process = nil
    state.pipe_name = pipe_name
    state.read_buffer = ""
    state.started = true
    return true, "attached"
end

function start()
    if state.started then return true end
    if not available() then return false, "ffi_unavailable" end

    local attached, attach_state = attach()
    if attached then return true, attach_state end

    -- Only FILE_NOT_FOUND/PATH_NOT_FOUND prove that there is no helper. Busy,
    -- timeout and access errors must fail closed; spawning in those cases used
    -- to create parallel IRC sessions and a fresh fallback nick on every retry.
    if attach_state ~= "helper_not_running_2" and attach_state ~= "helper_not_running_3" then
        return false, attach_state
    end

    local exe = executable_path()
    local probe = io.open(exe, "rb")
    if not probe then return false, "helper_missing" end
    probe:close()

    local pipe_name, full_pipe, pipe_error = pipe_paths()
    if not pipe_name then return false, pipe_error end
    state.pipe_name = pipe_name
    local parent_pid = tonumber(kernel32.GetCurrentProcessId()) or 0
    local log_path = diagnostic_log_path()
    local config_path = runtime_config_path()
    local identity_path = pf_irc_chat_config and pf_irc_chat_config.get_identity_path and
        pf_irc_chat_config.get_identity_path() or nil
    if identity_path == nil or identity_path == "" then
        return false, "identity_path_unavailable"
    end
    local command = string.format('"%s" --pipe %s --parent-pid %d',
        exe, state.pipe_name, parent_pid)
    if log_path ~= nil and log_path ~= "" then
        command = command .. string.format(' --log "%s"', log_path)
    end
    if config_path ~= nil and config_path ~= "" then
        command = command .. string.format(' --config "%s"', config_path)
    end
    command = command .. string.format(' --identity "%s"', identity_path)
    local command_buffer = ffi.new("char[?]", #command + 1)
    ffi.copy(command_buffer, command)
    local startup = ffi.new("PF_IRC_STARTUPINFOA[1]")
    startup[0].cb = ffi.sizeof("PF_IRC_STARTUPINFOA")
    local process_info = ffi.new("PF_IRC_PROCESS_INFORMATION[1]")
    local CREATE_NO_WINDOW = 0x08000000

    if kernel32.CreateProcessA(exe, command_buffer, nil, nil, 0, CREATE_NO_WINDOW,
        nil, nil, startup, process_info) == 0 then
        return false, "helper_start_failed_" .. tostring(kernel32.GetLastError())
    end
    state.process = own_handle(process_info[0].hProcess)
    kernel32.CloseHandle(process_info[0].hThread)

    local pipe_ready = false
    local pipe_error = 0
    for _ = 1, 120 do
        if kernel32.WaitNamedPipeA(full_pipe, 50) ~= 0 then
            pipe_ready = true
            break
        end
        pipe_error = tonumber(kernel32.GetLastError())
        if kernel32.WaitForSingleObject(state.process, 0) == 0 then break end
        kernel32.Sleep(50)
    end
    if not pipe_ready then
        terminate_process()
        close_handle("process")
        return false, "helper_pipe_timeout_" .. tostring(pipe_error)
    end

    local GENERIC_READ_WRITE = 0xC0000000
    local OPEN_EXISTING = 3
    state.pipe = own_handle(kernel32.CreateFileA(
        full_pipe, GENERIC_READ_WRITE, 0, nil, OPEN_EXISTING, 0, nil))
    if handle_is_invalid(state.pipe) then
        state.pipe = nil
        terminate_process()
        close_handle("process")
        return false, "helper_pipe_open_failed_" .. tostring(kernel32.GetLastError())
    end
    state.read_buffer = ""
    state.started = true
    return true
end

function send(fields)
    if not state.started or handle_is_invalid(state.pipe) then return false, "helper_not_started" end
    local data = encode(fields)
    local written = ffi.new("PF_IRC_DWORD[1]")
    if kernel32.WriteFile(state.pipe, data, #data, written, nil) == 0 or
        tonumber(written[0]) ~= #data then
        return false, "helper_write_failed_" .. tostring(kernel32.GetLastError())
    end
    return true
end

function poll(max_events)
    local events = {}
    if not state.started or handle_is_invalid(state.pipe) then return events end
    max_events = math.max(1, math.min(tonumber(max_events) or 32, 128))

    while #events < max_events do
        local available_bytes = ffi.new("PF_IRC_DWORD[1]")
        if kernel32.PeekNamedPipe(state.pipe, nil, 0, nil, available_bytes, nil) == 0 then
            stop(false)
            break
        end
        local count = tonumber(available_bytes[0])
        if count <= 0 then break end
        count = math.min(count, 8192)
        local buffer = ffi.new("char[?]", count)
        local bytes_read = ffi.new("PF_IRC_DWORD[1]")
        if kernel32.ReadFile(state.pipe, buffer, count, bytes_read, nil) == 0 then
            stop(false)
            break
        end
        state.read_buffer = state.read_buffer .. ffi.string(buffer, tonumber(bytes_read[0]))
        if #state.read_buffer > 65536 then
            state.read_buffer = ""
            table.insert(events, { "ERROR", "ipc_overflow", "IPC receive buffer was reset." })
            break
        end
        while #events < max_events do
            local delimiter = state.read_buffer:find("\n", 1, true)
            if not delimiter then break end
            local line = state.read_buffer:sub(1, delimiter - 1):gsub("\r$", "")
            state.read_buffer = state.read_buffer:sub(delimiter + 1)
            if line ~= "" then table.insert(events, decode(line)) end
        end
    end
    return events
end

function stop(send_quit)
    if state.started and send_quit ~= false then pcall(send, { "QUIT" }) end
    close_handle("pipe")
    if state.process ~= nil and not handle_is_invalid(state.process) then
        local WAIT_TIMEOUT = 0x102
        -- Never stall the Anomaly render/input thread while the external
        -- helper finishes its socket shutdown. If it did not exit immediately
        -- after QUIT/pipe close, terminate it and release our handle without a
        -- blocking wait. The helper owns no game state or user files.
        if kernel32.WaitForSingleObject(state.process, 0) == WAIT_TIMEOUT then
            terminate_process()
        end
    end
    close_handle("process")
    state.pipe_name = nil
    state.read_buffer = ""
    state.started = false
end

function is_started()
    return state.started == true
end
