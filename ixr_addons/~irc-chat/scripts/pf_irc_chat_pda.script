local function translated(id)
    return pf_irc_text_codec.to_ui(game.translate_string(id))
end

local function translated_utf8(id)
    return translated(id)
end

local function error_text(code, detail)
    local id = ERROR_TEXT[tostring(code or "")]
    if id then return translated(id) end
    detail = tostring(detail or "")
    if detail ~= "" then return pf_irc_text_codec.to_ui(detail) end
    return translated("pf_irc_error_connection")
end

-- In Anomaly, CUIStatic exposes its text only through CUILines returned by
-- TextControl(). IX-Ray also exports the direct SetText/GetText shortcuts,
-- but relying on those makes the PDA tab fail at runtime on Anomaly.
local function static_set_text(widget, value)
    widget:TextControl():SetText(pf_irc_text_codec.to_ui(value))
end

local function static_get_text(widget)
    return pf_irc_text_codec.from_ui(widget:TextControl():GetText() or "")
end

local NICK_COLORS = {
    GetARGB(255, 105, 190, 210), GetARGB(255, 125, 200, 120),
    GetARGB(255, 215, 165, 75), GetARGB(255, 190, 125, 195),
    GetARGB(255, 115, 150, 220), GetARGB(255, 215, 120, 105),
    GetARGB(255, 165, 190, 95), GetARGB(255, 205, 145, 85),
    GetARGB(255, 105, 200, 170), GetARGB(255, 170, 145, 215)
}
local MENTION_COLOR = GetARGB(255, 235, 190, 85)
local RIGHT_BUTTON_HINT_DELAY_MS = 500
local SCROLL_EDGE_ZONE_RATIO = 0.10
local MIN_SCROLL_EDGE_ZONE = 8

local function scroll_edge_state(view, minimum, maximum, current)
    -- CUIScrollView exposes the scrollbar's full range as maximum, but the
    -- native scrollbar clamps its actual position to max - page_size + 1.
    -- The page size is the scroll view height and is not exported to Lua.
    local page_size = math.max(1, math.floor(view:GetHeight()))
    local reachable_maximum = math.max(minimum, maximum - page_size + 1)
    local edge_zone = math.max(MIN_SCROLL_EDGE_ZONE,
        math.floor(page_size * SCROLL_EDGE_ZONE_RATIO + 0.5))
    return current <= minimum + edge_zone,
        current >= reachable_maximum - edge_zone,
        reachable_maximum
end

local function truncate_utf8(value, max_characters)
    value = tostring(value or "")
    local byte_index = 1
    local characters = {}
    while byte_index <= #value and #characters < max_characters do
        local byte = value:byte(byte_index)
        local step = byte >= 240 and 4 or (byte >= 224 and 3 or (byte >= 192 and 2 or 1))
        characters[#characters + 1] = value:sub(byte_index, math.min(#value, byte_index + step - 1))
        byte_index = byte_index + step
    end
    if byte_index <= #value and #characters > 0 then
        while #characters > math.max(1, max_characters - 3) do table.remove(characters) end
        characters[#characters + 1] = "..."
    end
    return table.concat(characters)
end

local function nick_color(nick)
    local hash = 5381
    nick = tostring(nick or ""):lower()
    for index = 1, #nick do hash = (hash * 33 + string.byte(nick, index)) % 2147483647 end
    return NICK_COLORS[(hash % #NICK_COLORS) + 1]
end

local function signature_field(value)
    value = tostring(value or "")
    return tostring(#value) .. ":" .. value
end

local function message_list_signature(messages)
    local parts = { tostring(#messages) }
    for _, message in ipairs(messages) do
        parts[#parts + 1] = table.concat({
            signature_field(message.kind), signature_field(message.nick),
            signature_field(message.identity), signature_field(message.text),
            message.own == true and "1" or "0", message.mentioned == true and "1" or "0",
            signature_field(message.time), signature_field(message.date)
        }, "|")
    end
    return table.concat(parts, "\30")
end

local MAX_MESSAGE_VIEW_CACHE = 4

class "pf_irc_message_row" (CUIScriptWnd)

local function cursor_over_with_left_padding(window, padding)
    local cursor_ok, cursor = pcall(GetCursorPosition)
    if not cursor_ok or not cursor or not window then return false end
    local rect = Frect()
    local rect_ok = pcall(function() window:GetAbsoluteRect(rect) end)
    if not rect_ok then return false end
    return cursor.x >= rect.x1 - math.max(0, padding or 0) and cursor.x <= rect.x2 and
        cursor.y >= rect.y1 and cursor.y <= rect.y2
end

local function same_message_group(previous, current)
    if not previous or previous.kind ~= "chat" or current.kind ~= "chat" then return false end
    local previous_nick = tostring(previous.nick or ""):lower()
    local current_nick = tostring(current.nick or ""):lower()
    if previous_nick == "" or previous_nick ~= current_nick then return false end
    local previous_identity = tostring(previous.identity or ""):lower()
    local current_identity = tostring(current.identity or ""):lower()
    return previous_identity == "" or current_identity == "" or previous_identity == current_identity
end

function pf_irc_message_row:__init(owner, message, grouped, emoji_width, emoji_height, shared_xml, group_gap) super()
    self.owner = owner
    local xml = shared_xml or CScriptXmlInit()
    if not shared_xml then xml:ParseFile("pda_irc_chat.xml") end
    xml:InitWindow("message_row", 0, self)
    self.time = xml:InitTextWnd("message_row:time", self)
    self.nick = xml:InitTextWnd("message_row:nick", self)
    -- The mention button has its own compact hitbox before the nickname.
    self.mention_button = xml:Init3tButton("message_row:mention", self)
    -- Services such as ChanServ may arrive through the bridge with kind
    -- "system", but a non-empty sender still makes them ordinary chat rows.
    local has_sender = tostring(message.nick or "") ~= ""
    local is_system = message.kind == "system" and not has_sender
    self.body = xml:InitTextWnd(is_system and "message_row:system_body" or "message_row:body", self)
    local row_width = math.max(20, math.floor(self:GetWidth()))
    local show_header = has_sender and not grouped
    self.mention_nick = show_header and not message.own and tostring(message.nick or "") or ""
    self.mention_available = self.mention_nick ~= ""
    self.mention_button:Show(false)
    self.mention_button:Enable(self.mention_available)
    if self.mention_available then
        self:Register(self.mention_button, "mention_user")
        self:AddCallback("mention_user", ui_events.BUTTON_CLICKED, self.Mention, self)
    end
    self.time:SetText(has_sender and (show_header and (message.time or "") or "") or (message.time or ""))
    local nick_text = show_header and (message.nick .. ":") or ""
    self.nick:SetText(pf_irc_text_codec.to_ui(nick_text))
    local body_x = self.body:GetWndPos().x
    local nick_x = self.nick:GetWndPos().x
    local header_y = show_header and math.max(0, tonumber(group_gap) or 0) or 0
    local body_y = show_header and header_y + 16 or 0
    self.time:SetWndPos(vector2():set(self.time:GetWndPos().x, header_y))
    self.mention_button:SetWndPos(vector2():set(self.mention_button:GetWndPos().x, header_y))
    local body_width = math.max(20, row_width - body_x - 4)
    self.nick:SetWndPos(vector2():set(nick_x, header_y))
    self.nick:AdjustWidthToText()
    self.nick:AdjustHeightToText()
    local line_height = math.max(1, self.nick:GetHeight())
    local nick_width = show_header and math.ceil(self.nick:GetWidth() + 2) or 1
    nick_width = math.max(1, math.min(nick_width, row_width - nick_x - 4))
    self.nick:SetWndSize(vector2():set(nick_width, 18))
    self.body:SetWndPos(vector2():set(body_x, body_y))
    self.body:SetWndSize(vector2():set(body_width, 20))
    local raw_text = tostring(message.text or "")
    local needs_icons = pf_irc_emoji.plain_text(raw_text) ~= raw_text
    -- Do not send unsupported Unicode to the engine font, even for one frame.
    local native_text = pf_irc_text_codec.to_ui(raw_text):gsub("\r\n", "\n"):
        gsub("\r", "\n"):gsub("\n", "\\n")
    self.body:SetText(needs_icons and "" or native_text)
    self.body:AdjustHeightToText()
    local body_height = math.max(line_height, self.body:GetHeight())
    local row_height = body_y + body_height
    self.body:SetWndSize(vector2():set(body_width, body_height))
    self:SetWndSize(vector2():set(row_width, row_height))
    if message.nick and message.nick ~= "" then self.nick:SetTextColor(nick_color(message.nick)) end
    if message.kind == "error" then self.body:SetTextColor(GetARGB(255, 235, 90, 70)) end
    if message.kind == "warning" then self.body:SetTextColor(GetARGB(255, 235, 180, 70)) end
    if is_system then self.body:SetTextColor(GetARGB(255, 190, 195, 192)) end
    if message.mentioned == true then
        self.nick:SetTextColor(MENTION_COLOR)
        self.body:SetTextColor(MENTION_COLOR)
    end
    if needs_icons then
        local color = GetARGB(255, 210, 210, 210)
        if message.kind == "error" then color = GetARGB(255, 235, 90, 70)
        elseif message.kind == "warning" then color = GetARGB(255, 235, 180, 70)
        elseif is_system then color = GetARGB(255, 190, 195, 192) end
        if message.mentioned == true then color = MENTION_COLOR end
        self.rich_body = CUIStatic()
        self.rich_body:SetAutoDelete(true)
        self:AttachChild(self.rich_body)
        self.rich_body:SetWndPos(vector2():set(body_x, body_y))
        self.rich_body:SetWndSize(vector2():set(body_width, 20))
        self.rich_body:Enable(false)
        -- Match native text pitch; emoji must fit the same font cell.
        local icon_height = math.min(emoji_height or 14, line_height)
        local icon_width = (emoji_width or 14) * icon_height / (emoji_height or 14)
        self.rich_renderer = pf_irc_emoji_view.create(self.rich_body, GetFontLetterica16Russian(),
            icon_width, icon_height, line_height)
        body_height = self.rich_renderer:render(raw_text, body_width, color, { center = is_system })
        self.rich_body:SetWndSize(vector2():set(body_width, body_height))
        self:SetWndSize(vector2():set(row_width, body_y + body_height))
    end
    self:SetAutoDelete(false)
    self:Show(true)
    self:Enable(true)
end

function pf_irc_message_row:__finalize()
end

function pf_irc_message_row:Update()
    CUIScriptWnd.Update(self)
    if not self.mention_available then return end
    self.mention_button:Show(cursor_over_with_left_padding(self.nick,
        self.nick:GetWndPos().x - self.mention_button:GetWndPos().x) or
        self.mention_button:IsCursorOverWindow())
end

function pf_irc_message_row:Mention()
    if self.owner and self.mention_nick ~= "" then
        self.owner:InsertMention(self.mention_nick)
    end
end

class "pf_irc_dialog_row" (CUIScriptWnd)

function pf_irc_dialog_row:__init(owner, conversation, shared_xml) super()
    self.owner = owner
    local xml = shared_xml or CScriptXmlInit()
    if not shared_xml then xml:ParseFile("pda_irc_chat.xml") end
    xml:InitWindow("dialog_row", 0, self)
    self.selection = xml:InitStatic("dialog_row:selection", self)
    -- Use actual text windows. CUIStatic::SetTextColor did not reliably tint
    -- these embedded labels and made them nearly black on the PDA background.
    self.title = xml:InitTextWnd("dialog_row:title", self)
    self.title:SetEllipsis(true)
    self.title_width = self.title:GetWidth()
    self.unread = xml:InitTextWnd("dialog_row:unread", self)
    self.preview = xml:InitTextWnd("dialog_row:preview", self)
    self.preview:SetEllipsis(true)
    self.separator = xml:InitStatic("dialog_row:separator", self)
    self.select_button = xml:Init3tButton("dialog_row:select", self)
    self:Register(self.select_button, "select_dialog")
    self:AddCallback("select_dialog", ui_events.BUTTON_CLICKED, self.Select, self)
    self:ApplyConversation(conversation)
    self:SetAutoDelete(false)
    self:Show(true)
    self:Enable(true)
end

function pf_irc_dialog_row:ApplyConversation(conversation)
    self.key = conversation.key
    self.public = conversation.public == true
    self.channel_name = tostring(conversation.channel or "")
    self.dialog_nick = tostring(conversation.nick or "")
    self.ready = conversation.ready == true
    self.parted = conversation.parted == true
    self.channel_state = tostring(conversation.state or "")
    local title = tostring(conversation.nick or "")
    local unread = tonumber(conversation.unread) or 0
    -- Reserve the counter cell only while it is visible; otherwise use the XML width.
    local title_width = unread > 0 and math.min(self.title_width,
        self.unread:GetWndPos().x - self.title:GetWndPos().x - 2) or self.title_width
    self.title:SetWndSize(vector2():set(math.max(1, title_width), 21))
    self.active = conversation.active == true
    self.title:SetText(pf_irc_text_codec.to_ui(title))
    self.unread:SetText(unread > 0 and tostring(math.min(99, unread)) or "")
    self.unread:SetTextColor(GetARGB(255, 225, 165, 70))
    if conversation.public then
        self.title:SetTextColor(unread > 0 and GetARGB(255, 225, 165, 70) or
            GetARGB(255, 190, 195, 192))
    else
        -- Match the participant list's stable colour for this nickname.
        self.title:SetTextColor(nick_color(conversation.nick))
    end
    self.preview:SetText(pf_irc_text_codec.to_ui(
        pf_irc_emoji.plain_text(conversation.last_message)))
    self.preview:SetTextColor(unread > 0 and GetARGB(255, 215, 218, 212) or
        GetARGB(255, 165, 172, 170))
    self.selection:Show(self.active)
end

function pf_irc_dialog_row:__finalize()
end

function pf_irc_dialog_row:Update()
    CUIScriptWnd.Update(self)
    self.selection:Show(self.active or self.select_button:IsCursorOverWindow())
end

function pf_irc_dialog_row:Select()
    self.owner:SelectConversation(self.key)
end

class "pf_irc_user_row" (CUIScriptWnd)

local function participant_row_key(user)
    local identity = tostring(user and user.identity or ""):lower()
    if identity ~= "" then return "identity:" .. identity end
    return "nick:" .. tostring(user and user.nick or ""):lower()
end

function pf_irc_user_row:__init(owner, user, shared_xml) super()
    self.owner = owner
    local xml = shared_xml or CScriptXmlInit()
    if not shared_xml then xml:ParseFile("pda_irc_chat.xml") end
    xml:InitWindow("user_row", 0, self)
    self.presence = xml:InitStatic("user_row:presence", self)
    self.nick = xml:InitTextWnd("user_row:nick", self)
    self.nick:SetEllipsis(true)
    self.actions_button = xml:Init3tButton("user_row:actions", self)
    self.mute_button = xml:Init3tButton("user_row:mute", self)
    self.unmute_button = xml:Init3tButton("user_row:unmute", self)
    self.query_button = xml:Init3tButton("user_row:query", self)
    self:Register(self.actions_button, "user_actions")
    self:Register(self.mute_button, "mute_user")
    self:Register(self.unmute_button, "unmute_user")
    self:Register(self.query_button, "query_user")
    self:AddCallback("user_actions", ui_events.BUTTON_CLICKED, self.OpenActions, self)
    self:AddCallback("mute_user", ui_events.BUTTON_CLICKED, self.ToggleMute, self)
    self:AddCallback("unmute_user", ui_events.BUTTON_CLICKED, self.ToggleMute, self)
    self:AddCallback("query_user", ui_events.BUTTON_CLICKED, self.OpenQuery, self)
    self.actions_right = self.actions_button:GetWndPos().x + self.actions_button:GetWidth()
    self.actions_visible = false
    self:ApplyUser(user)
    self:SetAutoDelete(false)
    self:Show(true)
    self:Enable(true)
end

function pf_irc_user_row:__finalize()
end

function pf_irc_user_row:Update()
    CUIScriptWnd.Update(self)
end

function pf_irc_user_row:ApplyUser(user)
    self.row_key = participant_row_key(user)
    self.identity = tostring(user.identity or "")
    self.user_nick = tostring(user.nick or "")
    self.muted = user.muted == true

    local prefix = tostring(user.prefix or "")
    self.nick:SetText(pf_irc_text_codec.to_ui(prefix .. self.user_nick))
    local presence_color = GetARGB(255, 74, 186, 94)
    if user.presence == "away" then presence_color = GetARGB(255, 215, 155, 65)
    elseif user.presence == "offline" then presence_color = GetARGB(255, 205, 65, 55) end
    self.presence:SetTextureColor(presence_color)
    self.nick:SetTextColor(nick_color(self.user_nick))
    if self.muted then
        self.presence:SetTextureColor(GetARGB(255, 90, 95, 96))
        self.nick:SetTextColor(GetARGB(255, 105, 110, 112))
    end
    self:SetActionsVisible(self.actions_visible == true)
end

function pf_irc_user_row:SetActionsVisible(shown)
    self.actions_visible = shown == true
    local right = self.actions_visible and self.mute_button:GetWndPos().x or
        self.actions_button:GetWndPos().x
    self.nick:SetWndSize(vector2():set(math.max(1, right - self.nick:GetWndPos().x - 3),
        self.nick:GetHeight()))
    self.query_button:Show(self.actions_visible)
    self.query_button:Enable(self.actions_visible)
    self.mute_button:Show(self.actions_visible and not self.muted)
    self.mute_button:Enable(self.actions_visible and not self.muted)
    self.unmute_button:Show(self.actions_visible and self.muted)
    self.unmute_button:Enable(self.actions_visible and self.muted)
end

function pf_irc_user_row:SetActionRight(right)
    local delta = right - self.actions_button:GetWndPos().x - self.actions_button:GetWidth()
    for _, button in ipairs({self.actions_button, self.query_button, self.mute_button, self.unmute_button}) do
        button:SetWndPos(vector2():set(button:GetWndPos().x + delta, button:GetWndPos().y))
    end
    self:SetWndSize(vector2():set(right + 2, self:GetHeight()))
    self:SetActionsVisible(self.actions_visible)
end

function pf_irc_user_row:OpenActions()
    self.owner:ShowUserActions(self)
end

function pf_irc_user_row:ToggleMute()
    self.owner:ToggleSelectedUserMute()
end

function pf_irc_user_row:OpenQuery()
    self.owner:QuerySelectedUser()
end

class "pf_irc_profile_item" (CUIListBoxItem)

function pf_irc_profile_item:__init(profile_name, text_width) super(27)
    self.profile_name = tostring(profile_name or "")
    local text = self:GetTextItem()
    text_width = math.max(24, tonumber(text_width) or 120)
    text:SetWndPos(vector2():set(8, 0))
    text:SetWndSize(vector2():set(text_width - 12, 27))
    text:SetFont(GetFontLetterica16Russian())
    text:SetText(pf_irc_text_codec.to_ui(self.profile_name))
    self:SetTextColor(GetARGB(255, 195, 198, 192))
    text:SetEllipsis(true)
end

function pf_irc_profile_item:__finalize()
end

class "pf_irc_chat_tab" (CUIScriptWnd)

function pf_irc_chat_tab:__init() super()
    self.last_revision = -1
    self.last_page = ""
    self.last_layout = ""
    self.login_initialized = false
    self.message_rows = {}
    self.message_view_cache = {}
    self.message_view_clock = 0
    self.active_message_view = nil
    self.history_edge_direction = nil
    self.history_edge_conversation = nil
    self.history_scroll_anchor = nil
    self.pending_message_scroll_frames = 0
    self.user_rows = {}
    self.dialog_rows = {}
    self.user_action_target = nil
    self.user_action_identity = nil
    self.user_action_nick = nil
    self.user_actions_open = false
    self.pending_reset_profile = nil
    self.pending_delete_profile = nil
    self.pending_delete_conversation = nil
    self.pending_confirmation_action = nil
    self.settings_tab = "connection"
    self.settings_channels = {}
    self.settings_channel_index = 1
    self.last_input_scope = nil
    self.right_hint_target = nil
    self.right_hint_started_ms = 0
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    local xml = CScriptXmlInit()
    xml:ParseFile("pda_irc_chat.xml")
    self.row_xml = xml
    -- Use the same stock PDA frame hierarchy as the Direction Finder tab.
    -- Keeping the background as frames also preserves the native 4:3/16:9
    -- border geometry instead of stretching one add-on-owned bitmap.
    xml:InitFrame("frame1", self)
    xml:InitFrame("frame2", self)
    xml:InitFrame("border", self)

    self.login = xml:InitStatic("login", self)
    xml:InitTextWnd("login:hint", self.login)
    self.auto_login_label = xml:InitTextWnd("login:auto_login_label", self.login)
    -- Text fields are deliberately CUIStatic displays. A native CUIEditBox in
    -- this nested PDA tab leaves a stale parent keyboard-capture pointer after
    -- F9. The add-on-owned hitbox and pf_irc_input_field edit the same visible
    -- field without entering the engine capture chain.
    self.login_input = xml:InitStatic("login:nick", self.login)
    self.login_input_hitbox = xml:Init3tButton("login:nick_hitbox", self.login)
    self.authorize_button = xml:Init3tButton("login:authorize", self.login)
    self.auto_login = xml:InitCheck("login:auto_login", self.login)
    self.login_result = xml:InitTextWnd("login:result", self.login)
    self:Register(self.login_input_hitbox, "login_input_hitbox")
    self:Register(self.authorize_button, "authorize")
    self:Register(self.auto_login, "auto_login")
    self:AddCallback("login_input_hitbox", ui_events.BUTTON_CLICKED, self.BeginLoginInput, self)
    self:AddCallback("authorize", ui_events.BUTTON_CLICKED, self.AuthorizeFromButton, self)
    self:AddCallback("auto_login", ui_events.BUTTON_CLICKED, self.SaveAutoLoginPreference, self)

    self.chat = xml:InitStatic("chat", self)
    self.quick_channel_button = xml:Init3tButton("chat:quick_channel", self.chat)
    self.conversation_notifications_on_button = xml:Init3tButton(
        "chat:conversation_notifications_on", self.chat)
    self.conversation_notifications_off_button = xml:Init3tButton(
        "chat:conversation_notifications_off", self.chat)
    self.conversation_delete_button = xml:Init3tButton("chat:conversation_delete", self.chat)
    self.disconnect_button = xml:Init3tButton("chat:disconnect", self.chat)
