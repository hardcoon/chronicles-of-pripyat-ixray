    self.profile_list_toggle = xml:Init3tButton("settings:profile_list_toggle", self.settings)
    self.profile_delete = xml:Init3tButton("settings:profile_delete", self.settings)
    self.settings_channel_list = xml:InitListBox("settings:channels_list", self.settings)
    self.settings_channel_list:ShowSelectedItem(true)
    self.settings_channel_add = xml:Init3tButton("settings:channel_add", self.settings)
    self.settings_channel_delete = xml:Init3tButton("settings:channel_delete", self.settings)
    self.address_hitbox = xml:Init3tButton("settings:address_hitbox", self.settings)
    self.channel_hitbox = xml:Init3tButton("settings:channel_hitbox", self.settings)
    self.port_hitbox = xml:Init3tButton("settings:port_hitbox", self.settings)
    self.key_hitbox = xml:Init3tButton("settings:key_hitbox", self.settings)
    self.encoding_hitbox = xml:Init3tButton("settings:encoding_hitbox", self.settings)
    self.nick_hitbox = xml:Init3tButton("settings:nick_hitbox", self.settings)
    self.modes_hitbox = xml:Init3tButton("settings:modes_hitbox", self.settings)
    self.settings_result = xml:InitTextWnd("settings:result", self.settings)
    self.settings_save = xml:Init3tButton("settings:save", self.settings)
    self.settings_reset = xml:Init3tButton("settings:reset", self.settings)
    self.settings_close = xml:Init3tButton("settings:close", self.settings)
    self.settings_tab_connection:TextControl():SetText(
        translated_utf8("pf_irc_settings_tab_profile"))
    self.settings_reset:TextControl():SetText(
        translated_utf8("pf_irc_reset_settings_compact"))
    local setting_fields = {
        { "settings_profile", self.profile, self.profile_hitbox, 32, 46, self.FocusSettingsProfile },
        { "settings_address", self.address, self.address_hitbox, 253, 46, self.FocusSettingsAddress },
        { "settings_channel", self.channel, self.channel_hitbox, 64, 46, self.FocusSettingsChannel },
        { "settings_port", self.port, self.port_hitbox, 5, 12, self.FocusSettingsPort },
        { "settings_key", self.key, self.key_hitbox, 64, 46, self.FocusSettingsKey },
        { "settings_encoding", self.encoding, self.encoding_hitbox, 20, 46, self.FocusSettingsEncoding },
        { "settings_nick", self.nick, self.nick_hitbox, 30, 46, self.FocusSettingsNick },
        { "settings_modes", self.modes, self.modes_hitbox, 20, 46, self.FocusSettingsModes }
    }
    for _, item in ipairs(setting_fields) do
        self:Register(item[3], item[1] .. "_hitbox")
        self:AddCallback(item[1] .. "_hitbox", ui_events.BUTTON_CLICKED, item[6], self)
    end
    self:Register(self.tls, "settings_tls")
    self:Register(self.guard, "settings_guard")
    self:Register(self.channel_show, "settings_channel_show")
    self:Register(self.key_show, "settings_key_show")
    local notification_checks = {
        { self.public_notify, "settings_public_notify" },
        { self.public_sound, "settings_public_sound" },
        { self.private_notify, "settings_private_notify" },
        { self.private_sound, "settings_private_sound" }
    }
    for _, item in ipairs(notification_checks) do
