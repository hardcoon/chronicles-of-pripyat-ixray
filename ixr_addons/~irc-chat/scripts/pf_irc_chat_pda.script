        self.AddSettingsChannel, self)
    self:AddCallback("settings_channel_delete", ui_events.BUTTON_CLICKED,
        self.DeleteSettingsChannel, self)
    -- All confirmations stay inside the PDA. Native CUIMessageBoxEx dialogs
    -- are styled as global game windows and may also retain their own input
    -- capture while this script-owned tab is being detached for F9.
    self.pda_confirmation_shade = xml:InitStatic("delete_conversation_shade", self)
    self.pda_confirmation_popup = xml:InitStatic("delete_conversation_popup", self)
    xml:InitFrameLine("delete_conversation_popup:top", self.pda_confirmation_popup)
    xml:InitFrameLine("delete_conversation_popup:bottom", self.pda_confirmation_popup)
    xml:InitFrameLine("delete_conversation_popup:left", self.pda_confirmation_popup)
    xml:InitFrameLine("delete_conversation_popup:right", self.pda_confirmation_popup)
    self.pda_confirmation_message = xml:InitTextWnd(
        "delete_conversation_popup:message", self.pda_confirmation_popup)
    self.pda_confirmation_confirm = xml:Init3tButton(
        "delete_conversation_popup:confirm", self.pda_confirmation_popup)
    self.pda_confirmation_cancel = xml:Init3tButton(
        "delete_conversation_popup:cancel", self.pda_confirmation_popup)
    self:Register(self.pda_confirmation_confirm, "pda_confirmation_confirm")
    self:Register(self.pda_confirmation_cancel, "pda_confirmation_cancel")
    self:AddCallback("pda_confirmation_confirm", ui_events.BUTTON_CLICKED,
        self.ConfirmPdaConfirmation, self)
    self:AddCallback("pda_confirmation_cancel", ui_events.BUTTON_CLICKED,
        self.CancelPdaConfirmation, self)
    self.pda_confirmation_confirm:TextControl():SetText(
        translated_utf8("pf_irc_confirm_yes"))
    self.pda_confirmation_cancel:TextControl():SetText(
        translated_utf8("pf_irc_confirm_no"))
    self.pda_confirmation_popup:Show(false)
    self.pda_confirmation_popup:Enable(false)
    self.pda_confirmation_shade:Show(false)
    self.pda_confirmation_shade:Enable(false)

    -- CUIPropertiesBox::Show is broken in this Anomaly build. Profiles use a
    -- normal add-on-owned list panel, with scrolling for an arbitrary count.
    self.profile_popup = xml:InitStatic("settings:profile_popup", self.settings)
    self.profile_list = xml:InitListBox("settings:profile_popup:list", self.profile_popup)
    self.profile_list:ShowSelectedItem(true)
    self:Register(self.profile_list, "settings_profile_list")
    self:AddCallback("settings_profile_list", ui_events.LIST_ITEM_CLICKED, self.SelectProfileFromList, self)
    self.profile_popup:Show(false)
    self.profile_popup:Enable(false)

    -- CUIPropertiesBox::Show is misbound in this IX-Ray build: its native
    -- Frect/Fvector2 method is exported to Lua as (int, int), while forcing the
    -- base CUIWindow::Show path ends in a pure-virtual call. The IRC command
    -- list is intentionally a normal add-on-owned panel instead.
    self.command_menu = xml:InitStatic("command_popup", self)
    local command_menu_position = self.command_menu:GetWndPos()
    self.command_menu_x = command_menu_position.x
    self.command_menu_bottom_y = command_menu_position.y + self.command_menu:GetHeight()
    self.command_clear = xml:Init3tButton("command_popup:clear", self.command_menu)
    self.command_query = xml:Init3tButton("command_popup:query", self.command_menu)
    self.command_mute = xml:Init3tButton("command_popup:mute", self.command_menu)
    self.command_unmute = xml:Init3tButton("command_popup:unmute", self.command_menu)
    self.command_close = xml:Init3tButton("command_popup:close", self.command_menu)
    self.command_channel = xml:Init3tButton("command_popup:channel", self.command_menu)
    self.command_buttons = {
        clear = self.command_clear,
        query = self.command_query,
        mute = self.command_mute,
        unmute = self.command_unmute,
        close = self.command_close,
        channel = self.command_channel
    }
    self.command_templates = {}
    local command_buttons = {
        { self.command_clear, "command_clear", self.InsertClearCommand },
        { self.command_query, "command_query", self.InsertQueryCommand },
        { self.command_mute, "command_mute", self.InsertMuteCommand },
        { self.command_unmute, "command_unmute", self.InsertUnmuteCommand },
        { self.command_close, "command_close", self.InsertCloseCommand },
        { self.command_channel, "command_channel", self.InsertChannelCommand }
    }
    for _, item in ipairs(command_buttons) do
        self:Register(item[1], item[2])
        self:AddCallback(item[2], ui_events.BUTTON_CLICKED, item[3], self)
    end
    self.command_menu:Show(false)
    self.command_menu:Enable(false)

    self.quick_channel_popup = xml:InitStatic("quick_channel_popup", self)
    xml:InitTextWnd("quick_channel_popup:caption", self.quick_channel_popup)
    xml:InitTextWnd("quick_channel_popup:channel_label", self.quick_channel_popup)
    xml:InitTextWnd("quick_channel_popup:key_label", self.quick_channel_popup)
    self.quick_channel_name = xml:InitStatic("quick_channel_popup:channel", self.quick_channel_popup)
