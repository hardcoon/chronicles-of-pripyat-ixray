    self.right_button_hint = xml:InitStatic("right_button_hint", self)
    self.right_button_hint_text = xml:InitTextWnd(
        "right_button_hint:description", self.right_button_hint)
    self.right_button_hint:Show(false)
    self.right_button_hint:Enable(false)
    self.right_button_hints = {
        { key = "quick_channel", button = self.quick_channel_button,
            text_id = "pf_irc_quick_channel_hint", hint_x = 533 },
        { key = "conversation_notifications_on",
            button = self.conversation_notifications_on_button,
            text_id = "pf_irc_disable_conversation_notifications_hint", utf8 = true,
            hint_x = 573 },
        { key = "conversation_notifications_off",
            button = self.conversation_notifications_off_button,
            text_id = "pf_irc_enable_conversation_notifications_hint", utf8 = true,
            hint_x = 573 },
        { key = "conversation_delete", button = self.conversation_delete_button,
            text_id = "pf_irc_delete_conversation_hint", hint_x = 613 },
        { key = "settings", button = self.settings_button,
            text_id = "pf_irc_settings_hint", hint_x = 653 }
    }

    self.input_fields = pf_irc_input_field.create()
    self.input_fields:bind("login", "login", self.login_input, self.login_input_hitbox, 30, 30)
    self.input_fields:bind("chat", "chat", self.input, self.chat_input_hitbox, 500, 68)
    self.input_fields:set_renderer("chat", function(text, caret, select_all)
        self.composer_renderer:render(text, self.composer:GetWidth(), GetARGB(255, 185, 185, 185),
            { single_line = true, caret = caret, select_all = select_all })
    end)
    self.input_fields:add_focus_region("chat", self.emoji_panel)
    self.input_fields:add_focus_region("chat", self.emoji_toggle)
    self.input_fields:add_focus_region("chat", self.layout_hitbox)
    for _, item in ipairs(setting_fields) do
        self.input_fields:bind(item[1], "settings", item[2], item[3], item[4], item[5])
    end
    self.input_fields:bind("quick_channel_name", "chat", self.quick_channel_name,
        self.quick_channel_name_hitbox, 64, 28)
    self.input_fields:bind("quick_channel_key", "chat", self.quick_channel_key,
        self.quick_channel_key_hitbox, 64, 28)
    self.settings:Show(false)
    self.settings_shade:Show(false)
    self:SyncLoginFromProfile()
    self:Refresh(true)
end

function pf_irc_chat_tab:__finalize()
    if self.input_fields then self.input_fields:shutdown() end
end

function pf_irc_chat_tab:HideRightButtonHint()
    if self.right_button_hint then self.right_button_hint:Show(false) end
    self.right_hint_target = nil
    self.right_hint_started_ms = 0
end

function pf_irc_chat_tab:ShowRightButtonHint(item)
    if not item or not item.button or not self.right_button_hint then return end
    self.right_button_hint_text:SetText(item.utf8 and translated_utf8(item.text_id) or
        translated(item.text_id))
    -- These four controls have fixed PDA coordinates. Keeping the tooltip in
    -- the same coordinate system avoids the unreliable nested absolute-rect
    -- conversion and guarantees that it opens to the left of its button.
    local hint_y = 140
    if item.follow_button_y then
        local rect = Frect()
        local rect_ok = pcall(function() item.button:GetAbsoluteRect(rect) end)
        if rect_ok then
            -- Vertically centre the 52 px panel against the participant's
            -- 24 px action button and keep it within the PDA chat frame.
            hint_y = math.max(190, math.min(630, rect.y1 - 14))
        end
    end
    self.right_button_hint:SetWndPos(vector2():set(item.hint_x or 573, hint_y))
    self.right_button_hint:Show(true)
end

function pf_irc_chat_tab:UpdateRightButtonHint()
    if not self.right_button_hint then return end
    local scope = self:InputScope()
    if (scope ~= "chat" and scope ~= "login") or self.settings:IsShown() or
        self.quick_channel_popup:IsShown() or self.command_menu:IsShown() or
        (self.pda_confirmation_popup and self.pda_confirmation_popup:IsShown()) then
        self:HideRightButtonHint()
        return
    end

    local hovered = nil
    for _, item in ipairs(self.right_button_hints or {}) do
        local ok, over = pcall(function()
            return item.button:IsShown() and item.button:IsCursorOverWindow()
        end)
        if ok and over then
            hovered = item
            break
        end
    end
    if not hovered and self.user_actions_open and self.user_action_target then
        local row = self.user_action_target
        local user_hints = {
            { key = "user_mute", button = row.mute_button,
                text_id = "pf_irc_mute", hint_x = 603, follow_button_y = true },
            { key = "user_unmute", button = row.unmute_button,
                text_id = "pf_irc_unmute", hint_x = 603, follow_button_y = true },
            { key = "user_query", button = row.query_button,
                text_id = "pf_irc_query_hint", hint_x = 629, follow_button_y = true }
        }
        for _, item in ipairs(user_hints) do
            local ok, over = pcall(function()
                return item.button:IsShown() and item.button:IsCursorOverWindow()
            end)
            if ok and over then
                hovered = item
                break
            end
        end
    end
    if not hovered then
        self:HideRightButtonHint()
        return
    end

    local now = time_global and time_global() or 0
    if self.right_hint_target ~= hovered.key then
        self.right_hint_target = hovered.key
        self.right_hint_started_ms = now
        self.right_button_hint:Show(false)
        return
    end
    if now - self.right_hint_started_ms >= RIGHT_BUTTON_HINT_DELAY_MS then
        self:ShowRightButtonHint(hovered)
    end
end

function pf_irc_chat_tab:Update()
    if self.pf_restore_active_section then
        finish_active_section_restore(self)
    end
    CUIScriptWnd.Update(self)
    self:Pulse()
    if self.pending_message_scroll_frames > 0 and self.messages then
        -- CUIScrollView recalculates its maximum only after the newly rebuilt
        -- rows have passed through a native UI frame. Repeat the request in
        -- the following frame so a view that was already at the bottom stays
        -- attached to the real, newly extended bottom.
        self.messages:ScrollToEnd()
        self.pending_message_scroll_frames = self.pending_message_scroll_frames - 1
    end
    self:UpdateRightButtonHint()
end

function pf_irc_chat_tab:Pulse()
    local state = pf_irc_chat.get_state()
    if state.revision ~= self.last_revision then self:Refresh(false) end
    self:PollHistoryPaging(state)
    local scope = self:InputScope()
    if scope ~= self.last_input_scope then
        self:ReleaseInlineInput()
        self.last_input_scope = scope
        if scope == "login" then self:BeginLoginInput()
        elseif scope == "chat" then self:BeginChatInput() end
    end
    if self.input_fields then
        local action, field_name = self.input_fields:update(scope)
        if action then self:HandleInlineInputAction(action, field_name) end
    end
    local layout = pf_irc_input_field.keyboard_layout()
    if layout ~= self.last_layout then
        self.last_layout = layout
        self.layout:SetText(layout)
    end
end

function pf_irc_chat_tab:PollHistoryPaging(state)
    if not state.chat_open or not self.messages then return end
    local ok, minimum, maximum, current = pcall(function()
        return self.messages:GetMinScrollPos(), self.messages:GetMaxScrollPos(),
            self.messages:GetCurrentScrollPos()
    end)
    if not ok then return end
    local at_top, at_bottom, reachable_maximum =
        scroll_edge_state(self.messages, minimum, maximum, current)
    if pf_irc_chat.set_history_follow_latest then
        pf_irc_chat.set_history_follow_latest(state.active_conversation, at_bottom)
    end
    if reachable_maximum <= minimum then
        self.history_edge_direction = nil
        return
    end
    local direction = nil
    if state.history_has_older and at_top then direction = "older"
    elseif state.history_has_newer and at_bottom then direction = "newer" end
    if not direction then
        self.history_edge_direction = nil
        self.history_edge_conversation = state.active_conversation
        return
    end
    if self.history_edge_direction == direction and
        self.history_edge_conversation == state.active_conversation then return end
    self.history_edge_direction = direction
    self.history_edge_conversation = state.active_conversation
    self.history_scroll_anchor = {
        direction = direction, conversation = state.active_conversation,
        position = current, maximum = maximum
    }
    local loaded = pf_irc_chat.load_message_page(direction)
    if loaded then self:Refresh(false) else self.history_scroll_anchor = nil end
end

function pf_irc_chat_tab:InputScope()
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu() or nil
    if not pda_menu or pda_menu:GetActiveSection() ~= "eptChat" then return nil end
    local state_ok, shown, enabled = pcall(function()
        return pda_menu:IsShown(), pda_menu:IsEnabled()
    end)
    if not state_ok or not shown or not enabled then return nil end
    if self.settings:IsShown() then return "settings" end
    if self.login:IsShown() then return "login" end
    if self.chat:IsShown() then return "chat" end
    return nil
end

function pf_irc_chat_tab:BeginLoginInput()
    if self.settings:IsShown() or self.login:IsShown() ~= true then return end
    self.input_fields:focus("login")
end

function pf_irc_chat_tab:BeginChatInput()
    if self.settings:IsShown() or self.chat:IsShown() ~= true then return end
    self.input_fields:focus("chat")
end

function pf_irc_chat_tab:ToggleInputLayout()
    if self:InputScope() ~= "chat" then return end
    local layout = pf_irc_input_field.toggle_keyboard_layout()
    self.last_layout = layout
    self.layout:SetText(layout)
    self:BeginChatInput()
end

function pf_irc_chat_tab:ToggleEmojiPanel()
    if self:InputScope() ~= "chat" then return end
    local shown = not self.emoji_panel:IsShown()
    self.emoji_panel:Show(shown)
    self.emoji_panel:Enable(shown)
    -- Selecting an emoji keeps the panel open; successful Send closes it.
end

function pf_irc_chat_tab:InsertEmoji(text)
    if self:InputScope() ~= "chat" then return end
    self.input_fields:insert("chat", text)
end

function pf_irc_chat_tab:HideQuickChannel()
    if not self.quick_channel_popup then return end
    local active = self.input_fields and self.input_fields:active_field() or nil
    if active == "quick_channel_name" or active == "quick_channel_key" then
        self.input_fields:blur()
    end
    self.quick_channel_popup:Show(false)
    self.quick_channel_popup:Enable(false)
end

function pf_irc_chat_tab:ShowQuickChannelFromButton()
    self:ReleaseInlineInput()
    self:HideCommandMenu()
    self:HideUserActions()
    self:HideProfileList()
    self.input_fields:set_text("quick_channel_name", "#")
    self.input_fields:set_text("quick_channel_key", "")
    self.quick_channel_result:SetText("")
    self.quick_channel_popup:Show(true)
    self.quick_channel_popup:Enable(true)
    self.input_fields:focus_from_click("quick_channel_name")
end

function pf_irc_chat_tab:HideQuickChannelFromButton()
    self:HideQuickChannel()
    self:BeginChatInput()
end

function pf_irc_chat_tab:FocusQuickChannelName()
    if self.quick_channel_popup:IsShown() then self.input_fields:focus("quick_channel_name") end
end

function pf_irc_chat_tab:FocusQuickChannelKey()
    if self.quick_channel_popup:IsShown() then self.input_fields:focus("quick_channel_key") end
end

function pf_irc_chat_tab:ConnectQuickChannel()
    local name = self.input_fields:get_text("quick_channel_name")
    local key = self.input_fields:get_text("quick_channel_key")
    self:ReleaseInlineInput()
    local ok, error_code = pf_irc_chat.add_temporary_channel(name, key)
    if not ok then
        self.quick_channel_result:SetText(error_text(error_code, ""))
        self.input_fields:focus("quick_channel_name")
        return
    end
    self:HideQuickChannel()
    self:Refresh(true)
    self:BeginChatInput()
end

function pf_irc_chat_tab:ConnectQuickChannelFromButton()
    self:ConnectQuickChannel()
end

function pf_irc_chat_tab:HideProfileList()
    if not self.profile_popup then return end
    self.profile_popup:Show(false)
    self.profile_popup:Enable(false)
end

function pf_irc_chat_tab:RefreshProfileList()
    self.profile_list:RemoveAll()
    for _, profile_name in ipairs(pf_irc_chat.list_profiles()) do
        self.profile_list:AddExistingItem(pf_irc_profile_item(profile_name, 420))
    end
end

function pf_irc_chat_tab:ToggleProfileList()
    self:ReleaseInlineInput()
    if self.profile_popup:IsShown() then
        self:HideProfileList()
        return
    end
    self:RefreshProfileList()
    self.profile_popup:Show(true)
    self.profile_popup:Enable(true)
end

function pf_irc_chat_tab:SelectProfileFromList()
    local item = self.profile_list:GetSelectedItem()
    local profile_name = item and tostring(item.profile_name or "") or ""
    if profile_name == "" then return end
    self:HideProfileList()
    local profile = pf_irc_chat_config.get_profile(profile_name)
    if self:FillProfile(profile_name, profile) then
        ui_trace(string.format("settings profile selected name=%s address=%s port=%s",
            profile_name, tostring(profile.address or ""), tostring(profile.port or "")))
        self.settings_result:SetText(translated("pf_irc_profile_selected"))
    end
end

function pf_irc_chat_tab:FocusSettingsProfile()
    self:HideProfileList()
    self.input_fields:focus("settings_profile")
end
function pf_irc_chat_tab:FocusSettingsAddress()
    self:HideProfileList()
    self.input_fields:focus("settings_address")
end
function pf_irc_chat_tab:FocusSettingsChannel()
    self:HideProfileList()
    self.channel_show:SetCheck(true)
    self:RefreshSensitiveSettings()
    self.input_fields:focus("settings_channel")
end
function pf_irc_chat_tab:FocusSettingsPort()
    self:HideProfileList()
    self.input_fields:focus("settings_port")
end
function pf_irc_chat_tab:FocusSettingsKey()
    self:HideProfileList()
    self.key_show:SetCheck(true)
    self:RefreshSensitiveSettings()
    self.input_fields:focus("settings_key")
end
function pf_irc_chat_tab:FocusSettingsEncoding()
    self:HideProfileList()
    self.input_fields:focus("settings_encoding")
end
function pf_irc_chat_tab:FocusSettingsNick()
    self:HideProfileList()
    self.input_fields:focus("settings_nick")
end
function pf_irc_chat_tab:FocusSettingsModes()
    self:HideProfileList()
    self.input_fields:focus("settings_modes")
end

function pf_irc_chat_tab:ReleaseInlineInput()
    if self.input_fields then self.input_fields:blur() end
end

function pf_irc_chat_tab:HideUserActions()
    if self.user_action_target then self.user_action_target:SetActionsVisible(false) end
    self.user_action_target = nil
    self.user_action_identity = nil
    self.user_action_nick = nil
    self.user_actions_open = false
end

function pf_irc_chat_tab:FindUserActionRow()
    local wanted_identity = tostring(self.user_action_identity or ""):lower()
    local wanted_nick = tostring(self.user_action_nick or ""):lower()
    for _, row in ipairs(self.user_rows) do
        local row_identity = tostring(row.identity or ""):lower()
        local row_nick = tostring(row.user_nick or ""):lower()
        if (wanted_identity ~= "" and row_identity == wanted_identity) or
            (wanted_nick ~= "" and row_nick == wanted_nick) then
            return row
        end
    end
    return nil
end

function pf_irc_chat_tab:RebindUserActionTarget()
    if not self.user_actions_open then return false end
    local row = self:FindUserActionRow()
    if not row then
        self:HideUserActions()
        return false
    end
    self.user_action_target = row
    self.user_action_identity = row.identity
    self.user_action_nick = row.user_nick
    row:SetActionsVisible(true)
    return true
end

function pf_irc_chat_tab:ShowUserActions(row)
    self:ReleaseInlineInput()
    self:HideQuickChannel()
    self:HideCommandMenu()
    local current_key = self.user_action_target and tostring(self.user_action_target.row_key or "") or ""
    local selected_key = tostring(row.row_key or "")
    if self.user_actions_open and current_key ~= "" and current_key == selected_key then
        self:HideUserActions()
        self:BeginChatInput()
        return
    end
    if self.user_action_target then self.user_action_target:SetActionsVisible(false) end
    self.user_action_target = row
    self.user_action_identity = row.identity
    self.user_action_nick = row.user_nick
    self.user_actions_open = true
    row:SetActionsVisible(true)
end

function pf_irc_chat_tab:QuerySelectedUser()
    local row = self.user_action_target
    if not row then return end
    local nick, identity = row.user_nick, row.identity
    self:HideUserActions()
    self:OpenQuery(nick, identity)
end

function pf_irc_chat_tab:ToggleSelectedUserMute()
    local row = self.user_action_target
    if not row then return end
    local identity, nick, muted = row.identity, row.user_nick, row.muted
    self:HideUserActions()
    if identity == "" then
        self.status_value:SetText(error_text("identity_missing", ""))
        self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
        self:BeginChatInput()
        return
    end
    local ok, error_code
    if muted then ok, error_code = pf_irc_chat.unmute(identity)
    else ok, error_code = pf_irc_chat.mute(identity, nick) end
    self:Refresh(true)
    if not ok then
        self.status_value:SetText(error_text(error_code, ""))
        self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
    end
    self:BeginChatInput()
end

function pf_irc_chat_tab:RefreshSensitiveSettings()
    local channel_value = static_get_text(self.channel)
    local key_value = static_get_text(self.key)
    local show_channel = self.channel_show:GetCheck() == true
    local show_key = self.key_show:GetCheck() == true
    static_set_text(self.channel_mask, channel_value == "" and "" or string.rep("*", #channel_value))
    static_set_text(self.key_mask, key_value == "" and "" or string.rep("*", #key_value))
    local channel_page = self.settings_tab == "channels"
    self.channel:Show(channel_page and show_channel)
    self.channel_mask:Show(channel_page and not show_channel)
    self.key:Show(channel_page and show_key)
    self.key_mask:Show(channel_page and not show_key)
end

function pf_irc_chat_tab:RefreshSettingsDeletionState()
    local profile_count = #(pf_irc_chat_config.list_profiles() or {})
    local profile_deletable = self.settings_profile_deletable ~= false
    self.profile_delete:Enable(profile_deletable and profile_count > 1)
    local channel = self.settings_channels[self.settings_channel_index or 1]
    self.settings_channel_delete:Enable(#self.settings_channels > 1 and channel ~= nil and
        pf_irc_chat_config.is_channel_deletable(self.settings_loaded_profile_name, channel.name))
end

function pf_irc_chat_tab:ToggleSensitiveSettings()
    self:ReleaseInlineInput()
    self:HideProfileList()
    self:RefreshSensitiveSettings()
end

function pf_irc_chat_tab:OnLoginEditCommit()
    if self.input_fields:commit("login") then self:Authorize() end
end

function pf_irc_chat_tab:OnLoginEditCancel()
    self.input_fields:cancel("login")
end

function pf_irc_chat_tab:OnChatEditCommit()
    if self.input_fields:commit("chat") then self:Send() end
end

function pf_irc_chat_tab:OnChatEditCancel()
    self.input_fields:cancel("chat")
end

function pf_irc_chat_tab:OnProfileEditCommit()
    self.input_fields:commit("settings_profile")
    self:LoadSelectedProfile()
end

function pf_irc_chat_tab:OnSettingsEditCommit()
    self:ReleaseInlineInput()
end

function pf_irc_chat_tab:OnSettingsEditCancel()
    self:ReleaseInlineInput()
end

function pf_irc_chat_tab:HandleInlineInputAction(action, field_name)
    if action == "cancel" then
        self.input_fields:cancel(field_name)
        if field_name == "quick_channel_name" or field_name == "quick_channel_key" then
            self:HideQuickChannel()
        end
        return
    end
    if action ~= "commit" then return end
    if field_name == "login" then
        self:OnLoginEditCommit()
    elseif field_name == "chat" then
        self:OnChatEditCommit()
    elseif field_name == "settings_profile" then
        self:OnProfileEditCommit()
    elseif field_name == "quick_channel_name" then
        self.input_fields:commit(field_name)
        self.input_fields:focus("quick_channel_key")
    elseif field_name == "quick_channel_key" then
        self.input_fields:commit(field_name)
        self:ConnectQuickChannel()
    else
        self.input_fields:commit(field_name)
    end
end

function pf_irc_chat_tab:Refresh(force)
    local state = pf_irc_chat.get_state()
    if not force and state.revision == self.last_revision then return end
    self.last_revision = state.revision
    local page = state.chat_open and "chat" or "login"
    self.chat:Show(page == "chat")
    self.login:Show(page == "login")
    self.authorize_button:Enable(not state.authorized)

    if page == "login" then
        if state.authorized then
            self.login_result:SetText(translated(STATUS_TEXT[state.status] or "pf_irc_status_authorizing"))
            self.login_result:SetTextColor(GetARGB(255, 220, 175, 70))
        elseif state.last_error_code or state.last_error then
            self.login_result:SetText(error_text(state.last_error_code, state.last_error))
            self.login_result:SetTextColor(GetARGB(255, 235, 95, 75))
        else
            self.login_result:SetText("")
        end
    else
        self:RefreshChat(state)
    end

    if self.last_page ~= page then
        self:ReleaseInlineInput()
        self:HideQuickChannel()
        self:HideUserActions()
        self.last_page = page
        if page == "chat" and state.ready then pcall(pf_irc_chat.request_user_sync) end
    end
end

function pf_irc_chat_tab:TouchMessageView(entry)
    self.message_view_clock = self.message_view_clock + 1
    entry.last_used = self.message_view_clock
end

function pf_irc_chat_tab:TrimMessageViewCache(active_key)
    local count = 0
    for _ in pairs(self.message_view_cache) do count = count + 1 end
    while count > MAX_MESSAGE_VIEW_CACHE do
        local oldest_key, oldest_clock = nil, nil
        for key, entry in pairs(self.message_view_cache) do
            if key ~= active_key and (not oldest_clock or entry.last_used < oldest_clock) then
                oldest_key, oldest_clock = key, entry.last_used
            end
        end
        if not oldest_key then return end
        self.message_view_cache[oldest_key] = nil
        count = count - 1
    end
end

function pf_irc_chat_tab:ShowMessageView(conversation_key, messages, signature)
    local key = tostring(conversation_key or "channel")
    local entry = self.message_view_cache[key]
    if self.active_message_view == key and entry and entry.signature == signature then
        self.message_rows = entry.rows
        self:TouchMessageView(entry)
        return
    end

    local same_view = self.active_message_view == key
    local old_minimum = self.messages:GetMinScrollPos()
    local old_position = self.messages:GetCurrentScrollPos()
    local old_maximum = self.messages:GetMaxScrollPos()
    local _, was_at_bottom = scroll_edge_state(
        self.messages, old_minimum, old_maximum, old_position)
    local paging_anchor = self.history_scroll_anchor and
        self.history_scroll_anchor.conversation == key
    self.messages:Clear()
    if not entry or entry.signature ~= signature then
        entry = { signature = signature, rows = {}, last_used = 0 }
        local previous_message = nil
        for _, message in ipairs(messages) do
            local grouped = same_message_group(previous_message, message)
            local group_gap = previous_message and not grouped and 2 or 0
            local row = pf_irc_message_row(self, message, grouped, self.emoji_width, self.emoji_height,
                self.row_xml, group_gap)
            table.insert(entry.rows, row)
            previous_message = message
        end
        self.message_view_cache[key] = entry
    end

    for _, row in ipairs(entry.rows) do
        -- Message rows are detached and reused when the player switches
        -- conversations. Giving CUIScrollView ownership here makes Clear()
        -- destroy a cached native window and leaves Lua holding a dangling
        -- pointer; the next UI frame then crashes in CDialogHolder::OnFrame.
        row:SetAutoDelete(false)
        self.messages:AddWindow(row, false)
    end
    self.message_rows = entry.rows
    self.active_message_view = key
    self:TouchMessageView(entry)
    self:TrimMessageViewCache(key)
    if not same_view or (was_at_bottom and not paging_anchor) then
        self.pending_message_scroll_frames = 2
        self.messages:ScrollToEnd()
    else
        self.messages:SetScrollPos(old_position)
    end
end

function pf_irc_chat_tab:RefreshChat(state)
    local status_id = STATUS_TEXT[state.status] or "pf_irc_status_unknown"
    self.status_value:SetText(translated(status_id))
    if state.status == "ready" then self.status_value:SetTextColor(GetARGB(255, 80, 220, 105))
    elseif state.status == "error" or state.status == "blocked" then self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
    else self.status_value:SetTextColor(GetARGB(255, 225, 175, 65)) end
    local shown_nick = state.effective_nick ~= "" and state.effective_nick or state.requested_nick
    self.actual_nick:SetText(translated("pf_irc_actual_nick") .. ": " ..
        pf_irc_text_codec.to_ui(shown_nick or ""))
    self.topic:SetText((state.topic and state.topic ~= "") and
        (translated("pf_irc_topic") .. ": " ..
            pf_irc_text_codec.to_ui(pf_irc_emoji.plain_text(state.topic))) or "")
    -- A state revision can rebuild the rows while the player is browsing the
    -- lower part of either side list. Preserve both native scroll positions so
    -- selecting a dialog or receiving an IRC update does not jump to the top.
    local users_scroll = self.users:GetCurrentScrollPos()

    self.private_dialogs:Show(true)
    self.private_dialogs:Enable(true)
    local conversations = pf_irc_chat.get_conversations()
    local active_conversation = nil
    for _, conversation in ipairs(conversations) do
        if conversation.active then
            active_conversation = conversation
            break
        end
    end
    self.quick_channel_button:Enable(state.authorized == true)
    local notification_button_enabled = active_conversation ~= nil
    local notifications_disabled = state.conversation_notifications_disabled == true
    self.conversation_notifications_on_button:Show(not notifications_disabled)
    self.conversation_notifications_on_button:Enable(
        notification_button_enabled and not notifications_disabled)
    self.conversation_notifications_off_button:Show(notifications_disabled)
    self.conversation_notifications_off_button:Enable(
        notification_button_enabled and notifications_disabled)
    self.conversation_delete_button:Enable(active_conversation ~= nil and
        (not active_conversation.public or active_conversation.deletable ~= false))
    self.disconnect_button:Enable(state.authorized == true)
    local rebuild_dialogs = #conversations ~= #self.dialog_rows
    if not rebuild_dialogs then
        for index, conversation in ipairs(conversations) do
            if not self.dialog_rows[index] or self.dialog_rows[index].key ~= conversation.key then
                rebuild_dialogs = true
                break
            end
        end
    end
    if rebuild_dialogs then
        local private_scroll = self.private_dialogs:GetCurrentScrollPos()
        self.private_dialogs:Clear()
        self.dialog_rows = {}
        for _, conversation in ipairs(conversations) do
            local row = pf_irc_dialog_row(self, conversation, self.row_xml)
            self.private_dialogs:AddWindow(row, true)
            row:SetAutoDelete(false)
            table.insert(self.dialog_rows, row)
        end
        self.private_dialogs:SetScrollPos(private_scroll)
    else
        for index, conversation in ipairs(conversations) do
            self.dialog_rows[index]:ApplyConversation(conversation)
        end
    end

    self.messages:Show(true)
    self.messages:Enable(true)
    local messages = pf_irc_chat.get_messages()
    local message_signature = message_list_signature(messages)
    self:ShowMessageView(state.active_conversation, messages, message_signature)
    local anchor = self.history_scroll_anchor
    if anchor and anchor.conversation == state.active_conversation then
        if anchor.direction == "older" then
            local new_maximum = self.messages:GetMaxScrollPos()
            self.messages:SetScrollPos(anchor.position + (new_maximum - anchor.maximum))
        else
            self.messages:SetScrollPos(anchor.position)
        end
        self.history_scroll_anchor = nil
    end
    local visible_users = pf_irc_chat.get_visible_users()
    self.users_caption:SetText(string.format(translated("pf_irc_participants_count"), #visible_users))
    self:RefreshUsers(visible_users)
    self.users:SetScrollPos(users_scroll)
end

function pf_irc_chat_tab:RefreshUsers(user_list)
    self.users:Show(true)
    self.users:Enable(true)

    local rebuild = #user_list ~= #self.user_rows
    if not rebuild then
        for index, user in ipairs(user_list) do
            local row = self.user_rows[index]
            if not row or row.row_key ~= participant_row_key(user) then
                rebuild = true
                break
            end
        end
    end

    if rebuild then
        local restore_user_actions = self.user_actions_open == true
        self.user_action_target = nil
        self.users:Clear()
        self.user_rows = {}
        for _, user in ipairs(user_list) do
            local row = pf_irc_user_row(self, user, self.row_xml)
            self.users:AddWindow(row, true)
            row:SetAutoDelete(false)
            table.insert(self.user_rows, row)
        end
        if restore_user_actions then self:RebindUserActionTarget() end
        self:LayoutUserActions()
        return
    end

    -- Keep the actual CUIButton instances alive while ordinary IRC revisions
    -- update messages, topics, presence or mute state. IX-Ray completes a
    -- click on mouse-up; replacing a row between mouse-down and mouse-up loses
    -- that click even though the cursor never left the actions button.
    for index, user in ipairs(user_list) do
        self.user_rows[index]:ApplyUser(user)
    end
    self:LayoutUserActions()
end

function pf_irc_chat_tab:LayoutUserActions()
    -- Reserve the native 6-unit scrollbar only when the 1-unit-spaced rows overflow.
    local height = 0
    for _, row in ipairs(self.user_rows) do height = height + row:GetHeight() + 1 end
    local reserve = height > self.users:GetHeight() and 6 or 0
    local right = self.users:GetWidth() - 2 - reserve - 2
    for _, row in ipairs(self.user_rows) do
        row:SetActionRight(math.min(row.actions_right, right))
    end
end

function pf_irc_chat_tab:SelectConversation(key)
    self:ReleaseInlineInput()
    self:HideQuickChannel()
    self:HideCommandMenu()
    self:HideUserActions()
    local ok, error_code = pf_irc_chat.select_conversation(key)
    if not ok then
        self.status_value:SetText(error_text(error_code, ""))
        self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
        return
    end
    self:Refresh(true)
    self:BeginChatInput()
end

function pf_irc_chat_tab:OpenQuery(nick, identity)
    self:ReleaseInlineInput()
    self:HideQuickChannel()
    self:HideCommandMenu()
    self:HideUserActions()
    local ok, error_code = pf_irc_chat.open_query(nick, identity)
    if not ok then
        self.status_value:SetText(error_text(error_code, ""))
        self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
        return
    end
    self:Refresh(true)
    self:BeginChatInput()
end

function pf_irc_chat_tab:SyncLoginFromProfile()
    local profile = pf_irc_chat.get_active_profile()
    static_set_text(self.login_input, profile and tostring(profile.nick or "") or "")
    self.auto_login:SetCheck(pf_irc_chat.get_auto_login() == true)
    self.login_initialized = true
end

function pf_irc_chat_tab:SaveAutoLoginPreference()
    self:ReleaseInlineInput()
    local ok, error_code = pf_irc_chat.set_auto_login(self.auto_login:GetCheck() == true)
    if not ok then
        self.login_result:SetText(error_text(error_code, ""))
        self.login_result:SetTextColor(GetARGB(255, 235, 95, 75))
    end
end

function pf_irc_chat_tab:Authorize()
    local nick = static_get_text(self.login_input)
    local ok, error_code = pf_irc_chat.authorize(nick)
    if not ok then
        self.login_result:SetText(error_text(error_code, ""))
        self.login_result:SetTextColor(GetARGB(255, 235, 95, 75))
        self:BeginLoginInput()
    else
        self.login_result:SetText(translated("pf_irc_status_authorizing"))
        self.login_result:SetTextColor(GetARGB(255, 220, 175, 70))
    end
end

function pf_irc_chat_tab:AuthorizeFromButton()
    self:ReleaseInlineInput()
    self:Authorize()
end

function pf_irc_chat_tab:Disconnect()
    self:ReleaseInlineInput()
    self:CancelPdaConfirmation()
    self:HideQuickChannel()
    pf_irc_chat.disconnect()
    self:HideCommandMenu()
    self:HideUserActions()
    self:SyncLoginFromProfile()
    self:Refresh(true)
end

function pf_irc_chat_tab:DisconnectFromButton()
    self:Disconnect()
end

function pf_irc_chat_tab:HidePdaConfirmation()
    if self.pda_confirmation_popup then
        self.pda_confirmation_popup:Show(false)
        self.pda_confirmation_popup:Enable(false)
    end
    if self.pda_confirmation_shade then
        self.pda_confirmation_shade:Show(false)
        self.pda_confirmation_shade:Enable(false)
    end
end

function pf_irc_chat_tab:ShowPdaConfirmation(text, action)
    self:HideRightButtonHint()
    self.pending_confirmation_action = action
    self.pda_confirmation_message:SetText(text or "")
    self.pda_confirmation_shade:Show(true)
    self.pda_confirmation_shade:Enable(true)
    self.pda_confirmation_popup:Show(true)
    self.pda_confirmation_popup:Enable(true)
end

function pf_irc_chat_tab:CancelPdaConfirmation()
    self.pending_confirmation_action = nil
    self.pending_reset_profile = nil
    self.pending_delete_profile = nil
    self.pending_delete_conversation = nil
    self:HidePdaConfirmation()
end

function pf_irc_chat_tab:ConfirmPdaConfirmation()
    local action = self.pending_confirmation_action
    self.pending_confirmation_action = nil
    self:HidePdaConfirmation()
    if action == "delete_conversation" then
        self:ConfirmDeleteCurrentConversation()
    elseif action == "delete_profile" then
        self:ConfirmDeleteProfile()
    elseif action == "reset_profiles" then
        self:ConfirmResetSettings()
    end
end

function pf_irc_chat_tab:AskDeleteCurrentConversationFromButton()
    self:ReleaseInlineInput()
    self:HideRightButtonHint()
    self:HideQuickChannel()
    self:HideCommandMenu()
    self:HideUserActions()
    local active = nil
    for _, conversation in ipairs(pf_irc_chat.get_conversations()) do
        if conversation.active then
            active = conversation
            break
        end
    end
    if not active then return end
    self.pending_delete_conversation = active.key
    self:ShowPdaConfirmation(string.format(
        translated_utf8("pf_irc_delete_conversation_confirm"),
        pf_irc_text_codec.to_ui(active.nick or active.channel or "")),
        "delete_conversation")
end

function pf_irc_chat_tab:CancelDeleteCurrentConversation()
    self:CancelPdaConfirmation()
end

function pf_irc_chat_tab:ConfirmDeleteCurrentConversation()
    local key = self.pending_delete_conversation
    self.pending_delete_conversation = nil
    if not key then return end
    local active = nil
    for _, conversation in ipairs(pf_irc_chat.get_conversations()) do
        if conversation.key == key then
            active = conversation
            break
        end
    end
    if not active then return end
    local ok, error_code
    if active.public then ok, error_code = pf_irc_chat.delete_channel(active.key)
    else ok, error_code = pf_irc_chat.remove_conversation(active.key) end
    if not ok then
        self.status_value:SetText(error_text(error_code, ""))
        self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
    end
    self:Refresh(true)
end

function pf_irc_chat_tab:ToggleConversationNotificationsFromButton()
    self:ReleaseInlineInput()
    self:HideRightButtonHint()
    self:HideQuickChannel()
    self:HideCommandMenu()
    self:HideUserActions()
    local ok = pf_irc_chat.toggle_active_conversation_notifications()
    if not ok then
        self.status_value:SetText(translated_utf8("pf_irc_error_notification_preferences"))
        self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
    end
    self:Refresh(true)
    self:BeginChatInput()
end

function pf_irc_chat_tab:Send()
    local text = self.input_fields:get_text("chat")
    local ok, error_code = pf_irc_chat.send_message(text)
    if ok then
        self.input_fields:set_text("chat", "")
        self.emoji_panel:Show(false)
        self.emoji_panel:Enable(false)
    else
        self.status_value:SetText(error_text(error_code, ""))
        self.status_value:SetTextColor(GetARGB(255, 235, 85, 70))
    end
    self:BeginChatInput()
end

function pf_irc_chat_tab:SendFromButton()
    self:ReleaseInlineInput()
    self:Send()
end

function pf_irc_chat_tab:InsertMention(nick)
    if not self.chat:IsShown() or self.settings:IsShown() then return false end
    nick = tostring(nick or "")
    if nick == "" then return false end
    return self.input_fields:insert_from_click("chat", "@" .. nick .. " ")
end

function pf_irc_chat_tab:ShowCommands()
    self:HideUserActions()
    local show = not self.command_menu:IsShown()
    if show then
        local state = pf_irc_chat.get_state()
        local private_active = state.private_dialog_active == true
        local shown = 0
        self.command_templates = {}
        for _, button in pairs(self.command_buttons) do
            button:Show(false)
            button:Enable(false)
        end
        -- Re-read the small addon-local command section whenever the menu is
        -- opened, so ordering/scope/template edits never require a Lua reload.
        for _, definition in ipairs(pf_irc_chat_config.get_command_settings(true)) do
            local button = self.command_buttons[definition.id]
            local scope_allowed = definition.scope ~= "private" or private_active
            if button and definition.enabled == true and scope_allowed then
                shown = shown + 1
                button:SetWndPos(vector2():set(3, 3 + (shown - 1) * 32))
                button:Show(true)
                button:Enable(true)
                self.command_templates[definition.id] = definition.insert
            end
        end
        if shown == 0 then return end
        local menu_height = 2 + shown * 32
        self.command_menu:SetWndSize(vector2():set(self.command_menu:GetWidth(), menu_height))
        self.command_menu:SetWndPos(vector2():set(
            self.command_menu_x,
            self.command_menu_bottom_y - menu_height
        ))
    end
    self.command_menu:Show(show)
    self.command_menu:Enable(show)
end

function pf_irc_chat_tab:HideCommandMenu()
    self.command_menu:Show(false)
    self.command_menu:Enable(false)
end

function pf_irc_chat_tab:ShowCommandsFromButton()
    self:ReleaseInlineInput()
    self:HideQuickChannel()
    self:ShowCommands()
end

function pf_irc_chat_tab:InsertConfiguredCommand(command_id)
    local value = self.command_templates and self.command_templates[command_id] or nil
    if not value then return end
    self.input_fields:set_text("chat", value)
    self:HideCommandMenu()
    self:BeginChatInput()
end

function pf_irc_chat_tab:InsertClearCommand()
    self:InsertConfiguredCommand("clear")
end

function pf_irc_chat_tab:InsertQueryCommand()
    self:InsertConfiguredCommand("query")
end

function pf_irc_chat_tab:InsertMuteCommand()
    self:InsertConfiguredCommand("mute")
end

function pf_irc_chat_tab:InsertUnmuteCommand()
    self:InsertConfiguredCommand("unmute")
end

function pf_irc_chat_tab:InsertCloseCommand()
    self:InsertConfiguredCommand("close")
end

function pf_irc_chat_tab:InsertChannelCommand()
    self:InsertConfiguredCommand("channel")
end

function pf_irc_chat_tab:SetSettingsWindows(windows, shown)
    for _, window in ipairs(windows) do
        if window then
            window:Show(shown)
            window:Enable(shown)
        end
    end
end

function pf_irc_chat_tab:ShowSettingsPage(page)
    if self.settings_tab == "channels" and page ~= "channels" then
        self:CommitSettingsChannel()
    end
    self:ReleaseInlineInput()
    self:HideProfileList()
    self.settings_tab = page
    local labels = self.settings_labels
    local connection = {
        self.connection_panel, labels.profile_label, self.profile, self.profile_hitbox,
        self.profile_list_toggle, self.profile_delete, labels.address_label, self.address,
        self.address_hitbox, labels.port_label, self.port, self.port_hitbox, labels.tls_label,
        self.tls, labels.encoding_label, self.encoding, self.encoding_hitbox, labels.nick_label,
        self.nick, self.nick_hitbox, labels.note
    }
    local channels = {
        self.channel_panel, labels.channels_caption, self.settings_channel_list,
        self.settings_channel_add, self.settings_channel_delete, labels.channel_label,
        self.channel, self.channel_mask, self.channel_hitbox, self.channel_show,
        labels.channel_show_label, labels.key_label, self.key, self.key_mask, self.key_hitbox,
        self.key_show, labels.key_show_label, labels.guard_label, self.guard,
        labels.modes_label, self.modes, self.modes_hitbox, labels.channel_help
    }
    local notifications = {
        self.notifications_panel, self.public_panel, self.private_panel,
        labels.public_notifications_caption, labels.private_notifications_caption,
        labels.public_notify_label, self.public_notify, labels.public_sound_label,
        self.public_sound, labels.private_notify_label, self.private_notify,
        labels.private_sound_label, self.private_sound
    }
    self:SetSettingsWindows(connection, page == "connection")
    self:SetSettingsWindows(channels, page == "channels")
    self:SetSettingsWindows(notifications, page == "notifications")
    if page == "channels" then self:RefreshSensitiveSettings() end
    self:RefreshSettingsDeletionState()
end

function pf_irc_chat_tab:ShowConnectionSettingsTab()
    self:ShowSettingsPage("connection")
end

function pf_irc_chat_tab:ShowChannelSettingsTab()
    self:ShowSettingsPage("channels")
end

function pf_irc_chat_tab:ShowNotificationSettingsTab()
    self:ShowSettingsPage("notifications")
end

function pf_irc_chat_tab:CommitSettingsChannel()
    local channel = self.settings_channels[self.settings_channel_index]
    if not channel then return end
    channel.name = self.input_fields:get_text("settings_channel")
    channel.key = self.input_fields:get_text("settings_key")
    channel.require_registered_channel = self.guard:GetCheck() == true
    channel.required_modes = self.input_fields:get_text("settings_modes")
end

function pf_irc_chat_tab:FillSettingsChannel(index)
    self.settings_channel_index = math.max(1,
        math.min(tonumber(index) or 1, #self.settings_channels))
    local channel = self.settings_channels[self.settings_channel_index]
    if not channel then return end
    self.input_fields:set_text("settings_channel", channel.name or "")
    self.input_fields:set_text("settings_key", channel.key or "")
    self.guard:SetCheck(channel.require_registered_channel == true)
    self.input_fields:set_text("settings_modes", channel.required_modes or "")
    self:RefreshSensitiveSettings()
    self:RefreshSettingsDeletionState()
end

function pf_irc_chat_tab:RefreshSettingsChannelList()
    self.settings_channel_list:RemoveAll()
    for index, channel in ipairs(self.settings_channels) do
        local item = pf_irc_profile_item(channel.name ~= "" and channel.name or
            translated("pf_irc_channel_new"), 208)
        item.channel_index = index
        self.settings_channel_list:AddExistingItem(item)
    end
end

function pf_irc_chat_tab:SelectSettingsChannelFromList()
    local item = self.settings_channel_list:GetSelectedItem()
    local index = item and tonumber(item.channel_index) or nil
    if not index then return end
    self:ReleaseInlineInput()
    self:CommitSettingsChannel()
    self:FillSettingsChannel(index)
end

function pf_irc_chat_tab:AddSettingsChannel()
    self:ReleaseInlineInput()
    self:CommitSettingsChannel()
    if #self.settings_channels >= 16 then
        self.settings_result:SetText(translated("pf_irc_channel_limit"))
        return
    end
    self.settings_channels[#self.settings_channels + 1] = {
        name = "#", key = "", require_registered_channel = false, required_modes = "",
        store_history = false
    }
    self:RefreshSettingsChannelList()
    self:FillSettingsChannel(#self.settings_channels)
    self.input_fields:focus("settings_channel")
end

function pf_irc_chat_tab:DeleteSettingsChannel()
    self:ReleaseInlineInput()
    local selected = self.settings_channels[self.settings_channel_index or 1]
    if selected and not pf_irc_chat_config.is_channel_deletable(
        self.settings_loaded_profile_name, selected.name) then
        self.settings_result:SetText(error_text("channel_delete_forbidden", ""))
        return
    end
    if #self.settings_channels <= 1 then
        self.settings_result:SetText(translated("pf_irc_channel_last"))
        return
    end
    table.remove(self.settings_channels, self.settings_channel_index)
    self.settings_channel_index = math.min(self.settings_channel_index, #self.settings_channels)
    self:RefreshSettingsChannelList()
    self:FillSettingsChannel(self.settings_channel_index)
end

function pf_irc_chat_tab:FillProfile(profile_name, profile)
    if not profile then return false end
    -- Keep the custom editor's backing values synchronized with the visible
    -- form. Updating only CUIStatic text lets a stale field value repaint over
    -- the newly selected profile on a later blur/save frame.
    self.input_fields:set_text("settings_profile", profile_name or "")
    self.input_fields:set_text("settings_address", tostring(profile.address or ""))
    self.input_fields:set_text("settings_port", tostring(profile.port or ""))
    self.tls:SetCheck(profile.tls == true)
    self.input_fields:set_text("settings_encoding", tostring(profile.encoding or "utf-8"))
    self.input_fields:set_text("settings_nick", tostring(profile.nick or ""))
    self.settings_loaded_profile_name = tostring(profile_name or ""):lower()
    self.settings_history_namespace = tostring(profile.history_namespace or profile_name or ""):lower()
    self.settings_profile_deletable = profile.deletable ~= false
    self.settings_channels = {}
    for _, channel in ipairs(profile.channels or {}) do
        self.settings_channels[#self.settings_channels + 1] = {
            name = tostring(channel.name or ""),
            key = tostring(channel.key or ""),
            require_registered_channel = channel.require_registered_channel == true,
            required_modes = tostring(channel.required_modes or ""),
            store_history = channel.store_history == true
        }
    end
    if #self.settings_channels == 0 then
        self.settings_channels[1] = {
            name = tostring(profile.channel or ""), key = tostring(profile.key or ""),
            require_registered_channel = profile.require_registered_channel == true,
            required_modes = tostring(profile.required_modes or ""),
            store_history = profile.store_history == true
        }
    end
    self.settings_channel_index = 1
    self:RefreshSettingsChannelList()
    self:FillSettingsChannel(1)
    self.settings_result:SetText("")
    self:RefreshSensitiveSettings()
    return true
end

function pf_irc_chat_tab:FillNotificationSettings()
    local settings = pf_irc_chat_config.get_notification_settings() or {
        notify_public_messages = true,
        sound_public_messages = false,
        notify_private_messages = true,
        sound_private_messages = true
    }
    self.public_notify:SetCheck(settings.notify_public_messages == true)
    self.public_sound:SetCheck(settings.sound_public_messages == true)
    self.private_notify:SetCheck(settings.notify_private_messages == true)
    self.private_sound:SetCheck(settings.sound_private_messages == true)
end

function pf_irc_chat_tab:ShowSettings()
    self:ReleaseInlineInput()
    self:CancelPdaConfirmation()
    self:HideQuickChannel()
    self:HideUserActions()
    self:HideProfileList()
    self.channel_show:SetCheck(false)
    self.key_show:SetCheck(false)
    local profile, profile_name = pf_irc_chat.get_active_profile()
    self:FillProfile(profile_name, profile)
    self:FillNotificationSettings()
    self:ShowSettingsPage("connection")
    local state = pf_irc_chat.get_state()
    if state.authorized then
        self.input_fields:set_text("settings_nick", state.requested_nick or "")
    end
    self.settings_save:TextControl():SetText(translated_utf8("pf_irc_save_compact"))
    self:HideCommandMenu()
    self.settings_shade:Show(true)
    self.settings:Show(true)
    self.settings:Enable(true)
end

function pf_irc_chat_tab:ShowSettingsFromButton()
    self:ShowSettings()
end

function pf_irc_chat_tab:HideSettings()
    self:CancelPdaConfirmation()
    self:HideProfileList()
    self.settings:Show(false)
    self.settings_shade:Show(false)
end

function pf_irc_chat_tab:HideSettingsFromButton()
    self:ReleaseInlineInput()
    self:HideSettings()
end

function pf_irc_chat_tab:LoadSelectedProfile()
    local profile_name = self.input_fields:get_text("settings_profile"):lower()
    local profile = pf_irc_chat_config.get_profile(profile_name)
    if not self:FillProfile(profile_name, profile) then
        self.settings_result:SetText(translated("pf_irc_profile_new"))
    end
end

function pf_irc_chat_tab:ReadProfileForm()
    self:CommitSettingsChannel()
    local profile_name = self.input_fields:get_text("settings_profile"):lower()
    local namespace = self.settings_history_namespace
    if profile_name ~= tostring(self.settings_loaded_profile_name or ""):lower() then
        namespace = profile_name
    end
    return profile_name, {
        address = self.input_fields:get_text("settings_address"), channels = self.settings_channels,
        port = tonumber(self.input_fields:get_text("settings_port")), tls = self.tls:GetCheck() == true,
        encoding = self.input_fields:get_text("settings_encoding"),
        nick = self.input_fields:get_text("settings_nick"),
        history_namespace = namespace
    }
end

function pf_irc_chat_tab:ReadNotificationForm()
    return {
        notify_public_messages = self.public_notify:GetCheck() == true,
        sound_public_messages = self.public_sound:GetCheck() == true,
        notify_private_messages = self.private_notify:GetCheck() == true,
        sound_private_messages = self.private_sound:GetCheck() == true
    }
end

function pf_irc_chat_tab:SaveSettings()
    local profile_name, profile = self:ReadProfileForm()
    local notifications = self:ReadNotificationForm()
    local state = pf_irc_chat.get_state()
    ui_trace(string.format(
        "settings profile save target=%s loaded=%s active=%s address=%s port=%s channels=%d",
        tostring(profile_name), tostring(self.settings_loaded_profile_name or ""),
        tostring(select(2, pf_irc_chat.get_active_profile()) or ""),
        tostring(profile.address or ""), tostring(profile.port or ""),
        #(profile.channels or {})))
    local ok, error_code, reconnected = pf_irc_chat.save_profile(profile_name, profile, notifications)
    if ok then
        self.settings_loaded_profile_name = profile_name
        self:RefreshProfileList()
        self:RefreshSettingsChannelList()
        self:FillSettingsChannel(self.settings_channel_index)
        local saved_profile = pf_irc_chat_config.get_profile(profile_name)
        self.settings_profile_deletable = not (saved_profile and saved_profile.deletable == false)
        self:RefreshSettingsDeletionState()
        static_set_text(self.login_input, profile.nick or "")
        local result_id = reconnected and "pf_irc_saved_reconnect" or
            (state.authorized and "pf_irc_saved_settings" or "pf_irc_saved_only")
        self.settings_result:SetText(translated(result_id))
    else
        self.settings_result:SetText(translated("pf_irc_save_failed") .. ": " .. error_text(error_code, ""))
    end
end

function pf_irc_chat_tab:SaveSettingsFromButton()
    self:ReleaseInlineInput()
    self:HideProfileList()
    self:SaveSettings()
end

function pf_irc_chat_tab:AskResetSettings()
    self.pending_reset_profile = self.input_fields:get_text("settings_profile"):lower()
    self:ShowPdaConfirmation(
        translated_utf8("pf_irc_reset_confirm_compact"), "reset_profiles")
end

function pf_irc_chat_tab:AskResetSettingsFromButton()
    self:ReleaseInlineInput()
    self:HideProfileList()
    self:AskResetSettings()
end

function pf_irc_chat_tab:ConfirmResetSettings()
    local requested_profile_name = self.pending_reset_profile
    self.pending_reset_profile = nil
    local ok, error_code, active_name, shown_name = pf_irc_chat.reset_profile(requested_profile_name)
    if ok then
        local profile_name = shown_name or active_name or requested_profile_name
        local profile = pf_irc_chat_config.get_profile(profile_name)
        self:FillProfile(profile_name, profile)
        self:RefreshProfileList()
        local state = pf_irc_chat.get_state()
        local preserved_nick = state.authorized and state.requested_nick or (profile and profile.nick or "")
        static_set_text(self.nick, tostring(preserved_nick or ""))
        static_set_text(self.login_input, tostring(preserved_nick or ""))
        self.settings_result:SetText(translated("pf_irc_reset_done"))
    else
        self.settings_result:SetText(translated("pf_irc_reset_failed") .. ": " .. error_text(error_code, ""))
    end
end

function pf_irc_chat_tab:AskDeleteProfileFromButton()
    self:ReleaseInlineInput()
    self:HideProfileList()
    local profile_name = self.input_fields:get_text("settings_profile"):lower()
    if not pf_irc_chat_config.get_profile(profile_name) then
        self.settings_result:SetText(error_text("profile_missing", ""))
        return
    end
    self.pending_delete_profile = profile_name
    self:ShowPdaConfirmation(string.format(
        translated("pf_irc_profile_delete_confirm"), profile_name), "delete_profile")
end

function pf_irc_chat_tab:ConfirmDeleteProfile()
    local profile_name = self.pending_delete_profile
    self.pending_delete_profile = nil
    local ok, error_code, reconnected, active_name = pf_irc_chat.delete_profile(profile_name)
    if not ok then
        self.settings_result:SetText(translated("pf_irc_profile_delete_failed") .. ": " ..
            error_text(error_code, ""))
        return
    end
    local profile = pf_irc_chat_config.get_profile(active_name)
    self:FillProfile(active_name, profile)
    self:RefreshProfileList()
    local state = pf_irc_chat.get_state()
    if state.authorized then static_set_text(self.nick, state.requested_nick or "") end
    static_set_text(self.login_input, static_get_text(self.nick))
    self.settings_result:SetText(translated(reconnected and
        "pf_irc_profile_deleted_reconnect" or "pf_irc_profile_deleted"))
end

function pf_irc_chat_tab:OnKeyboard(dik, keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik_to_bind(dik) == key_bindings.kQUIT then
        if self.pda_confirmation_popup and self.pda_confirmation_popup:IsShown() then
            self:CancelPdaConfirmation()
            return true
        end
        if self.quick_channel_popup and self.quick_channel_popup:IsShown() then
            self:HideQuickChannelFromButton()
            return true
        end
        -- Let CLevel's kQUIT path close the whole PDA on this same press.
        -- Blur keeps the current draft (including empty); cancel would restore
        -- the stale snapshot taken when the field received focus.
        self:ReleaseInlineInput()
        return false
    end
    if self.input_fields and self.input_fields:is_active() then
        -- The add-on editor polls the physical keyboard in Pulse. Never route
        -- the event through CUIWindow: there is intentionally no native
        -- keyboard capturer that could survive a save/load cycle.
        return self.input_fields:on_keyboard(dik, keyboard_action)
    end
    return CUIScriptWnd.OnKeyboard(self, dik, keyboard_action) == true
end

function refresh_visibility()
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu() or nil
    if not pda_menu then return false end
    local tabs = pda_menu:GetTabControl()
    local button = tabs and tabs:GetButtonById("eptChat") or nil
    if not button then return false end
    local enabled = pf_irc_chat.is_enabled()
    button:Show(enabled)
    button:Enable(enabled)
    if not enabled and pda_menu:GetActiveSection() == "eptChat" then tabs:SetActiveTab("eptTasks") end
    return true
end

local function bridge_first_show(section)
    -- F9 cleanup must leave the old script window detached. In the new Lua VM,
    -- intercept only the first native Tasks callback if its preserved button
    -- still points at Chat or Orders. Returning that page here prevents a map
    -- frame; its first UI Update then fixes CUIPdaWnd's section identifier.
    if not first_show_restore_pending or reload_detaching or section_restore_in_progress then
        return nil
    end

    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu() or nil
    if not pda_menu then return nil end
    local state_ok, tabs, active_id, shown = pcall(function()
        local control = pda_menu:GetTabControl()
        return control, control and control:GetActiveId() or nil, pda_menu:IsShown()
    end)
    if not state_ok or not tabs or not shown then return nil end

    if active_id == section then
        first_show_restore_pending = false
        return nil
    end
    if section ~= "eptTasks" or
        (active_id ~= "eptChat" and active_id ~= "eptWeather") then
        first_show_restore_pending = false
        return nil
    end

    first_show_restore_pending = false
    if active_id == "eptChat" and not pf_irc_chat.is_enabled() then
        pcall(function() tabs:SetActiveTab("eptTasks") end)
        return nil
    end

    local window = nil
    if active_id == "eptChat" then
        window = get_ui()
    elseif lz_new_mechanics_pda and lz_new_mechanics_pda.set_active_subdialog then
        window = lz_new_mechanics_pda.set_active_subdialog(active_id)
    end
    if window then
        window.pf_restore_active_section = active_id
        window.pf_restore_update_pass = 0
    end
    return window
end

function finish_active_section_restore(window)
    local target = window and window.pf_restore_active_section or nil
    if not target then return true end

    -- CUIPdaWnd updates the active page once through its child hierarchy and
    -- once directly. Detaching during the first pass would mutate the parent's
    -- child iterator, so synchronize only on the direct second call.
    window.pf_restore_update_pass = (window.pf_restore_update_pass or 0) + 1
    if window.pf_restore_update_pass < 2 then return true end

    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu() or nil
    if not pda_menu then
        window.pf_restore_active_section = nil
        window.pf_restore_update_pass = nil
        return false
    end
    local state_ok, active_id, active_section = pcall(function()
        local tabs = pda_menu:GetTabControl()
        return tabs and tabs:GetActiveId() or nil, pda_menu:GetActiveSection()
    end)
    window.pf_restore_active_section = nil
    window.pf_restore_update_pass = nil
    if not state_ok or active_id ~= target or active_section == target then
        return state_ok
    end

    section_restore_in_progress = true
    local restored = pcall(function() pda_menu:SetActiveSubdialog(target) end)
    section_restore_in_progress = false
    return restored
end

function pulse()
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu() or nil
    if pda_menu then
        local shown_ok, shown = pcall(function() return pda_menu:IsShown() end)
        if shown_ok and shown then pcall(pf_irc_chat.note_pda_opened) end
    end
    local online = false
    if chat_singleton then
        chat_singleton:Pulse()
        local ok, scope = pcall(function() return chat_singleton:InputScope() end)
        online = ok and scope == "chat"
    end
    pcall(pf_irc_chat.set_presence, online and "online" or "away")
end

function before_game_reload()
    local window = chat_singleton

    -- CUIPdaWnd::Show(false) hides a script tab but leaves it attached to the
    -- native PDA frame. The Lua VM is then destroyed during load, so the
    -- parallel UI update can walk a freed CUIScriptWnd. For a selected Chat or
    -- Orders page, point at its existing wrapper and switch to a native tab
    -- while both sides are still alive.
    if window and window.input_fields then
        pcall(function() window.input_fields:shutdown() end)
    end
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu() or nil
    if pda_menu then
        reload_detaching = true
        local ok = pcall(function()
            local tabs = pda_menu:GetTabControl()
            local selected_id = tabs and tabs:GetActiveId() or nil
            local selected_window = nil
            if selected_id == "eptChat" then
                selected_window = window
            elseif selected_id == "eptWeather" and lz_new_mechanics_pda and
                lz_new_mechanics_pda.get_existing_weather_ui then
                selected_window = lz_new_mechanics_pda.get_existing_weather_ui()
            end
            if selected_window then
                -- Point CUIPdaWnd at the already-existing wrapper directly.
                -- Calling the tab callback here would refresh IRC or construct
                -- an off-screen page solely for teardown.
                pda_menu:SetActiveDialog(selected_window)
                pda_menu:SetActiveSubdialog("eptTasks")
                if pda_menu:GetActiveSection() ~= "eptTasks" then
                    error("selected PDA wrapper was not detached")
                end
            end
        end)
        reload_detaching = false
        if not ok then return false end
    end
    chat_singleton = nil
    return true
end

function on_game_load()
    -- CUIPdaWnd is rebuilt by F9 while Lua globals can survive. Forget the old
    -- wrapper before get_ui() is asked for the tab again; shutdown touches no
    -- C++ child window and therefore remains safe during UI teardown.
    if chat_singleton and chat_singleton.input_fields then
        pcall(function() chat_singleton.input_fields:shutdown() end)
    end
    chat_singleton = nil
    reload_detaching = false
    first_show_restore_pending = true
end

function get_ui()
    chat_singleton = chat_singleton or pf_irc_chat_tab()
    chat_singleton:Refresh(true)
    local state = pf_irc_chat.get_state()
    if not section_restore_in_progress and state.chat_open and state.ready then
        pcall(pf_irc_chat.request_user_sync)
    end
    return chat_singleton
end

function set_active_subdialog(section)
    refresh_visibility()
    local bridged = bridge_first_show(section)
    if bridged then return bridged end
    if section == "eptChat" then
        if pf_irc_chat.is_enabled() then
            return get_ui()
        end
        return nil
    end
    pcall(pf_irc_chat.set_presence, "away")
    if lz_new_mechanics_pda and lz_new_mechanics_pda.set_active_subdialog then
        return lz_new_mechanics_pda.set_active_subdialog(section)
    end
    return pda.set_active_subdialog(section)
end

function pf_irc_chat_tab:CenterAutoLogin()
    self.auto_login_label:SetText(translated("pf_irc_auto_login"))
    self.auto_login_label:AdjustWidthToText()
    local aspect = self.emoji_toggle:GetWidth() / self.emoji_toggle:GetHeight()
    local glyph_width, gap = 16 * aspect, 10 * aspect
    local left = (self.login:GetWidth() - glyph_width - gap - self.auto_login_label:GetWidth()) / 2
    self.auto_login:SetWndPos(vector2():set(left - (self.auto_login:GetWidth() - glyph_width) / 2,
        self.auto_login:GetWndPos().y))
    self.auto_login_label:SetWndPos(vector2():set(left + glyph_width + gap,
        self.auto_login_label:GetWndPos().y))
end
