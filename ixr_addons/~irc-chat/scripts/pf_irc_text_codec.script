-- Text at the IRC/engine boundary is UTF-8, while Anomaly's Russian UI font
-- consumes Windows-1251 bytes. Keep chat state, IPC and profile data in UTF-8
-- and convert only when text enters or leaves a native UI widget.

local cp1251_to_unicode = {
    [0x80] = 0x0402, [0x81] = 0x0403, [0x82] = 0x201A, [0x83] = 0x0453,
    [0x84] = 0x201E, [0x85] = 0x2026, [0x86] = 0x2020, [0x87] = 0x2021,
    [0x88] = 0x20AC, [0x89] = 0x2030, [0x8A] = 0x0409, [0x8B] = 0x2039,
    [0x8C] = 0x040A, [0x8D] = 0x040C, [0x8E] = 0x040B, [0x8F] = 0x040F,
    [0x90] = 0x0452, [0x91] = 0x2018, [0x92] = 0x2019, [0x93] = 0x201C,
    [0x94] = 0x201D, [0x95] = 0x2022, [0x96] = 0x2013, [0x97] = 0x2014,
    [0x99] = 0x2122, [0x9A] = 0x0459, [0x9B] = 0x203A, [0x9C] = 0x045A,
    [0x9D] = 0x045C, [0x9E] = 0x045B, [0x9F] = 0x045F, [0xA0] = 0x00A0,
    [0xA1] = 0x040E, [0xA2] = 0x045E, [0xA3] = 0x0408, [0xA4] = 0x00A4,
    [0xA5] = 0x0490, [0xA6] = 0x00A6, [0xA7] = 0x00A7, [0xA8] = 0x0401,
    [0xA9] = 0x00A9, [0xAA] = 0x0404, [0xAB] = 0x00AB, [0xAC] = 0x00AC,
    [0xAD] = 0x00AD, [0xAE] = 0x00AE, [0xAF] = 0x0407, [0xB0] = 0x00B0,
    [0xB1] = 0x00B1, [0xB2] = 0x0406, [0xB3] = 0x0456, [0xB4] = 0x0491,
    [0xB5] = 0x00B5, [0xB6] = 0x00B6, [0xB7] = 0x00B7, [0xB8] = 0x0451,
    [0xB9] = 0x2116, [0xBA] = 0x0454, [0xBB] = 0x00BB, [0xBC] = 0x0458,
    [0xBD] = 0x0405, [0xBE] = 0x0455, [0xBF] = 0x0457
}

for byte = 0xC0, 0xFF do
    cp1251_to_unicode[byte] = 0x0410 + byte - 0xC0
end

local unicode_to_cp1251 = {}
for byte, codepoint in pairs(cp1251_to_unicode) do
    unicode_to_cp1251[codepoint] = byte
end

local function decode_utf8(text, index)
    local first = text:byte(index)
    if not first then return nil, index + 1 end
    if first < 0x80 then return first, index + 1 end

    local count, codepoint, minimum
    if first >= 0xC2 and first <= 0xDF then
        count, codepoint, minimum = 2, first - 0xC0, 0x80
    elseif first >= 0xE0 and first <= 0xEF then
        count, codepoint, minimum = 3, first - 0xE0, 0x800
    elseif first >= 0xF0 and first <= 0xF4 then
        count, codepoint, minimum = 4, first - 0xF0, 0x10000
    else
        return nil, index + 1
    end

    for offset = 1, count - 1 do
        local continuation = text:byte(index + offset)
        if not continuation or continuation < 0x80 or continuation > 0xBF then
            return nil, index + 1
        end
        codepoint = codepoint * 0x40 + continuation - 0x80
    end
    if codepoint < minimum or codepoint > 0x10FFFF or
        (codepoint >= 0xD800 and codepoint <= 0xDFFF) then
        return nil, index + 1
    end
    return codepoint, index + count
end

local function encode_utf8(codepoint)
    if codepoint < 0x80 then return string.char(codepoint) end
    if codepoint < 0x800 then
        return string.char(0xC0 + math.floor(codepoint / 0x40),
            0x80 + codepoint % 0x40)
    end
    if codepoint < 0x10000 then
        return string.char(0xE0 + math.floor(codepoint / 0x1000),
            0x80 + math.floor(codepoint / 0x40) % 0x40,
            0x80 + codepoint % 0x40)
    end
    return string.char(0xF0 + math.floor(codepoint / 0x40000),
        0x80 + math.floor(codepoint / 0x1000) % 0x40,
        0x80 + math.floor(codepoint / 0x40) % 0x40,
        0x80 + codepoint % 0x40)
end

-- IPC, history and editor state stay UTF-8. Native UI text uses Windows-1251,
-- including the engine's byte-oriented ellipsis path.
function to_ui(value)
    local text, result = tostring(value or ""), {}
    local index = 1
    while index <= #text do
        local codepoint, next_index = decode_utf8(text, index)
        result[#result + 1] = not codepoint and text:sub(index,index) or
            (codepoint < 0x80 and string.char(codepoint) or
                (unicode_to_cp1251[codepoint] and string.char(unicode_to_cp1251[codepoint]) or "?"))
        index = next_index
    end
    return table.concat(result)
end
-- CUITextWnd/CUIStatic force ParseText(true) on resize, even in simple mode.
-- Native coloring cannot be disabled through the installed Lua API. Keep the
-- wire/history/CoPID name intact and escape only text entering native widgets.
local function parse_color(tag, base_color)
    if tag == "default" then return base_color or -1 end
    local a, r, g, b = tag:match("^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$")
    if not a or #a > 3 or #r > 3 or #g > 3 or #b > 3 then return nil end
    a, r, g, b = tonumber(a), tonumber(r), tonumber(g), tonumber(b)
    if a > 255 or r > 255 or g > 255 or b > 255 then return nil end
    return a * 16777216 + r * 65536 + g * 256 + b
end
function escape_markup(value, allow_colors)
    local text, result, cursor = tostring(value or ""), {}, 1
    while true do
        local first = text:find("%c[", cursor, true)
        if not first then result[#result + 1] = text:sub(cursor); break end
        result[#result + 1] = text:sub(cursor, first - 1)
        local last = text:find("]", first + 3, true)
        if allow_colors and last and parse_color(text:sub(first + 3, last - 1)) then
            result[#result + 1] = text:sub(first, last)
            cursor = last + 1
        else
            result[#result + 1] = "% c["
            cursor = first + 3
        end
    end
    return table.concat(result)
end
function to_ui_literal(value)
    return to_ui(escape_markup(value))
end
-- Rich emoji messages apply validated colors to separate plain-text widgets;
-- native body/news controls can retain those same validated tags directly.
function color_runs(value, base_color)
    local text, runs = escape_markup(value, true), {}
    local cursor, color = 1, base_color
    while true do
        local first, last, tag = text:find("%%c%[(.-)%]", cursor)
        if not first then
            if cursor <= #text then runs[#runs + 1] = {text=text:sub(cursor), color=color} end
            break
        end
        if first > cursor then runs[#runs + 1] = {text=text:sub(cursor, first - 1), color=color} end
        color, cursor = parse_color(tag, base_color), last + 1
    end
    return runs
end
function from_ui(value)
    local text, result = tostring(value or ""), {}
    for index = 1, #text do
        local byte = text:byte(index)
        result[#result + 1] = byte < 0x80 and string.char(byte) or
            encode_utf8(cp1251_to_unicode[byte] or 0xFFFD)
    end
    return table.concat(result)
end
