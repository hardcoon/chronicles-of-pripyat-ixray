<scroll_bar override="add">
<pf_irc_compact_v2 height="10" height_v="10" hold_delay="40">
    <up_arrow width="10" height="16" stretch="1">
        <texture_e>ui_scroll_btn_up</texture_e>
    </up_arrow>
    <down_arrow width="10" height="16" stretch="1">
        <texture_e>ui_scroll_btn_down</texture_e>
    </down_arrow>
    <back_v width="10" height="10" stretch="1">
        <texture>ui_scroll_back</texture>
    </back_v>
    <box_v frame_mode="0" vertical="1">
        <texture>ui_scroll_box</texture>
    </box_v>
</pf_irc_compact_v2>

<pf_irc_compact_dark height="10" height_v="10" hold_delay="40">
    <up_arrow width="10" height="16" stretch="1">
        <texture_e>ui_pf_irc_scroll_dark_up</texture_e>
    </up_arrow>
    <down_arrow width="10" height="16" stretch="1">
        <texture_e>ui_pf_irc_scroll_dark_down</texture_e>
    </down_arrow>
    <back_v width="10" height="10" stretch="1">
        <texture>ui_pf_irc_scroll_dark_back</texture>
    </back_v>
    <box_v frame_mode="0" vertical="1">
        <texture>ui_pf_irc_scroll_dark_box</texture>
    </box_v>
</pf_irc_compact_dark>
<pf_irc_compact_dark_v3 height="6" height_v="6" hold_delay="40">
    <up_arrow width="6" height="16" stretch="1">
        <texture_e>ui_pf_irc_scroll_dark_up</texture_e>
    </up_arrow>
    <down_arrow width="6" height="16" stretch="1">
        <texture_e>ui_pf_irc_scroll_dark_down</texture_e>
    </down_arrow>
    <back_v width="6" height="10" stretch="1">
        <texture>ui_pf_irc_scroll_track_v3</texture>
    </back_v>
    <box_v frame_mode="0" vertical="1">
        <texture>ui_pf_irc_scroll_thumb_v3</texture>
    </box_v>
</pf_irc_compact_dark_v3></scroll_bar>
