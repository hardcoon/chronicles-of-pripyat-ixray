-- Standalone in-game NPC editor for Chronicles of Pripyat / IX-Ray.
-- Editor-owned NPCs use one addon-owned remark section. Existing NPCs are
-- edited as reversible previews and never have their xr_logic rebuilt.

local STATE_KEY = "pf_npc_editor"
local STATE_VERSION = 2
local TOOL_SECTION = "pf_npc_editor_tool_native"
local ROUTE_TOOL_SECTION = "pf_npc_route_editor_tool_native"
local SETTINGS_SECTION = "pf_npc_editor_settings"
local CATALOG_SECTION = "pf_npc_editor_catalog"
local EDITOR_ACTIVE_SECTION = "remark@pf_npc_editor"
local NO_SMART_TERRAIN_ID = 65535
local INVALID_ACTION_ID = 4294967295
local INVALID_LEVEL_VERTEX_ID = 4294967295
local LIST_ROW_HEIGHT = 28
local ROTATION_STEP = math.rad(5)
local PLACEMENT_ROTATION_STEP = math.rad(10)
local PLACEMENT_MODE_HOTKEYS = 3
local PLACEMENT_MODE_CURSOR = 4
local PLACEMENT_MODE_CROSSHAIR = 5
local PLACEMENT_MODE_DETAIL = 6
local PASSIVE_SOUND_THRESHOLD = 1000000
local PLACEMENT_DEFAULT_DISTANCE = 4
local BBOX_WIDTH = 0.72
local BBOX_DEPTH = 0.72
local BBOX_HEIGHT = 1.82

local settings_ini = system_ini()
local impl = {
	tool_access = {
		actor_id = nil, developer = nil, complete = false, next_update = 0,
		pending_id = nil, route_pending_id = nil, section_missing_reported = false,
		developer_start_hook_installed = false,
	},
}

function impl.setting_number(name, fallback)
	if settings_ini:section_exist(SETTINGS_SECTION) and
		settings_ini:line_exist(SETTINGS_SECTION, name) then
		return settings_ini:r_float(SETTINGS_SECTION, name)
	end
	return fallback
end

local PLACEMENT_FLIGHT_SPEED = impl.setting_number("placement_flight_speed", 6)
local FIRST_PERSON_RAY_OFFSET = math.max(
	0, impl.setting_number("first_person_ray_offset", 0.85))

function impl.setting_bool(name, fallback)
	if settings_ini:section_exist(SETTINGS_SECTION) and
		settings_ini:line_exist(SETTINGS_SECTION, name) then
		return settings_ini:r_bool(SETTINGS_SECTION, name)
	end
	return fallback
end

function impl.setting_string(name, fallback)
	if settings_ini:section_exist(SETTINGS_SECTION) and
		settings_ini:line_exist(SETTINGS_SECTION, name) then
		return settings_ini:r_string(SETTINGS_SECTION, name)
	end
	return fallback
end

