	<string id="pf_ne_route_placement_modes_mesh"><text>1/2 КАМЕРА   3 ХОТКЕИ   4 КУРСОР   5 ПРИЦЕЛ   6 ТОЧНО   9 ЗАБЛОКИРОВАНО: AI-СЕТКА %s</text></string>
