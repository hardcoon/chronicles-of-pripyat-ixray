-- Stable compatibility facade for Chronicles of Pripyat mechanics.
-- LTX/XML/script callers keep using lz_new_mechanics.*; implementation and
-- runtime state live in the four lz_nm_* subsystem modules.

local state = {
	callbacks_registered = false
}
local impl = {}

-- Core/text API.
function text_for_legacy(value) return lz_nm_core.text_for_legacy(value) end
function text_for_utf8(value) return lz_nm_core.text_for_utf8(value) end

-- Lore, starter content, backpacks, sleep, and strange consumables.
function ghost_city_note_count() return lz_nm_world.ghost_city_note_count() end
function ghost_city_note_section(index) return lz_nm_world.ghost_city_note_section(index) end
function ghost_city_note_index(section) return lz_nm_world.ghost_city_note_index(section) end
function ghost_city_note_found(index) return lz_nm_world.ghost_city_note_found(index) end
function new_game_start()
	local unlocked = lz_nm_world.new_game_start()
	if lz_nlc_art_spawn and lz_nlc_art_spawn.new_game_start then
		lz_nlc_art_spawn.new_game_start()
	end
	if pf_fixed_house_stashes and pf_fixed_house_stashes.new_game_start then
		pf_fixed_house_stashes.new_game_start()
	end
	if pf_static_property_stashes and pf_static_property_stashes.new_game_start then
		pf_static_property_stashes.new_game_start()
	end
	if pf_static_vehicle_stashes and pf_static_vehicle_stashes.new_game_start then
		pf_static_vehicle_stashes.new_game_start()
	end
	impl.dispatch_encyclopedia_ui(unlocked and unlocked > 0)
	return unlocked
end
function debug_spawn_lore_test_stash() return lz_nm_world.debug_spawn_lore_test_stash() end
function use_sleepbag(item) return lz_nm_world.use_sleepbag(item) end
function on_inventory_eat(npc, item)
	if pf_food_tooltip and pf_food_tooltip.on_inventory_eat then
		pf_food_tooltip.on_inventory_eat(npc, item)
	end
	return lz_nm_world.on_inventory_eat(npc, item)
end
-- game_global.ltx exposes this native callback unconditionally. Keep the
-- facade-owned symbol available even when no gameplay mechanic modifies hits;
-- IX-Ray treats a missing functor as a fatal error in CActor::Hit.
function actor_before_hit(_actor, _script_hit, _bone_id)
	return true
end
