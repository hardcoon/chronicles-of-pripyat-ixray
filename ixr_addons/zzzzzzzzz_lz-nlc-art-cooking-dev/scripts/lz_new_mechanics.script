-- Equipment API.
-- These inventory events are internal integration points owned by the actor
-- binder. Existing LTX/XML callers continue using the same public functors.
function actor_on_inventory_item_take(item)
	local result = lz_nm_equipment.actor_on_inventory_item_take(item)
	if lz_nlc_art_spawn and lz_nlc_art_spawn.actor_on_inventory_item_take then
		lz_nlc_art_spawn.actor_on_inventory_item_take(item)
	end
	if lz_nlc_art_cooking and lz_nlc_art_cooking.actor_on_inventory_item_take then
		lz_nlc_art_cooking.actor_on_inventory_item_take(item)
	end
	local unlocked = lz_nm_world.actor_on_mechanics_item_take(item)
	if unlocked > 0 then impl.dispatch_encyclopedia_ui(true) end
	return result
end
function actor_on_inventory_item_drop(item)
	local result = lz_nm_equipment.actor_on_inventory_item_drop(item)
	if lz_nlc_art_cooking and lz_nlc_art_cooking.actor_on_inventory_item_drop then
		lz_nlc_art_cooking.actor_on_inventory_item_drop(item)
	end
	return result
end
function actor_on_inventory_trade(item, sell_bye)
	local result = lz_nm_equipment.actor_on_inventory_trade(item, sell_bye)
	if lz_nlc_art_spawn and lz_nlc_art_spawn.actor_on_inventory_trade then
		lz_nlc_art_spawn.actor_on_inventory_trade(item, sell_bye)
	end
	if lz_nlc_art_cooking and lz_nlc_art_cooking.actor_on_inventory_trade then
		lz_nlc_art_cooking.actor_on_inventory_trade(item, sell_bye)
	end
	if not sell_bye then
		local unlocked = lz_nm_world.actor_on_mechanics_item_take(item)
		if unlocked > 0 then impl.dispatch_encyclopedia_ui(true) end
	end
	return result
end

