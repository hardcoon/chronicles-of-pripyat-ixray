function impl.dispatch_beacon_ui()
	local requests = lz_nm_beacons.take_ui_requests()
	if not requests then return end
	if requests.refresh and lz_new_mechanics_pda and
		lz_new_mechanics_pda.refresh_beacon_ui then
		lz_new_mechanics_pda.refresh_beacon_ui()
	end
	if requests.destroy_confirmation_id and lz_new_mechanics_pda and
		lz_new_mechanics_pda.show_beacon_destroy_confirmation then
		lz_new_mechanics_pda.show_beacon_destroy_confirmation(
			requests.destroy_confirmation_id
		)
	end
	if requests.name_dialog_id then
		local opened = false
		if lz_new_mechanics_pda and lz_new_mechanics_pda.show_beacon_name_dialog then
			get_hud():HideActorMenu()
			opened = lz_new_mechanics_pda.show_beacon_name_dialog(
				requests.name_dialog_id, true
			)
		end
		if not opened then
			lz_nm_beacons.confirm_beacon_install(requests.name_dialog_id)
		end
	end
end

function impl.dispatch_encyclopedia_ui(refresh_articles)
	if lz_new_mechanics_pda and lz_new_mechanics_pda.refresh_encyclopedia_marker then
		lz_new_mechanics_pda.refresh_encyclopedia_marker(refresh_articles == true)
	end
end

-- Preserve the former monolithic callback order, including load-time migrations.
function impl.on_game_load_ordered()
	if lz_new_mechanics_pda and lz_new_mechanics_pda.on_game_load then
		lz_new_mechanics_pda.on_game_load()
	end
	lz_nm_surge_cover.reset()
	lz_nm_beacons.reset_runtime_on_load()
	lz_nm_equipment.on_game_load()
	local unlocked = lz_nm_world.reset_and_migrate_on_load()
	lz_nm_beacons.migrate_and_refresh_on_load()
	lz_nm_world.schedule_start_stash_on_load()
	if lz_orders and lz_orders.on_game_load then lz_orders.on_game_load() end
	impl.dispatch_beacon_ui()
	-- Also restores an unread marker already stored in an older save. The
	-- inventory migration itself remains silent and creates no news entries.
	impl.dispatch_encyclopedia_ui(unlocked and unlocked > 0)
end

function beacon_on_game_load()
	local result = impl.on_game_load_ordered()
	if lz_nlc_art_cooking_runtime and lz_nlc_art_cooking_runtime.on_game_load then
		lz_nlc_art_cooking_runtime.on_game_load()
	end
	if lz_nlc_natural_artifacts_qa and lz_nlc_natural_artifacts_qa.on_game_load then
		lz_nlc_natural_artifacts_qa.on_game_load()
	end
	if lz_nlc_art_spawn and lz_nlc_art_spawn.on_game_load then
		lz_nlc_art_spawn.on_game_load()
	end
	return result
end

function impl.actor_on_update_ordered()
	if not db.actor then return end
	lz_nm_world.update_sleep()
	if lz_orders and lz_orders.update then lz_orders.update() end
	lz_nm_world.update_cleanup()
	lz_nm_equipment.update_headgear_slot()
	local now = time_global()
	lz_nm_polarity.update(now)
	lz_nm_equipment.update_detector_and_fade(now)
	lz_nm_world.update_strange_consumables(now)
	lz_nm_beacons.update_actions(now)
	impl.dispatch_beacon_ui()
	lz_nm_world.update_starter_check(now)
	lz_nm_equipment.update_context_actions(now)
	lz_nm_world.update_backpacks(now)
	if pf_fixed_stash_runtime and pf_fixed_stash_runtime.update then
		pf_fixed_stash_runtime.update(now)
	end
	lz_nm_world.update_start_stash(now)
	-- The active IX-Ray mechanics facade is the proven owner of this update
	-- chain. mod_script imports the standalone cooking facade, but its local
	-- RegisterScriptCallback registration is not invoked by this build.
	if lz_nlc_art_cooking_runtime and lz_nlc_art_cooking_runtime.update then
		lz_nlc_art_cooking_runtime.update(now)
	end
	if lz_nlc_natural_artifacts_qa and lz_nlc_natural_artifacts_qa.update then
		lz_nlc_natural_artifacts_qa.update(now)
	end
	if lz_nlc_art_spawn and lz_nlc_art_spawn.update then
		lz_nlc_art_spawn.update(now)
	end
	lz_nm_beacons.update_marker(now)
	impl.dispatch_beacon_ui()
	lz_nm_surge_cover.update(now)
end

function actor_on_update()
	return impl.actor_on_update_ordered()
end

function on_game_start()
	if state.callbacks_registered then return end
	lz_nm_polarity.register_debug_spawn()
	if pda then
		pda.property_box_add_properties = lz_nm_beacons.pda_property_box_add_properties
		pda.property_box_clicked = pda_property_box_clicked
	end
	if type(RegisterScriptCallback) == "function" then
		RegisterScriptCallback("update", actor_on_update)
		RegisterScriptCallback("load", beacon_on_game_load)
		state.callbacks_registered = true
		printf("lz_new_mechanics: script callbacks registered")
	else
		printf("! lz_new_mechanics: RegisterScriptCallback is unavailable")
	end
end

-- The serialized binder stays in this facade. Existing saves retain the same
-- two-byte payload: packed hit counters followed by the randomized threshold.
class "lz_nm_beacon_binder" (object_binder)

function lz_nm_beacon_binder:__init(object) super(object)
	self.hits = 0
	self.threshold = math.random(5, 10)
	self.object:set_tip_text(game.translate_string("lz_nm_beacon_world_use"))
end

function lz_nm_beacon_binder:net_spawn(data)
	if not object_binder.net_spawn(self, data) then return false end
	self.object:set_callback(callback.hit, self.hit_callback, self)
	return true
end

function lz_nm_beacon_binder:net_destroy()
	self.object:set_callback(callback.hit, nil)
	object_binder.net_destroy(self)
end

function lz_nm_beacon_binder:hit_callback(object, amount, direction, who, bone_index)
	local result = lz_nm_beacons.handle_binder_hit(self, object, amount, who)
	impl.dispatch_beacon_ui()
	return result
end

function lz_nm_beacon_binder:net_save_relevant()
	return true
end

function lz_nm_beacon_binder:save(packet)
	object_binder.save(self, packet)
	packet:w_u8(self.hits)
	packet:w_u8(self.threshold)
end

function lz_nm_beacon_binder:load(reader)
	object_binder.load(self, reader)
	self.hits = reader:r_u8()
	self.threshold = reader:r_u8()
end

function bind_beacon(object)
	object:bind_object(lz_nm_beacon_binder(object))
end

-- mod_script imports modules but does not invoke this callback automatically.
on_game_start()
