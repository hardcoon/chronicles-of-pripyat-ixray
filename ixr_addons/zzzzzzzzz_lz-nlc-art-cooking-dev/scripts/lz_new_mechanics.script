	lz_nm_world.actor_on_item_take_from_box(box, item)
	if pf_fixed_stash_runtime and pf_fixed_stash_runtime.actor_on_item_take_from_box then
		pf_fixed_stash_runtime.actor_on_item_take_from_box(box, item)
	end
end
