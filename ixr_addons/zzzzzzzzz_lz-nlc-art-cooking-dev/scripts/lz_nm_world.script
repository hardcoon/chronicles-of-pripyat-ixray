-- World objects, starter content, lore, sleep, backpacks, and strange consumables.
-- Engine callbacks are owned by the lz_new_mechanics facade.
local state = {
	pending_backpack_boxes = {},
	pending_backpack_deploy = nil,
	sleep_autosave = nil,
	strange_stew_faint_due = nil,
	strange_stew_phase = nil,
	strange_stew_phase_due = nil,
	strange_stew_destination = nil,
	strange_stew_target_slot = nil,
	strange_consumable_encounter = nil,
	strange_consumable_fallback = nil,
	removed_items_cleaned = false,
	mechanics_encyclopedia_ini = nil
}
local impl = {}
local core = lz_nm_core

local MECHANICS_ENCYCLOPEDIA_PATH = "plugins\\lz_new_mechanics_encyclopedia.ltx"
local MECHANICS_ITEM_UNLOCK_SECTION = "encyclopedia_item_unlocks"
local MECHANICS_UNREAD_KEY = "lz_nm_encyclopedia_unread"

local function developer_mode_enabled()
	return pf_stash_qa and pf_stash_qa.is_developer_mode and
		pf_stash_qa.is_developer_mode() == true
end

local removed_item_sections = {
	snickers = true,
	energy_drink1 = true,
	bandage_army = true,
	mutant_part_snork_leg = true
}

-- Detector salvage is deliberately tiered. Low-end detectors yield only
-- common electronic parts, while Svarog guarantees one of every material.

