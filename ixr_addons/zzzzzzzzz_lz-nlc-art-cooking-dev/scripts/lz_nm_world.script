local lore_encyclopedia_unlocks = {}
local lore_note_indexes = {}
local pripyat_city_note_indexes = {}
for index, section in ipairs(lore_test_stash_items) do
	lore_encyclopedia_unlocks[section] = string.format(
		"lz_ghost_city_note_%02d_found", index
	)
	lore_note_indexes[section] = index
end
for index, section in ipairs(pripyat_city_note_items) do
	lore_encyclopedia_unlocks[section] = string.format(
		"lz_pripyat_city_note_%02d_found", index
	)
	pripyat_city_note_indexes[section] = index
end

function ghost_city_note_count()
	return #lore_test_stash_items
end

function ghost_city_note_section(index)
	index = tonumber(index)
	return index and lore_test_stash_items[index] or nil
end

function ghost_city_note_index(section)
	return type(section) == "string" and lore_note_indexes[section] or nil
end

function ghost_city_note_found(index)
	index = tonumber(index)
	local section = index and lore_test_stash_items[index] or nil
	local info = section and lore_encyclopedia_unlocks[section] or nil
	return db.actor ~= nil and info ~= nil and db.actor:has_info(info)
end

function pripyat_city_note_count()
	return #pripyat_city_note_items
end

function pripyat_city_note_section(index)
	index = tonumber(index)
	return index and pripyat_city_note_items[index] or nil
end

function pripyat_city_note_index(section)
	return type(section) == "string" and pripyat_city_note_indexes[section] or nil
end

function pripyat_city_note_found(index)
	index = tonumber(index)
	local section = index and pripyat_city_note_items[index] or nil
	local info = section and lore_encyclopedia_unlocks[section] or nil
	return db.actor ~= nil and info ~= nil and db.actor:has_info(info)
end

function impl.has_lore_encyclopedia_article(collection)
	if not db.actor then return false end
	for _, section in ipairs(collection) do
		local info = lore_encyclopedia_unlocks[section]
		if db.actor:has_info(info) then return true end
	end
	return false
end

function impl.notify_lore_article(section)
	if not db.actor then return end
	local flag, message
	if pripyat_city_note_indexes[section] then
		flag = "lz_pripyat_city_first_article_notified"
		message = "lz_pripyat_city_first_article_news"
	elseif lore_note_indexes[section] then
		flag = "lz_ghost_city_first_article_notified"
		message = "lz_ghost_city_first_article_news"
	end
	if not flag or db.actor:has_info(flag) then return end
	db.actor:give_info_portion(flag)
	news_manager.send_tip(db.actor, message, nil, nil, nil, nil)
end

function impl.get_mechanics_encyclopedia_ini()
	if not state.mechanics_encyclopedia_ini then
		state.mechanics_encyclopedia_ini = ini_file(MECHANICS_ENCYCLOPEDIA_PATH)
	end
	return state.mechanics_encyclopedia_ini
end

function impl.unlock_mechanics_info(info)
	if not db.actor or not info or info == "" or db.actor:has_info(info) then return false end
	db.actor:give_info_portion(info)
	return true
end

function impl.unlock_mechanics_for_section(section, item)
	if not db.actor or not section then return 0 end
	section = core.canonical_item_section(section)
	local unlocked = 0
	local ini = impl.get_mechanics_encyclopedia_ini()
	if ini and ini:section_exist(MECHANICS_ITEM_UNLOCK_SECTION) and
		ini:line_exist(MECHANICS_ITEM_UNLOCK_SECTION, section) then
		local infos = ini:r_string(MECHANICS_ITEM_UNLOCK_SECTION, section)
		for info in string.gmatch(infos or "", "[^,]+") do
			info = string.gsub(info, "^%s*(.-)%s*$", "%1")
			if impl.unlock_mechanics_info(info) then unlocked = unlocked + 1 end
		end
	end

	if unlocked > 0 then
		xr_logic.pstor_store(db.actor, MECHANICS_UNREAD_KEY, true)
		printf(
			"lz_new_mechanics: unlocked [%s] mechanics encyclopedia article(s) for [%s]",
			tostring(unlocked), tostring(section)
		)
	end
	return unlocked
end

-- Called for ground/corpse/box transfers and, through the facade, purchases.
-- Permanent info portions make duplicate engine callbacks harmless.
function actor_on_mechanics_item_take(item)
	if not item then return 0 end
	local server_item = alife():object(item:id(), true)
	local section = server_item and server_item:section_name() or item:section()
	return impl.unlock_mechanics_for_section(section, item)
end

function scan_owned_mechanics_items()
	if not db.actor then return 0 end
	local unlocked = 0
	db.actor:iterate_inventory(function(_, item)
		unlocked = unlocked + actor_on_mechanics_item_take(item)
	end, db.actor)
	return unlocked
end

function mechanics_encyclopedia_has_unread()
	return db.actor ~= nil and
		xr_logic.pstor_retrieve(db.actor, MECHANICS_UNREAD_KEY, false) == true
end

function mark_mechanics_encyclopedia_read()
	if not db.actor then return false end
	xr_logic.pstor_store(db.actor, MECHANICS_UNREAD_KEY, false)
	return true
end

local STASH_SPOT = "ui_pda2_actor_box_location"
local STRANGE_STEW_ARRIVAL_DISTANCE = 15
local STRANGE_STEW_START_DELAY_MS = 50
local STRANGE_STEW_PHASE_FALLBACK_MS = 12000
local STRANGE_CONSUMABLE_PSY_DAMAGE = 0.1
local STRANGE_CONSUMABLE_USE_PROFILES = {
	lz_nm_strange_stew = { encounter = "weak_mercs", fallback_delay_ms = 5000 },
	lz_nm_strange_shot = { encounter = "vodka_random", fallback_delay_ms = 4200 },
	lz_nm_strange_drink = { encounter = "random", fallback_delay_ms = 3600 }
}

local function cleanup_removed_items()
	if state.removed_items_cleaned then return end
	local obsolete = {}
	for _, object in alife():objects() do
		if removed_item_sections[object:section_name()] then
			table.insert(obsolete, object)
		end
	end
	for _, object in ipairs(obsolete) do alife():release(object, true) end
	state.removed_items_cleaned = true
	if #obsolete > 0 then
		printf("lz_new_mechanics: removed [%s] obsolete items from the save", tostring(#obsolete))
	end
end


-- Developer startup is owned by pf_dev_loadout. These public names remain
-- for existing intro/facade callers, without independent timers or issuance.
function new_game_start()
    xr_effects.pf_new_game_start()
    return scan_owned_mechanics_items()
end

-- QA shortcut: run_string lz_new_mechanics.debug_spawn_lore_test_stash()
-- The historical name is retained for console compatibility, but the command
-- requests missing notes in the single startup chest. It never
-- creates a separate test stash or adds ordinary documents to the actor.
function debug_spawn_lore_test_stash()
    local sections = {}
    for _, collection in ipairs({ lore_test_stash_items, pripyat_city_note_items }) do
        for _, section in ipairs(collection) do sections[#sections + 1] = section end
    end
    return pf_dev_loadout.add_documents(sections)
end

-- Portable sleeping bag uses the native Call of Pripyat sleep dialog. One
-- charge is spent only after the player confirms sleep, never on cancel.
function impl.consume_sleepbag_use(item_id)
	local item = item_id and level.object_by_id(item_id) or nil
	if not item or not db.actor or not core.is_actor_owned_item(item) then return false end

	-- itm_sleepbag is a generic action item, not CEatableItem. Its five visible
	-- charges are therefore stored as 20% condition steps instead of portions.
	local maximum = 5
	local condition = math.max(0, math.min(1, item:condition()))
	local remaining = math.floor(condition * maximum + 0.5)
	if remaining < 1 then
		core.release_item(item)
		return false
	end
	if remaining == 1 then
		core.release_item(item)
	else
		item:set_condition((remaining - 1) / maximum)
	end
	return true
end

function use_sleepbag(item)
	if not item or not db.actor then return false end
	if not core.require_actor_owned_item(item) then return false end
	local item_id = item:id()
	ui_sleep_dialog.sleep(function() return impl.consume_sleepbag_use(item_id) end)
	return true
end

-- Native "Use" is kept as the only sleeping-pill action. This callback is
-- invoked immediately before the engine consumes one dose.
function on_inventory_eat(npc, item)
	-- Bound game_object userdata has no Lua __eq operator in this IX-Ray build.
	-- Compare stable engine IDs instead of comparing userdata directly.
	if not item or not npc or not db.actor or npc:id() ~= db.actor:id() then return true end
	local section = core.canonical_item_section(item:section())
	if section == "drug_sleep" then
		ui_sleep_dialog.sleep()
	end

	-- The normal path still comes from each animator's end_lua_callback. Keep a
	-- delayed one-shot fallback because an interrupted HUD animator can consume
	-- the item without ever delivering that callback.
	local profile = STRANGE_CONSUMABLE_USE_PROFILES[section]
	if profile and not state.strange_stew_phase and
		not state.strange_stew_faint_due and not state.strange_consumable_fallback then
		local encounter = profile.encounter
		if encounter == "random" then
			encounter = math.random(1, 2) == 1 and "weak_mercs" or "vodka_random"
		end
		state.strange_consumable_fallback = {
			section = section,
			encounter = encounter,
			due = time_global() + profile.fallback_delay_ms
		}
	end
	return true
end

-- The backpack is converted into a persistent inventory box at the actor's
-- position. It intentionally has no use animation.
function impl.complete_backpack_deploy(item)
	if not item or not db.actor or not core.is_actor_owned_item(item) then return false end
	local object = alife():create(
		"lz_nm_backpack_box",
		db.actor:position(),
		db.actor:level_vertex_id(),
		db.actor:game_vertex_id()
	)
	if not object then
		core.message("lz_nm_backpack_failed")
		return false
	end

	level.map_add_object_spot_ser(object.id, STASH_SPOT, game.translate_string("lz_nm_backpack_marker"))
	if lz_nm_beacons and lz_nm_beacons.register_personal_stash then
		lz_nm_beacons.register_personal_stash(object.id)
	end
	core.release_item(item)
	core.message("lz_nm_backpack_deployed")
	return true
end

function deploy_backpack(item)
	if not item or not db.actor then return false end
	if not core.require_actor_owned_item(item) then return false end
	if state.pending_backpack_deploy then return false end
	state.pending_backpack_deploy = {
		item_id = item:id(),
		due = time_global() + 150
	}
	return false
end

function impl.box_has_items(box)
	for _ in alife():get_children(box) do return true end
	return false
end

function impl.collapse_backpack_box(box, control)
	if not box or impl.box_has_items(box) then return false end
	local menu = ActorMenu and ActorMenu.get_actor_menu and ActorMenu.get_actor_menu() or nil
	local opened_box = menu and menu:GetInvBox() or nil
	if opened_box and opened_box:id() == box.id and get_hud() then
		get_hud():HideActorMenu()
	end
	level.map_remove_object_spot(box.id, STASH_SPOT)
	if lz_nm_beacons and lz_nm_beacons.unregister_personal_stash then
		lz_nm_beacons.unregister_personal_stash(box.id)
	end
	core.create_for_actor("itm_backpack")
	if control then core.release_item(control) end
	alife():release(box, true)
	core.message("lz_nm_backpack_packed")
	return true
end

function impl.nearest_backpack_box(max_distance)
	if not db.actor then return nil end
	local actor_pos = db.actor:position()
	local nearest, nearest_distance
	for _, object in alife():objects() do
		if object:section_name() == "lz_nm_backpack_box" then
			local pos = object.position
			local dx = pos.x - actor_pos.x
			local dy = pos.y - actor_pos.y
			local dz = pos.z - actor_pos.z
			local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
			if distance <= max_distance and (not nearest_distance or distance < nearest_distance) then
				nearest = object
				nearest_distance = distance
			end
		end
	end
	return nearest
end

function pack_backpack(control)
	local box = impl.nearest_backpack_box(4.0)
	if not box then
		core.message("lz_nm_backpack_not_near")
		return false
	end
	if impl.box_has_items(box) then
		core.message("lz_nm_backpack_not_empty")
		return false
	end
	return impl.collapse_backpack_box(box, control)
end

-- Unlock one persistent encyclopedia article the first time a documentary
-- note reaches the actor, regardless of whether it came from a box, corpse,
-- trader, or the ground. Duplicate callbacks are harmless because info
-- portions are permanent and checked before being granted.
function actor_on_lore_item_take(item)
	if not db.actor or not item then return end
	local server_item = alife():object(item:id(), true)
	local section = server_item and server_item:section_name() or item:section()
	local story_index = pf_story_documents.document_index(section)
	if story_index and story_index >= 13 then
		pf_story_documents.on_document_taken(item)
		return
	end
	local info = lore_encyclopedia_unlocks[section]
	if not info or db.actor:has_info(info) then return end
	db.actor:give_info_portion(info)
	impl.notify_lore_article(section)
	printf(
		"lz_new_mechanics: lore encyclopedia entry unlocked for [%s]",
		tostring(section)
	)
end

-- A deployed backpack has no artificial folding token. Taking the final real
-- item removes the now-empty box and returns the backpack to the actor.
function actor_on_item_take_from_box(box, item)
	if not box or not item then return end
	if box:section() ~= "lz_nm_backpack_box" then return end
	-- This signal arrives before both the client and ALife server have committed
	-- the transfer. Retry briefly instead of relying on a single frame; this is
	-- also reliable when the actor-menu "take all" action moves several stacks.
	local now = time_global()
	state.pending_backpack_boxes[box:id()] = {
		due = now + 100,
		expires = now + 3000
	}
end

function impl.spawn_strange_consumable_event(encounter)
	if encounter and pf_dynamic_stashes and
		pf_dynamic_stashes.spawn_strange_consumable_ambush then
		pf_dynamic_stashes.spawn_strange_consumable_ambush(encounter)
	end
end

function strange_stew_wakeup_finished()
	if not state.strange_stew_phase then return end
	local encounter = state.strange_consumable_encounter
	state.strange_stew_phase = nil
	state.strange_stew_phase_due = nil
	state.strange_stew_destination = nil
	state.strange_stew_target_slot = nil
	state.strange_consumable_encounter = nil
	if db.actor then
		xr_effects.enable_ui(db.actor, nil)
		-- In this IX-Ray build the psy_health property setter applies a delta.
		db.actor.psy_health = -STRANGE_CONSUMABLE_PSY_DAMAGE
	end
	impl.spawn_strange_consumable_event(encounter)
end

function strange_stew_blackout_callback()
	if state.strange_stew_phase ~= "falling" or not db.actor then return end
	state.strange_stew_phase = "waking"
	state.strange_stew_phase_due = time_global() + STRANGE_STEW_PHASE_FALLBACK_MS

	level.change_game_time(0, 3, 0)
	if surge_manager and surge_manager.get_surge_manager then
		surge_manager.get_surge_manager().time_forwarded = true
	end
	if psi_storm_manager and psi_storm_manager.get_psi_storm_manager then
		psi_storm_manager.get_psi_storm_manager().time_forwarded = true
	end
	if level_weathers and level_weathers.get_weather_manager then
		level_weathers.get_weather_manager():forced_weather_change()
	end
	if state.strange_stew_destination then
		db.actor:set_actor_position(state.strange_stew_destination)
		printf(
			"lz_new_mechanics: strange consumable moved actor near purple stash slot [%s]",
			tostring(state.strange_stew_target_slot)
		)
	else
		printf("! lz_new_mechanics: no purple stash arrival point; strange consumable fainted actor in place")
	end
	-- Resolve the vodka branch while the blackout still covers the event. The
	-- stew branch keeps its mercenary ambush until the wake-up camera finishes.
	if state.strange_consumable_encounter == "vodka_random" then
		local encounter = state.strange_consumable_encounter
		state.strange_consumable_encounter = nil
		impl.spawn_strange_consumable_event(encounter)
	end
	state.strange_stew_destination = nil
	state.strange_stew_target_slot = nil
	level.add_cam_effector(
		"camera_effects\\surge_01.anm", 105184, false,
		"lz_new_mechanics.strange_stew_wakeup_finished"
	)
end

function impl.start_strange_stew_faint()
	if not db.actor or state.strange_stew_phase then return end
	state.strange_stew_destination = nil
	state.strange_stew_target_slot = nil
	-- All three strange consumables share the original purple-stash relocation.
	-- Their post-blackout encounter still differs: stew keeps the weak mercenary
	-- ambush, vodka keeps its corpse/nothing roll, and water chooses either event.
	if state.strange_consumable_encounter and pf_dynamic_stashes and
		pf_dynamic_stashes.random_hidden_purple_arrival then
		state.strange_stew_destination, state.strange_stew_target_slot =
			pf_dynamic_stashes.random_hidden_purple_arrival(STRANGE_STEW_ARRIVAL_DISTANCE)
	end

	xr_effects.disable_ui_only(db.actor, nil)
	state.strange_stew_phase = "falling"
	state.strange_stew_phase_due = time_global() + STRANGE_STEW_PHASE_FALLBACK_MS
	level.add_cam_effector(
		"camera_effects\\surge_02.anm", 105184, false,
		"lz_new_mechanics.strange_stew_blackout_callback"
	)
	level.add_pp_effector("surge_fade.ppe", 105185, false)
end

-- Dedicated animator callback. Delay one update so HudAnimatorManager can
-- finish StopAnimator before the faint disables input and hides the weapon.
function impl.schedule_strange_consumable_faint(encounter)
	if state.strange_stew_phase or state.strange_stew_faint_due then return end
	state.strange_consumable_fallback = nil
	state.strange_consumable_encounter = encounter
	state.strange_stew_faint_due = time_global() + STRANGE_STEW_START_DELAY_MS
end

function strange_stew_animation_finished()
	impl.schedule_strange_consumable_faint("weak_mercs")
end

function strange_shot_animation_finished()
	impl.schedule_strange_consumable_faint("vodka_random")
end

function strange_drink_animation_finished()
	-- The strange drink always relocates to a purple stash, then borrows one of
	-- the two established encounter outcomes with equal probability.
	impl.schedule_strange_consumable_faint(
		math.random(1, 2) == 1 and "weak_mercs" or "vodka_random")
end

-- Backward-compatible callback used by the first implementation of the stew.
function strange_consumable_animation_finished()
	strange_stew_animation_finished()
end

-- Lifecycle phases are intentionally separate so the facade can preserve the
-- exact ordering of the former monolithic actor_on_update function.
function reset_and_migrate_on_load()
	if state.strange_stew_phase and db.actor then
		xr_effects.enable_ui(db.actor, nil)
	end
	state.strange_stew_faint_due = nil
	state.strange_stew_phase = nil
	state.strange_stew_phase_due = nil
	state.strange_stew_destination = nil
	state.strange_stew_target_slot = nil
	state.strange_consumable_encounter = nil
	state.strange_consumable_fallback = nil
	state.pending_backpack_deploy = nil
	cancel_sleep_autosave()
	if db.actor and not db.actor:has_info("lz_ghost_city_first_article_notified") and
		impl.has_lore_encyclopedia_article(lore_test_stash_items) then
		db.actor:give_info_portion("lz_ghost_city_first_article_notified")
	end
	if db.actor and not db.actor:has_info("lz_pripyat_city_first_article_notified") and
		impl.has_lore_encyclopedia_article(pripyat_city_note_items) then
		db.actor:give_info_portion("lz_pripyat_city_first_article_notified")
	end
	-- One full pass per load migrates currently owned tools in old saves. Normal
	-- gameplay remains event-driven; no inventory scan runs in the update loop.
	return scan_owned_mechanics_items()
end

function schedule_start_stash_on_load() end
function schedule_developer_start_stash() return pf_dev_loadout.request() end

function on_game_load()
	reset_and_migrate_on_load()
	schedule_start_stash_on_load()
end

-- Only an explicit successful wake-up can arm this transient request.
-- Both sleep controllers use this leaf; the mechanics facade remains its sole updater.
function cancel_sleep_autosave()
	state.sleep_autosave = nil
end

function impl.sleep_autosave_actor(request)
	local actor = db.actor
	if not actor or actor:id() ~= request.actor_id or not actor:alive()
		or actor:death_time() ~= 0 or actor.bleeding > 0 or actor.radiation > 0
		or actor.health < request.health - 0.0005 then
		return nil
	end
	request.health = actor.health
	return actor
end

function begin_sleep_autosave()
	cancel_sleep_autosave()
	local actor = db.actor
	if not actor or not actor:alive() or actor:death_time() ~= 0 then return end
	state.sleep_autosave = {actor_id = actor:id(), health = actor.health}
end

function finish_sleep_autosave(success)
	local request = state.sleep_autosave
	if not request then return end
	local actor = impl.sleep_autosave_actor(request)
	if success ~= true or not actor or actor:has_info("actor_is_sleeping") then
		cancel_sleep_autosave()
		return
	end
	-- Let death/hit packets and the restored camera finish before issuing save.
	-- Check every update during this grace period, including death_time while
	-- health can still be positive in KillEntity -> GE_DIE.
	request.finished_frame = device().frame
	request.due = time_global() + 1000
end

function update_sleep()
	local request = state.sleep_autosave
	if not request then return end
	local actor = impl.sleep_autosave_actor(request)
	if not actor then
		cancel_sleep_autosave()
		return
	end
	if not request.due then return end
	if actor:has_info("actor_is_sleeping") or actor:has_info("sleep_active") then
		cancel_sleep_autosave()
		return
	end
	if time_global() < request.due or device().frame <= request.finished_frame + 1 then return end
	local simulator = alife()
	local server_actor = simulator and simulator:object(request.actor_id)
	cancel_sleep_autosave() -- Consume before the console can re-enter a save callback.
	if server_actor and server_actor:alive() then
		xr_effects.scenario_autosave(actor, nil, {"st_save_lz_after_sleep"})
	end
end

function update_cleanup()
	cleanup_removed_items()
end

function update_strange_consumables(now)
	local fallback = state.strange_consumable_fallback
	if fallback and now >= fallback.due then
		state.strange_consumable_fallback = nil
		printf(
			"! lz_new_mechanics: animator callback fallback activated for [%s]",
			tostring(fallback.section)
		)
		impl.schedule_strange_consumable_faint(fallback.encounter)
	end
	if state.strange_stew_faint_due and now >= state.strange_stew_faint_due then
		state.strange_stew_faint_due = nil
		impl.start_strange_stew_faint()
	end
	if state.strange_stew_phase_due and now >= state.strange_stew_phase_due then
		if state.strange_stew_phase == "falling" then
			strange_stew_blackout_callback()
		elseif state.strange_stew_phase == "waking" then
			strange_stew_wakeup_finished()
		end
	end
end

function update_starter_check(now) end

function update_backpacks(now)
	if state.pending_backpack_deploy and now >= state.pending_backpack_deploy.due then
		local pending = state.pending_backpack_deploy
		state.pending_backpack_deploy = nil
		local item = level.object_by_id(pending.item_id)
		if item and core.is_actor_owned_item(item) then
			impl.complete_backpack_deploy(item)
		end
	end
	for id, pending in pairs(state.pending_backpack_boxes) do
		if now >= pending.due then
			local client_box = level.object_by_id(id)
			local server_box = alife():object(id, true)
			if not server_box then
				state.pending_backpack_boxes[id] = nil
			elseif client_box and client_box:is_inv_box_empty() and not impl.box_has_items(server_box) then
				state.pending_backpack_boxes[id] = nil
				impl.collapse_backpack_box(server_box, nil)
			elseif now >= pending.expires then
				state.pending_backpack_boxes[id] = nil
			else
				pending.due = now + 100
			end
		end
	end
end

function update_start_stash(now)
end
