local function valid_puzzle_reward_id(reward_id)
	reward_id = tostring(reward_id or ""):lower()
	if #reward_id < 12 or #reward_id > 96 or reward_id:find("[^a-z0-9_%-]") then
		return nil
	end
	return reward_id
end

