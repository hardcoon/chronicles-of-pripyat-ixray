-- Server-side inventory items do not expose their condition field to Lua in
-- this IX-Ray build. Condition therefore has to be applied to the online game
-- object. The section index also gives us a reliable fallback when a stash was
-- saved and loaded before its contents ever came online.
local conditioned_loot_sections = {}
for _, pool_name in ipairs({
	"weapons_green", "weapons_cyan", "weapons_purple",
	"weapons_orange_standard", "weapons_orange_exotic", "weapons_red_unique"
}) do
	for _, section in ipairs(loot_pools[pool_name]) do conditioned_loot_sections[section] = "weapon" end
end
for _, pool_name in ipairs({
	"outfits_green", "outfits_cyan", "outfits_purple", "outfits_orange",
	"outfits_orange_exo",
	"headgear_cyan", "headgear_purple", "headgear_orange"
}) do
	for _, section in ipairs(loot_pools[pool_name]) do conditioned_loot_sections[section] = "armor" end
end

