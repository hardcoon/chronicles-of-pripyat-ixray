	},
	{ items = { { section = "pf_stash_pda_stalker", count = 3 } } }
}

-- The manager owns the black-and-white detector lookup. This is deliberately
-- the same spatial grid as logical stash streaming: detectors can react to a
-- reserved coordinate before a physical container exists, without a second
-- runtime index drifting out of sync with the selected slots.
local active_metal_detectors = {
	pf_metal_detector_homemade = {
		max_range = 20,
		ranges = { green = 20, cyan = 10 }
	},
	pf_metal_detector_wave = {
		max_range = 15,
		ranges = { cyan = 15, purple = 10 }
	},
	pf_metal_detector_magnet = {
		max_range = 20,
		ranges = { cyan = 20, purple = 15, orange = 5 },
		reveal_tiers = { orange = true }
	}
}

-- Exact starting quotas for a new world: 60%/20%/10%/5%/5%.
-- These are not tier caps: hint rewards may append more logical slots.
function impl.tier_for_index(index)
	if index <= 240 then return "green" end
	if index <= 320 then return "cyan" end
	if index <= 360 then return "purple" end
	if index <= 380 then return "orange" end
	if index <= STARTING_STASH_COUNT then return "red" end
	return nil
end

