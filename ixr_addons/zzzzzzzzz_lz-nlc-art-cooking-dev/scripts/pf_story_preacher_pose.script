-- Direction-neutral, base-idle-only seated pose for Sergey Sverchkov.
-- The stock `sit` state starts a separate animstate graph with transitions and
-- random branches. That graph can keep the visible body at its former facing
-- even after server yaw, desired direction and look_position have changed.

STATE_NAME = "pf_story_sergey_sit_fixed"
FLOOR_STATE_NAME = "pf_story_sergey_floor_fixed"
local registered = false

function ensure_registered()
	if registered then return true end

	local states = state_lib.states
	local animations = state_mgr_animation_list.animations
	if type(states) ~= "table" or type(animations) ~= "table" then
		return false
	end

	local function register_pose(name, motion)
		local animation_name = name.."_pose"
		states[name] = {
			weapon = "strapped",
			movement = move.stand,
			mental = anim.free,
			bodystate = move.standing,
			animstate = nil,
			animation = animation_name,
		}

		animations[animation_name] = {
			prop = {
				maxidle = 5,
				sumidle = 3,
				rnd = 80,
				moving = false,
			},
			into = nil,
			out = nil,
			idle = { [0] = motion },
			rnd = nil,
		}
	end
	register_pose(STATE_NAME, "sit_0_idle_0")
	-- The stock sit_ass state uses sit_2; sit_0 is the former squat.
	register_pose(FLOOR_STATE_NAME, "sit_2_idle_0")

	registered = true
	printf("~ [pf_story_preacher_pose] registered squat and floor seated poses")
	return true
end
