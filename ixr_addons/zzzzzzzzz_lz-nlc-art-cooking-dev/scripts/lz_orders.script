local function trim(value)
	value = tostring(value or "")
	value = string.gsub(value, "^%s+", "")
	value = string.gsub(value, "%s+$", "")
	return value
end

local function split(value, separator)
	local result = {}
	value = tostring(value or "")
	separator = separator or "|"
	local start = 1
	while true do
		local pos = string.find(value, separator, start, true)
		if not pos then
			table.insert(result, string.sub(value, start))
			break
		end
		table.insert(result, string.sub(value, start, pos - 1))
		start = pos + #separator
	end
	return result
end

local function get_config()
	if not config then config = ini_file(CONFIG_PATH) end
	return config
end

local function get_sysini()
	if not sysini then sysini = system_ini() end
	return sysini
end

local function translate(id)
	return game.translate_string(tostring(id or ""))
end

-- Some stock localization entries are assembled from legacy CP1251 and UTF-8
-- fragments. Feeding such a mixed item name to the PDA's single-byte text path
-- leaves the UTF-8 fragment visible as mojibake. Order-only keys keep the board
-- independent from those duplicate stock string-table entries.
local order_item_name_overrides = {
	mineral_water = "lz_order_item_mineral_water"
}

local function utf8_text(value)
	value = tostring(value or "")
	if lz_new_mechanics and lz_new_mechanics.text_for_utf8 then
		return lz_new_mechanics.text_for_utf8(value)
	end
	return value
end

local function legacy_text(value)
	value = tostring(value or "")
	if lz_new_mechanics and lz_new_mechanics.text_for_legacy then
		return lz_new_mechanics.text_for_legacy(value)
	end
	return value
end

local function utf8_visible_length(value)
	local _, count = string.gsub(tostring(value or ""), "[^\128-\191]", "")
	return count
end

local function wrap_words(value, limit)
	limit = math.max(12, math.floor(tonumber(limit) or 30))
	local text = tostring(value or ""):gsub("\\n", "\n")
	local result = {}
	for paragraph in string.gmatch(text .. "\n", "(.-)\n") do
		local line = ""
		local line_length = 0
		for word in string.gmatch(paragraph, "%S+") do
			local word_length = utf8_visible_length(word)
			if line ~= "" and line_length + 1 + word_length > limit then
				table.insert(result, line)
				line = word
				line_length = word_length
			else
				if line ~= "" then
					line = line .. " " .. word
					line_length = line_length + 1 + word_length
				else
					line = word
					line_length = word_length
				end
			end
		end
		if line ~= "" then table.insert(result, line) end
	end
	return table.concat(result, "\\n")
end

local function message(id_or_text)
	if db.actor and news_manager and news_manager.send_tip then
		news_manager.send_tip(db.actor, id_or_text, nil, nil, nil, nil)
	end
end

function print_actor_position()
	if not db.actor then
		printf("! lz_orders: actor is not available")
		return false
	end
	point_dump_counter = point_dump_counter + 1
	local position = db.actor:position()
	printf(
		"LZ_POINT_%02d | level=%s | pos=%.3f, %.3f, %.3f | lvid=%d | gvid=%d",
		point_dump_counter, level.name(), position.x, position.y, position.z,
		db.actor:level_vertex_id(), db.actor:game_vertex_id()
	)
	return true
end

function reset_point_counter()
	point_dump_counter = 0
	printf("lz_orders: point counter reset")
end

-- Development helper for collecting the 24 permanent delivery locations.
-- Captures live in actor pstor, so changing levels, saving or restarting the
-- game does not lose the route. The log line is already formatted as a Lua
-- registry entry and can be pasted into drop_points after field collection.
function impl.decode_captured_drop_points()
	local result = {}
	if not db.actor then return result end
	local raw = tostring(xr_logic.pstor_retrieve(db.actor, CAPTURED_DROP_POINTS_KEY, "") or "")
	for _, encoded in ipairs(split(raw, "|")) do
		if encoded ~= "" then
			local fields = split(encoded, ",")
			if #fields >= 9 then
				table.insert(result, {
					level = fields[1],
					x = tonumber(fields[2]) or 0,
					y = tonumber(fields[3]) or 0,
					z = tonumber(fields[4]) or 0,
					level_vertex_id = math.floor(tonumber(fields[5]) or 0),
					game_vertex_id = math.floor(tonumber(fields[6]) or 0),
					yaw = tonumber(fields[7]) or 0,
					direction_x = tonumber(fields[8]) or 0,
					direction_z = tonumber(fields[9]) or 0,
					object_id = math.floor(tonumber(fields[10]) or -1)
				})
			end
		end
	end
	return result
end

function impl.save_captured_drop_points(points)
	if not db.actor then return false end
	local encoded = {}
	for _, point in ipairs(points or {}) do
		table.insert(encoded, string.format(
			"%s,%.4f,%.4f,%.4f,%d,%d,%.6f,%.6f,%.6f,%d",
			point.level, point.x, point.y, point.z,
			point.level_vertex_id, point.game_vertex_id, point.yaw,
			point.direction_x, point.direction_z,
			math.floor(tonumber(point.object_id) or -1)
		))
	end
	xr_logic.pstor_store(db.actor, CAPTURED_DROP_POINTS_KEY, table.concat(encoded, "|"))
	return true
end

function impl.print_captured_drop_point(index, point)
	local point_id = string.format("outskirts_%02d", index)
	printf(
		"LZ_DROP_POINT_%02d | level=%s | pos=%.4f, %.4f, %.4f | lvid=%d | gvid=%d | yaw=%.6f | dir=%.6f, %.6f | object_id=%d",
		index, point.level, point.x, point.y, point.z,
		point.level_vertex_id, point.game_vertex_id, point.yaw,
		point.direction_x, point.direction_z,
		math.floor(tonumber(point.object_id) or -1)
	)
	printf(
		"%s = { name = \"lz_order_point_numbered\", display_index = %d, level = \"%s\", story_id = \"\", position = { %.4f, %.4f, %.4f }, level_vertex_id = %d, game_vertex_id = %d, yaw = %.6f, section = \"lz_nm_order_dropbox\", object_key = \"lz_orders_dropbox_%s_id\" },",
		point_id, index + 1, point.level, point.x, point.y, point.z,
		point.level_vertex_id, point.game_vertex_id, point.yaw, point_id
	)
end

function impl.release_captured_dropbox(point)
	local object_id = math.floor(tonumber(point and point.object_id) or -1)
	if object_id < 0 then return false end
	local object = alife():object(object_id, true)
	if not object or object:section_name() ~= "lz_nm_order_dropbox" or not object.position then
		return false
	end
	if math.abs(object.position.x - point.x) > 0.5 or
		math.abs(object.position.y - point.y) > 0.5 or
		math.abs(object.position.z - point.z) > 0.5 then
		return false
	end
	alife():release(object, true)
	return true
end

function capture_drop_point()
	if not db.actor then
		printf("! lz_orders: actor is not available")
		return false
	end
	local points = impl.decode_captured_drop_points()
	if #points >= CAPTURED_DROP_POINTS_LIMIT then
		printf("! lz_orders: all %d delivery points are already captured", CAPTURED_DROP_POINTS_LIMIT)
		return false
	end

	local position = db.actor:position()
	local current_level = level.name()
	for index, point in ipairs(points) do
		if point.level == current_level then
			local dx, dy, dz = position.x - point.x, position.y - point.y, position.z - point.z
			if dx * dx + dy * dy + dz * dz < 25 then
				printf(
					"! lz_orders: point is only %.2f m from captured point %02d; move at least 5 m",
					math.sqrt(dx * dx + dy * dy + dz * dz), index
				)
				return false
			end
		end
	end

	local direction = db.actor:direction()
	local point = {
		level = current_level,
		x = position.x, y = position.y, z = position.z,
		level_vertex_id = db.actor:level_vertex_id(),
		game_vertex_id = db.actor:game_vertex_id(),
		yaw = direction:getH(),
		direction_x = direction.x,
		direction_z = direction.z
	}
	local marker = alife():create(
		"lz_nm_order_dropbox", vector():set(position),
		point.level_vertex_id, point.game_vertex_id
	)
	if not marker then
		printf("! lz_orders: failed to create the captured delivery dropbox")
		return false
	end
	if marker.angle then marker.angle = vector():set(0, point.yaw, 0) end
	point.object_id = marker.id
	table.insert(points, point)
	if not impl.save_captured_drop_points(points) then
		alife():release(marker, true)
		return false
	end
	impl.print_captured_drop_point(#points, point)
	printf(
		"lz_orders: delivery point captured [%d/%d]",
		#points, CAPTURED_DROP_POINTS_LIMIT
	)
	return true
end

function dump_drop_points()
	local points = impl.decode_captured_drop_points()
	printf("lz_orders: captured delivery points [%d/%d]", #points, CAPTURED_DROP_POINTS_LIMIT)
	for index, point in ipairs(points) do impl.print_captured_drop_point(index, point) end
	return #points
end

function undo_drop_point()
	local points = impl.decode_captured_drop_points()
	if #points == 0 then
		printf("! lz_orders: there are no captured delivery points to undo")
		return false
	end
	local removed = table.remove(points)
	local object_removed = impl.release_captured_dropbox(removed)
	impl.save_captured_drop_points(points)
	printf(
		"lz_orders: removed delivery point %02d [%s | %.4f, %.4f, %.4f]; model=%s; remaining [%d/%d]",
		#points + 1, removed.level, removed.x, removed.y, removed.z,
		object_removed and "removed" or "not found",
		#points, CAPTURED_DROP_POINTS_LIMIT
	)
	return true
end

function reset_drop_points()
	if not db.actor then return false end
	for _, point in ipairs(impl.decode_captured_drop_points()) do
		impl.release_captured_dropbox(point)
	end
	xr_logic.pstor_store(db.actor, CAPTURED_DROP_POINTS_KEY, "")
	printf("lz_orders: all captured delivery points were cleared [0/%d]", CAPTURED_DROP_POINTS_LIMIT)
	return true
end

local function game_seconds()
	if not game or not level then return 0 end
	return math.max(0, math.floor(tonumber(game.get_game_time():diffSec(level.get_start_time())) or 0))
end

local function format_money(value)
	local text = tostring(math.floor(tonumber(value) or 0))
	local formatted = text
	while true do
		local changed, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1 %2")
		formatted = changed
		if count == 0 then break end
	end
	return string.format(translate("lz_order_money_format"), formatted)
end

local function format_time(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	local days = math.floor(seconds / DAY_SECONDS)
	local hours = math.floor((seconds % DAY_SECONDS) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	if days > 0 then
		return string.format(translate("lz_order_time_days_hours"), days, hours)
	elseif hours > 0 then
		return string.format(translate("lz_order_time_hours_minutes"), hours, minutes)
	end
	return string.format(translate("lz_order_time_minutes"), math.max(1, minutes))
end

local function item_name(section)
	local override = order_item_name_overrides[section]
	if override then return translate(override) end
	local ini = get_sysini()
	if not ini:section_exist(section) then return section end
	local line = ini:line_exist(section, "inv_name") and "inv_name" or "inv_name_short"
	if not ini:line_exist(section, line) then return section end
	return translate(ini:r_string(section, line))
end

local function requirement_name(requirement)
	if requirement and requirement.name then return translate(requirement.name) end
	return item_name(requirement and requirement.section or "")
end

local function forbidden_item_section(section)
	local lowered = string.lower(tostring(section or ""))
	return lowered == "hand_radio" or lowered == "af_dummy_buliz" or
		string.find(lowered, "pda", 1, true) ~= nil or
		lz_nlc_anomaly_registry.is_absolute(section)
end

local variant_item_pools = {
	medicine = {
		"medkit", "bandage", "antirad", "medkit_army", "drug_coagulant",
		"drug_radioprotector", "drug_sleep"
	},
	rations = { "bread", "kolbasa", "conserva", "energy_drink", "mineral_water", "vodka" },
	repair = {
		"jup_b200_tech_materials_wire", "jup_b200_tech_materials_capacitor",
		"jup_b200_tech_materials_transistor", "jup_b200_tech_materials_textolite",
