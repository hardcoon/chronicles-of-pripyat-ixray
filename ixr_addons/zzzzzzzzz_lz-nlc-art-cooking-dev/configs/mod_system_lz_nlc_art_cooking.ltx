; Standalone NLC 7 artifact-cooking addon. Removing the addon restores prior data.

[lz_nlc_anomaly_analyzer]:identity_immunities
GroupControlSection = spawn_group
$spawn = "devices\lz_nlc_anomaly_analyzer"
class = II_ATTCH
cform = skeleton
visual = dynamics\devices\dev_detector_1\dev_detector_1.ogf
inv_name = st_lz_nlc_anomaly_analyzer_name
inv_name_short = st_lz_nlc_anomaly_analyzer_name
description = st_lz_nlc_anomaly_analyzer_descr
icons_texture = ui\ui_lz_nlc_anomaly_analyzer
inv_grid_width = 1
inv_grid_height = 1
inv_grid_x = 0
inv_grid_y = 0
slot = -1
default_to_ruck = true
sprint_allowed = true
belt = true
inv_weight = 0.5
cost = 6500
can_trade = true
can_stack = false
quest_item = false
use_condition = false

; Dedicated developer-only container for the seven complete modification branches.
[lz_nlc_qa_art_stash]:inventory_box
$spawn = "devices\lz_nlc_qa_art_stash"
visual = dynamics\box\box_wood_01.ogf
radius = 1

; Legacy load compatibility for saves that still contain the removed startup
