[logic]
active = {+pf_story_path_continues_achievement_gained +pf_story_preacher_reunion_finished} remark@entrance_idle, {+pf_story_path_continues_achievement_gained} remark@entrance_dialog, {+pf_story_preacher_attacked} remark@hostile, remark@campfire_prayer
; Lua is the single relation owner: hostile/red after note 10, neutral after
; note 12. A root relation here is reapplied on section changes and used to
; restore a saved personal -1000 goodwill after the reunion.
on_hit = hit@preacher
on_death = death@preacher

; The generic hit checker is created only when [logic] has on_hit. Lua uses
; storage.hit to distinguish a real shot from the actor before enabling combat.
[hit@preacher]
on_info = {+pf_story_preacher_attacked} remark@hostile

[remark@campfire_prayer]
anim = pf_story_sergey_sit_fixed
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
use_camp = false

; Compatibility for saves made while the former preacher sequence was active.
; Both legacy sections now resolve to the passive seated state.
[remark@face_actor]:remark@campfire_prayer

[remark@sermon]:remark@campfire_prayer

[remark@hostile]
anim = threat
target = story | actor
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[remark@entrance_dialog]
anim = pf_story_sergey_sit_fixed
meet = meet@spare
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
use_camp = false
on_info = {+pf_story_preacher_reunion_finished} remark@entrance_idle

[meet@spare]
; xr_meet starts action_meet_wait whenever close/far distance is non-zero.
; That action clears desired direction even with nil anim/victim, so keep its
; contact state disabled and use the scheme only to expose the dialog action.
close_distance = 0
close_anim = nil
close_snd_hello = nil
close_snd_bye = nil
close_victim = nil
far_distance = 0
far_anim = nil
far_victim = nil
far_snd = nil
meet_on_talking = false
trade_enable = false
use = {+pf_story_path_continues_achievement_gained -pf_story_pendant_found -pf_story_preacher_reunion_finished} true, false
meet_dialog = pf_story_preacher_spare_dialog
abuse = false

[remark@entrance_idle]
anim = pf_story_sergey_sit_fixed
meet = no_meet
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
use_camp = false

[death@preacher]
on_info = %+pf_story_preacher_dead =stop_sound%
