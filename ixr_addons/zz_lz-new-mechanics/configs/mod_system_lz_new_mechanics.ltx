; Chronicles of Pripyat 4.26 / IX-Ray - self-contained IWP mechanics adaptation.
; Remove or rename the parent addon folder to disable all of these changes.

; Keep native IX-Ray artefact condition wear disabled for every artefact
; derived from af_base.
![af_base]
use_condition = false
degrade_rate = 0

; Polarity reuses the Altered Wheel icon and world model. Its unique attraction
; is implemented by lz_nm_polarity only while this exact section is on the belt.
