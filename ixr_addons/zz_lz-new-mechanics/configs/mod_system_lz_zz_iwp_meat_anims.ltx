hands_orientation = 0.0, 0.0, 0.0
hands_orientation_16x9 = 0.0, 0.0, 0.0
item_attached = false
sound_1 = $silent
disable_input = false
disable_key_input = false
disable_ui_input = false
hide_gasmask = false
restore_weapon = true
dof = 0.0, 0.0, 0.0, 0.0
start_lua_callback = pf_hf_iwp_preview.on_started
end_lua_callback = pf_hf_iwp_preview.on_finished

