[meat_cook_use]:animator_base
; Original IWP [meat_cook_use] model, paired motion and zero origin.
hands_position = 0.000, 0.000, 0.000
hands_position_16x9 = 0.000, 0.000, 0.000
item_attached = true
item_visual = dynamics\weapons\wpn_eat\harvest\meat_1\wpn_meat_cook_hud.ogf
item_position = 0.000, 0.000, 0.000
item_orientation = 0.000, 0.000, 0.000
anm_show = meat_eat, meat_eat_hud
disable_ui_input = true
hide_gasmask = true
dof = 0.0, 0.5, 5, 5.7
; Original IWP track; HUD gain doubled after the user's in-game listening check.
; 0.42 -> 0.84 adds 6 dB; the recording and other food sounds are unchanged.
; Animated food suppresses use_sound; the animator starts/stops this track.
sound_1 = interface\item_usage\meat_use, 0.84

; Manual previews remain available through run_string and never consume food.
[pf_hf_iwp_preview_base]:animator_base
