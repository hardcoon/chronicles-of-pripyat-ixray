-- Shared, dependency-free helpers for the Chronicles of Pripyat mechanics modules.
-- This module never registers engine callbacks; lz_new_mechanics owns them.

-- system_ini() is unsafe while CScriptEngine is still importing this module.
-- Resolve and cache it on the first gameplay call instead of during script init.
local state = {}
local impl = {}

function get_sysini()
	if not state.sysini then
		state.sysini = system_ini()
	end
	return state.sysini
end

function canonical_item_section(section)
	-- Old saves may still contain the former armor-only kit. Treat it as the
	-- unified disassembly kit without invalidating the saved object section.
	if section == "lz_nm_armor_disassembly_kit" then
		return "lz_nm_weapon_disassembly_kit"
	end
	return section
end

function message(text_id)
	if db.actor and news_manager and news_manager.send_tip then
		news_manager.send_tip(db.actor, text_id, nil, nil, nil, nil)
	end
end

function server_object(item)
	return item and alife():object(item:id(), true) or nil
end

function is_actor_owned_item(item)
	if not item or not db.actor then return false end
	local object = server_object(item)
	return object ~= nil and tonumber(object.parent_id) == db.actor:id()
end

function require_actor_owned_item(item)
	if is_actor_owned_item(item) then return true end
	message("lz_nm_action_requires_inventory")
	return false
end

function release_item(item)
	local object = server_object(item)
	if object then
		alife():release(object, true)
	end
end

function create_for_actor(section)
	if not db.actor then return nil end
	return alife():create(
		section,
		db.actor:position(),
		db.actor:level_vertex_id(),
		db.actor:game_vertex_id(),
		db.actor:id()
	)
end

function is_weapon(item)
	if not item then return false end
	-- weapon_classes is local to _g.script in the donor and therefore cannot be
	-- accessed through _G. Use the public engine helper when it is available.
	if type(IsWeapon) == "function" and IsWeapon(item) then return true end

	-- Keep a config fallback for builds whose packed _g.script does not export
	-- IsWeapon. system_ini() contains inherited values as well.
	local section = item:section()
	if not get_sysini():line_exist(section, "class") then return false end
	local class = get_sysini():r_string(section, "class")
	if not class or string.sub(class, 1, 3) ~= "WP_" then return false end
	return class ~= "WP_SCOPE" and class ~= "WP_SILEN" and class ~= "WP_GLAUN"
end

function is_weapon_mechanics_target(item)
	if not is_weapon(item) then return false end
	local section = item:section()
	if section == "wpn_binoc" or section == "mp_wpn_binoc" or
		section == "wpn_knife" or section == "wpn_knife_mp" or
		section == "mp_wpn_knife" then return false end
	if get_sysini():line_exist(section, "class") then
		local class = get_sysini():r_string(section, "class")
		if class == "WP_BINOC" or class == "WP_KNIFE" then return false end
	end
	return true
end

function item_slot(item)
	if not item then return -1 end
	local section = item:section()
	if not get_sysini():line_exist(section, "slot") then return -1 end
	return tonumber(get_sysini():r_string(section, "slot")) or -1
end

function is_helmet(item)
	if not item then return false end
	if type(IsHeadgear) == "function" and IsHeadgear(item) then return true end

	local slot = item_slot(item)
	if slot == 11 then return true end
	local section = item:section()
	if not get_sysini():line_exist(section, "class") then return false end
	local class = get_sysini():r_string(section, "class")
	return class == "E_HLMET"
end

function is_outfit_or_helmet(item)
	if not item then return false end
	if is_helmet(item) then return true end
	if type(IsOutfit) == "function" and IsOutfit(item) then return true end

	-- Config slots are zero-based (6/11), while actor:item_in_slot() below uses
	-- the corresponding one-based script slots (7/12).
	local slot = item_slot(item)
	if slot == 6 then return true end
	local section = item:section()
	if not get_sysini():line_exist(section, "class") then return false end
	return get_sysini():r_string(section, "class") == "E_STLK"
end

function refresh_actor_menu()
	local menu = ActorMenu and ActorMenu.get_actor_menu and ActorMenu.get_actor_menu() or nil
	if menu and menu:IsShown() then
		menu:UpdateConditionProgressBars()
		menu:refresh_current_cell_item()
	end
end

function item_display_name(item)
	if not item then return nil end
	local section = item:section()
	local line = get_sysini():line_exist(section, "inv_name_short") and "inv_name_short" or "inv_name"
	if not get_sysini():line_exist(section, line) then return section end
	return game.translate_string(get_sysini():r_string(section, line))
end

-- CStringTable returns translated text as UTF-8, but CInifile::w_string and
-- the legacy inventory font path expect Windows-1251. Convert generated menu
-- labels before placing them into system_ini; otherwise Cyrillic is displayed
-- as strings such as "РџРѕС‡РёРЅРёС‚СЊ".
local cp1251_by_codepoint = {
	[0x0401] = 0xA8, [0x0451] = 0xB8,
	[0x0402] = 0x80, [0x0403] = 0x81, [0x0453] = 0x83,
	[0x0409] = 0x8A, [0x040A] = 0x8C, [0x040C] = 0x8D,
	[0x040B] = 0x8E, [0x040F] = 0x8F, [0x0452] = 0x90,
	[0x0459] = 0x9A, [0x045A] = 0x9C, [0x045C] = 0x9D,
	[0x045B] = 0x9E, [0x045F] = 0x9F, [0x040E] = 0xA1,
	[0x045E] = 0xA2, [0x0408] = 0xA3, [0x0490] = 0xA5,
	[0x0404] = 0xAA, [0x0407] = 0xAF, [0x0406] = 0xB2,
	[0x0456] = 0xB3, [0x0491] = 0xB4, [0x0454] = 0xBA,
	[0x0458] = 0xBC, [0x0405] = 0xBD, [0x0455] = 0xBE,
	[0x0457] = 0xBF, [0x00AB] = 0xAB, [0x00BB] = 0xBB,
	[0x201A] = 0x82, [0x201E] = 0x84, [0x2026] = 0x85,
	[0x2020] = 0x86, [0x2021] = 0x87, [0x20AC] = 0x88,
	[0x2030] = 0x89, [0x2039] = 0x8B, [0x2018] = 0x91,
	[0x2019] = 0x92, [0x201C] = 0x93, [0x201D] = 0x94,
	[0x2022] = 0x95, [0x2013] = 0x96, [0x2014] = 0x97,
	[0x2122] = 0x99, [0x203A] = 0x9B, [0x2116] = 0xB9,
	[0x00A0] = 0xA0, [0x00A4] = 0xA4, [0x00A6] = 0xA6,
	[0x00A7] = 0xA7, [0x00A9] = 0xA9, [0x00AC] = 0xAC,
	[0x00AD] = 0xAD, [0x00AE] = 0xAE, [0x00B0] = 0xB0,
	[0x00B1] = 0xB1, [0x00B5] = 0xB5, [0x00B6] = 0xB6,
	[0x00B7] = 0xB7
}

local codepoint_by_cp1251 = {}
for codepoint, byte in pairs(cp1251_by_codepoint) do
	codepoint_by_cp1251[byte] = codepoint
end

function impl.is_valid_utf8(text)
	local index = 1
	while index <= #text do
		local first = string.byte(text, index)
		if first < 0x80 then
			index = index + 1
		elseif first >= 0xC2 and first <= 0xDF then
			local second = string.byte(text, index + 1)
			if not second or second < 0x80 or second > 0xBF then return false end
			index = index + 2
		elseif first >= 0xE0 and first <= 0xEF then
			local second = string.byte(text, index + 1)
			local third = string.byte(text, index + 2)
			if not second or not third or second < 0x80 or second > 0xBF or
				third < 0x80 or third > 0xBF then return false end
			if first == 0xE0 and second < 0xA0 then return false end
			if first == 0xED and second > 0x9F then return false end
			index = index + 3
		elseif first >= 0xF0 and first <= 0xF4 then
			local second = string.byte(text, index + 1)
			local third = string.byte(text, index + 2)
			local fourth = string.byte(text, index + 3)
			if not second or not third or not fourth or
				second < 0x80 or second > 0xBF or
				third < 0x80 or third > 0xBF or
				fourth < 0x80 or fourth > 0xBF then return false end
			if first == 0xF0 and second < 0x90 then return false end
			if first == 0xF4 and second > 0x8F then return false end
			index = index + 4
		else
			return false
		end
	end
	return true
end

function impl.utf8_to_cp1251(text)
	-- Original game item names are already CP1251. Only convert strings that
	-- are valid UTF-8; otherwise preserve their bytes exactly as supplied.
	if not impl.is_valid_utf8(text) then return text end
	local result = {}
	local index = 1
	while index <= #text do
		local first = string.byte(text, index)
		local codepoint
		local length = 1
		if first < 0x80 then
			codepoint = first
		elseif first >= 0xC2 and first <= 0xDF and index + 1 <= #text then
			codepoint = (first - 0xC0) * 0x40 + (string.byte(text, index + 1) - 0x80)
			length = 2
		elseif first >= 0xE0 and first <= 0xEF and index + 2 <= #text then
			codepoint = (first - 0xE0) * 0x1000 +
				(string.byte(text, index + 1) - 0x80) * 0x40 +
				(string.byte(text, index + 2) - 0x80)
			length = 3
		else
			-- Preserve an already-ANSI byte and malformed input byte-for-byte.
			table.insert(result, string.char(first))
			index = index + 1
			codepoint = nil
		end

		if codepoint then
			local encoded = cp1251_by_codepoint[codepoint]
			if codepoint < 0x80 then
				encoded = codepoint
			elseif codepoint >= 0x0410 and codepoint <= 0x044F then
				encoded = codepoint - 0x0350
			end
			table.insert(result, encoded and string.char(encoded) or "?")
			index = index + length
		end
	end
	return table.concat(result)
end

function impl.cp1251_to_utf8(text)
	-- Names typed into CUIEditBox are stored as CP1251. Keep strings that are
	-- already UTF-8 intact and convert only legacy single-byte values before
	-- combining them with UTF-8 localization templates.
	if impl.is_valid_utf8(text) then return text end
	local result = {}
	for index = 1, #text do
		local byte = string.byte(text, index)
		local codepoint = byte
		if byte >= 0xC0 then
			codepoint = byte + 0x0350
		elseif byte >= 0x80 then
			codepoint = codepoint_by_cp1251[byte] or 0x003F
		end

		if codepoint < 0x80 then
			table.insert(result, string.char(codepoint))
		elseif codepoint < 0x800 then
			table.insert(result, string.char(
				0xC0 + math.floor(codepoint / 0x40),
				0x80 + codepoint % 0x40
			))
		else
			table.insert(result, string.char(
				0xE0 + math.floor(codepoint / 0x1000),
				0x80 + math.floor(codepoint / 0x40) % 0x40,
				0x80 + codepoint % 0x40
			))
		end
	end
	return table.concat(result)
end

function text_for_legacy(value)
	return impl.utf8_to_cp1251(tostring(value or ""))
end

function text_for_utf8(value)
	return impl.cp1251_to_utf8(tostring(value or ""))
end
