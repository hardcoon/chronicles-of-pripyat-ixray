![common]
>script = pf_indoor_light

[pf_indoor_light_effect]
enabled = true
levels = *
tonemap_amount = 0.90      ; значение стандартного r2_tonemap_amount в помещении
transition_seconds = 2.0   ; длительность плавного перехода
effect_update_interval_ms = 50 ; шаг обновления только во время перехода

[pf_indoor_light_detection]
check_interval_ms = 1000   ; период проверки статической геометрии
settings_reload_interval_ms = 10000 ; перечитывание LTX в игре; 0 = только при загрузке
debug_log_interval_ms = 5000 ; период записи диагностики в лог; 0 = выключено
roof_radius_m = 2.4        ; радиус проверки крыши вокруг героя
roof_range_m = 20.0       ; учитывает высокие потолки больших залов
roof_min_clearance_m = 1.8 ; отсеивает низкий зонт или навес над героем
roof_enter_hits = 5        ; центр обязателен, остальные точки дают покрытие крыши
roof_exit_hits = 4         ; мягкий порог удержания внутри помещения
roof_wide_radius_m = 6.0   ; широкий круг крыши для центра больших залов
roof_wide_enter_hits = 6  ; не менее трёх четвертей широкого круга под крышей
roof_wide_exit_hits = 6   ; гистерезис широкого покрытия
roof_wide_min_wall_hits = 2 ; навес без стен помещением не считается
roof_wide_wall_range_m = 30.0 ; дальний поиск стен только под широкой крышей
wall_range_m = 18.0        ; стены могут находиться далеко от центра большого зала
wall_lower_height_m = 0.6  ; ниже большинства подоконников
wall_upper_height_m = 2.4  ; выше окон, парапетов и оград
wall_height_tolerance_m = 4.0 ; допускает неровные и разрушенные стены, но не дальний дом
wall_enter_hits = 5        ; вход по пяти из шестнадцати направлений
wall_exit_hits = 3         ; более мягкое удержание в больших оконных залах
wall_enter_pairs = 1       ; хотя бы одна противоположная пара обязательна
wall_exit_pairs = 1
exit_missed_checks = 5     ; выход только после пяти неудачных проверок подряд
max_passthrough = 2        ; пропуск тонких и прозрачных материалов
ignored_material_indices = 6,10,13,20,23,45,47,51,52,55,58,59,60,61,62
