; =============================================================================
; ПРИПЯТЬ-4: НАСТРОЙКИ IRC-МОСТА И МЕНЮ КОМАНД
; =============================================================================
; Этот файл читают pf_irc_bridge.exe и Lua-интерфейс КПК. Изменение параметров
; не требует пересборки pf_irc_bridge.exe.
;
; Когда применяются изменения:
; - параметры [bridge] — после ручного Disconnect/Authorize или перезапуска;
; - секции [commands] и [command_*] — при следующем открытии меню «Команды».
;
; Формат:
; - логические значения: true/false (также понимаются 1/0 и yes/no);
; - списки: значения через запятую;
; - строки, начинающиеся с ;, являются комментариями.
;
; ВАЖНО ДЛЯ ПОРТОВ И СБОРОК НА ОСНОВЕ АДДОНА:
; - адрес, порт, TLS, канал, JOIN-ключ, кодировка и ник находятся не здесь,
;   а в configs\pf_irc_chat_profiles.ltx и пользовательском профиле КПК;
; - не добавляйте сюда пароль NickServ, пароль владельца или другие секреты;
; - при переносе создайте собственный IRC-канал и замените штатный JOIN-ключ.
; Неверное значение игнорируется; мост использует встроенное безопасное
; значение и пишет причину в диагностический журнал.

[bridge]
; ---------- Резервные IRC-узлы ---------------------------------------------
; false: каждое подключение использует только адрес активного профиля КПК.
; true: после неудачи мост перебирает failover_nodes по порядку, но ТОЛЬКО
; если адрес активного профиля точно совпадает с failover_primary.
; Порт, TLS, канал и ключ у всех резервных узлов остаются от активного профиля.
failover_enabled = false

; Основной узел, для которого разрешено переключение на резервы.
; Только имя хоста: без irc://, https://, порта, слешей и пробелов.
failover_primary = nexus.hybridirc.com

; Резервные хосты через запятую, максимум 16 уникальных записей.
; Балансировщик irc.hybridirc.com оставлен последним запасным вариантом.
failover_nodes = sirius.hybridirc.com, irc.hybridirc.com

; ---------- Heartbeat: защита простаивающего TCP/TLS-соединения ------------
; Heartbeat отправляет служебный IRC PING самому серверу. Он не публикует
; сообщения в канал и не виден другим игрокам. Серверный PING всегда получает
; немедленный PONG независимо от этой настройки.
heartbeat_enabled = true

; Через сколько секунд без ВХОДЯЩЕГО IRC-трафика отправить контрольный PING.
; Допустимо 1..3600 секунд. Слишком малое значение создаёт лишний трафик.
heartbeat_idle_seconds = 60

; Сколько секунд ждать ответ PONG на наш контрольный PING.
; Допустимо 1..3600 секунд. Слишком малое значение даёт ложные тайм-ауты.
heartbeat_reply_timeout_seconds = 60

; Сколько контрольных PING подряд может остаться без ответа перед reconnect.
; Допустимо 1..10. При текущих 60/60/3 мост терпит несколько минут тишины.
heartbeat_missed_limit = 3

; ---------- Статус присутствия Online/Away --------------------------------
; Задержка стабилизации в миллисекундах, допустимо 100..60000.
; Быстрые открытия/закрытия КПК не создают очередь AWAY-команд: ожидающее
; значение заменяется новым, после задержки отправляется только итоговый статус.
presence_debounce_ms = 3000

; ---------- Повторное подключение ------------------------------------------
; Задержки между попытками reconnect в секундах. Используются слева направо,
; затем последнее значение повторяется. От 1 до 16 значений, каждое 1..3600.
; Автоматический reconnect запускается только если сессия хотя бы раз успешно
; дошла до канала; ошибка первой авторизации остаётся на экране входа.
reconnect_delays_seconds = 15, 30, 60, 120, 300

; Через сколько секунд готовой сессии считать соединение стабильным и сбросить
; лестницу reconnect к первой задержке. Допустимо 1..3600 секунд.
stable_connection_seconds = 300

; Тайм-аут одного TCP-подключения к IRC-узлу. Это не тайм-аут JOIN/ChanServ.
; Допустимо 1..300 секунд.
connect_timeout_seconds = 15

; =============================================================================
; МЕНЮ «КОМАНДЫ» В КПК
; =============================================================================
; Эти секции читает Lua-интерфейс. Они управляют порядком, видимостью и текстом,
; подставляемым в поле ввода, а не разрешениями IRC-сервера.
; Поддерживаются только ID: clear, query, mute, unmute, close, channel.
; Неизвестные ID игнорируются. Пропущенный известный ID всё равно добавится в
; конец стандартного порядка; чтобы скрыть команду, задайте enabled = false.
[commands]
; Порядок сверху вниз в выпадающем меню.
order = channel, query, unmute, mute, close, clear

[command_clear]
; enabled: показывать пункт меню.
; scope = all: показывать и в общем канале, и в личном диалоге.
; /clear очищает только локальную историю выбранного диалога/канала.
enabled = true
scope = all
insert = /clear

[command_query]
; /query Nick открывает или создаёт локальный личный диалог с IRC-ником.
; append_space = true добавляет пробел после команды для удобного ввода ника.
enabled = true
scope = all
insert = /query
append_space = true

[command_mute]
; /mute Nick локально скрывает сообщения и уведомления выбранного IRC-ника.
enabled = true
scope = all
insert = /mute
append_space = true

[command_unmute]
; /unmute Nick снимает локальное скрытие IRC-ника.
enabled = true
scope = all
insert = /unmute
append_space = true

[command_close]
; scope = private: пункт виден только внутри личного диалога.
; /close закрывает выбранный личный диалог локально.
enabled = true
scope = private
insert = /close

[command_channel]
; /channel возвращает из личного диалога в общий канал.
enabled = true
scope = private
insert = /channel
