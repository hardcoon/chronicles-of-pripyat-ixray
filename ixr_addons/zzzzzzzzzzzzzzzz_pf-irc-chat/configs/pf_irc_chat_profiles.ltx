; Immutable connection defaults shipped with the addon.
; Runtime edits are written to $app_data_root$\pf_irc_chat\profiles.ltx.

[general_default]
enabled = true
auto_login = false
active_profile = hybridirc
notify_public_messages = true
sound_public_messages = false
notify_private_messages = true
sound_private_messages = true

[profile_hybridirc_default]
address = nexus.hybridirc.com
channel = #chronicles_of_pripyat
port = 6697
tls = true
key = STARTPRIPYAT
encoding = utf-8
nick =
require_registered_channel = true
required_modes = knst
