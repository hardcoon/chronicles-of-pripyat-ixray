# Never publish rollback or cache output, even inside an admitted source tree.
**/*.bak
**/*.backup
**/*.log
**/*.dmp
**/*.pdb
**/__pycache__/
**/*.py[cod]

# Windows/macOS metadata is never part of the product or a Release package.
[Tt]humbs.db
[Ee]hthumbs.db
[Dd]esktop.ini
.DS_Store
