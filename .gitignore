# Delta/source repository: the installed base game stays ignored. Product
# overrides are admitted explicitly below so `git add` cannot accidentally
# stage the multi-gigabyte distribution.
*

!/.gitignore
!/.gitattributes
!/README.md
!/fsgame.ltx

# Runtime is generated per installation and is never source material.
/userdata/
/imgui.ini

# Internal project documentation stays local and is never published.
/docs/

# Development tools and launcher source stay local outside the public product tree.
/tools/
/launcher/
/.launcher/
/.launcher-cache/

