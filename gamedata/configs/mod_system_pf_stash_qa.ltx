inv_grid_y = 0

; Crosshair-only rejection and live deletion tool. It first records the exact
; physical stash under the reticle, then removes that ALife object from the game.
; Compatibility section for existing saves only. Its 33-character section name
; overflows the engine's 32-byte quick-slot buffer, so Lua replaces it on load.
[pf_stash_crosshair_rejection_tool]:pf_stash_rejection_tool
$spawn = "food and drugs\pf_stash_crosshair_rejection_tool"
; Engine safeguard: 2x1 items are rejected before the unsafe quick-slot copy.
inv_grid_width = 2
inv_name = pf_stash_crosshair_rejection_tool_name
inv_name_short = pf_stash_crosshair_rejection_tool_name
description = pf_stash_crosshair_rejection_tool_descr
inv_grid_x = 7
inv_grid_y = 0
; Native Use (double-click / quick slot) is handled by OnInventoryEat and
; records + deletes the stash under the crosshair. Keep only the secondary
; nearest-stash operation as an explicit context-menu action.
use1_text = pf_stash_rejection_tool_use
use1_functor = pf_stash_qa.use_stash_rejection_tool

