; Registration of data belonging to the pripyat_full location.
; This file extends the stock Call of Pripyat lists through DLTX and avoids
; replacing system.ltx with the incompatible IWP/CoC version.

#include "zones\mod_zones_pripyat_full.ltx"

; Keep the original IWP late-afternoon start, but set the calendar to the
; 30th anniversary of the Chernobyl disaster.
![alife]
start_date = 26.04.2016
start_time = 16:30:00

![info_portions]
>files = info_pripyat_full

![dialogs]
>files = dialogs_pripyat_full, dialogs_pf_yanov_trapper, dialogs_pf_yanov_nimble

![profiles]
>files = npc_profile_pripyat_full, npc_profile_pf_yanov_nimble
>specific_characters_files = character_desc_pripyat_full, character_desc_pf_yanov_nimble

