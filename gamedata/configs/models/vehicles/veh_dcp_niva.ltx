; White Lost Alpha Definitive Car Pack Niva for the opt-in IX-Ray profile.
; This file is embedded verbatim into veh_dcp_niva.ogf UserData.
; Doors, physical hood (front_door) and trunk (back_door) are interactive.

[disable]
linear_factor = 0.3
angular_factor = 0.3

[car_definition]
vehicle_feature_profile = dcp_white_niva
fuel_profile = dcp_vehicle_fuel_v1
collision_sound_profile = dcp_vehicle_collision_v1
part_damage_mode = body_only
trunk_use_mode = open_inventory
trunk_use_distance = 3.5
; Interaction follows the complete visual back_door OBB. This small padding
; only makes the panel edge easier to aim at and does not change collision.
trunk_interaction_padding = 0.08, 0.08, 0.08
trunk_interaction_offset = 0.0, 0.0, 0.0
trunk_close_on_inventory_exit = true
durability_factor = 3.0
interior_volume = 0.5

camera_pos = -0.394, 1.5, -0.1
camera_pos_firsteye = -0.394, 1.5, -0.1
camera_pos_lookat = 0.0, 1.74, 0.0
camera_pos_free = 0.0, 1.71, 0.0
camera_dynamics_profile = vehicle_comfort_v1
; These donor fields remain compatibility data and never delay the seat in
; world space. The named global profile owns all runtime camera tuning.
camera_inertion_n = 0
camera_inertion_k = 0
camera_angle_factor = 1.08
door_air_resistance_scale = 0.001

driving_wheels = back_left_wheel, back_right_wheel, front_left_wheel, front_right_wheel
steering_wheels = front_left_wheel, front_right_wheel
breaking_wheels = front_left_wheel, front_right_wheel, back_left_wheel, back_right_wheel
doors = left_door, right_door, front_door
steer = stearing_wheel
stearing_wheel_factor = 6
driver_place = seat_left
exhausts = exhausts
damage = damage_bones
trunk_bone = back_door
collision_hit_threshold = 0.2
hit_stall_threshold = 0.1

; Exact veh_niva_u_02 defaults recovered from the donor DLL. The white Niva
; does not override these values in its original LTX, so neutral coefficients
; and the donor's slow nonlinear steering ramp are the source of truth.
slip_sliding_threshold = 0.6
vel_sliding_threshold = 5
wheels_spin_factor_start = 0.75
wheels_spin_factor_stop = 0.8
friction_slip_factor = 1.0
friction2_slip_factor = 1.0
friction_spin_factor = 1.0
friction2_spin_factor = 1.0
friction_slip_speed = 0.005
contact_slip_scale = 0.0
friction2_steering_wheels = 1.0
friction2_nonsteering_wheels = 1.0
friction2_brp_boost = 1.0
handbrake_rpm_threshold = 2.0
handbrake_rpm_decrease = 1.0
drift_start_boost = 0.0
drift_boost_time = 0.25
steer_spin_boost = 0
steer_speed_boost = 0.0
steer_turn_factor = 1.0
steer_counter_turn_factor = 0.5
steer_turn_compensation = 0.5
steer_turn_compensation_max = 0.3
steer_turn_delta = 0.2
brake_boost = 1.0

fuel_tank = 42
fuel_consumption = 7
engine_power = 8.6
max_power_rpm = 3900
max_torque_rpm = 1650
sound_rpm = 3250
power_increment_factor = 0.012
power_decrement_factor = 0.24
rpm_increment_factor = 0.1
rpm_decrement_factor = 0.2
rpm_brp_increment_factor = 0.9
rpm_brp_decrement_factor = 0.9
