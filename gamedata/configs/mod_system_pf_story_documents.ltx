[pf_guardian_seva_outfit]:monolith_scientific_outfit
$spawn = "outfit\pf_guardian_seva_outfit"
inv_name = pf_guardian_seva_outfit_name
inv_name_short = pf_guardian_seva_outfit_name
description = pf_guardian_seva_outfit_descr
cost = 0
can_trade = false
radiation_restore_speed = -0.004
; Keep the unique suit on the regular SEVA upgrade tree explicitly. This is
; intentionally declared here instead of relying only on parent inheritance,
; so mechanics and the upgrade UI treat this quest section as a full suit.
upgrades = up_gr_firstab_scientific_outfit, up_gr_seconab_scientific_outfit, up_gr_thirdab_scientific_outfit, up_gr_fourtab_scientific_outfit, up_gr_fifthab_scientific_outfit
installed_upgrades =
upgrade_scheme = upgrade_scheme_scientific_outfit

