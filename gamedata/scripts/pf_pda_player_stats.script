-- Local counters and persistent IRC observations for the PDA player cards.
local tiers = { "green", "cyan", "purple", "orange", "red" }
local tier_weights = { 1, 2, 3, 5, 10 }
local appearance_state = { revision = 0 }
local sort_indices = { mutants = 1, stalkers = 2, days = 3, stashes = 4, artifacts = 5 }
local sort_options = {
    { key = "sort_field", default = "rank", values = { "rank", "mutants", "stalkers", "days", "artifacts", "stashes" } },
    { key = "sort_order", default = "desc", values = { "desc", "asc" } },
    { key = "status_order", default = "any", values = { "any", "online_first", "offline_first" } }
}

function sorting_options() return sort_options end

local function sort_value(record, field)
    local index = sort_indices[field]
    if not index then return record.rank end
    local values = record.values
    return values and not values.no_data and tonumber(values[index]) or nil
end

local function trim(value)
    return tostring(value or ""):match("^%s*(.-)%s*$")
end

local function count(value)
    return math.max(0, math.floor(tonumber(value) or 0))
end

local function player_name()
    local irc = rawget(_G, "pf_irc_chat")
    local nick = ""
    if irc and irc.get_state then
        local state = irc.get_state()
        if state and state.authorized then nick = trim(state.effective_nick) end
    end
    if nick == "" and irc and irc.get_active_profile then
        local profile = irc.get_active_profile()
        nick = trim(profile and profile.nick)
    end
    if nick ~= "" then
        local codec = rawget(_G, "pf_irc_text_codec")
        return codec and codec.to_ui and codec.to_ui(nick) or nick
    end
    return db.actor:character_name()
end

function developer_marked()
    local actor = db and db.actor
    return actor ~= nil and db.storage ~= nil and db.storage[actor:id()] ~= nil and
        (xr_logic.pstor_retrieve(actor, "pf_developer_achievement_gained", false) == true or
         xr_logic.pstor_retrieve(actor, "pf_spawner_used", false) == true)
end

local function local_appearance()
    local actor, avatar, armor = db.actor, 0, 0
    avatar = pf_player_appearance.local_avatar()
    -- Ask the engine for the equipped outfit; LTX and Lua slot IDs differ.
    -- The transport calls packet at most once per second, not every frame.
    local ok, section = pcall(function()
        local outfit = actor:get_current_outfit()
        return outfit and outfit:section() or nil
    end)
    if ok then armor = pf_player_appearance.outfit_id(section) end
    return avatar, armor
end

function local_values()
    if not db or not db.actor then return nil end
    if developer_marked() then return { no_data = true } end
    local stats = xr_statistic.actor_statistic or {}
    local manager, total, stash_score = rawget(_G, "pf_dynamic_stashes"), 0, 0
    if manager and manager.get_searched_stash_count then
        for index, tier in ipairs(tiers) do
            local found = count(manager.get_searched_stash_count(tier))
            total = total + found
            stash_score = stash_score + found * tier_weights[index]
        end
    end
    local values = { count(stats.killed_monsters), count(stats.killed_stalkers),
        count(game.get_game_time():diffSec(level.get_start_time()) / 86400),
        total, count(stats.artefacts_founded) }
    values[6] = values[1] + values[2] + values[3] + values[5] + stash_score
    values.avatar_id, values.armor_id = local_appearance()
    return values
end

function packet()
    local values = local_values()
    local payload = values and (values.no_data and "" or pf_player_stats_wire.encode(values)) or nil
    appearance_state.packet = payload
    return payload
end

function rank(values) return values and pf_player_stats_wire.rank(values) or nil end

function lines(values)
    if not values or values.no_data then return game.translate_string("pf_pda_player_stats_unknown"), "" end
    return string.format(game.translate_string("pf_pda_player_stats_kills"),
        values[1], values[2], values[3]),
        string.format(game.translate_string("pf_pda_player_stats_stashes"), values[4], values[5])
end

function card_lines(values)
    if not values or values.no_data then return game.translate_string("pf_pda_player_stats_unknown"), "" end
    return string.format(game.translate_string("pf_pda_player_stats_card_kills"), values[1], values[2], values[3]),
        string.format(game.translate_string("pf_pda_player_stats_card_found"), values[5], values[4])
end

function get_rows(filters)
    filters = filters or {}
    local irc = rawget(_G, "pf_irc_chat")
    local status = irc and irc.get_state() or {}
    local profile = irc and irc.get_active_profile() or {}
    local identity = pf_irc_chat_config.get_identity(false)
    local own_id = identity and ("install:" .. identity.install_id:lower()) or ""
    local own_nick = status.effective_nick or profile.nick or ""
    local connected = status.any_channel_ready
    if connected == nil then connected = status.ready end
    local result = {}
    for _, record in ipairs(pf_player_stats_cache.records(profile)) do
        local own_record = own_id ~= "" and record.identity == own_id
        local own_pending_nick = not pf_player_stats_cache.is_confirmed(record.identity) and
            pf_player_stats_cache.canonical_nick(record.nick) ==
                pf_player_stats_cache.canonical_nick(own_nick)
        if not own_record and not own_pending_nick then
            result[#result + 1] = { nick = pf_irc_text_codec.to_ui(record.nick), irc_nick = record.nick,
                sort_nick = record.nick:lower(), identity = record.identity,
                values = record.values, presence = record.presence, rank = rank(record.values) }
        end
    end
    local values = local_values()
    if values and pf_player_stats_cache.has_copid(own_id) and not pf_player_stats_cache.is_operator(profile, own_id) then
        result[#result + 1] = { nick = player_name(), sort_nick = player_name():lower(), own = true,
            identity = own_id, values = values, rank = rank(values),
            presence = connected and (status.presence or "away") or "offline" }
    end
    local visible = {}
    for _, record in ipairs(result) do
        local has_data = record.values and not record.values.no_data
        local connected = record.presence == "online" or record.presence == "away"
        if (filters.include_blocked == true or not pf_player_stats_cache.is_blocked(record.identity)) and
            (filters.show_empty == true or has_data) and
            (not filters.online_only or connected) then
            visible[#visible + 1] = record
        end
    end
    table.sort(visible, function(a, b)
        if filters.status_order == "online_first" or filters.status_order == "offline_first" then
            local a_on = a.presence == "online" or a.presence == "away"
            local b_on = b.presence == "online" or b.presence == "away"
            if a_on ~= b_on then
                if filters.status_order == "online_first" then return a_on end
                return not a_on
            end
        end
        local a_value, b_value = sort_value(a, filters.sort_field), sort_value(b, filters.sort_field)
        -- Missing counters always stay last within their status group, even
        -- for ascending order. Real zeroes remain valid sortable data.
        if (a_value == nil) ~= (b_value == nil) then return a_value ~= nil end
        if a_value ~= b_value then
            if filters.sort_order == "asc" then return a_value < b_value end
            return a_value > b_value
        end
        if a.sort_nick ~= b.sort_nick then return a.sort_nick < b.sort_nick end
        return a.identity < b.identity
    end)
    return visible
end

function bind_self(nick)
    local identity = pf_irc_chat_config.get_identity(false)
    return pf_player_stats_cache.bind_self(pf_irc_chat.get_active_profile(), nick,
        identity and ("install:" .. identity.install_id:lower()) or nil)
end

function sync(profile, channels) return pf_player_stats_cache.sync(profile, channels) end
function flush(defer) return pf_player_stats_cache.flush(defer) end
function revision()
    local signature = tostring(pf_player_stats_cache.revision()) .. ":" ..
        tostring(appearance_state.packet) .. ":" .. tostring(developer_marked()) .. ":" ..
        tostring(pf_player_appearance.local_avatar())
    if signature ~= appearance_state.signature then
        appearance_state.signature = signature
        appearance_state.revision = appearance_state.revision + 1
    end
    return appearance_state.revision
end

function get_stat(index)
    -- Cards now live in a scroll view attached to the existing native ranking page.
    return nil
end
