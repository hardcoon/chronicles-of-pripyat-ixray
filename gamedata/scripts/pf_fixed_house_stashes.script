-- Compatibility entry point retained for lz_new_mechanics. Permanent spawning
-- is intentionally disabled; the dynamic manager owns the 350 active stashes.
function new_game_start()
	return true
end

function point_count()
	return #points
end

function append_dynamic_candidates(target, next_id, source_name)
	next_id = tonumber(next_id) or 10001
	for _, point in ipairs(points) do
		table.insert(target, {
			id = next_id,
			kind = "curated",
			position = { point.x, point.y, point.z },
			level_vertex_id = point.level_vertex_id,
			game_vertex_id = point.game_vertex_id,
			yaw = point.yaw,
			curated = true,
			source_catalogue = source_name or "manual"
		})
		next_id = next_id + 1
	end
	return next_id
end

function reset_spawn_flag()
	return true
end
