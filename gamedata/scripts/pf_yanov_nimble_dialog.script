-- Compatibility entry points retained for the already released UAZ sale.
function uaz_van_sale_available(a, b) return vehicle_uaz_van_available(a, b) end
function can_buy_uaz_van(a, b)
	return vehicle_uaz_van_available(a, b) and db.actor:money() >= UAZ_VAN_SALE.price
end
function cannot_afford_uaz_van(a, b)
	return vehicle_uaz_van_available(a, b) and db.actor:money() < UAZ_VAN_SALE.price
end
function buy_uaz_van(a, b) return buy_vehicle_sale(UAZ_VAN_SALE, a, b) end

local function update_vehicle_sale_marker(sale)
	if db.actor == nil or runtime.marker_cleanup_complete[sale.id] or
		stored(sale.purchased_key, false) ~= true or
		not map_spot_api_available() then
		return
	end

	local object_id = tonumber(stored(sale.object_id_key, -1)) or -1
	if object_id < 0 then return end

	if stored(sale.marker_reached_key, false) == true then
		remove_map_spots(object_id, sale.legacy_marker_type)
		remove_map_spots(object_id, sale.marker_type)
		runtime.marker_cleanup_complete[sale.id] = true
		return
	end

	local simulator = alife()
	local server_object = simulator ~= nil and simulator:object(object_id) or nil
	if server_object == nil then return end

	local client_object = type(level.object_by_id) == "function" and
		level.object_by_id(object_id) or nil
	local vehicle_position = client_object ~= nil and
		client_object:position() or server_object.position
	if vehicle_position == nil then return end

	local actor_position = db.actor:position()
	local dx = actor_position.x - vehicle_position.x
	local dy = actor_position.y - vehicle_position.y
	local dz = actor_position.z - vehicle_position.z
	if dx * dx + dy * dy + dz * dz <= sale.marker_reveal_distance_sqr then
		remove_map_spots(object_id, sale.legacy_marker_type)
		remove_map_spots(object_id, sale.marker_type)
		save(sale.marker_reached_key, true)
		runtime.marker_cleanup_complete[sale.id] = true
		printf(
			"[PF YANOV NIMBLE] vehicle marker removed section=%s object_id=%s distance=5m",
			sale.section,
			tostring(object_id)
		)
		return
	end

	-- Existing saves may still contain the old amber primary-object marker.
	ensure_vehicle_marker(sale, object_id)
end

function update_uaz_van_marker()
	update_vehicle_sale_marker(UAZ_VAN_SALE)
end

function update_vehicle_sales()
	for _, sale in ipairs(VEHICLE_SALES) do
		update_vehicle_sale_marker(sale)
		update_vehicle_sale_fuel(sale)
	end
end
