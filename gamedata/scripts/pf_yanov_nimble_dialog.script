local INTRO_PSTOR_KEY = "pf_yanov_nimble_intro_v1"
local FUEL_ORDER_STATE_KEY = "pf_yanov_nimble_fuel_order_v1_state"
local FUEL_ORDER_DUE_KEY = "pf_yanov_nimble_fuel_order_v1_due"
local FUEL_ORDER_NOTICE_KEY = "pf_yanov_nimble_fuel_order_v1_notice"
local FUEL_ORDER_PRICE = 6000
local FUEL_ORDER_MIN_HOURS = 6
local FUEL_ORDER_MAX_HOURS = 18
local FUEL_SALE_COOLDOWN_DUE_KEY = "pf_yanov_nimble_fuel_sale_v1_due"
local FUEL_SALE_MIN_DAYS = 3
local FUEL_SALE_MAX_DAYS = 6
local SECONDS_PER_HOUR = 3600
local HOURS_PER_DAY = 24
local FUEL_CANISTER_SECTION = "pf_vehicle_fuel_canister"
local ORDER_IDLE = 0
local ORDER_WAITING = 1
local ORDER_READY = 2
local VEHICLE_SALE_FUEL = { minimum_liters = 5, maximum_liters = 15 }
local VEHICLE_MARKER_TYPE = "pf_yanov_nimble_uaz_location"
local VEHICLE_LEGACY_MARKER_TYPE = "primary_object"
local VEHICLE_MATCH_DISTANCE_SQR = 1
local VEHICLE_MARKER_REVEAL_DISTANCE_SQR = 5 * 5

local function new_vehicle_sale(id, price, section, marker_hint, position, angle,
	level_vertex_id, game_vertex_id)
	local key_prefix = "pf_yanov_nimble_" .. id .. "_v1_"
	return {
		id = id,
		purchased_key = key_prefix .. "purchased",
		object_id_key = key_prefix .. "object_id",
		price = price,
		section = section,
		position = position,
		angle = angle,
		level_vertex_id = level_vertex_id,
		game_vertex_id = game_vertex_id,
		match_distance_sqr = VEHICLE_MATCH_DISTANCE_SQR,
		marker_type = VEHICLE_MARKER_TYPE,
		legacy_marker_type = VEHICLE_LEGACY_MARKER_TYPE,
		marker_hint = marker_hint,
		marker_reached_key = key_prefix .. "marker_reached",
		marker_reveal_distance_sqr = VEHICLE_MARKER_REVEAL_DISTANCE_SQR,
		initial_fuel_key = key_prefix .. "initial_fuel",
		initial_fuel_applied_key = key_prefix .. "initial_fuel_applied"
	}
end

