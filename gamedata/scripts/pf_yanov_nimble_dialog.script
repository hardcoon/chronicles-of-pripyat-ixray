local VEHICLE_SALES_BY_ID = {}
for _, sale in ipairs(VEHICLE_SALES) do
	VEHICLE_SALES_BY_ID[sale.id] = sale
end
local UAZ_VAN_SALE = VEHICLE_SALES_BY_ID.uaz_van_broken
local runtime = {
	selected_vehicle_sale_id = nil,
	marker_cleanup_complete = {},
	fuel_complete = {}
}

function reset_vehicle_sales_runtime()
	runtime.selected_vehicle_sale_id = nil
	runtime.marker_cleanup_complete = {}
	runtime.fuel_complete = {}
end

function reset_uaz_van_marker_runtime()
	reset_vehicle_sales_runtime()
end

local function stored(key, default)
	if db.actor == nil then return default end
	return xr_logic.pstor_retrieve(db.actor, key, default)
end

local function save(key, value)
	if db.actor ~= nil then xr_logic.pstor_store(db.actor, key, value) end
end

local function prepare_vehicle_sale_fuel(sale)
	local amount = math.random(
		VEHICLE_SALE_FUEL.minimum_liters,
		VEHICLE_SALE_FUEL.maximum_liters
	)
	save(sale.initial_fuel_key, amount)
	save(sale.initial_fuel_applied_key, false)
	runtime.fuel_complete[sale.object_id_key] = nil
	return amount
end

local function vehicle_sale_fuel_amount(sale)
	local amount = tonumber(stored(sale.initial_fuel_key, -1)) or -1
	if amount < VEHICLE_SALE_FUEL.minimum_liters or
			amount > VEHICLE_SALE_FUEL.maximum_liters then
		amount = math.random(
			VEHICLE_SALE_FUEL.minimum_liters,
			VEHICLE_SALE_FUEL.maximum_liters
		)
		save(sale.initial_fuel_key, amount)
	end
	return amount
end

local function update_vehicle_sale_fuel(sale)
	local runtime_key = sale.object_id_key
	if runtime.fuel_complete[runtime_key] or
			stored(sale.purchased_key, false) ~= true then
		return
	end
	if stored(sale.initial_fuel_applied_key, false) == true then
		runtime.fuel_complete[runtime_key] = true
		return
	end

	local object_id = tonumber(stored(sale.object_id_key, -1)) or -1
	if object_id < 0 or level == nil or
			type(level.object_by_id) ~= "function" then
		return
	end
	local client_object = level.object_by_id(object_id)
	if client_object == nil then return end

	local requested = vehicle_sale_fuel_amount(sale)
	local ok, applied = pcall(function()
		local car = client_object:get_car()
		if car == nil then return nil end
		local capacity = tonumber(car.fuel_tank) or 0
		if capacity <= 0 then return nil end
		local amount = math.min(requested, capacity)
		car.fuel = amount
		return amount
	end)
	if not ok or applied == nil then return end

	save(sale.initial_fuel_applied_key, true)
	runtime.fuel_complete[runtime_key] = true
	printf(
		"[PF YANOV NIMBLE] initial vehicle fuel applied section=%s object_id=%s fuel=%d",
		sale.section,
		tostring(object_id),
		applied
	)
end

local function map_spot_api_available()
	return level ~= nil and
		type(level.map_has_object_spot) == "function" and
		type(level.map_add_object_spot_ser) == "function" and
		type(level.map_remove_object_spot) == "function"
end

local function remove_map_spots(object_id, marker_type)
	while level.map_has_object_spot(object_id, marker_type) ~= 0 do
		level.map_remove_object_spot(object_id, marker_type)
	end
end

local function ensure_vehicle_marker(sale, object_id)
	remove_map_spots(object_id, sale.legacy_marker_type)
	if level.map_has_object_spot(object_id, sale.marker_type) == 0 then
		level.map_add_object_spot_ser(
			object_id,
			sale.marker_type,
			sale.marker_hint
		)
	end
end

local function current_game_seconds()
	if game == nil or level == nil or game.get_game_time == nil or
			level.get_start_time == nil then
		return nil
	end
	return math.max(0, math.floor(tonumber(
		game.get_game_time():diffSec(level.get_start_time())
	) or 0))
end

local function notify_order_ready()
	if tonumber(stored(FUEL_ORDER_NOTICE_KEY, 0)) == 1 then return end
	if news_manager ~= nil and type(news_manager.send_tip) == "function" then
		news_manager.send_tip(
			db.actor,
			"pf_yanov_nimble_fuel_order_ready_tip",
			nil,
			nil,
			nil,
			nil
		)
	end
	save(FUEL_ORDER_NOTICE_KEY, 1)
end

local function fuel_order_state()
	if db.actor == nil then return ORDER_IDLE end
	local state = tonumber(stored(FUEL_ORDER_STATE_KEY, ORDER_IDLE)) or ORDER_IDLE
	if state ~= ORDER_WAITING then return state end

	local now = current_game_seconds()
	local due = tonumber(stored(FUEL_ORDER_DUE_KEY, -1)) or -1
	if now == nil then return state end
	if due < 0 then
		due = now + math.random(FUEL_ORDER_MIN_HOURS, FUEL_ORDER_MAX_HOURS) * SECONDS_PER_HOUR
		save(FUEL_ORDER_DUE_KEY, due)
	end
	if now >= due then
		state = ORDER_READY
		save(FUEL_ORDER_STATE_KEY, state)
		notify_order_ready()
		printf("[PF YANOV NIMBLE] fuel order ready at game_second=%d", now)
	end
	return state
end

function intro_done(first_speaker, second_speaker)
	return db.actor ~= nil
		and xr_logic.pstor_retrieve(db.actor, INTRO_PSTOR_KEY, false) == true
end

function needs_intro(first_speaker, second_speaker)
	return not intro_done(first_speaker, second_speaker)
end

function complete_intro(first_speaker, second_speaker)
	if db.actor == nil then return false end
	xr_logic.pstor_store(db.actor, INTRO_PSTOR_KEY, true)
	return true
end

function fuel_sale_available(first_speaker, second_speaker)
	if not intro_done(first_speaker, second_speaker) then return false end
	local now = current_game_seconds()
	if now == nil then return false end
	local due = tonumber(stored(FUEL_SALE_COOLDOWN_DUE_KEY, 0)) or 0
	return now >= due
end

function fuel_sale_unavailable(first_speaker, second_speaker)
	return intro_done(first_speaker, second_speaker) and
		not fuel_sale_available(first_speaker, second_speaker)
end

function can_buy_fuel_canister(first_speaker, second_speaker)
	return fuel_sale_available(first_speaker, second_speaker) and
		db.actor:money() >= FUEL_ORDER_PRICE
end

function cannot_afford_fuel_canister(first_speaker, second_speaker)
	return fuel_sale_available(first_speaker, second_speaker) and
		db.actor:money() < FUEL_ORDER_PRICE
end

function buy_fuel_canister(first_speaker, second_speaker)
	if not can_buy_fuel_canister(first_speaker, second_speaker) then return false end
	local now = current_game_seconds()
	local simulator = alife()
	if now == nil or simulator == nil or dialogs == nil or
			type(dialogs.relocate_money_from_actor) ~= "function" then
		return false
	end

	local item = simulator:create(
		FUEL_CANISTER_SECTION,
		db.actor:position(),
		db.actor:level_vertex_id(),
		db.actor:game_vertex_id(),
		db.actor:id()
	)
	if item == nil then
		printf("! [PF YANOV NIMBLE] failed to create directly sold fuel canister")
		return false
	end

	dialogs.relocate_money_from_actor(first_speaker, second_speaker, FUEL_ORDER_PRICE)
	if news_manager ~= nil and type(news_manager.relocate_item) == "function" then
		news_manager.relocate_item(db.actor, "in", FUEL_CANISTER_SECTION)
	end
	local cooldown_days = math.random(FUEL_SALE_MIN_DAYS, FUEL_SALE_MAX_DAYS)
	local due = now + cooldown_days * HOURS_PER_DAY * SECONDS_PER_HOUR
	save(FUEL_SALE_COOLDOWN_DUE_KEY, due)
	printf(
		"[PF YANOV NIMBLE] fuel canister sold price=%d cooldown_days=%d due=%d item_id=%s",
		FUEL_ORDER_PRICE,
		cooldown_days,
		due,
		tostring(item.id)
	)
	return true
end

function fuel_order_available(first_speaker, second_speaker)
	return intro_done(first_speaker, second_speaker) and
		fuel_order_state() == ORDER_IDLE
end

function can_start_fuel_order(first_speaker, second_speaker)
	return fuel_order_available(first_speaker, second_speaker) and
		db.actor:money() >= FUEL_ORDER_PRICE
end

function cannot_afford_fuel_order(first_speaker, second_speaker)
	return fuel_order_available(first_speaker, second_speaker) and
		db.actor:money() < FUEL_ORDER_PRICE
end

function start_fuel_order(first_speaker, second_speaker)
	if not can_start_fuel_order(first_speaker, second_speaker) then return false end
	local now = current_game_seconds()
	if now == nil or dialogs == nil or
			type(dialogs.relocate_money_from_actor) ~= "function" then
		return false
	end

	local delivery_hours = math.random(FUEL_ORDER_MIN_HOURS, FUEL_ORDER_MAX_HOURS)
	local due = now + delivery_hours * SECONDS_PER_HOUR
	dialogs.relocate_money_from_actor(first_speaker, second_speaker, FUEL_ORDER_PRICE)
	save(FUEL_ORDER_STATE_KEY, ORDER_WAITING)
	save(FUEL_ORDER_DUE_KEY, due)
	save(FUEL_ORDER_NOTICE_KEY, 0)
	printf(
		"[PF YANOV NIMBLE] fuel order started price=%d hours=%d due=%d",
		FUEL_ORDER_PRICE,
		delivery_hours,
		due
	)
	return true
end

function fuel_order_ready(first_speaker, second_speaker)
	return fuel_order_state() == ORDER_READY
end

function fuel_order_idle(first_speaker, second_speaker)
	return fuel_order_state() == ORDER_IDLE
end

function nimble_should_be_present()
	return true
end

function collect_fuel_order(first_speaker, second_speaker)
	if not fuel_order_ready(first_speaker, second_speaker) or alife() == nil then
		return false
	end
	local item = alife():create(
		FUEL_CANISTER_SECTION,
		db.actor:position(),
		db.actor:level_vertex_id(),
		db.actor:game_vertex_id(),
		db.actor:id()
	)
	if item == nil then
		printf("! [PF YANOV NIMBLE] failed to create fuel canister")
		return false
	end

	if news_manager ~= nil and type(news_manager.relocate_item) == "function" then
		news_manager.relocate_item(db.actor, "in", FUEL_CANISTER_SECTION)
	end
	save(FUEL_ORDER_STATE_KEY, ORDER_IDLE)
	save(FUEL_ORDER_DUE_KEY, 0)
	save(FUEL_ORDER_NOTICE_KEY, 0)
	printf("[PF YANOV NIMBLE] fuel order collected item_id=%s", tostring(item.id))
	return true
end

local function vehicle_sale_available(sale, first_speaker, second_speaker)
	return sale ~= nil and intro_done(first_speaker, second_speaker) and
		stored(sale.purchased_key, false) ~= true
end

local function select_vehicle_sale(id)
	if VEHICLE_SALES_BY_ID[id] == nil then return false end
	runtime.selected_vehicle_sale_id = id
	return true
end

local function selected_vehicle_sale()
	return VEHICLE_SALES_BY_ID[runtime.selected_vehicle_sale_id]
end

function can_buy_selected_vehicle(first_speaker, second_speaker)
	local sale = selected_vehicle_sale()
	return vehicle_sale_available(sale, first_speaker, second_speaker) and
		db.actor:money() >= sale.price
end

function cannot_afford_selected_vehicle(first_speaker, second_speaker)
	local sale = selected_vehicle_sale()
	return vehicle_sale_available(sale, first_speaker, second_speaker) and
		db.actor:money() < sale.price
end

local function existing_vehicle_at_sale_point(sale)
	local simulator = alife()
	if simulator == nil then return nil end
	for _, object in simulator:objects() do
		if object:section_name() == sale.section then
			local current = object.position
			local dx = current.x - sale.position.x
			local dy = current.y - sale.position.y
			local dz = current.z - sale.position.z
			if dx * dx + dy * dy + dz * dz <= sale.match_distance_sqr then
				return object
			end
		end
	end
	return nil
end

local function buy_vehicle_sale(sale, first_speaker, second_speaker)
	if not vehicle_sale_available(sale, first_speaker, second_speaker) or
		db.actor:money() < sale.price or alife() == nil or dialogs == nil or
		type(dialogs.relocate_money_from_actor) ~= "function" then
		return false
	end

	local object = existing_vehicle_at_sale_point(sale)
	if object == nil then
		local position = vector():set(
			sale.position.x,
			sale.position.y,
			sale.position.z
		)
		object = alife():create(
			sale.section,
			position,
			sale.level_vertex_id,
			sale.game_vertex_id
		)
		if object == nil then
			printf("! [PF YANOV NIMBLE] failed to create %s", sale.section)
			return false
		end

		object.angle = vector():set(
			sale.angle.x,
			sale.angle.y,
			sale.angle.z
		)
	else
		printf(
			"[PF YANOV NIMBLE] reusing sale vehicle section=%s object_id=%s",
			sale.section,
			tostring(object.id)
		)
	end

	dialogs.relocate_money_from_actor(first_speaker, second_speaker, sale.price)
	save(sale.purchased_key, true)
	save(sale.object_id_key, object.id)
	save(sale.marker_reached_key, false)
	runtime.marker_cleanup_complete[sale.id] = nil
	local initial_fuel = prepare_vehicle_sale_fuel(sale)

	if map_spot_api_available() then
		ensure_vehicle_marker(sale, object.id)
	end

	printf(
		"[PF YANOV NIMBLE] vehicle purchased section=%s price=%d object_id=%s initial_fuel=%d",
		sale.section,
		sale.price,
		tostring(object.id),
		initial_fuel
	)
	return true
end

function buy_selected_vehicle(first_speaker, second_speaker)
	return buy_vehicle_sale(selected_vehicle_sale(), first_speaker, second_speaker)
end

function vehicle_zaz968_available(a, b) return vehicle_sale_available(VEHICLE_SALES_BY_ID.zaz968, a, b) end
function vehicle_lada_2101_available(a, b) return vehicle_sale_available(VEHICLE_SALES_BY_ID.lada_2101, a, b) end
function vehicle_gaz24_available(a, b) return vehicle_sale_available(VEHICLE_SALES_BY_ID.gaz24, a, b) end
