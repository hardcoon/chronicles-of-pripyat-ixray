-- Developer-only native-door placement editor for IX-Ray.
-- Its in-world workflow is the deliberately smaller door-specific variant of
-- PF NPC Editor: the normal crosshair chooses direction, number keys select
-- distance from the moving actor and the real OGF lower edge snaps to floor.

local TOOL_SECTION = "pf_door_spawn_tool"
local PREVIEW_PSTOR = "pf_door_qa_active_preview_id"
local PLACEMENT_LOG_FILENAME = "pf_door_qa_placements.log"
local EVENT_LOG_FILENAME = "pf_door_qa_events.log"
local PLACEMENT_LOG_HEADER = "# object_id\tlevel\tcatalog_id\tsection\tmodel\tx\ty\tz\tyaw_rad\tyaw_deg\tdir_x\tdir_y\tdir_z\tlevel_vertex_id\tgame_vertex_id\tcreated_game_time"
local EVENT_LOG_HEADER = "# event\tevent_time\tlevel\tobject_id\tprevious_id\tcatalog_id\tsection\tmodel\tx\ty\tz\tyaw_rad\tyaw_deg\tdir_x\tdir_y\tdir_z\tlevel_vertex_id\tgame_vertex_id"

local INVALID_LEVEL_VERTEX_ID = 4294967295
local TARGET_RAY_DISTANCE = 25.0
local GROUND_RAY_START_HEIGHT = 1.5
local GROUND_RAY_RANGE = 20.0
local ROTATION_STEP = math.rad(5)
local LIVE_MOVE_DISTANCE_SQR = 0.0004
local GROUND_CLEARANCE = 0.01
local HEIGHT_ADJUST_STEP = 0.05

-- min_x/max_x/min_y are the actual OGF bounding-box limits. Together with
-- the model-depth bounds below they let the editor test the floor under the
-- whole leaf and place its real lower edge on that floor instead of assuming
-- that every OGF origin is at its bottom.
