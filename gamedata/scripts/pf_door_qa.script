    { id = "wood_120x240", label = "Деревянная 120x240", section = "pf_qa_door_wood_120x240", model = "dynamics\\door\\door_wood_120x240_01.ogf", min_x = -1.200, max_x = 0.000, min_y = 0.000 },
    { id = "wood_130x245", label = "Деревянная 130x245", section = "pf_qa_door_wood_130x245", model = "dynamics\\door\\door_wood_130x245_01.ogf", min_x = -1.300, max_x = 0.000, min_y = 0.000 },
    { id = "wood_130x250", label = "Деревянная 130x250", section = "pf_qa_door_wood_130x250", model = "dynamics\\door\\door_wood_130x250_01.ogf", min_x = -1.300, max_x = 0.000, min_y = 0.000 },
