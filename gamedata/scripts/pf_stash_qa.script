local function restore_qa_tool_uses(item)
	local max_uses = item:get_max_uses()
	if max_uses and max_uses > 0 then
		item:set_remaining_uses(max_uses)
	end
end

function on_inventory_eat(actor, item)
	local section = item and item:section() or nil
	if section == QA_RELOAD_TOOL_SECTION then
		restore_qa_tool_uses(item)
		pf_bunker_qa_tool.use_reload_tool(item)
	elseif section == QA_LIGHT_POINT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		record_future_light_point()
	elseif section == QA_NPC_SPAWN_POINT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		record_future_npc_spawn_point()
	elseif section == QA_SCIENTIST_TELEPORT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		teleport_to_scientists()
	elseif section == LEGACY_QA_REJECTION_TOOL_SECTION then
		restore_qa_tool_uses(item)
		mark_nearest_stash_for_catalog_removal()
	elseif section == QA_CROSSHAIR_REJECTION_TOOL_SECTION or
		section == LEGACY_QA_CROSSHAIR_REJECTION_TOOL_SECTION then
		restore_qa_tool_uses(item)
		delete_stash_at_crosshair_and_log()
	elseif section == QA_TELEPORT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		teleport_to_next_stash()
	elseif section == QA_MARKERS_TOOL_SECTION then
		restore_qa_tool_uses(item)
		toggle_all_stash_markers()
	elseif section == QA_CATALOG_MARKERS_TOOL_SECTION then
		restore_qa_tool_uses(item)
		use_stash_catalog_markers_tool(item)
	elseif section == QA_INTERIOR_TELEPORT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		teleport_to_random_stash_candidate("interior")
	elseif section == QA_OUTDOOR_TELEPORT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		teleport_to_random_stash_candidate("outdoor")
	elseif section == QA_SPAWN_TOOL_SECTION then
		restore_qa_tool_uses(item)
		spawn_stash_at_crosshair()
	elseif section == QA_DELETE_TOOL_SECTION then
		restore_qa_tool_uses(item)
		delete_qa_object_at_crosshair()
	elseif section == QA_UNDO_TOOL_SECTION then
		restore_qa_tool_uses(item)
		undo_last_qa_placement()
	elseif section == QA_STORY_DOCUMENT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		pf_story_documents.debug_give_next(item)
	elseif section == QA_LORE_NOTES_TOOL_SECTION then
		restore_qa_tool_uses(item)
		local mechanics = rawget(_G, "lz_new_mechanics")
		if mechanics and mechanics.debug_spawn_lore_test_stash then
			mechanics.debug_spawn_lore_test_stash()
		else
			report("Lore-notes QA API is unavailable")
		end
	elseif section == QA_ORDER_POINT_TOOL_SECTION then
		restore_qa_tool_uses(item)
		use_order_point_capture_tool(item)
	end

	-- The active bridge owns the single engine callback, but ordinary items
	-- must retain the sleeping-pill and other mechanics from the existing addon.
	local mechanics = rawget(_G, "lz_new_mechanics")
	if mechanics and mechanics.on_inventory_eat then
		return mechanics.on_inventory_eat(actor, item)
	end
	return true
end

local function qa_actor_on_update()
	if not db.actor then return end
	process_new_game_mode_request()
	enforce_developer_clear_weather()
	if qa_tools_checked then return end
	if time_global() < qa_tools_check_due then return end
	qa_tools_checked = ensure_stash_qa_tools(true)
end

local function qa_on_game_load()
	qa_tools_checked = false
	qa_tools_check_due = time_global() + 1000
	qa_issue_actor_id = nil
	qa_pending_sections = {}
	new_game_mode_checked = false
end

function on_game_start()
	if qa_callbacks_registered then return end
	if type(RegisterScriptCallback) ~= "function" then
		report("RegisterScriptCallback is unavailable for the QA rejection tool", true)
		return
	end
	RegisterScriptCallback("update", qa_actor_on_update)
	RegisterScriptCallback("load", qa_on_game_load)
	qa_callbacks_registered = true
end

local function remove_log_record(filename, object, position)
	local path = qa_log_path(filename)
	local file = io.open(path, "r")
	if not file then return true, false end

	local kept_lines = {}
	local removed = false
	local expected_id = tostring(object.id)
	local expected_level = level.name()
	local expected_section = object:section_name()
	for line in file:lines() do
		local recorded_id, recorded_level, recorded_section, _, x, y, z = string.match(
			line,
			"^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t"
		)
		local same_position = x and y and z and
			math.abs((tonumber(x) or 1e30) - position.x) <= 0.001 and
			math.abs((tonumber(y) or 1e30) - position.y) <= 0.001 and
			math.abs((tonumber(z) or 1e30) - position.z) <= 0.001
		if string.sub(line, 1, 1) ~= "#" and
			recorded_id == expected_id and recorded_level == expected_level and
			recorded_section == expected_section and same_position then
			removed = true
		else
			table.insert(kept_lines, line)
		end
	end
	file:close()
	if not removed then return true, false end

	file = io.open(path, "w")
	if not file then return false, false end
	for _, line in ipairs(kept_lines) do file:write(line .. "\n") end
	file:close()
	return true, true
end

local function remove_placement_log_record(object, position)
	return remove_log_record(QA_LOG_FILENAME, object, position)
end

local function remove_pattern_log_record(object, position)
	return remove_log_record(QA_PATTERN_LOG_FILENAME, object, position)
end

local function last_placement_log_record()
	local file = io.open(qa_log_path(QA_LOG_FILENAME), "r")
	if not file then return nil end
	local last = nil
	for line in file:lines() do
		local id, recorded_level, section, _, x, y, z = string.match(
			line,
			"^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t"
		)
		if string.sub(line, 1, 1) ~= "#" and id and
			QA_DELETABLE_SECTIONS[section] then
			last = {
				id = tonumber(id),
				level = recorded_level,
				section = section,
				position = vector():set(tonumber(x), tonumber(y), tonumber(z))
			}
		end
	end
	file:close()
	return last
end

local function spawn_at_crosshair(section, label)
	if not db.actor then return false end
	local position, ray, camera_position, camera_direction = crosshair_hit_position()
	if not position then
		report("Crosshair ray did not hit any surface")
		return false
	end

	local object = alife():create(
		section,
		position,
		db.actor:level_vertex_id(),
		db.actor:game_vertex_id()
	)
	if not object then
		report("Failed to spawn " .. label)
		return false
	end

	local direction = vector():set(device().cam_dir)
	object.angle = vector():set(0, math.atan2(direction.x, direction.z), 0)
	if not append_placement_log(object, position) then
		alife():release(object, true)
		report("Failed to write the QA placement log; object was not kept")
		return false
	end
	if not append_pattern_log(object, position, ray, camera_direction) then
		remove_placement_log_record(object, position)
		alife():release(object, true)
		report("Failed to write the QA pattern log; object was not kept")
		return false
	end
	report(string.format(
		"%s spawned at %.3f, %.3f, %.3f (id %s, element %s, material %s)",
		label, position.x, position.y, position.z, tostring(object.id),
		tostring(ray:get_element()), tostring(ray:get_material())
	))
	return true
end

-- Console equivalents:
-- run_string pf_stash_qa.spawn_stash_at_crosshair()
-- run_string pf_stash_qa.delete_qa_object_at_crosshair()
-- run_string pf_stash_qa.undo_last_qa_placement()
-- run_string pf_stash_qa.mark_stash_for_catalog_removal()
function spawn_stash_at_crosshair()
	return spawn_at_crosshair(QA_STASH_SECTION, "stash")
end

function toggle_all_stash_markers()
	local manager = pf_dynamic_stashes
	if not manager or not manager.debug_toggle_all_physical_stash_markers then
		report("Dynamic stash QA map API is unavailable")
		return false
	end
	local visible, count = manager.debug_toggle_all_physical_stash_markers()
	if count == 0 then
		report("No existing dynamic stash containers to mark")
		return false
	end
	report(string.format(
		"Dynamic stash PDA markers %s: %d",
		visible and "shown" or "hidden", count
	))
	return true
end

local function teleport_entry_distance_sqr(left, right)
	local dx = left.x - right.x
	local dy = left.y - right.y
	local dz = left.z - right.z
	return dx * dx + dy * dy + dz * dz
end

local function build_stash_teleport_queue()
	local remaining = {}
	local manager = pf_dynamic_stashes
	if manager and manager.debug_active_stash_points then
		for _, point in ipairs(manager.debug_active_stash_points()) do
			table.insert(remaining, {
				id = -point.slot_index,
				dynamic_slot = point.slot_index,
				x = point.x,
				y = point.y,
				z = point.z
			})
		end
	end
	for _, object in alife():objects() do
		local section = object:section_name()
		if QA_CATALOG_REMOVAL_SECTIONS[section] then
			local position = object.position
			table.insert(remaining, {
				id = object.id,
				section = section,
				x = position.x,
				y = position.y,
				z = position.z
			})
		end
	end

	-- A deterministic nearest-neighbour route keeps consecutive inspections in
	-- the same part of the map while still visiting every captured object once.
	local queue = {}
	local cursor = db.actor:position()
	while #remaining > 0 do
		local best_index = 1
		local best_distance = teleport_entry_distance_sqr(cursor, remaining[1])
		for index = 2, #remaining do
			local distance = teleport_entry_distance_sqr(cursor, remaining[index])
			if distance < best_distance or
				(distance == best_distance and
				remaining[index].id < remaining[best_index].id) then
				best_index = index
				best_distance = distance
			end
		end
		local entry = table.remove(remaining, best_index)
		table.insert(queue, entry)
		cursor = entry
	end

	stash_teleport_queue = queue
	stash_teleport_index = 0
	stash_teleport_skipped = 0
	stash_teleport_complete = #queue == 0
	return #queue
end

local function teleport_landing_position(target)
	-- QA inspection must work even where the actor has no navigation vertex.
	-- Keep the stash exactly under the actor instead of snapping to level.ai.
	-- CActor::ForceTransform also resets movement velocity to zero, while the
	-- vertical clearance keeps the actor capsule out of the stash/furniture.
	return vector():set(
		target.x, target.y + TELEPORT_STASH_UNDERFOOT_HEIGHT, target.z
	)
end

local function teleport_queue_entry(entry)
	if entry.dynamic_slot then
		local target = vector():set(entry.x, entry.y, entry.z)
		local landing = teleport_landing_position(target)
		db.actor:set_actor_position(landing)
		return true, target, landing
	end
	local server_object = alife():object(entry.id, true)
	if not server_object or server_object:section_name() ~= entry.section then
		return false
	end
	local target = server_object.position
	if teleport_entry_distance_sqr(target, entry) >
		TELEPORT_QUEUE_POSITION_EPSILON_SQR then
		return false
	end

	local landing = teleport_landing_position(target)
	db.actor:set_actor_position(landing)
	return true, target, landing
end

function reset_stash_teleport_queue()
	stash_teleport_queue = nil
	stash_teleport_index = 0
	stash_teleport_skipped = 0
	stash_teleport_complete = false
	report("Stash teleport queue reset")
	return true
end

function teleport_to_next_stash()
	if not db.actor then return false end
	if stash_teleport_complete then
		report(string.format(
			"Stash teleport queue complete: %d visited, %d unavailable",
			stash_teleport_index - stash_teleport_skipped,
			stash_teleport_skipped
		))
		return true
	end
	if not stash_teleport_queue then
		local count = build_stash_teleport_queue()
		if count == 0 then
			report("No active dynamic, fixed, or QA stashes found")
			return false
		end
	end

	while stash_teleport_index < #stash_teleport_queue do
		stash_teleport_index = stash_teleport_index + 1
		local entry = stash_teleport_queue[stash_teleport_index]
		local ok, target, landing = teleport_queue_entry(entry)
		if ok then
			if stash_teleport_index == #stash_teleport_queue then
				stash_teleport_complete = true
			end
			report(string.format(
				"Stash %d/%d at %.3f, %.3f, %.3f (%s, landing %.1f m)%s",
				stash_teleport_index, #stash_teleport_queue,
				target.x, target.y, target.z,
				entry.dynamic_slot and ("active " .. tostring(entry.dynamic_slot)) or
					("id " .. tostring(entry.id)),
				landing:distance_to(target),
				stash_teleport_complete and " - queue complete" or ""
			))
			return true
		end
		stash_teleport_skipped = stash_teleport_skipped + 1
	end

	stash_teleport_complete = true
	report(string.format(
		"Stash teleport queue complete: %d visited, %d unavailable",
		#stash_teleport_queue - stash_teleport_skipped,
		stash_teleport_skipped
	))
	return true
end

local function random_stash_candidate_pool(kind)
	local cached = random_teleport_pools[kind]
	if cached then return cached end

	local source = nil
	if kind == "interior" then
		if pf_stash_interior_candidates and pf_stash_interior_candidates.get then
			source = pf_stash_interior_candidates.get()
		end
	elseif kind == "outdoor" then
		if pf_stash_candidates and pf_stash_candidates.get then
			source = pf_stash_candidates.get()
		end
	end

	if not source then return nil end
	local pool = {}
	for _, candidate in ipairs(source) do
		if candidate.kind == kind and candidate.level_vertex_id and candidate.position then
			table.insert(pool, candidate)
		end
	end
	random_teleport_pools[kind] = pool
	return pool
end

function teleport_to_random_stash_candidate(kind)
	if not db.actor then return false end
	if level.name() ~= RANDOM_TELEPORT_LEVEL then
		report("Random location teleport is available only on Pripyat Full")
		return false
	end

	local pool = random_stash_candidate_pool(kind)
	if not pool or #pool == 0 then
		report("No " .. tostring(kind) .. " teleport candidates are available")
		return false
	end

	local index = math.random(1, #pool)
	if #pool > 1 and pool[index].id == random_teleport_last_id[kind] then
		index = index % #pool + 1
	end
	local candidate = pool[index]
	local vertex_position = level.vertex_position(candidate.level_vertex_id)
	if not vertex_position then
		report(string.format(
			"Invalid AI vertex %s for %s candidate %s",
			tostring(candidate.level_vertex_id), tostring(kind), tostring(candidate.id)
		))
		return false
	end

	-- Candidate coordinates can sit against furniture or static geometry. The
	-- linked AI vertex is the safe nearby standing point used for QA travel.
	local landing = vector():set(
		vertex_position.x, vertex_position.y + 0.20, vertex_position.z
	)
	db.actor:set_actor_position(landing)
	random_teleport_last_id[kind] = candidate.id
	report(string.format(
		"Random %s location %s: %.3f, %.3f, %.3f (AI vertex %s)",
		tostring(kind), tostring(candidate.id),
		candidate.position[1], candidate.position[2], candidate.position[3],
		tostring(candidate.level_vertex_id)
	))
	return true
end

function delete_qa_object_at_crosshair()
	local ray = crosshair_ray()
	local client_object = ray and ray:get_object() or nil
	if not client_object then
		report("Crosshair is not pointing at a QA stash")
		return false
	end

	local server_object = alife():object(client_object:id(), true)
	local section = server_object and server_object:section_name() or nil
	if not server_object or not QA_DELETABLE_SECTIONS[section] then
		report("Target is not a deletable QA stash")
		return false
	end

	local position = vector():set(server_object.position)
	local id = server_object.id
	local model = configured_model(section)
	local log_ok, log_removed = remove_placement_log_record(server_object, position)
	local pattern_ok, pattern_removed = remove_pattern_log_record(server_object, position)
	if not log_ok or not pattern_ok then
		report("Failed to update the QA placement/pattern logs; object was not deleted")
		return false
	end
	alife():release(server_object, true)
	report(string.format(
		"QA object deleted at %.3f, %.3f, %.3f (id %s, model %s, logs %s/%s)",
		position.x, position.y, position.z, tostring(id), model,
		log_removed and "placement removed" or "no placement",
		pattern_removed and "pattern removed" or "no pattern"
	))
	return true
end

local function catalog_stash_at_crosshair()
	local ray = crosshair_ray()
	local client_object = ray and ray:get_object() or nil
	if not client_object then
		return nil, "Crosshair is not pointing at a fixed or QA stash"
	end

	local server_object = alife():object(client_object:id(), true)
	local section = server_object and server_object:section_name() or nil
	if not server_object or not QA_CATALOG_REMOVAL_SECTIONS[section] then
		return nil, "Target is not a fixed or QA stash"
	end
	return server_object
end

function mark_stash_for_catalog_removal()
	local server_object, error_message = catalog_stash_at_crosshair()
	if not server_object then
		report(error_message)
		return false
	end

	local position = vector():set(server_object.position)
	local ok, added = append_catalog_rejection_log(server_object, position)
	if not ok then
		report("Failed to write the stash catalogue rejection log")
		return false
	end
	if not added then
		report(string.format(
			"Stash at %.3f, %.3f, %.3f is already marked for catalogue removal",
			position.x, position.y, position.z
		))
		return true
	end
	report(string.format(
		"Stash marked for catalogue removal at %.3f, %.3f, %.3f (id %s, model %s)",
		position.x, position.y, position.z, tostring(server_object.id),
		configured_model(section)
	))
	return true
end

function delete_stash_at_crosshair_and_log()
	local server_object, error_message = catalog_stash_at_crosshair()
	if not server_object then
		report(error_message)
		return false
	end

	-- Preserve all authoring information before releasing the live object. The
	-- rejection log is the source record for removing the same placement from
	-- the fixed catalogue; if it cannot be written, keep the object untouched.
	local position = vector():set(server_object.position)
	local id = server_object.id
	local section = server_object:section_name()
	local model = configured_model(section)
	local ok, added = append_catalog_rejection_log(server_object, position)
	if not ok then
		report("Failed to write the stash catalogue rejection log; object was not deleted")
		return false
	end

	alife():release(server_object, true)
	report(string.format(
		"Stash deleted and marked for catalogue removal at %.3f, %.3f, %.3f " ..
		"(id %s, model %s, log %s)",
		position.x, position.y, position.z, tostring(id), model,
		added and "added" or "already present"
	))
	return true
end

function undo_last_qa_placement()
	local record = last_placement_log_record()
	if not record then
		report("UNDO: the QA placement log is empty")
		return false
	end
	if record.level ~= level.name() then
		report("UNDO: the last QA placement belongs to another level")
		return false
	end

	local server_object = record.id and alife():object(record.id, true) or nil
	local current_section = server_object and server_object:section_name() or nil
	local current_position = server_object and server_object.position or nil
	local same_position = current_position and
		math.abs(current_position.x - record.position.x) <= 0.001 and
		math.abs(current_position.y - record.position.y) <= 0.001 and
		math.abs(current_position.z - record.position.z) <= 0.001
	if not server_object or current_section ~= record.section or not same_position then
		report("UNDO: the last logged QA object no longer exists")
		return false
	end

	local position = vector():set(server_object.position)
	local log_ok, log_removed = remove_placement_log_record(server_object, position)
	local pattern_ok, pattern_removed = remove_pattern_log_record(server_object, position)
	if not log_ok or not pattern_ok or not log_removed then
		report("UNDO: failed to update the QA logs; object was not deleted")
		return false
	end
	alife():release(server_object, true)
	report(string.format(
		"UNDO: removed last QA object at %.3f, %.3f, %.3f (logs %s/%s)",
		position.x, position.y, position.z,
		log_removed and "placement removed" or "no placement",
		pattern_removed and "pattern removed" or "no pattern"
	))
	return true
end

function on_key_press(dik)
	return false
end

-- mod_script imports modules but does not invoke this callback automatically.
on_game_start()
