	return false
end

function use_story_document_tool(item)
	pf_story_documents.debug_give_next(item)
	return false
end

function use_lore_notes_tool(_item)
	local mechanics = rawget(_G, "lz_new_mechanics")
	if not mechanics or not mechanics.debug_spawn_lore_test_stash then
		report("Lore-notes QA API is unavailable")
		return false
	end
	mechanics.debug_spawn_lore_test_stash()
