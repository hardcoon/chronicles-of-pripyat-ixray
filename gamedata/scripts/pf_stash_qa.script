-- Manual QA placement helpers for rebuilding the dynamic-stash catalogue.
-- These objects never consult or modify pf_dynamic_stashes candidate points.

local MAX_RAY_DISTANCE = 250
local QA_LOG_FILENAME = "pf_stash_qa_placements.log"
local QA_LOG_HEADER = "# object_id\tlevel\tsection\tmodel\tx\ty\tz\tyaw_deg\tcreated_game_time"
local QA_PATTERN_LOG_FILENAME = "pf_stash_qa_patterns.log"
local QA_PATTERN_LOG_HEADER = "# object_id\tlevel\tstash_section\tstash_model\tx\ty\tz\tyaw_deg\thit_kind\thit_element\thit_material\thit_object_id\thit_object_section\thit_object_model\thit_distance\tray_dx\tray_dy\tray_dz\tcreated_game_time"
local QA_REJECTION_LOG_FILENAME = "pf_stash_qa_catalog_rejections.log"
local QA_REJECTION_LOG_HEADER = "# object_id\tlevel\tsection\tmodel\tx\ty\tz\tyaw_deg\tcreated_game_time"
local QA_STASH_SECTION = "pf_qa_crosshair_stash"
local QA_RELOAD_TOOL_SECTION = "pf_bunker_reload_tool"
local QA_LIGHT_POINT_TOOL_SECTION = "pf_bunker_light_point_tool"
local QA_NPC_SPAWN_POINT_TOOL_SECTION = "pf_npc_spawn_point_tool"
local QA_SCIENTIST_TELEPORT_TOOL_SECTION = "pf_scientist_teleport_tool"
local LEGACY_QA_REJECTION_TOOL_SECTION = "pf_stash_rejection_tool"
local LEGACY_QA_CROSSHAIR_REJECTION_TOOL_SECTION = "pf_stash_crosshair_rejection_tool"
local QA_CROSSHAIR_REJECTION_TOOL_SECTION = "pf_stash_aim_remove_tool"
local QA_TELEPORT_TOOL_SECTION = "pf_stash_teleport_tool"
local QA_MARKERS_TOOL_SECTION = "pf_stash_markers_tool"
local QA_CATALOG_MARKERS_TOOL_SECTION = "pf_stash_catalog_markers_tool"
local QA_INTERIOR_TELEPORT_TOOL_SECTION = "pf_interior_teleport_tool"
local QA_OUTDOOR_TELEPORT_TOOL_SECTION = "pf_outdoor_teleport_tool"
local QA_SPAWN_TOOL_SECTION = "pf_stash_spawn_tool"
local QA_DELETE_TOOL_SECTION = "pf_stash_delete_tool"
local QA_UNDO_TOOL_SECTION = "pf_stash_undo_tool"
local QA_STORY_DOCUMENT_TOOL_SECTION = "pf_story_document_tool"
local QA_LORE_NOTES_TOOL_SECTION = "pf_lore_notes_tool"
local QA_ORDER_POINT_TOOL_SECTION = "pf_order_point_tool"
local QA_DOOR_SPAWN_TOOL_SECTION = "pf_door_spawn_tool"
local DEVELOPER_MODE_PSTOR = "pf_developer_mode"
local DEVELOPER_ENVIRONMENT_READY_PSTOR = "pf_developer_environment_ready"
local DEVELOPER_CLEAR_WEATHER = "default_clear"
local DEVELOPER_START_HOUR = 10
local DEVELOPER_ACCESS_SETTING_FILE = "pf_developer_access.setting"
local NEW_GAME_MODE_REQUEST_FILE = "pf_new_game_mode.request"
local NEW_GAME_DIFFICULTIES = {
	novice = "gd_novice",
	stalker = "gd_stalker",
	veteran = "gd_veteran",
	master = "gd_master",
	developer = "gd_novice"
}
local QA_TOOL_DEFINITIONS = {
	{ QA_RELOAD_TOOL_SECTION, "NPC reload tool" },
	{ QA_LIGHT_POINT_TOOL_SECTION, "future light point tool" },
	{ QA_NPC_SPAWN_POINT_TOOL_SECTION, "future NPC spawn point tool" },
	{ QA_SCIENTIST_TELEPORT_TOOL_SECTION, "scientist teleport tool" },
	{ QA_TELEPORT_TOOL_SECTION, "stash teleport tool" },
	{ QA_MARKERS_TOOL_SECTION, "stash map marker tool" },
	{ QA_CATALOG_MARKERS_TOOL_SECTION, "stash catalogue map marker tool" },
	{ QA_INTERIOR_TELEPORT_TOOL_SECTION, "random interior teleport tool" },
	{ QA_OUTDOOR_TELEPORT_TOOL_SECTION, "random outdoor teleport tool" },
	{ QA_SPAWN_TOOL_SECTION, "stash spawn tool" },
	{ QA_DELETE_TOOL_SECTION, "stash delete tool" },
	{ QA_CROSSHAIR_REJECTION_TOOL_SECTION, "crosshair stash rejection tool" },
	{ QA_UNDO_TOOL_SECTION, "stash placement undo tool" },
	{ QA_STORY_DOCUMENT_TOOL_SECTION, "next story document tool" },
	{ QA_LORE_NOTES_TOOL_SECTION, "lore notes tool" },
	{ QA_ORDER_POINT_TOOL_SECTION, "order delivery point tool" },
	{ QA_DOOR_SPAWN_TOOL_SECTION, "door spawn tool" }
}
local QA_TOOL_SECTIONS = {}
for _, definition in ipairs(QA_TOOL_DEFINITIONS) do
	QA_TOOL_SECTIONS[definition[1]] = true
end
