	{ "device_torch", "developer flashlight" },
	{ "wpn_knife", "developer knife" }
}
local DEVELOPER_KEEP_SECTIONS = {
	device_torch = true,
	wpn_knife = true
}
for section in pairs(QA_TOOL_SECTIONS) do
	DEVELOPER_KEEP_SECTIONS[section] = true
end
local QA_DELETABLE_SECTIONS = {
	[QA_STASH_SECTION] = true
}
local QA_CATALOG_REMOVAL_SECTIONS = {
	[QA_STASH_SECTION] = true,
	pf_fixed_house_stash_backpack = true,
	pf_fixed_house_stash_wood_box = true
}
local TELEPORT_QUEUE_POSITION_EPSILON_SQR = 0.05 * 0.05
local TELEPORT_STASH_UNDERFOOT_HEIGHT = 1.10
local stash_teleport_queue = nil
local stash_teleport_index = 0
local stash_teleport_skipped = 0
local stash_teleport_complete = false
local qa_callbacks_registered = false
local qa_tools_checked = false
local qa_tools_check_due = 0
local qa_issue_actor_id = nil
local qa_pending_sections = {}
local new_game_mode_checked = false
local RANDOM_TELEPORT_LEVEL = "pripyat_full"
local random_teleport_pools = {}
local random_teleport_last_id = {}


local function crosshair_ray()
	if not db.actor then return nil end

	local camera_position = vector():set(device().cam_pos)
	local camera_direction = vector():set(device().cam_dir):normalize()
	local ray = ray_pick()
	ray:set_flags(3)
	ray:set_range(MAX_RAY_DISTANCE)
	ray:set_ignore_object(db.actor)
	ray:set_position(camera_position)
	ray:set_direction(camera_direction)
	if not ray:query() then return nil end
	return ray, camera_position, camera_direction
end

local function crosshair_hit_position()
	local ray, camera_position, camera_direction = crosshair_ray()
	if not ray then return nil end
	local position = vector():set(camera_position)
	position:mad(camera_position, camera_direction, ray:get_distance())
	return position, ray, camera_position, camera_direction
end

local function report(message, hud_silent)
	printf("[PF STASH QA] %s", message)
	if db.actor and hud_silent ~= true then
		db.actor:give_game_news("QA", message, "pf_news_stash", 0, 2500)
	end
end

local function new_game_mode_request_path()
	return getFS():update_path("$app_data_root$", NEW_GAME_MODE_REQUEST_FILE)
end

local function developer_access_setting_path()
	return getFS():update_path("$app_data_root$", DEVELOPER_ACCESS_SETTING_FILE)
end

function is_developer_access_enabled()
	local file = io.open(developer_access_setting_path(), "r")
	if not file then return false end
	local value = string.lower(file:read("*l") or "")
	file:close()
	value = string.gsub(value, "^%s+", "")
	value = string.gsub(value, "%s+$", "")
	return value == "1" or value == "true"
end

function set_developer_access_enabled(enabled)
	local file = io.open(developer_access_setting_path(), "w")
	if not file then
		printf("[PF STASH QA] Unable to save the Developer access setting")
		return false
	end
	file:write(enabled == true and "1\n" or "0\n")
	file:close()
	return true
end

local function write_new_game_mode_request(mode)
	local file = io.open(new_game_mode_request_path(), "w")
	if not file then
		report("Unable to write the pending new-game mode")
		return false
	end
	file:write(tostring(mode), "\n")
	file:close()
	return true
end

-- The main-menu Lua state is rebuilt while a new game is loading. Keep this
-- one-shot request in appdata so Developer remains distinguishable from the
-- hidden novice enum after that rebuild.
function request_new_game_mode(mode)
	if not NEW_GAME_DIFFICULTIES[mode] then
		report("Rejected unknown new-game mode: " .. tostring(mode))
		return false
	end
	if mode == "developer" and not is_developer_access_enabled() then
		report("Rejected Developer new-game mode while access is disabled")
		return false
	end
	return write_new_game_mode_request(mode)
end

function clear_new_game_mode_request()
	return write_new_game_mode_request("consumed")
end

function set_developer_mode(enabled)
	if not db.actor then return false end
	xr_logic.pstor_store(db.actor, DEVELOPER_MODE_PSTOR, enabled == true)
	if enabled ~= true then
		xr_logic.pstor_store(db.actor, DEVELOPER_ENVIRONMENT_READY_PSTOR, false)
	end
	return true
end

function is_developer_mode()
	return db.actor ~= nil and
		xr_logic.pstor_retrieve(db.actor, DEVELOPER_MODE_PSTOR, false) == true
end

local function enforce_developer_clear_weather()
	if not is_developer_mode() then return false end
	if level.is_wfx_playing and level.stop_weather_fx and level.is_wfx_playing() then
		level.stop_weather_fx()
	end
	if level.get_weather() ~= DEVELOPER_CLEAR_WEATHER then
		level.set_weather(DEVELOPER_CLEAR_WEATHER, true)
	end
	return true
end

local function prepare_developer_environment(hud_silent)
	if not db.actor or not is_developer_mode() then return false end
	local already_ready = xr_logic.pstor_retrieve(
		db.actor, DEVELOPER_ENVIRONMENT_READY_PSTOR, false
	) == true
	if not already_ready then
		local current_minutes = level.get_time_hours() * 60 + level.get_time_minutes()
		local target_minutes = DEVELOPER_START_HOUR * 60
		local minutes_to_change = (target_minutes - current_minutes) % (24 * 60)
		if minutes_to_change > 0 then
			level.change_game_time(
				0, math.floor(minutes_to_change / 60), minutes_to_change % 60
			)
			local surge = surge_manager and surge_manager.get_surge_manager and
				surge_manager.get_surge_manager() or nil
			if surge then surge.time_forwarded = true end
		end
		xr_logic.pstor_store(db.actor, DEVELOPER_ENVIRONMENT_READY_PSTOR, true)
		report("Developer environment prepared: 10:00, clear weather locked", hud_silent)
	end
	enforce_developer_clear_weather()
	return true
end

function prepare_developer_new_game()
	local actor = db.actor
	local sim = alife()
	if not actor or not sim then return false end

	set_developer_mode(true)
	prepare_developer_environment(true)
	local remove_ids = {}
	actor:iterate_inventory(function(_, item)
		if item and not DEVELOPER_KEEP_SECTIONS[item:section()] then
			table.insert(remove_ids, item:id())
		end
	end, actor)

	local removed = 0
	for _, id in ipairs(remove_ids) do
		local server_item = sim:object(id, true)
		if server_item then
			sim:release(server_item, true)
			removed = removed + 1
		end
	end

	local ready = ensure_stash_qa_tools(true)
	qa_tools_checked = ready
	report(string.format(
		"Developer inventory prepared: removed %d regular items, QA tools ready=%s",
		removed, tostring(ready)
	), true)
	return ready
end

local function process_new_game_mode_request()
	if new_game_mode_checked or not db.actor then return end

	local file = io.open(new_game_mode_request_path(), "r")
	if not file then
		new_game_mode_checked = true
		return
	end
	local mode = string.lower(file:read("*l") or "")
	file:close()
	if mode == "developer" and not is_developer_access_enabled() then
		mode = "novice"
	end

	local difficulty = NEW_GAME_DIFFICULTIES[mode]
	if not difficulty then
		new_game_mode_checked = true
		return
	end

	-- Apply the requested enum again after the gameplay Lua state exists. This
	-- prevents a persisted user.ltx difficulty from replacing the menu choice.
	get_console():execute("g_game_difficulty " .. difficulty)
	write_new_game_mode_request("consumed")
	new_game_mode_checked = true
	xr_effects.pf_new_game_start(mode == "developer")

	if mode == "developer" then
		local world = rawget(_G, "lz_nm_world")
		if world and world.schedule_developer_start_stash then
			world.schedule_developer_start_stash()
		end
	end
	report("New-game mode initialized: " .. mode .. " (" .. difficulty .. ")", true)
end

local function configured_model(section)
	local ini = system_ini()
	if ini:line_exist(section, "visual") then
		return ini:r_string(section, "visual")
	end
	return "<unknown>"
end

local function game_timestamp()
	local year, month, day, hour, minute, second, millisecond = 0, 0, 0, 0, 0, 0, 0
	year, month, day, hour, minute, second, millisecond = game.get_game_time():get(
		year, month, day, hour, minute, second, millisecond
	)
	return string.format(
		"%04d-%02d-%02d %02d:%02d:%02d",
		year, month, day, hour, minute, second
	)
end

local function qa_log_path(filename)
	return getFS():update_path("$logs$", filename)
end

local function append_placement_log(object, position)
	local path = qa_log_path(QA_LOG_FILENAME)
	local needs_header = true
	local existing = io.open(path, "r")
	if existing then
		needs_header = existing:read("*l") == nil
		existing:close()
	end

	local file = io.open(path, "a")
	if not file then return false end
	if needs_header then file:write(QA_LOG_HEADER .. "\n") end
	local section = object:section_name()
	local yaw = object.angle and object.angle.y or 0
	file:write(string.format(
		"%s\t%s\t%s\t%s\t%.6f\t%.6f\t%.6f\t%.3f\t%s\n",
		tostring(object.id), level.name(), section, configured_model(section),
		position.x, position.y, position.z, math.deg(yaw), game_timestamp()
	))
	file:close()
	return true
end

local function append_pattern_log(object, position, ray, camera_direction)
	local path = qa_log_path(QA_PATTERN_LOG_FILENAME)
	local needs_header = true
	local existing = io.open(path, "r")
	if existing then
		needs_header = existing:read("*l") == nil
		existing:close()
	end

	local file = io.open(path, "a")
	if not file then return false end
	if needs_header then file:write(QA_PATTERN_LOG_HEADER .. "\n") end

	local stash_section = object:section_name()
	local yaw = object.angle and object.angle.y or 0
	local hit_object = ray:get_object()
	local hit_server = hit_object and alife():object(hit_object:id(), true) or nil
	local hit_kind = hit_server and "object" or "static"
	local hit_object_id = hit_server and tostring(hit_server.id) or "-1"
	local hit_object_section = hit_server and hit_server:section_name() or "<static>"
	local hit_object_model = hit_server and configured_model(hit_object_section) or "<compiled>"

	file:write(string.format(
		"%s\t%s\t%s\t%s\t%.6f\t%.6f\t%.6f\t%.3f\t%s\t%s\t%s\t%s\t%s\t%s\t%.6f\t%.6f\t%.6f\t%.6f\t%s\n",
		tostring(object.id), level.name(), stash_section, configured_model(stash_section),
		position.x, position.y, position.z, math.deg(yaw), hit_kind,
		tostring(ray:get_element()), tostring(ray:get_material()), hit_object_id,
		hit_object_section, hit_object_model, ray:get_distance(),
		camera_direction.x, camera_direction.y, camera_direction.z, game_timestamp()
	))
	file:close()
	return true
end

local function append_catalog_rejection_log(object, position)
	local path = qa_log_path(QA_REJECTION_LOG_FILENAME)
	local needs_header = true
	local existing = io.open(path, "r")
	if existing then
		local expected_level = level.name()
		local expected_section = object:section_name()
		for line in existing:lines() do
			needs_header = false
			local _, recorded_level, recorded_section, _, x, y, z = string.match(
				line,
				"^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t"
			)
			local same_position = x and y and z and
				math.abs((tonumber(x) or 1e30) - position.x) <= 0.001 and
				math.abs((tonumber(y) or 1e30) - position.y) <= 0.001 and
				math.abs((tonumber(z) or 1e30) - position.z) <= 0.001
			if recorded_level == expected_level and
				recorded_section == expected_section and same_position then
				existing:close()
				return true, false
			end
		end
		existing:close()
	end

	local file = io.open(path, "a")
	if not file then return false, false end
	if needs_header then file:write(QA_REJECTION_LOG_HEADER .. "\n") end
	local section = object:section_name()
	local yaw = object.angle and object.angle.y or 0
	file:write(string.format(
		"%s\t%s\t%s\t%s\t%.6f\t%.6f\t%.6f\t%.3f\t%s\n",
		tostring(object.id), level.name(), section, configured_model(section),
		position.x, position.y, position.z, math.deg(yaw), game_timestamp()
	))
	file:close()
	return true, true
end

local function reconcile_actor_developer_items(hud_silent)
	local actor = db.actor
	local sim = alife()
	if not actor or not sim then return nil end

	local actor_id = actor:id()
	if qa_issue_actor_id ~= actor_id then
		qa_issue_actor_id = actor_id
		qa_pending_sections = {}
	end

	local ids_by_section = {}
	actor:iterate_inventory(function(_, item)
		local section = item and item:section() or nil
		if section and DEVELOPER_KEEP_SECTIONS[section] then
			ids_by_section[section] = ids_by_section[section] or {}
			table.insert(ids_by_section[section], item:id())
		end
	end, actor)

	local present = {}
	local duplicate_ids = {}
	for section, ids in pairs(ids_by_section) do
		table.sort(ids)
		local client_item = actor:object(section)
		local keep_id = client_item and client_item:id() or ids[1]
		present[section] = true
		qa_pending_sections[section] = nil
		for _, id in ipairs(ids) do
			if id ~= keep_id then
				table.insert(duplicate_ids, id)
			end
		end
	end

	local removed = 0
	for _, id in ipairs(duplicate_ids) do
		local duplicate = sim:object(id, true)
		if duplicate then
			sim:release(duplicate, true)
			removed = removed + 1
		end
	end
	if removed > 0 then
		report(string.format("Removed %d duplicate Developer inventory items", removed), hud_silent)
	end
	return present
end

local function ensure_qa_tool(section, label, present, hud_silent)
	if not db.actor then return false end
	if (present and present[section]) or db.actor:object(section) then
		if present then present[section] = true end
		qa_pending_sections[section] = nil
		return true
	end
	if qa_pending_sections[section] then
		return true
	end
	local item = alife():create(
		section, vector(), 0, 0, db.actor:id()
	)
	if not item then
		report("Failed to issue the QA " .. label, hud_silent)
		return false
	end
	qa_pending_sections[section] = true
	if present then present[section] = true end
	report("QA " .. label .. " added to inventory", hud_silent)
	return true
end

local function retire_legacy_rejection_tool(hud_silent)
	if not db.actor then return false end
	local item = db.actor:object(LEGACY_QA_REJECTION_TOOL_SECTION)
	if not item then return true end

	local sim = alife()
	local server_object = sim and sim:object(item:id(), true) or nil
	if not server_object then return false end
	sim:release(server_object, true)
	report("Removed obsolete standalone nearest-stash QA tool from inventory", hud_silent)
	return true
end

local function retire_legacy_crosshair_rejection_tool(hud_silent)
	if not db.actor then return false end
	local sim = alife()
	if not sim then return false end

	local legacy_ids = {}
	db.actor:iterate_inventory(function(_, item)
		if item and item:section() == LEGACY_QA_CROSSHAIR_REJECTION_TOOL_SECTION then
			table.insert(legacy_ids, item:id())
		end
	end, db.actor)

	for _, id in ipairs(legacy_ids) do
		local server_object = sim:object(id, true)
		if server_object then sim:release(server_object, true) end
	end
	if #legacy_ids > 0 then
		report("Replaced obsolete overlong crosshair QA tool with quick-slot-safe version", hud_silent)
	end
	return true
end

function ensure_stash_qa_tools(hud_silent)
	local all_ready = retire_legacy_rejection_tool(hud_silent)
	if not retire_legacy_crosshair_rejection_tool(hud_silent) then all_ready = false end
	if not is_developer_mode() then return all_ready end
	local present = reconcile_actor_developer_items(hud_silent)
	if not present then return false end
	for _, essential in ipairs(DEVELOPER_ESSENTIAL_DEFINITIONS) do
		if not ensure_qa_tool(essential[1], essential[2], present, hud_silent) then all_ready = false end
	end
	for _, tool in ipairs(QA_TOOL_DEFINITIONS) do
		if not ensure_qa_tool(tool[1], tool[2], present, hud_silent) then all_ready = false end
	end
	return all_ready
end

local function nearest_catalog_stash()
	if not db.actor then return nil end
	local actor_position = db.actor:position()
	local nearest = nil
	local nearest_distance_sqr = nil
	for _, object in alife():objects() do
		if QA_CATALOG_REMOVAL_SECTIONS[object:section_name()] then
			local position = object.position
			local dx = position.x - actor_position.x
			local dy = position.y - actor_position.y
			local dz = position.z - actor_position.z
			local distance_sqr = dx * dx + dy * dy + dz * dz
			if not nearest_distance_sqr or distance_sqr < nearest_distance_sqr or
				(distance_sqr == nearest_distance_sqr and object.id < nearest.id) then
				nearest = object
				nearest_distance_sqr = distance_sqr
			end
		end
	end
	return nearest, nearest_distance_sqr
end

function mark_nearest_stash_for_catalog_removal()
	local server_object, distance_sqr = nearest_catalog_stash()
	if not server_object then
		report("No existing fixed or QA stash was found")
		return false
	end
	local position = vector():set(server_object.position)
	local ok, added = append_catalog_rejection_log(server_object, position)
	if not ok then
		report("Failed to write the stash catalogue rejection log")
		return false
	end
	local distance = math.sqrt(distance_sqr or 0)
	if not added then
		report(string.format(
			"Nearest stash is already marked: %.3f, %.3f, %.3f (%.1f m)",
			position.x, position.y, position.z, distance
		))
		return true
	end
	report(string.format(
		"Nearest stash marked for removal: %.3f, %.3f, %.3f " ..
		"(id %s, %.1f m, model %s)",
		position.x, position.y, position.z, tostring(server_object.id), distance,
		configured_model(server_object:section_name())
	))
	return true
end

function use_stash_rejection_tool(_item)
	mark_nearest_stash_for_catalog_removal()
	-- The custom inventory action must not invoke the native Eat path after the
	-- log was written. Quick slots use Eat directly and are handled by the global
	-- OnInventoryEat callback owned by the late-loading QA bridge addon.
	return false
end

function use_stash_teleport_tool(_item)
	teleport_to_next_stash()
	-- As above, the context action performs the QA operation itself and must not
	-- fall through to the native Eat path. Quick slots are handled below.
	return false
end

function use_stash_markers_tool(_item)
	toggle_all_stash_markers()
	return false
end

function use_stash_catalog_markers_tool(item)
	local overlay = rawget(_G, "pf_stash_catalog_qa")
	if overlay and overlay.use_tool then return overlay.use_tool(item) end
	report("Canonical stash catalogue QA API is unavailable")
	return false
end

function use_stash_spawn_tool(_item)
	spawn_stash_at_crosshair()
	return false
end

function use_stash_delete_tool(_item)
	delete_qa_object_at_crosshair()
	return false
end

function use_stash_undo_tool(_item)
	undo_last_qa_placement()
	return false
end

local function record_future_light_point()
	local recorder = pf_bunker_qa
	if not recorder or not recorder.record_light_point then
		report("Bunker light-point QA API is unavailable")
		return false
	end
	return recorder.record_light_point()
end

local function record_future_npc_spawn_point()
	local recorder = pf_bunker_qa
	if not recorder or not recorder.record_npc_point then
		report("NPC spawn-point QA API is unavailable")
		return false
	end
	return recorder.record_npc_point()
end

function use_light_point_tool(_item)
	record_future_light_point()
	return false
end

function teleport_to_scientists()
	local bunker = pf_scientist_bunker
	if not bunker or not bunker.teleport_actor_to_scientists then
		report("Scientist-bunker teleport API is unavailable")
		return false
	end

	local ok, destination = bunker.teleport_actor_to_scientists()
	if not ok then
		report("Scientist teleport failed: " .. tostring(destination))
		return false
	end

	report(string.format(
		"Teleported to scientists at %.3f, %.3f, %.3f",
		destination.x, destination.y, destination.z
	))
	return true
end

function use_scientist_teleport_tool(_item)
