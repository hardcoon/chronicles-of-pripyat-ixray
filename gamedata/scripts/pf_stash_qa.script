		report("Order delivery-point tool is available only in Developer mode")
		return false
	end
	local orders = rawget(_G, "lz_orders")
	if not orders or not orders.capture_drop_point then
		report("Order delivery-point QA API is unavailable")
		return false
	end
	orders.capture_drop_point()
	return false
end

function use_order_point_undo_tool(_item)
	if not is_developer_mode() then
		report("Order delivery-point tool is available only in Developer mode")
		return false
	end
	local orders = rawget(_G, "lz_orders")
	if not orders or not orders.undo_drop_point then
		report("Order delivery-point QA API is unavailable")
