local level_name = "pripyat_full"
local qa_runtime_config = "pf_bunker_qa_runtime.ltx"
local bunker_center = vector():set(1277, 0, 74)
local activation_distance_sqr = 250 * 250
local update_interval = 500
local actor_look_distance_sqr = 10 * 10
local actor_look_release_distance_sqr = 12 * 12
local greeting_distance_sqr = 3 * 3
local greeting_release_distance_sqr = 4 * 4
local cleanup_delay = 5000
local cleanup_interval = 1000
local position_tolerance_sqr = 0.25 * 0.25
local direction_dot_threshold = 0.995
local direction_retry_interval = 2000
local passive_sound_threshold = 1000000
local no_smart_terrain_id = 65535
-- Positions come from the accepted Num7 records in pf_bunker_qa_npc_points.log;
-- yaw and look vectors include the later authored rotation adjustments. The
-- armed guards use the commander's guard state; unarmed scientists use its
-- matching idle animation without a weapon precondition. Recorded look
-- vectors remain the fallback when the actor is not close enough.
local residents = {
    {
        section = "pf_bunker_novikov",
        visual = "actors\\pripyat_full\\pf_bunker_novikov",
        position = vector():set(1274.679321, -0.072798, 74.458542),
        yaw = 1.570796327,
        direction = vector():set(1, 0, 0),
        look = vector():set(1284.679321, 1.427202, 74.458542),
        level_vertex_id = 13998324,
        game_vertex_id = 584,
        -- Temporary direction-neutral clone of the requested stock CoP pose.
        -- It keeps the lead_1 animation set but leaves the authored 90-degree
        -- facing exclusively to these resident yaw/direction/look fields.
        state = "pf_bunker_novikov_jup_b41_fixed",
        fixed_direction = true,
        greeting_hello = "jup_b6_scientist_medic_greeting",
        greeting_bye = "jup_b6_scientist_medic_farewell",
        logic_section = "remark@pf_bunker_novikov",
    },
    {
        section = "pf_bunker_hermann",
        position = vector():set(1269.282227, 0.147409, 82.302155),
        yaw = 2.538623062,
        direction = vector():set(0.567090891, 0, -0.823655220),
        look = vector():set(1274.953136, 1.647409, 74.065603),
        level_vertex_id = 13965791,
        game_vertex_id = 584,
        -- Hermann is unarmed as in stock CoP. wait_trade drives the same
        -- state_mgr "idle" animation while explicitly requiring no weapon.
        state = "wait_trade",
        greeting_hello = "jup_b6_scientist_nuclear_physicist_greeting",
        greeting_bye = "jup_b6_scientist_nuclear_physicist_farewell",
        logic_section = "remark@pf_bunker_hermann",
    },
    {
        section = "pf_bunker_guard_01",
        visual = "actors\\stalker_soldier\\stalker_soldier_2",
        fixed_name = "pf_bunker_guard_commander_name",
        position = vector():set(1295.683105, -0.625042, 57.597500),
        yaw = 0.739959136,
        direction = vector():set(0.674257734, 0, 0.738496113),
        look = vector():set(1302.425682, 0.874958, 64.982461),
        level_vertex_id = 14118581,
        game_vertex_id = 584,
        state = "guard",
        logic_section = "remark@pf_bunker_guard_commander",
        guard = true,
    },
    {
        section = "pf_bunker_guard_02",
        name_subset = "private",
        position = vector():set(1281.486816, 5.087826, 71.635094),
        yaw = 2.346496662,
        direction = vector():set(0.713930823, 0, -0.700216238),
        look = vector():set(1288.626124, 6.587826, 64.632932),
        level_vertex_id = 14038318,
        game_vertex_id = 584,
        state = "guard",
