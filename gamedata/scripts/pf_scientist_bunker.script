    {
        section = "pf_bunker_guard_03",
        visual = "actors\\stalker_soldier\\stalker_soldier_2",
        name_subset = "private",
        position = vector():set(1267.362915, 5.702414, 80.970695),
        yaw = -0.780278690,
        direction = vector():set(-0.703477502, 0, 0.710717499),
        look = vector():set(1260.328140, 7.202414, 88.077870),
        level_vertex_id = 13957733,
        game_vertex_id = 584,
        state = "binocular",
        greeting_hello = "meet_hello",
        logic_section = "remark@pf_bunker_guard_03",
        guard = true,
    },
    {
        section = "pf_bunker_guard_04",
        visual = "actors\\stalker_soldier\\stalker_soldier_2",
        name_subset = "private",
        position = vector():set(1287.467163, -0.271441, 78.435860),
        yaw = 1.584007587,
        direction = vector():set(0.999912739, 0, -0.013210876),
        look = vector():set(1297.466290, 1.228559, 78.303751),
        level_vertex_id = 14070817,
        game_vertex_id = 584,
        state = "guard_chasovoy",
        greeting_hello = "meet_hello",
        logic_section = "remark@pf_bunker_guard_04",
        guard = true,
    },
