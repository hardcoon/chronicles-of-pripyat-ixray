-- Persistent observations, independent of game saves. Presence is never saved.
-- The optional fifth log field "op" retains the last observed channel role.
local state = { records = {}, by_network = {}, by_nick = {}, live = {}, seen = {}, loaded = false, revision = 0 }
local impl = {}

function impl.fold(text)
    return tostring(text or ""):lower():gsub("[%[\\%]%^]", {
        ["["] = "{", ["]"] = "}", ["\\"] = "|", ["^"] = "~" })
end

function canonical_nick(nick)
    -- Fold the full IRC nickname. A legitimate name can end in any apparent
    -- suffix (including _dead); only an actual identity links different names.
    return impl.fold(nick)
end

function impl.escape(text)
    return tostring(text):gsub("[^%w .:_@#{}%-%[%]]", function(c)
        return string.format("%%%02X", c:byte())
    end)
end

function impl.unescape(text)
    return text:gsub("%%(%x%x)", function(hex) return string.char(tonumber(hex, 16)) end)
end

function impl.valid(text, limit)
    return type(text) == "string" and #text > 0 and #text <= limit and not text:find("[%z\1-\32\127]")
end

function impl.network(profile)
    return tostring(profile and profile.address or ""):lower() .. ":" .. tostring(profile and profile.port or 0)
end

function impl.key(network, identity)
    return network .. "\t" .. identity:lower()
end

function impl.strength(identity)
    if identity:sub(1, 8) == "install:" then return 4 end
    if identity:sub(1, 8) == "account:" then return 3 end
    if identity:sub(1, 5) == "host:" then return 2 end
    return 1
end

function impl.serialize(record)
    if not record.serialized_line then
        record.serialized_line = table.concat({impl.escape(record.network), impl.escape(record.identity),
            impl.escape(record.nick), record.payload}, "\t") .. (record.operator and "\top" or "")
    end
    return record.serialized_line
end

function impl.unindex(record, key)
    local network = state.by_nick[record.network]
    local nick = canonical_nick(record.nick)
    local bucket = network and network[nick]
    if bucket then
        bucket[key] = nil
        if next(bucket) == nil then network[nick] = nil end
    end
end

function impl.put(network, identity, nick, payload)
    if not impl.valid(network, 260) or not impl.valid(identity, 260) or not impl.valid(nick, 128) then return end
    local values = payload ~= "-" and pf_player_stats_wire.decode(payload) or nil
    if payload ~= "-" and not values then return end
    identity = identity:lower()
    -- Hosts can be shared by several players. Until WHOIS supplies an install
    -- or account ID, retain separate full nicknames instead of merging a NAT.
    if impl.strength(identity) < 3 then identity = "nick:" .. canonical_nick(nick) end
    local key = impl.key(network, identity)
    local record = state.records[key]
    local changed = not record
    local weak_key = impl.key(network, "nick:" .. canonical_nick(nick))
    local weak = key ~= weak_key and state.records[weak_key] or nil
    if weak then
        impl.unindex(weak, weak_key)
        -- This is an exact current nickname, never a guessed suffix match.
        -- Different confirmed identities are never absorbed by this path.
        record = record or weak
        if weak.current_payload then
            record.values, record.payload = weak.current_values, weak.current_payload
        end
        if weak.operator then record.operator = true end
        state.records[weak_key] = nil
        if state.by_network[network] then state.by_network[network][weak_key] = nil end
        changed = true
    end
    record = record or {}
    if record.nick and (record.nick ~= nick or record.identity ~= identity) then impl.unindex(record, key) end
    changed = changed or record.nick ~= nick or record.identity ~= identity or
        (values ~= nil and record.payload ~= payload)
    record.network, record.identity, record.nick = network, identity:lower(), nick
    if values or not record.payload then record.payload, record.values = payload, values end
    record.presence = record.presence or "offline"
    if changed then record.serialized_line = nil end
    impl.serialize(record)
    state.records[key] = record
    state.by_network[network] = state.by_network[network] or {}
    state.by_network[network][key] = record
    state.by_nick[network] = state.by_nick[network] or {}
    local folded = canonical_nick(nick)
    state.by_nick[network][folded] = state.by_nick[network][folded] or {}
    state.by_nick[network][folded][key] = record
    return record, key, changed
end

function impl.load()
    if state.loaded then return end
    state.loaded = true
    state.path = getFS():update_path("$app_data_root$", "pf_player_stats.log")
    local file = io.open(state.path, "rb")
    if not file then return end
    local content = file:read(8 * 1024 * 1024 + 1)
    file:close()
    if not content or #content > 8 * 1024 * 1024 or content:sub(1, 12) ~= "PF_STATS_1\r\n" then
        -- Do not replace an unknown/corrupt format with an empty cache.
        state.read_only = true
        return
    end
    for line in content:gmatch("[^\r\n]+") do
        if #line <= 2048 then
            local network, identity, nick, payload, role =
                line:match("^([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)\t(op)$")
            if not network then
                network, identity, nick, payload =
                    line:match("^([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)$")
            end
            if network then
                local record = impl.put(impl.unescape(network), impl.unescape(identity),
                    impl.unescape(nick), payload)
                if record and role == "op" then record.operator = true; record.serialized_line = nil end
            end
        end
    end
end

function impl.changed(record)
    if record then record.serialized_line = nil end
    if not state.dirty then state.flush_after = (time_global and time_global() or 0) + 5000 end
    state.dirty = true
end

function impl.roles(channels, confirmed)
    local roles = { nicks = {}, identities = {} }
    for _, channel in pairs(channels or {}) do
        if channel.ready then
            for _, user in pairs(channel.users or {}) do
                local nick = canonical_nick(user.nick)
                local identity = confirmed[nick]
                -- The bridge normalizes channel owner/admin/operator to @.
                -- Accept raw equivalents too; + (voice) is not an operator.
                local operator = tostring(user.prefix or ""):find("[@&~]") ~= nil
                roles.nicks[nick] = roles.nicks[nick] or operator
                if identity then roles.identities[identity] = roles.identities[identity] or operator end
            end
        end
    end
    return roles
end

function impl.observe_role(record, roles)
    local nick, identity = roles.nicks[canonical_nick(record.nick)], roles.identities[record.identity]
    if nick == nil and identity == nil then return end
    local operator = nick == true or identity == true
    if (record.operator == true) ~= operator then
        record.operator = operator
        impl.changed(record)
        return true
    end
end

function bind_self(profile, nick, identity)
    impl.load()
    state.self = nil
    if not impl.valid(nick, 128) or not impl.valid(identity, 260) or
        not has_copid(identity) then return end
    local network = impl.network(profile)
    state.self = {network = network, nick = canonical_nick(nick), identity = identity:lower()}
    local _, _, changed = impl.put(network, identity, nick, "-")
    if changed then impl.changed(); state.revision = state.revision + 1 end
end

function sync(profile, channels)
    impl.load()
    local network = impl.network(profile)
    local view_changed, seen = false, {}
    local live = {}
    local confirmed = {}
    for _, channel in pairs(channels or {}) do
        if channel.ready then
            for _, user in pairs(channel.users or {}) do
                local identity = tostring(user.identity or ""):lower()
                if impl.strength(identity) >= 3 then confirmed[canonical_nick(user.nick)] = identity end
            end
        end
    end
    if state.self and state.self.network == network then
        confirmed[state.self.nick] = state.self.identity
    end
    -- Gather all channels before applying roles: operator in any joined
    -- channel wins, regardless of channel iteration order.
    local roles = impl.roles(channels, confirmed)
    for record in pairs(state.live) do record.next_presence = "offline" end
    for channel_key, channel in pairs(channels or {}) do
        if channel.ready then
            for _, user in pairs(channel.users or {}) do
                local nick, identity = user.nick, tostring(user.identity or ""):lower()
                if identity == "" then identity = "nick:" .. impl.fold(nick) end
                if impl.valid(nick, 128) and impl.valid(identity, 260) then
                    local source_identity = identity
                    if state.self and state.self.network == network and
                        canonical_nick(nick) == state.self.nick then
                        identity = state.self.identity
                    elseif impl.strength(identity) < 3 then
                        identity = confirmed[canonical_nick(nick)] or identity
                    end
                    local record, _, changed = impl.put(network, identity, nick, "-")
                    if changed then impl.changed(); view_changed = true end
                    if record then
                        live[record] = true
                        if record.next_presence ~= "online" then
                            record.next_presence = user.presence == "away" and "away" or "online"
                        end
                        local payload = user.away_message
                        local source = channel_key .. "\t" .. source_identity .. "\t" .. impl.fold(nick)
                        seen[source] = payload
                        if payload ~= state.seen[source] then
                            local values = pf_player_stats_wire.decode(payload)
                            if values then
                                if payload ~= record.payload then impl.changed(record); view_changed = true end
                                record.payload, record.values = payload, values
                                record.current_payload, record.current_values = payload, values
                            elseif user.presence == "away" and type(payload) == "string" and payload ~= "" then
                                -- An explicit non-game/invalid AWAY (including the spawner
                                -- fallback) withdraws old data and appearance. Online clears
                                -- AWAY normally, so an empty Online reason retains the cache.
                                if record.payload ~= "-" then impl.changed(record); view_changed = true end
                                record.payload, record.values = "-", nil
                                record.current_payload, record.current_values = "-", nil
                            end
                        end
                    end
                end
            end
        end
    end
    state.seen = seen
    -- Presence needs only previously/currently connected records, not the
    -- thousands of offline historical identities in the cache.
    for record in pairs(state.live) do
        if not live[record] then
            if record.presence ~= "offline" then view_changed = true end
            record.presence, record.next_presence = "offline", "offline"
        end
    end
    for record in pairs(live) do
        if record.presence ~= (record.next_presence or "offline") then view_changed = true end
        record.presence = record.next_presence or "offline"
    end
    state.live = live
    -- Preserve role classification of old cached entries sharing a currently
    -- visible nickname, using the nickname index instead of a history scan.
    for nick in pairs(roles.nicks) do
        local index = state.by_nick[network]
        for _, record in pairs(index and index[nick] or {}) do
            if impl.observe_role(record, roles) then view_changed = true end
        end
    end
    if view_changed then state.revision = state.revision + 1 end
end

-- COPID is the bridge's advertised install GUID; other IRC identities do not
-- qualify for statistics. Presence of a COPID is not proof of authenticity.
function has_copid(identity)
    identity = tostring(identity or ""):lower()
    local a, b, c, d, e = identity:match("^install:(%x+)%-(%x+)%-(%x+)%-(%x+)%-(%x+)$")
    return a ~= nil and #a == 8 and #b == 4 and #c == 4 and #d == 4 and #e == 12 and
        identity ~= "install:00000000-0000-0000-0000-000000000000"
end

function records(profile)
    impl.load()
    local network, result = impl.network(profile), {}
    for _, record in pairs(state.by_network[network] or {}) do
        if has_copid(record.identity) and not record.operator then
            result[#result + 1] = record
        end
    end
    return result
end

-- One local install-ID list, shared across IRC servers and game saves.
function impl.load_blacklist()
    if state.blocked then return end
    state.blocked, state.blacklist_revision = {}, 1
    state.blacklist_path = getFS():update_path("$app_data_root$", "pf_player_stats_blacklist.cfg")
    local file = io.open(state.blacklist_path, "rb")
    if not file then return end
    local content = file:read(1024 * 1024 + 1)
    file:close()
    local header = "PF_STATS_BLACKLIST_1\n"
    if not content or #content > 1024 * 1024 or content:sub(1, #header) ~= header then
        state.blacklist_read_only = true
        return -- Preserve unknown/corrupt files; never replace them with an empty list.
    end
    for line in content:sub(#header + 1):gmatch("[^\r\n]+") do
        local identity, nick = line:match("^([^\t]+)\t([^\t]*)$")
        if identity and has_copid(identity) and #nick <= 384 then
            nick = impl.unescape(nick)
            if #nick <= 128 and not nick:find("[%z\1-\31\127]") then state.blocked[identity:lower()] = nick end
        end
    end
end

function impl.replace_file(path, content)
    local temporary = path .. ".tmp"
    local file = io.open(temporary, "wb")
    local ok = false
    if file then
        ok = file:write(content) ~= nil
        ok = file:close() and ok
    end
    if ok then
        if not state.kernel then
            local loaded, ffi = pcall(require, "ffi")
            if loaded then
                pcall(ffi.cdef, "int __stdcall MoveFileExA(const char*, const char*, unsigned long);")
                local ready, kernel = pcall(ffi.load, "kernel32")
                if ready then state.kernel = kernel end
            end
        end
        local moved, result = pcall(function()
            return state.kernel and state.kernel.MoveFileExA(temporary, path, 9) ~= 0
        end)
        ok = moved and result
    end
    return ok == true
end

function is_blocked(identity)
    impl.load_blacklist()
    return state.blocked[tostring(identity or ""):lower()] ~= nil
end

function blacklist_revision()
    impl.load_blacklist()
    return state.blacklist_revision
end

function blocked_ids()
    impl.load_blacklist()
    local result = {}
    for identity in pairs(state.blocked) do result[identity] = true end
    return result
end

function blocked_records()
    impl.load_blacklist()
    local result = {}
    for identity, nick in pairs(state.blocked) do
        result[#result + 1] = {identity = identity, nick = nick}
    end
    return result
end

function set_blocked(identity, nick, blocked)
    impl.load_blacklist()
    identity, nick = tostring(identity or ""):lower(), tostring(nick or "")
    if not has_copid(identity) or type(blocked) ~= "boolean" or #nick > 128 or
        nick:find("[%z\1-\31\127]") or (state.self and identity == state.self.identity) then
        return false, "pf_pda_blacklist_invalid"
    end
    if (state.blocked[identity] ~= nil) == blocked then return true end
    if state.blacklist_read_only then return false, "pf_pda_blacklist_save_error" end
    local candidate, identities = {}, {}
    for key, value in pairs(state.blocked) do candidate[key] = value end
    candidate[identity] = blocked and nick or nil
    for key in pairs(candidate) do identities[#identities + 1] = key end
    table.sort(identities)
    local lines = {"PF_STATS_BLACKLIST_1"}
    for _, key in ipairs(identities) do lines[#lines + 1] = key .. "\t" .. impl.escape(candidate[key]) end
    local content = table.concat(lines, "\n") .. "\n"
    if #content > 1024 * 1024 or not impl.replace_file(state.blacklist_path, content) then
        return false, "pf_pda_blacklist_save_error"
    end
    state.blocked = candidate
    state.blacklist_revision = state.blacklist_revision + 1
    state.revision = state.revision + 1
    return true
end


function is_confirmed(identity) return impl.strength(tostring(identity or "")) >= 3 end

function is_operator(profile, identity)
    impl.load()
    local record = state.records[impl.key(impl.network(profile), tostring(identity or ""):lower())]
    return record ~= nil and record.operator == true
end

function revision() return state.revision end

function flush(defer)
    if not state.dirty or state.read_only then return true end
    local now = time_global and time_global() or 0
    if now < (state.retry_after or 0) then return false end
    -- The periodic tick batches writes. Explicit/default flush remains immediate
    -- for disconnect, save/load, shutdown and callers of the existing API.
    if defer and now < (state.flush_after or 0) then return true end
    local lines = {}
    for _, record in pairs(state.records) do
        lines[#lines + 1] = impl.serialize(record)
    end
    table.sort(lines)
    local content = "PF_STATS_1\r\n" .. table.concat(lines, "\r\n") .. "\r\n"
    if #content > 8 * 1024 * 1024 then state.read_only = true; return false end
    local temporary = state.path .. ".tmp"
    local file = io.open(temporary, "wb")
    local ok = false
    if file then
        ok = file:write(content) ~= nil
        ok = file:close() and ok
    end
    if ok then
        if not state.kernel then
            local loaded, ffi = pcall(require, "ffi")
            if loaded then
                pcall(ffi.cdef, "int __stdcall MoveFileExA(const char*, const char*, unsigned long);")
                state.kernel = ffi.load("kernel32")
            end
        end
        -- Atomic replacement: failure leaves the previous file intact.
        ok = state.kernel and state.kernel.MoveFileExA(temporary, state.path, defer and 1 or 9) ~= 0
    end
    if ok then state.dirty = false; return true end
    state.retry_after = now + 5000
    if printf then printf("[PDA stats] Could not replace local cache; previous file retained") end
    return false
end
