function give_radio(first_speaker, second_speaker)
	if db.actor:has_info("pf_guide_radio_received") then
		return
	end

	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "hand_radio")
	db.actor:give_info_portion("pf_guide_radio_received")
end

function finish_guide_dialog(first_speaker, second_speaker)
	if not db.actor:has_info("pf_guide_dialog_done") then
		db.actor:give_info_portion("pf_guide_dialog_done")
	end

	local story_just_started = not db.actor:has_info("pf_story_past_started")
	if not db.actor:has_info("pf_story_past_started") then
		db.actor:give_info_portion("pf_story_past_started")
		task_manager.get_task_manager():give_task("pf_learn_past")
	end

	if story_just_started then
		xr_effects.scenario_autosave(
			db.actor, second_speaker, {"st_save_pf_story_started"})
	end
	level.add_complex_effector("fade_in_out", 8914)
end

-- Non-lethal encounter branch: after the sermon Sergey may hand over the
-- pendant voluntarily. Taking it still drives the same document chain as
-- looting it from his corpse.
function give_preacher_pendant(first_speaker, second_speaker)
	dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "pf_story_brother_pendant")
	pf_story_encounter.on_pendant_given_alive(second_speaker)
end

-- The reunion no longer takes Sergey's pendant away. He keeps the clue while
-- he is alive, withdraws from the conversation and goes aside to pray.
function finish_preacher_reunion(first_speaker, second_speaker)
	pf_story_encounter.on_preacher_reunion_finished(second_speaker)
end

