local guardian_t3_pair_groups = {
	gravi = {
		"af_gravi", "af_gold_fish", "af_eye", "af_fire",
		"af_baloon", "af_glass", "af_dummy_dummy", "af_ice"
	},
	gold_fish = {
		"af_gold_fish", "af_eye", "af_fire", "af_baloon",
		"af_glass", "af_dummy_dummy", "af_ice"
	},
	eye = {
		"af_eye", "af_fire", "af_baloon", "af_glass", "af_dummy_dummy", "af_ice"
	},
	fire = {"af_fire", "af_baloon", "af_glass", "af_dummy_dummy", "af_ice"},
	baloon = {"af_baloon", "af_glass", "af_dummy_dummy", "af_ice"},
	glass = {"af_glass", "af_dummy_dummy", "af_ice"},
	dummy_dummy = {"af_dummy_dummy", "af_ice"},
	ice = {"af_ice"}
}

