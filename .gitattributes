# Normalize source files in the repository while keeping Windows launchers and
# PowerShell scripts immediately executable in the local checkout.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.ltx text eol=lf
*.script text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.pl text eol=lf

# Game resources are binary. Git LFS can be introduced deliberately before a
# future large-asset import; existing small tracked assets remain ordinary Git.
*.dds binary
*.ogf binary
*.omf binary
*.ogg binary
*.ogm binary
*.spawn filter=lfs diff=lfs merge=lfs -text
*.xr binary
*.png binary
*.exe binary
*.dll binary

